-- Expression-body factories must preserve the native words they contain.
local Record = Struct { value: U32 }

local expression_factory = do(name) = do(body)
    local word = do(record: Ref Record): U32 = body record
    return word
end

local block_factory = do(name)
    return do(body)
        local word = do(record: Ref Record): U32 = body record
        return word
    end
end

local read_expression = expression_factory "expression" do(record) = record.value + 1
export read_expression

local read_block = block_factory "block" do(record) = record.value + 1
export read_block

local borrow_factory = do(name) = do(body)
    local word = do(record: Ref Record): Ref Record = body record
    return word
end

local borrow_expression = borrow_factory "borrow" do(record) = record
export borrow_expression

local parenthesized_factory = do(name) = do(body)
    local word = do(record: (Ref Record)): U32 = body record
    return word
end

local read_parenthesized = parenthesized_factory "parenthesized" do(record) = record.value + 1
export read_parenthesized

local text_factory = do(name) = do(body)
    local word = do(): Chars 4 = body()
    return word
end

local text_expression = text_factory "text" do() = Chars 4 "abc"

test "expression and block factories agree" do(): Unit
    local record = Record { value = 41 }
    assert(read_expression(Ref record) == 42)
    assert(read_block(Ref record) == 42)
    assert(read_parenthesized(Ref record) == 42)
    assert(borrow_expression(Ref record).value == 41)
    local text = text_expression()
    assert(text.length == 3)
end
