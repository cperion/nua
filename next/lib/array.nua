-- Fixed-length arrays (syntax §13): the words of every `Array T n`, served once per family. An
-- array is a value: its elements are its parts, known while they are known; the compiler
-- supplies only the element's place and a view of the elements in memory, which check nothing.

local index = import "index"

local made = setmetatable({}, { __mode = "k" })

local words = do(T, A)
    if made[A] then return made[A] end
    local count = A.count

    -- `a[i]`: the element's place, its index checked (`index-range` when known)
    local element = do(self: Ref A, at): Ref T
        index.unsigned at
        local i = U64 at
        local outside = i >= count
        index.refuse_known(outside, ("index-range: index %s is outside an array of length %d"):format(index.shown i, count))
        if outside then trap "array index out of range" end
        return array_element_of self i
    end

    -- `a:slice()`: a read-only view of the elements
    local slice = do(self: Ref A): Slice T = array_view self (Slice T)

    -- `a.length` is known
    local member = do(self, name)
        if name == "length" then return count end
        return nil
    end

    made[A] = define
        __index = element
        __member = member
        .slice
    end
    return made[A]
end

-- the members of every array type (syntax §16.1: served once per family)
family FixedArray words

return define
    .words
end
