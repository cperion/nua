-- `T with entries end` is `T { entries }`: keyed data without commas.
local Point = struct with
    x: U32
    y: U32
end

local Shape = oneof with
    circle: U32
    rect: Point
end

-- a `with` with no type before it takes its type from the context
local origin = do(n: U32): Point
    local y = n + 1
    return with
        x = n
        .y
    end
end

local shifted = do(n: U32): U32
    local p = origin n
    local q: Point = with x = 1, y = 2 end
    return p.x + p.y + q.x + q.y
end
export shifted

local sum = do(n: U32): U32
    local p = Point with
        x = n
        y = n * 2
    end
    local q = Point with x = 1, y = 2 end
    local x = 5
    local r = Point with
        .x
        y = q.y
    end
    return p.x + p.y + q.x + r.x + r.y
end
export sum

-- matching is keyed application: the handlers are the entries
local area = do(n: U32): U32
    local s = Shape.rect Point with x = n, y = 3 end
    return s with
        circle = do(r) = r * r
        rect =: p
            local w = p.x
            return w * p.y
        end
    end
end
export area

-- `endall` closes every open Nua block, handlers and data alike
local pair = do(n: U32): U32
    local a = Shape.circle n
    local b = Shape.rect Point with x = 7, y = 3 end
    local total: U32 = 0
    a with
        rect =: r
            total = r.x
        end
    circle =: r
    b with
        circle =: q
            total = r + q
        end
    rect =: p
        total = r + p.x + p.y
    endall
    return total + 1
end
export pair
