-- The front end: Nua as a host of Mua (compiler activities §5.1). Mua parses every source; this
-- host gives meaning to the forms only Nua has: typed lambdas and typed functions (native words),
-- `export` and the `call` boundary. Everything else is Mua's.
--
-- A typed lambda becomes `__nua.word { … }` whose `body` is a hosted body, a Lua closure
-- `function(__E, __path, __arguments)` that performs the word's statements through the
-- evaluation vocabulary `__E`. The path is an argument of every operation: nothing consults a
-- current path. A path is a handle whose state a join replaces, so expressions never reassign
-- it; branch arms and loop bodies are closures that receive their own. A statement that may end
-- its path (a call, a branch, a loop) is followed by a check of `__path.dead`.
--
-- Every `local` of a typed body is a binding cell made by `__E.bind`: a native initializer makes
-- it a place, a host value a host binding. A typed `for` is the native loop of syntax §6.3; an
-- untyped one is ordinary Lua, run while the body is evaluated (syntax §6.1). Annotations are
-- host expressions, evaluated once where the word is made. Generated code stays on its source
-- lines, so LuaJIT's error positions are the source's.

local quote = text -> ("%q"):format(text)

local binary_operators = {
    ["+"] = "add", ["-"] = "subtract", ["*"] = "multiply", ["/"] = "divide", ["%"] = "remainder",
    ["=="] = "equal", ["~="] = "not_equal", ["<"] = "less", ["<="] = "less_equal",
    [">"] = "greater", [">="] = "greater_equal",
    ["&"] = "bit_and", ["|"] = "bit_or", ["~"] = "bit_xor", ["<<"] = "shift_left", [">>"] = "shift_right",
    [".."] = "concatenate",
}

local unary_operators = { ["-"] = "negate", ["not"] = "not", ["~"] = "bit_not" }

-- One code generator per typed lambda (a stateful vocabulary, writing compilers §4.6). Its
-- state belongs to the generation: the output being written (produced), the line it has
-- reached (evolving), the scopes of the names the body declares (inherited by nested blocks),
-- and whether the word makes tail applications (accumulated per word). The node kinds of
-- Mua's syntax tree are a closed set, so each part of the generation is a vocabulary keyed by
-- kind, and a kind it does not know is refused by name.
local generating = do(filename, start_line)
    local out = {}
    local line = start_line or 1
    -- innermost last; each maps a name to its kind (`cell`, a binding cell of the body; `host`,
    -- a Lua local of a generation-time loop) and lists its cells in declaration order
    local scopes = { { kinds = {}, cells = {}, positions = {}, openings = {} } }
    -- declarations and openings in source order: a later one shadows an earlier one
    local sequence = 0
    local opening_count = 0
    local tail_calls = false

    local emit = text -> do out[#out + 1] = text end
    local at = do(target)
        if target and target > line then
            emit(("\n"):rep(target - line))
            line = target
        end
    end
    local fail = do(message, where)
        error(("%s:%s: %s"):format(filename, tostring(where or line), message), 0)
    end
    local declare = do(name, kind)
        local scope = scopes[#scopes]
        scope.kinds[name] = kind
        sequence += 1
        scope.positions[name] = sequence
        if kind == "cell" then table.insert(scope.cells, name) end
    end
    local lookup = do(name)
        for depth = #scopes, 1, -1 do
            local kind = scopes[depth].kinds[name]
            if kind then return kind end
        end
        return nil
    end

    -- the opened contexts that may answer `name`, innermost and latest first, down to the
    -- declaration that shadows them (syntax §10.5), and what the name is declared as
    local openings_of = do(name)
        local variables = {}
        for depth = #scopes, 1, -1 do
            local scope = scopes[depth]
            local position = scope.positions[name]
            for index = #scope.openings, 1, -1 do
                local opening = scope.openings[index]
                if position == nil or opening.position > position then variables[#variables + 1] = opening.variable end
            end
            if scope.kinds[name] then return variables, scope.kinds[name] end
        end
        return variables, nil
    end
    -- the text of a name that may be a place: through the contexts that may answer it, else
    -- what it is lexically
    local name_place = do(name)
        local text = name
        local variables = openings_of name
        for index = #variables, 1, -1 do
            text = ("__E.opened(__path, %s, %q, function() return %s end)"):format(variables[index], name, text)
        end
        return text
    end
    local is_place_name = do(name)
        local variables, kind = openings_of name
        return kind == "cell" or #variables > 0
    end
    -- the anonymous home opened here: the name of its parameter
    local home_name = do()
        for depth = #scopes, 1, -1 do
            if scopes[depth].home then return scopes[depth].home end
        end
        return nil
    end

    -- the boundaries of the generation: a scope of names, and an output of its own
    local inner_scope = do(run)
        scopes[#scopes + 1] = { kinds = {}, cells = {}, positions = {}, openings = {} }
        run()
        local cells = scopes[#scopes].cells
        scopes[#scopes] = nil
        -- the end of the scope: its cells, for the evaluator to release their owners
        emit((" __E.scope_end(__path, { %s });"):format(table.concat(cells, ", ")))
    end
    local block_scope = do(run)
        inner_scope(do()
            emit " __E.scope_begin(__path);"
            run()
        end)
    end
    local captured = do(run)
        local outer = out
        out = {}
        run()
        local text = table.concat out
        out = outer
        return text
    end

    -- a node through the vocabulary of its kind
    local dispatching = do(vocabulary, refusal)
        return do(node)
            at node.line
            local handler = vocabulary[node.k]
            if handler == nil then fail(refusal:format(node.k), node.line) end
            return handler node
        end
    end
    local list = do(nodes, emitter)
        local texts = {}
        for index, node in ipairs nodes do texts[index] = emitter node end
        return table.concat(texts, ", ")
    end
    -- a table constructor, its items through `element`
    local table_text = do(node, element, spread_refusal)
        local items = {}
        for _, item in ipairs node.items do
            if item.kind == "pos" then items[#items + 1] = element item.e
            elseif item.kind == "named" then items[#items + 1] = item.name .. " = " .. element item.e
            elseif item.kind == "keyed" then items[#items + 1] = "[" .. element item.key .. "] = " .. element item.e
            else fail(spread_refusal, node.line) end
        end
        return "{ " .. table.concat(items, ", ") .. " }"
    end
    local literal = node -> node.text
    local keyword = node -> node.k

    --------------------------------------------------------------------------------------------
    -- host expressions: plain Lua, for annotations and the callees of applications

    local host_expression
    local Host = define
        name = node -> node.name
        num = literal
        str = literal
        paren = node -> "(" .. host_expression node.e .. ")"
        field = node -> host_expression node.obj .. "." .. node.name
        index = node -> host_expression node.obj .. "[" .. host_expression node.key .. "]"
        call = node -> host_expression node.fn .. "(" .. list(node.args, host_expression) .. ")"
        method = node -> host_expression node.obj .. ":" .. node.name .. "(" .. list(node.args, host_expression) .. ")"
        binop = node -> "(" .. host_expression node.a .. " " .. node.op .. " " .. host_expression node.b .. ")"
        unop = node -> "(" .. node.op .. " " .. host_expression node.a .. ")"
        table = do(node)
            if node.define then fail("table is not available in an annotation", node.line) end
            return table_text(node, host_expression, "a spread is not available in an annotation")
        end
    end
    Host["nil"], Host["true"], Host["false"] = keyword, keyword, keyword
    host_expression = dispatching(Host, "%s is not available in an annotation")

    --------------------------------------------------------------------------------------------
    -- expressions of a typed body: each performs its operation through the evaluation
    -- vocabulary `__E` on the current path

    local expression, statement, statements, block_body, function_text, target, open_context

    -- a name read in a typed body: a cell of the body, a Lua local of a generation-time loop, or
    -- a host value from around the word
    local name_value = do(name)
        if is_place_name name then return ("__E.get(__path, %s)"):format(name_place name) end
        return name
    end
    -- whether a node names a place of the body: a local, or a field or element of one
    local place_chain
    place_chain = do(node)
        if node.k == "name" then return is_place_name node.name end
        return (node.k == "field" or node.k == "index") and place_chain(node.obj)
    end
    -- `Ref p` of a place: a borrow, never an application of Ref to p's value
    local place_reference = node -> node.k == "call" and node.fn.k == "name" and node.fn.name == "Ref" and #node.args == 1 and place_chain(node.args[1])
    -- the operand of a member or element access: a cell keeps its place, a field of a place
    -- stays a place (its owner is borrowed, never copied out), anything else its value
    local base
    base = do(node)
        if node.k == "name" and is_place_name node.name then return name_place node.name end
        if node.k == "field" and place_chain(node.obj) then return ("__E.member(__path, %s, %q)"):format(base node.obj, node.name) end
        return expression node
    end
    -- the callee of an application: a cell's value, else the host value as Lua names it
    local host_or_value = do(node)
        if node.k == "name" then return name_value node.name end
        return expression node
    end
    local home_text = do(node)
        local home = home_name()
        if home == nil then fail("context-required: `..` reads a home, and none is opened here", node.line) end
        return home
    end
    local callee_of = node -> node.fn.k == "call" and expression node.fn or host_or_value(node.fn)
    -- the arguments of an application, captured one by one in order once the callee is known
    -- (compiler activities §5.1): a local or a field of one is passed as its place, so the
    -- requirement it fills decides whether it is read, moved or lent (syntax §9.2)
    -- (`by_place`: `Ptr` and `copy`, whose element arguments are places too)
    local supplied = do(nodes, by_place)
        local items, spreads = {}, false
        for index, node in ipairs nodes do
            local place = node.k == "name" and is_place_name node.name and name_place node.name
                or node.k == "home" and home_text(node)
                or node.k == "field" and place_chain(node.obj) and (by_place or node.obj.k ~= "index") and target(node)
                or by_place and node.k == "index" and place_chain(node) and target(node)
            if node.k == "spread" then
                spreads = true
                items[index] = "for _, __item in ipairs(__E.pack_items(__path, " .. expression node.e .. ")) do __n = __n + 1; __a[__n] = __capture(__n, __item) end"
            else
                items[index] = place or expression node
            end
        end
        if spreads then
            for index, node in ipairs nodes do
                if node.k ~= "spread" then items[index] = "__n = __n + 1; __a[__n] = __capture(__n, " .. items[index] .. ")" end
            end
            return "function(__capture) local __n, __a = 0, {}; " .. table.concat(items, "; ") .. "; return __a end"
        end
        for index in ipairs nodes do items[index] = "__capture(" .. index .. ", " .. items[index] .. ")" end
        return ("function(__capture) return { %s } end"):format(table.concat(items, ", "))
    end
    local lambda_arm = node -> ("function(__path) return %s end"):format(expression node)
    local boundary_flag = node -> node.boundary and "true" or "false"

    local Expressions = define
        name = node -> name_value node.name
        num = literal
        str = literal
        paren = node -> "(" .. expression node.e .. ")"
        home = node -> ("__E.get(__path, %s)"):format(home_text node)
        binop = do(node)
            if node.op == "and" then return ("__E.both(__path, %s, %s)"):format(expression node.a, lambda_arm node.b) end
            if node.op == "or" then return ("__E.either(__path, %s, %s)"):format(expression node.a, lambda_arm node.b) end
            local operator = binary_operators[node.op]
            if operator == nil then fail(("the operator %s is not available in a typed body"):format(node.op), node.line) end
            return ("__E.operate(__path, %q, %s, %s)"):format(operator, expression node.a, expression node.b)
        end
        unop = do(node)
            if node.op == "#" then return ("__E.length(__path, %s)"):format(base node.a) end
            local operator = unary_operators[node.op]
            if operator == nil then fail(("the operator %s is not available in a typed body"):format(node.op), node.line) end
            return ("__E.operate(__path, %q, %s)"):format(operator, expression node.a)
        end
        cond = node -> ("__E.choose(__path, %s, %s, %s)"):format(expression node.c, lambda_arm node.a, lambda_arm node.b)
        field = node -> ("__E.dot(__path, %s, %q)"):format(base node.obj, node.name)
        index = node -> ("__E.element(__path, %s, %s)"):format(base node.obj, expression node.key)
        call = do(node)
            -- `Ref x` borrows the local itself: its cell, not its value (which would move an owner);
            -- `Ref s.field`, `Ref g[i]` borrow part of a place (syntax §9.4)
            if place_reference node then
                return ("__E.apply(__path, Ref, { %s }, false)"):format(target node.args[1])
            end
            -- `producer(args) { handlers }`: the evaluator decides whether the table consumes the
            -- producer's returns in place or is an ordinary argument (syntax §11.2)
            if node.fn.k == "call" and #node.args == 1 and node.args[1].k == "table" then
                local inner = node.fn
                local producer = inner.fn.k == "name" and is_place_name inner.fn.name and name_place inner.fn.name or callee_of inner
                return ("__E.apply_continued(__path, %s, %s, %s, %s, %s)"):format(producer, supplied(inner.args), boundary_flag inner, expression(node.args[1]), boundary_flag node)
            end
            -- a place applied keeps its cell (a local, or a field or element of one): a sum
            -- matched in place lends its payload to `Ref` handlers (syntax §11.2)
            -- a bare call in an opened region goes to the innermost receiver with that member,
            -- unless a local binding names it (syntax §10.5)
            if node.fn.k == "name" then
                local variables, kind = openings_of node.fn.name
                if #variables > 0 and kind ~= "cell" and kind ~= "host" then
                    return ("__E.apply_opened(__path, { %s }, %q, function() return %s end, %s, %s)"):format(table.concat(variables, ", "), node.fn.name, node.fn.name, supplied(node.args), boundary_flag node)
                end
            end
            local callee = node.fn.k == "name" and is_place_name node.fn.name and name_place node.fn.name
                or node.fn.k ~= "name" and place_chain(node.fn) and target(node.fn)
                or callee_of node
            local by_place = node.fn.k == "name" and (node.fn.name == "Ptr" or node.fn.name == "copy")
            return ("__E.apply(__path, %s, %s, %s)"):format(callee, supplied(node.args, by_place), boundary_flag node)
        end
        method = node -> ("__E.method(__path, %s, %q, %s, %s)"):format(base node.obj, node.name, supplied(node.args), boundary_flag node)
        -- a table of a typed body names each entry once: Lua would keep the last of two, and a
        -- match must handle each alternative exactly once (syntax §11.2)
        table = do(node)
            if node.define then fail("table is not available in a typed body yet", node.line) end
            local named = {}
            for _, item in ipairs node.items do
                if item.kind == "named" then
                    if named[item.name] then fail(("the entry '%s' is given twice"):format(item.name), item.e and item.e.line or node.line) end
                    named[item.name] = true
                end
            end
            local has_spread = false
            for _, item in ipairs node.items do has_spread = has_spread or item.kind == "spread" end
            if not has_spread then return table_text(node, expression, "a spread is not available in a typed body yet") end
            -- a keyed spread (syntax §10.7): entries in source order, resolved by the evaluation
            local entries = {}
            for index, item in ipairs node.items do
                if item.kind == "spread" then entries[index] = ("{ spread = %s }"):format(base item.e)
                elseif item.kind == "named" then entries[index] = ("{ name = %q, value = %s }"):format(item.name, expression item.e)
                elseif item.kind == "pos" then entries[index] = ("{ value = %s }"):format(expression item.e)
                else fail("a keyed entry is not available beside a spread", node.line) end
            end
            return ("__E.spread_table(__path, { %s })"):format(table.concat(entries, ", "))
        end
        -- a typed lambda is a word; an untyped one a word evaluated in place, whose result is
        -- what it returns
        lambda = node -> function_text(node.fn)
    end
    Expressions["nil"], Expressions["true"], Expressions["false"] = keyword, keyword, keyword
    expression = dispatching(Expressions, "%s is not available in a typed body yet")

    -- the place an assignment writes; a nested target (`o.left.value`) is a chain of cells
    -- (declared with the other mutually recursive emitters above)
    target = do(node)
        if node.k == "name" then
            if not is_place_name node.name then
                fail(("cannot assign '%s': a typed body assigns only the locals it declares"):format(node.name), node.line)
            end
            return name_place node.name
        end
        local target_base = inner -> (inner.k == "field" or inner.k == "index") and target(inner) or base(inner)
        if node.k == "field" then return ("__E.member(__path, %s, %q)"):format(target_base node.obj, node.name) end
        if node.k == "index" then return ("__E.member_at(__path, %s, %s)"):format(target_base node.obj, expression node.key) end
        fail("this is not something a typed body can assign", node.line)
    end

    --------------------------------------------------------------------------------------------
    -- statements of a typed body: each is emitted in place; one that may end its path is
    -- followed by a check of `__path.dead`

    local dead_check = " if __path.dead then return __E.stop(__path) end"
    -- the values of a multiple assignment or declaration, each held in its own temporary
    local temporaries_of = do(values)
        local temporaries = {}
        for index in ipairs values do temporaries[index] = "__value" .. index end
        return temporaries
    end
    -- a generation-time loop: its header, its body a scope of the names it declares as host locals
    local generation_loop = do(header, names, body)
        emit header
        block_scope(do()
            for _, name in ipairs names do declare(name, "host") end
            statements body
        end)
        emit(" end;" .. dead_check)
    end

    -- opening a binding (syntax §10.5): a context the names after it may resolve through
    open_context = do(text)
        opening_count += 1
        local variable = "__open" .. opening_count
        emit((" local %s = __E.open_context(__path, %s);"):format(variable, text))
        sequence += 1
        local scope = scopes[#scopes]
        scope.openings[#scope.openings + 1] = { .variable, position = sequence }
    end

    local Statements = define
        open = do(node)
            if node.init and (node.init.k == "index" or node.init.k == "field") and place_chain(node.init.k == "index" and node.init.obj or node.init) then
                -- a slot or a field: opened where it is, its fields live places (syntax §10.6)
                emit((" local %s = __E.bind(__path, %q, nil, __E.open_reference(__path, %s));"):format(node.name, node.name, target node.init))
                declare(node.name, "cell")
            elseif node.init then
                statement { k = "local", names = { { name = node.name, line = node.line } }, exprs = { node.init }, line = node.line }
            end
            open_context(is_place_name node.name and name_place node.name or node.name)
        end
        assign = do(node)
            local values = {}
            for index, value in ipairs node.exprs do values[index] = expression value end
            local temporaries = temporaries_of values
            emit(("do local %s = %s;"):format(table.concat(temporaries, ", "), table.concat(values, ", ")))
            for index, written in ipairs node.targets do
                emit((" __E.set(__path, %s, %s);"):format(target written, temporaries[index] or "nil"))
            end
            emit(" end;" .. dead_check)
        end
        compound = do(node)
            local operator = binary_operators[node.op]
            if operator == nil then fail(("the compound operator %s= is not available in a typed body"):format(node.op), node.line) end
            local written = target node.target
            emit(("do local __place = %s; __E.set(__path, __place, __E.operate(__path, %q, __E.get(__path, __place), %s)) end;"):format(written, operator, expression node.e))
            emit dead_check
        end
        callstat = node -> emit(("do local _ = %s end;"):format(expression node.e) .. dead_check)
        -- a typed `for` is the native counted loop (syntax §6.3); an untyped one runs while the
        -- body is generated, over host numbers
        numfor = do(node)
            if node.type then
                local annotation = host_expression node.type
                local step = node.step and expression node.step or "nil"
                local body = block_body(node.body, node.var)
                emit(("__E.count(__path, %q, %s, %s, %s, %s, %s);"):format(node.var, annotation, expression node.lo, expression node.hi, step, body) .. dead_check)
                return
            end
            local low = ("__E.host_number(__path, %s)"):format(expression node.lo)
            local high = ("__E.host_number(__path, %s)"):format(expression node.hi)
            local step = node.step and (", __E.host_number(__path, %s)"):format(expression node.step) or ""
            generation_loop(("for %s = %s, %s%s do "):format(node.var, low, high, step), { node.var }, node.body)
        end
        genfor = do(node)
            local names = {}
            for index, name in ipairs node.names do names[index] = type name == "table" and name.name or name end
            generation_loop(("for %s in %s do "):format(table.concat(names, ", "), list(node.exprs, host_or_value)), names, node.body)
        end
        continue = node -> emit "do return __E.next_loop(__path) end;"
        localfunction = do(node)
            if not node.fn.result then fail("the statement localfunction is not available in a typed body yet", node.line) end
            declare(node.name, "host")
            emit(("local %s; %s = %s;"):format(node.name, node.name, function_text(node.fn, node.name)))
        end
    end
    Statements["local"] = do(node)
        local values = {}
        for index, value in ipairs(node.exprs or {}) do values[index] = expression value end
        local temporaries = temporaries_of values
        if #values > 0 then emit(("local %s = %s;"):format(table.concat(temporaries, ", "), table.concat(values, ", "))) end
        for index, name in ipairs node.names do
            at name.line
            local annotation = name.type and host_expression name.type or "nil"
            emit((" local %s = __E.bind(__path, %q, %s, %s);"):format(name.name, name.name, annotation, temporaries[index] or "nil"))
            declare(name.name, "cell")
        end
        emit dead_check
    end
    -- `if`: a dynamic branch whose false arm is the rest of the clauses
    Statements["if"] = do(node)
        local clause
        clause = do(position)
            local current = node.clauses[position]
            if current == nil then
                if node.els then return block_body(node.els) end
                return "function(__path) return __E.fall(__path) end"
            end
            local condition = expression current.cond
            local when_true = block_body(current.body)
            local when_false = clause(position + 1)
            return ("function(__path) __E.branch(__path, %s, %s, %s); if __path.dead then return __E.stop(__path) end return __E.fall(__path) end"):format(condition, when_true, when_false)
        end
        local first = node.clauses[1]
        local condition = expression first.cond
        local when_true = block_body(first.body)
        local when_false = clause 2
        emit(("__E.branch(__path, %s, %s, %s);"):format(condition, when_true, when_false) .. dead_check)
    end
    Statements["while"] = node -> emit(("__E.loop(__path, %s, %s);"):format(lambda_arm(node.cond), block_body(node.body)) .. dead_check)
    Statements["return"] = do(node)
        if #node.exprs > 1 then fail("a word returns one value", node.line) end
        if #node.exprs == 0 then
            emit "do return __E.return_value(__path, nil) end;"
            return
        end
        -- `return f args`: a tail application, which may re-enter the word as a loop round
        local returned = node.exprs[1]
        -- (handlers applied to a producer consume its returns: not a re-entry of the word)
        local continued = returned.k == "call" and returned.fn.k == "call" and #returned.args == 1 and returned.args[1].k == "table"
        local opened_call = returned.k == "call" and returned.fn.k == "name" and #openings_of(returned.fn.name) > 0
        if returned.k == "call" and not returned.boundary and not continued and not place_reference returned and not opened_call then
            tail_calls = true
            emit(("do return __E.return_tail(__path, %s, %s) end;"):format(callee_of returned, supplied(returned.args)))
            return
        end
        emit(("do return __E.return_value(__path, %s) end;"):format(expression returned))
    end
    Statements["break"] = node -> emit "do return __E.break_loop(__path) end;"
    Statements["do"] = do(node)
        emit "do"
        block_scope(|| -> statements node.body)
        emit " end;"
    end
    statement = dispatching(Statements, "the statement %s is not available in a typed body yet")
    -- each statement names its line on the path, so a diagnostic or an origin points at it
    statements = do(nodes)
        for _, node in ipairs nodes do
            if node.line then
                at node.line
                emit((" __path.line = %d;"):format(node.line))
            end
            statement node
        end
    end

    -- a block as a closure over its own path; a loop variable is a cell it receives
    block_body = do(nodes, variable)
        local parameters = variable and ("__path, " .. variable) or "__path"
        local text = captured(|| -> block_scope(do()
            if variable then declare(variable, "cell") end
            statements nodes
        end))
        return ("function(%s) %s return __E.fall(__path) end"):format(parameters, text)
    end

    -- a typed lambda or typed function: `__nua.word { … }`. Its body is an output and a scope
    -- of its own; whether it makes tail applications is its own.
    -- `receiver`, for a method (syntax §8): the host expression of its receiver's type; the
    -- word's first requirement is then `self: Ref T`
    function_text = do(fn, name, receiver)
        local requirements = {}
        local parameters = {}
        if receiver then parameters[1] = { name = "self", receiver = receiver } end
        for _, parameter in ipairs fn.params do parameters[#parameters + 1] = parameter end
        for index, parameter in ipairs parameters do
            local annotation = parameter.receiver and ("__nua.receiver(%s)"):format(parameter.receiver)
                or parameter.type and host_expression parameter.type or "nil"
            requirements[index] = ("{ name = %q, type = %s }"):format(parameter.name, annotation)
        end
        local result = fn.result and host_expression fn.result or "nil"
        local outer_tail_calls = tail_calls
        tail_calls = false
        local body = captured(|| -> inner_scope(do()
            local bindings = {}
            for index, parameter in ipairs parameters do
                bindings[#bindings + 1] = ("local %s = __E.argument(__path, %d);"):format(parameter.name, index)
                declare(parameter.name, "cell")
            end
            emit(table.concat(bindings, " "))
            for _, parameter in ipairs parameters do
                if parameter.opened then
                    open_context parameter.name
                    if parameter.unnamed then scopes[#scopes].home = parameter.name end
                end
            end
            -- `..args`: a pack, second-class: a host value of the body (syntax §10.8)
            if fn.rest then
                emit((" local %s = __E.rest_argument(__path);"):format(fn.rest))
                declare(fn.rest, "host")
            end
            if fn.expr then
                statement { k = "return", exprs = { fn.expr }, line = fn.expr.line }
            else
                statements fn.body
            end
        end))
        local has_tail_calls = tail_calls
        tail_calls = outer_tail_calls
        return ("__nua.word { name = %s, source = %q, line = %d, requirements = { %s }, result = %s, tail_calls = %s, rest = %s, body = function(__E, __path) %s return __E.fall(__path) end }"):format(
            quote(name or fn.name or "a word"), filename, fn.line or line, table.concat(requirements, ", "), result, tostring has_tail_calls, fn.rest and "true" or "false", body)
    end

    return define
        .function_text
        .host_expression
    end
end

-- the host: what Mua's parser and emitter consult
local host = do(filename)
    local statements, prefixes, emit_statements = {}, {}, {}
    -- `export name`, `export name as "c_name"`, `export Counter.add as "counter_add"` (a
    -- method, syntax §8; its C name defaults to the dotted path joined by `_`)
    statements.export = do(parser, token)
        local reader = parser.r
        reader:next()
        local parts = { reader:name("after export").v }
        while reader:peek(1).t == "." and reader:peek(2).t == "name" and reader:peek(1).ws == "" do
            reader:next()
            parts[#parts + 1] = reader:next().v
        end
        local name = table.concat(parts, ".")
        local c_name = table.concat(parts, "_")
        local next_token = reader:peek(1)
        if next_token.t == "name" and next_token.v == "as" and not next_token.nl then
            reader:next()
            local text = reader:next()
            if text.t ~= "string" then reader:error("export ... as expects a string naming the C function", text) end
            c_name = assert(loadstring("return " .. text.v))()
        end
        return { k = "export", .name, .c_name, line = token.line }
    end
    emit_statements.export = node -> ("__nua.export(%s, %q, %d)"):format(node.name, node.c_name, node.line)
    -- `call f x` in a typed body: the application crosses a native boundary
    prefixes.call = do(parser, token)
        local next_token = parser.r:peek(2)
        if (parser.typed_depth or 0) == 0 or next_token.t ~= "name" or next_token.nl or next_token.kw then return nil end
        parser.r:next()
        local applied = parser:suffixed()
        if applied.k ~= "call" and applied.k ~= "method" then parser.r:error("call needs an application: call f x", token) end
        applied.boundary = true
        return applied
    end
    local typed = |fn, line, name, receiver| -> generating(filename, line).function_text(fn, name, receiver)
    return define
        id = "nua-next-front-1"
        .statements
        .prefixes
        .emit_statements
        typed_lambda = node -> typed(node.fn, node.line, nil)
        -- `struct { … }` declares a native record; its field types are host expressions
        struct = do(node)
            local generator = generating(filename, node.line)
            local fields = {}
            for index, field in ipairs node.fields do
                fields[index] = ("{ name = %q, type = %s }"):format(field.name, generator.host_expression field.type)
            end
            return ("__nua.record(%q, { %s }, %d)"):format(node.name or "struct", table.concat(fields, ", "), node.line or 0)
        end
        -- `oneof { … }` declares a native sum; its payload types are host expressions
        sum = do(node)
            local generator = generating(filename, node.line)
            local alternatives = {}
            for index, alternative in ipairs node.fields do
                alternatives[index] = ("{ name = %q, payload = %s }"):format(alternative.name, generator.host_expression alternative.type)
            end
            return ("__nua.sum(%q, { %s }, %d)"):format(node.name or "oneof", table.concat(alternatives, ", "), node.line or 0)
        end
        typed_function = do(node)
            if node.k == "localfunction" then
                return ("local %s; %s = %s"):format(node.name, node.name, typed(node.fn, node.line, node.name))
            end
            -- `function T:name(...)`: a method of T (syntax §8); `function T.name(...)`: a
            -- member of T, a hook when its name is one (§16); on a Lua table, a field
            local path = table.concat(node.path, ".")
            if node.method then
                local full = path .. ":" .. node.method
                return ("__nua.member(%s, %q, %s, %d)"):format(path, node.method, typed(node.fn, node.line, full, path), node.line)
            end
            if #node.path > 1 then
                local owner = table.concat(node.path, ".", 1, #node.path - 1)
                return ("__nua.member(%s, %q, %s, %d)"):format(owner, node.path[#node.path], typed(node.fn, node.line, path), node.line)
            end
            return ("%s = %s"):format(path, typed(node.fn, node.line, path))
        end
    end
end

return define
    .host
end
