-- Native interfaces are projections of accepted graph facts. Execution below is dataflow
-- over that same CFG, not a deduplicated list of events or another executable program.
local data = require "nua.compiler.data"
local types = require "nua.types"
local identity = require "nua.identity"
local graph = require "nua.compiler.graph"
local verify = require "nua.compiler.verify"
local facts = require "nua.compiler.facts"
local effects = require "nua.compiler.effects"
local provenance = require "nua.compiler.provenance"
local paths = require "nua.compiler.borrow_paths"

local effect_fields = { "reads", "writes", "moves", "ends", "consumes" }
local access_key = access -> access.place.serial .. ":" .. provenance.key(provenance.components(access.path))
local union_accesses = paths.union
local interface = do(definition, published, info)
    local parts = {}
    for path, component in pairs info.components do
        if data.ComponentInfo.is(component, data.Borrowed) then
            local borrow = assert(published.borrows[component.borrow])
            local origins = {}
            for _, origin in ipairs borrow.origins do
                local place = assert(definition.places[origin.place], "an interface origin has no declared place")
                if data.PlaceRoot.is(place.root, data.ParameterRoot) then
                    origins[#origins + 1] = data.Incoming { parameter = place.root.parameter, path = provenance.concat(provenance.access_path(place.path), origin.path) }
                elseif data.PlaceRoot.is(place.root, data.GlobalRoot) then
                    origins[#origins + 1] = data.GlobalOrigin { global = place.root.global, path = origin.path }
                else error("a native interface returns a borrow of a callee-local place", 0) end
            end
            parts[path] = data.BorrowPart { .origins, mutable = borrow.mutable }
        elseif data.ComponentInfo.is(component, data.Owning) then parts[path] = data.OwnerPart {}
        else parts[path] = data.PlainPart {} end
    end
    return data.InterfaceInfo { type = info.type, .parts }
end
local project = do(definition, published, revision)
    local inputs, returns, site_effects, terminators, normal_exits, requires_disjoint = {}, {}, {}, {}, {}, {}
    local input_borrows = {}
    for index, type in ipairs definition.signature.parameters do
        local info = published.values[data.operand_key(data.Parameter { definition = definition.id, .index, .type })] or provenance.plain(type)
        inputs[index] = interface(definition, published, info)
        for key, part in pairs info.components do if not provenance.is_payload(key) and data.ComponentInfo.is(part, data.Borrowed) then input_borrows[part.borrow] = true end end
    end
    local outward = do(access)
        local place = definition.places[access.place]
        if place == nil then return {} end
        local result = {}
        for _, base in ipairs provenance.accesses(place, definition.places, published.borrows) do
            local root = definition.places[base.place].root
            if data.PlaceRoot.is(root, data.ParameterRoot) or data.PlaceRoot.is(root, data.GlobalRoot) then
                result[#result + 1] = data.Access { place = base.place, path = provenance.concat(base.path, access.path) }
            end
        end
        return result
    end
    local project_effects = do(information)
        local result = { ..information }
        for _, field in ipairs effect_fields do
            local accesses = {}
            for _, access in ipairs information[field] do accesses = union_accesses(accesses, outward(access)) end
            result[field] = accesses
        end
        return data.Effects(result)
    end
    for _, block in ipairs definition.blocks do
        terminators[block.id] = project_effects(effects.ending(block.terminator))
        if data.Terminator.is(block.terminator, data.Return) then
            normal_exits[block.id] = true
            local operand = block.terminator.value
            local info = operand and not data.Operand.is(operand, data.Constant) and published.values[data.operand_key(operand)] or provenance.plain(definition.signature.result)
            returns[block.id] = interface(definition, published, info)
        end
        for _, instruction in ipairs block.instructions do
            local site = assert(published.sites[instruction.site.id])
            local actual = data.Instruction.is(instruction, data.Invoke) and site.effects or effects.of(instruction)
            local projected = project_effects(actual)
            site_effects[instruction.site.id] = projected
            for _, accesses in ipairs { projected.moves, projected.ends } do
                for _, moved in ipairs accesses do
                    for borrow in pairs input_borrows do
                        local info = published.borrows[borrow]
                        local state = site.before.borrows[borrow]
                        if state and data.BorrowState.is(state, data.Live) then
                            for _, origin in ipairs info.origins do
                                for _, stored in ipairs outward(origin) do
                                    requires_disjoint[#requires_disjoint + 1] = data.AliasRequirement { .moved, .stored, at = instruction.site.id }
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return data.BoundaryContract { definition = definition.id, .inputs, .returns, effects = site_effects, .terminators, .requires_disjoint, .normal_exits, .revision }
end

-- A stable dependency fingerprint, independent of allocations in a reconstruction. It is
-- not the contract: event order is retained in its site maps and the actual definition.
local fingerprint = do(bundle)
    local definition, contract, published = bundle.definition, bundle.contract, bundle.facts
    local found = {}
    local access_name = do(access)
        local place = definition.places[access.place]
        if not place then return "local" end
        local root = place.root
        if data.PlaceRoot.is(root, data.ParameterRoot) then return "p" .. root.parameter .. ":" .. provenance.key(provenance.components(provenance.concat(provenance.access_path(place.path), access.path))) end
        if data.PlaceRoot.is(root, data.GlobalRoot) then return "g" .. root.global.serial .. ":" .. provenance.key(provenance.components(access.path)) end
        return "local"
    end
    local block_names, site_names = {}, {}
    for index, block in ipairs definition.blocks do block_names[block.id] = "b" .. index end
    for _, block in ipairs definition.blocks do
        local name = block_names[block.id]
        for index, instruction in ipairs block.instructions do
            local at = name .. ":" .. index .. ":"
            site_names[instruction.site.id] = at
            for _, kind in ipairs { "Compute", "Pack", "Extract", "Load", "Store", "Address", "Check", "Invoke", "Atomic", "Fence", "Mechanism", "Moves", "Ends", "Budget" } do
                if data.Instruction.is(instruction, data[kind]) then found[at .. kind] = true end
            end
            if instruction.opcode then found[at .. instruction.opcode] = true end
            if instruction.binding then found[at .. instruction.binding] = true end
            if data.Instruction.is(instruction, data.Invoke) and data.Callee.is(instruction.callee, data.DirectNua) then found[at .. "call:" .. instruction.callee.definition.serial] = true end
        end
        for index, edge in ipairs(graph.edges_of(block.terminator)) do found[name .. ":edge:" .. index .. ":" .. block_names[edge.target]] = true end
    end
    for id, site in pairs contract.effects do
        local at = site_names[id]
        for _, field in ipairs effect_fields do for _, access in ipairs site[field] do found[at .. field .. access_name(access)] = true end end
        for _, flag in ipairs { "may_trap", "may_wait", "may_switch", "foreign_extent", "nonreturning" } do if site[flag] then found[at .. flag] = true end end
    end
    for block, info in pairs contract.returns do
        found[block_names[block] .. ":normal"] = true
        for path, part in pairs info.parts do
            if data.InterfacePart.is(part, data.BorrowPart) then
                for _, origin in ipairs part.origins do found[block_names[block] .. ":return:" .. provenance.key(path) .. ":" .. (origin.parameter or "global") .. ":" .. provenance.key(provenance.components(origin.path))] = true end
            end
        end
    end
    for site_id, site in pairs published.sites do
        for id, contents in pairs site.after.contents do
            local place = definition.places[id]
            if place and provenance.is_memory(place) and data.Contents.is(contents, data.Resident) then
                local name = access_name(provenance.accesses(place, definition.places, published.borrows)[1])
                if name ~= "local" then
                    for path, part in pairs contents.info.components do
                        if data.ComponentInfo.is(part, data.Borrowed) then
                            local state = site.after.borrows[part.borrow]
                            for _, origin in ipairs published.borrows[part.borrow].origins do found[site_names[site_id] .. "memory:" .. name .. ":" .. provenance.key(path) .. ":" .. access_name(origin) .. ":" .. (state.reason or "live")] = true end
                        end
                    end
                end
            end
        end
    end
    local keys = {}
    for key in pairs found do keys[#keys + 1] = key end
    table.sort(keys)
    return table.concat(keys, "|")
end

-- Actual argument origins are indexed by parameter. A view parameter's Contents is its
-- already captured data, whereas a Ref parameter's Contents descends from its header.
local substitute = do(bundle, access, arguments, registry, flow, memory, writer)
    local place = bundle.definition.places[access.place]
    if place == nil then return {} end
    if not data.PlaceRoot.is(place.root, data.ParameterRoot) then return {} end
    local index = place.root.parameter
    local argument = arguments[index]
    if not argument then return {} end
    local suffix = provenance.concat(provenance.access_path(place.path), access.path)
    local result = {}
    for path, component in pairs argument.components do
        if data.ComponentInfo.is(component, data.Borrowed) then
            local prefix = provenance.access_path(path)
            local matches = #suffix >= #prefix
            for position, step in ipairs prefix do
                local actual = suffix[position]
                if not actual or getmetatable(step) ~= getmetatable(actual) or step.name ~= actual.name then matches = false end
            end
            if matches then
                local from = #prefix + 1
                local native_type = bundle.definition.signature.parameters[index]
                local component_type = native_type
                for _, step in ipairs path do
                    local next_type
                    if types.NativeType.is(component_type, types.RecordType) and data.Component.is(step, data.FieldComponent) then
                        for _, field in ipairs component_type.fields do if field.name == step.name then next_type = field.type end end
                    end
                    component_type = next_type or component_type
                end
                if types.NativeType.is(component_type, types.ViewType) then
                    if suffix[from] and data.AccessStep.is(suffix[from], data.ContentsStep) then from += 1 end
                end
                local rest = {}
                for position = from, #suffix do rest[#rest + 1] = suffix[position] end
                for _, origin in ipairs registry[component.borrow].origins do
                    local resolved = false
                    local current = types.NativeType.is(native_type, types.ReferenceType) and native_type.target or nil
                    local prefix, position = {}, 1
                    while current and position <= #rest and flow and memory do
                        local step = rest[position]
                        if types.NativeType.is(current, types.ReferenceType) or (types.NativeType.is(current, types.ViewType) and data.AccessStep.is(step, data.ContentsStep)) then
                            local info = memory.read(flow, { data.Access { place = origin.place, path = provenance.concat(origin.path, prefix) } }, current, writer)
                            if info then
                                local suffix = {}
                                local first = types.NativeType.is(current, types.ViewType) and position + 1 or position
                                for next_position = first, #rest do suffix[#suffix + 1] = rest[next_position] end
                                for key, part in pairs info.components do
                                    if #key == 0 and data.ComponentInfo.is(part, data.Borrowed) then
                                        for _, source in ipairs registry[part.borrow].origins do result[#result + 1] = data.Access { place = source.place, path = provenance.concat(source.path, suffix) } end
                                        resolved = true
                                    end
                                end
                            end
                            break
                        elseif types.NativeType.is(current, types.BufferType) and data.AccessStep.is(step, data.ContentsStep) and rest[position + 1] then
                            prefix[#prefix + 1], prefix[#prefix + 2] = step, rest[position + 1]
                            position += 2
                            current = current.element
                        elseif types.NativeType.is(current, types.RecordType) and data.AccessStep.is(step, data.FieldStep) then
                            local field_type
                            for _, field in ipairs current.fields do if field.name == step.name then field_type = field.type end end
                            current = field_type
                            prefix[#prefix + 1] = step
                            position += 1
                        else break end
                    end
                    if not resolved then result[#result + 1] = data.Access { place = origin.place, path = provenance.concat(origin.path, rest) } end
                end
            end
        end
    end
    return paths.union({}, result)
end

local run = do(bundle, path, arguments, compilation, fail, resolve)
    local memory = compilation.memory
    local caller_registry = compilation.borrows
    local definition, published, contract = bundle.definition, bundle.facts, bundle.contract
    local tracking = facts.tracking { supply = compilation.supply, borrows = caller_registry }
    local mapped = access -> substitute(bundle, access, arguments, caller_registry, path.flow, memory, path.writer)
    local aggregate_effects = effects.empty()
    local record_effect = do(kind, accesses)
        aggregate_effects[kind] = union_accesses(aggregate_effects[kind], accesses)
    end
    local record_flags = do(information)
        for _, name in ipairs { "may_trap", "may_wait", "may_switch", "foreign_extent" } do
            if information[name] then aggregate_effects[name] = true end
        end
    end
    local local_registry = {}
    for id, info in pairs published.borrows do
        local origins = {}
        for _, origin in ipairs info.origins do origins = union_accesses(origins, mapped(origin)) end
        local form = info.form
        if data.BorrowForm.is(form, data.Selected) then
            local alternatives = {}
            for _, alternative in ipairs form.alternatives do
                local selected_origins = {}
                for _, origin in ipairs alternative.origins do selected_origins = union_accesses(selected_origins, mapped(origin)) end
                alternatives[#alternatives + 1] = data.BorrowAlternative { form = alternative.form, origins = selected_origins }
            end
            form = data.Selected { selector = form.selector, .alternatives }
        end
        local_registry[id] = data.BorrowInfo { ..info, .form, .origins }
    end
    local local_tracking = facts.tracking { supply = compilation.supply, borrows = local_registry }
    local input_borrows = {}
    for index, type in ipairs definition.signature.parameters do
        local info = published.values[data.operand_key(data.Parameter { definition = definition.id, .index, .type })]
        for key, part in pairs(info and info.components or {}) do if not provenance.is_payload(key) and data.ComponentInfo.is(part, data.Borrowed) then input_borrows[part.borrow] = true end end
    end
    local check_alias = do(access, states, kind)
        for id in pairs input_borrows do
            if states[id] and data.BorrowState.is(states[id], data.Live) then
                for _, origin in ipairs local_registry[id].origins do
                    if access.place == origin.place and facts.affects(access.path, origin.path) then fail(path, kind == "moves" and "the call may move storage it also receives a view of" or "the call ends storage it also receives a view of") end
                end
            end
        end
    end
    local resolve_access = do(access)
        local place = definition.places[access.place]
        if place and data.PlaceRoot.is(place.root, data.IndirectRoot) then
            local result = {}
            for _, base in ipairs provenance.accesses(place, definition.places, local_registry) do result[#result + 1] = data.Access { place = base.place, path = provenance.concat(base.path, access.path) } end
            return result
        end
        return mapped(access)
    end
    local related_origins, related_alternatives = {}, {}
    local inherit = do(destination, source, union)
        local original, incoming = local_registry[destination], local_registry[source]
        local origins = union and union_accesses(related_origins[destination] or {}, incoming.origins) or incoming.origins
        local different = not provenance.same_origins(original.origins, origins)
        if union then related_origins[destination] = origins end
        local form = original.form
        if data.BorrowForm.is(form, data.Selected) then
            local alternatives = {}
            local schema = paths.alternatives(published.borrows[source])
            local actual = paths.alternatives(incoming)
            related_alternatives[destination] = related_alternatives[destination] or {}
            local received = related_alternatives[destination]
            for index, alternative in ipairs published.borrows[destination].form.alternatives do
                for position, source_alternative in ipairs schema do
                    if paths.key(alternative) == paths.key(source_alternative) then received[index] = union_accesses(received[index] or {}, actual[position].origins) end
                end
                alternatives[index] = data.BorrowAlternative { form = alternative.form, origins = received[index] or form.alternatives[index].origins }
            end
            form = data.Selected { selector = form.selector, .alternatives }
        end
        local_registry[destination] = data.BorrowInfo { ..original, .form, .origins }
        return different
    end
    local make_info = do(info, flow, local_states)
        local components = {}
        for component_path, component in pairs info.components do
            if data.ComponentInfo.is(component, data.Borrowed) then
                local source = local_registry[component.borrow]
                local state = local_states[component.borrow] or data.Live {}
                local borrow = memory.resident_borrow(flow, { source }, { state })
                components[component_path] = data.Borrowed { .borrow }
            else components[component_path] = component end
        end
        return data.ValueInfo { type = info.type, .components, proofs = {} }
    end
    local before = facts.fork(path.flow)
    local states_at, locals_at, by_id = { [definition.entry] = before }, { [definition.entry] = {} }, {}
    for _, block in ipairs definition.blocks do by_id[block.id] = block end
    local exits, return_rows = {}, {}
    local changed = true
    while changed do
        changed = false
        for _, block in ipairs definition.blocks do
            if states_at[block.id] then
                local flow = facts.fork(states_at[block.id])
                local local_flow = facts.empty()
                for id, state in pairs locals_at[block.id] do local_flow.borrows[id] = state end
                local previous = published.entries[block.id]
                local observed = {}
                if block.id == definition.entry then
                    for id, state in pairs previous.borrows do if local_flow.borrows[id] == nil then local_flow.borrows[id] = state end end
                end
                local acquire = do(snapshot)
                    for id, state in pairs snapshot.borrows do
                        if not observed[id] and (not previous or previous.borrows[id] == nil) then local_flow.borrows[id] = state end
                    end
                    previous = snapshot
                end
                local continuing = true
                for _, instruction in ipairs block.instructions do
                    local site = published.sites[instruction.site.id]
                    acquire(site.before)
                    local use = do(borrow)
                        local state = local_flow.borrows[borrow]
                        if state and data.BorrowState.is(state, data.Ended) then fail(path, ("a borrow is used after it ended (%s) inside the native call"):format(state.reason)) end
                    end
                    local place = instruction.place and definition.places[instruction.place]
                    if place and data.PlaceRoot.is(place.root, data.IndirectRoot) then use(place.root.borrow) end
                    for _, operand in ipairs verify.operands_of(instruction) do
                        local info = not data.Operand.is(operand, data.Constant) and published.values[data.operand_key(operand)]
                        for key, part in pairs(info and info.components or {}) do
                            local used = not provenance.is_payload(key)
                            if data.Instruction.is(instruction, data.Extract) then
                                for position = 1, math.min(#key, #instruction.path) do
                                    local a, b = key[position], instruction.path[position]
                                    if getmetatable(a) ~= getmetatable(b) or a.name ~= b.name then used = false end
                                end
                            end
                            if used and data.ComponentInfo.is(part, data.Borrowed) then use(part.borrow) end
                        end
                    end
                    local site_effects = contract.effects[instruction.site.id]
                    local nested = data.Instruction.is(instruction, data.Invoke) and data.Callee.is(instruction.callee, data.DirectNua) and compilation.bundle_of and compilation.bundle_of(instruction.callee.definition)
                    if nested then
                        local supplied = {}
                        for index, operand in ipairs instruction.arguments do
                            local info = not data.Operand.is(operand, data.Constant) and published.values[data.operand_key(operand)] or provenance.plain(operand.type)
                            supplied[index] = make_info(info, flow, local_flow.borrows)
                        end
                        local at = { ..path, .flow }
                        local entering = { ..local_flow.borrows }
                        local nested_result, nested_effects, normal = resolve(nested, at, supplied, local_registry, local_flow.borrows)
                        flow, continuing = at.flow, normal
                        if normal and instruction.result then
                            local parts = {}
                            for key, part in pairs nested_result.components do parts[provenance.key(key)] = part end
                            local result_info = published.values[instruction.result]
                            for key, part in pairs(result_info and result_info.components or {}) do
                                local source = parts[provenance.key(key)]
                                if source and data.ComponentInfo.is(source, data.Borrowed) and data.ComponentInfo.is(part, data.Borrowed) then
                                    local_flow.borrows[part.borrow] = flow.borrows[source.borrow]
                                    local_registry[part.borrow] = data.BorrowInfo { ..local_registry[part.borrow], origins = caller_registry[source.borrow].origins }
                                    observed[part.borrow] = true
                                end
                            end
                        end
                        record_flags(nested_effects)
                        for _, field in ipairs effect_fields do
                            record_effect(field, nested_effects[field])
                            if field == "moves" or field == "ends" or field == "consumes" then for _, access in ipairs nested_effects[field] do check_alias(access, entering, field) end end
                        end
                    else
                        site_effects = data.Instruction.is(instruction, data.Invoke) and site_effects or effects.of(instruction)
                        record_flags(site_effects)
                        for _, field in ipairs effect_fields do
                            local accesses = {}
                            for _, access in ipairs site_effects[field] do accesses = union_accesses(accesses, resolve_access(access)) end
                            record_effect(field, accesses)
                            for _, access in ipairs accesses do
                                if field == "moves" or field == "ends" or field == "consumes" then check_alias(access, local_flow.borrows, field) end
                                if field == "moves" then tracking.moves(flow, access, instruction.site.origin); local_tracking.moves(local_flow, access, instruction.site.origin)
                                elseif field == "ends" or field == "consumes" then
                                    local reason = instruction.reason or "cleared"
                                    tracking.ends(flow, access, reason, instruction.site.origin)
                                    local_tracking.ends(local_flow, access, reason, instruction.site.origin)
                                    if reason == "cleared" or reason == "released" or reason == "replaced" or reason == "moved" then memory.forget(flow, access) end
                                end
                            end
                        end
                        if data.Instruction.is(instruction, data.Store) and (types.borrows(instruction.value.type) or types.owns(instruction.value.type)) then
                            local targets = union_accesses({}, resolve_access(data.Access { place = instruction.place, path = {} }))
                            if #targets > 0 then
                                local source_info = data.Operand.is(instruction.value, data.Constant) and provenance.plain(instruction.value.type) or assert(published.values[data.operand_key(instruction.value)])
                                local info = make_info(source_info, flow, local_flow.borrows)
                                local at = { ..path, .flow }
                                compilation.check_store(at, targets, info)
                                memory.store(at, targets, info, instruction.site.origin)
                            end
                        end
                    end
                    if data.Instruction.is(instruction, data.Load) and types.borrows(definition.places[instruction.place].type) then
                        local targets = union_accesses({}, resolve_access(data.Access { place = instruction.place, path = {} }))
                        local actual = memory.read(flow, targets, definition.places[instruction.place].type, path.writer)
                        if actual then
                            local parts = {}
                            for key, part in pairs actual.components do parts[provenance.key(key)] = part end
                            for key, part in pairs published.values[instruction.result].components do
                                local source = parts[provenance.key(key)]
                                if source and data.ComponentInfo.is(source, data.Borrowed) and data.ComponentInfo.is(part, data.Borrowed) then
                                    local_flow.borrows[part.borrow] = flow.borrows[source.borrow]
                                    local_registry[part.borrow] = data.BorrowInfo { ..local_registry[part.borrow], origins = caller_registry[source.borrow].origins }
                                    observed[part.borrow] = true
                                end
                            end
                        end
                    end
                    local transfer = do(source, source_prefix, destination_prefix)
                        local destination = instruction.result and published.values[instruction.result]
                        if not source or not destination then return end
                        for target_path, target in pairs destination.components do
                            local matches = #target_path >= #destination_prefix
                            for index, component in ipairs destination_prefix do if not target_path[index] or provenance.key({ component }) ~= provenance.key({ target_path[index] }) then matches = false end end
                            if matches and data.ComponentInfo.is(target, data.Borrowed) then
                                local wanted = { unpack(source_prefix) }
                                for index = #destination_prefix + 1, #target_path do wanted[#wanted + 1] = target_path[index] end
                                for key, part in pairs source.components do
                                    if provenance.key(key) == provenance.key(wanted) and data.ComponentInfo.is(part, data.Borrowed) then
                                        local_flow.borrows[target.borrow] = local_flow.borrows[part.borrow]
                                        inherit(target.borrow, part.borrow, false)
                                        observed[target.borrow] = true
                                    end
                                end
                            end
                        end
                    end
                    local value_info = operand -> not data.Operand.is(operand, data.Constant) and published.values[data.operand_key(operand)] or nil
                    if data.Instruction.is(instruction, data.Extract) then transfer(value_info(instruction.aggregate), instruction.path, {})
                    elseif data.Instruction.is(instruction, data.Compute) and instruction.opcode == "reinterpret" then transfer(value_info(instruction.arguments[1]), {}, {})
                    elseif data.Instruction.is(instruction, data.Pack) and types.NativeType.is(instruction.type, types.RecordType) then
                        for index, field in ipairs instruction.type.fields do transfer(value_info(instruction.components[index]), {}, { data.FieldComponent { name = field.name } }) end
                    end
                    acquire(site.after)
                    if not continuing then break end
                end
                local terminator = block.terminator
                if continuing then record_flags(contract.terminators[block.id]) end
                if continuing and data.Terminator.is(terminator, data.Return) then
                    exits[block.id] = flow
                    if terminator.value and not data.Operand.is(terminator.value, data.Constant) then
                        return_rows[block.id] = { info = make_info(published.values[data.operand_key(terminator.value)], flow, local_flow.borrows), .flow }
                    end
                end
                for _, edge in ipairs(continuing and graph.edges_of(terminator) or {}) do
                    local row = published.edges[edge.id]
                    if row then acquire(row.flow) end
                    local old = states_at[edge.target]
                    local joined = old and tracking.agree({ old, flow }).flow or facts.fork(flow)
                    if old then memory.agree({ old, flow }, joined) end
                    local different = old == nil or not memory.same(old, joined)
                    if old then
                        for id, state in pairs joined.borrows do
                            if old.borrows[id] and getmetatable(old.borrows[id]) ~= getmetatable(state) then different = true end
                        end
                    end
                    local carried = { ..local_flow.borrows }
                    for index, operand in ipairs edge.arguments do
                        local source = not data.Operand.is(operand, data.Constant) and published.values[data.operand_key(operand)]
                        local target = published.values[data.operand_key(data.BlockArgument { block = edge.target, .index, type = by_id[edge.target].arguments[index].type })]
                        for key, part in pairs(target and target.components or {}) do
                            if data.ComponentInfo.is(part, data.Borrowed) then
                                for source_key, incoming in pairs(source and source.components or {}) do
                                    if provenance.key(key) == provenance.key(source_key) and data.ComponentInfo.is(incoming, data.Borrowed) then
                                        carried[part.borrow] = local_flow.borrows[incoming.borrow]
                                        if inherit(part.borrow, incoming.borrow, true) then different = true end
                                    end
                                end
                            end
                        end
                    end
                    local destination = published.entries[edge.target]
                    local relate
                    relate = do(source, target)
                        if data.NativeValue.is(source, data.Reference) and data.NativeValue.is(target, data.Reference) then
                            carried[target.borrow] = local_flow.borrows[source.borrow]
                            if inherit(target.borrow, source.borrow, true) then different = true end
                        elseif data.NativeValue.is(source, data.Aggregate) and data.NativeValue.is(target, data.Aggregate) then
                            for name, part in pairs target.parts do if source.parts[name] then relate(source.parts[name], part) end end
                        end
                    end
                    if row and destination then
                        for id, target in pairs destination.contents do
                            local source = row.flow.contents[id]
                            if source and data.Contents.is(source, data.Tracked) and data.Contents.is(target, data.Tracked) then relate(source.value, target.value) end
                        end
                    end
                    local old_local = locals_at[edge.target] or {}
                    for id, state in pairs carried do
                        local previous_state = old_local[id]
                        if previous_state == nil or (data.BorrowState.is(state, data.Ended) and data.BorrowState.is(previous_state, data.Live)) then old_local[id] = state; different = true end
                    end
                    states_at[edge.target], locals_at[edge.target] = joined, old_local
                    if different then changed = true end
                end
            end
        end
    end
    local flows, rows = {}, {}
    for _, flow in pairs exits do flows[#flows + 1] = flow end
    for _, row in pairs return_rows do rows[#rows + 1] = row end
    if #flows > 0 then
        path.flow = tracking.agree(flows).flow
        memory.agree(flows, path.flow)
    end
    local returned = #rows > 0 and memory.merge_info(rows, path.flow) or provenance.plain(definition.signature.result)
    aggregate_effects.nonreturning = #flows == 0
    return returned, aggregate_effects, #flows > 0
end
-- Agreement of call contexts is a private dataflow worklist over the real definitions.
-- Recursive edges use the current least result, then revisit their dependents; there is no
-- recursive unrolling limit and no snapshot/flat-effect substitute for a closed call.
local apply = do(bundle, path, arguments, compilation, fail)
    local contexts, order, changed = {}, {}, false
    local probes = {}
    local registry, memory = compilation.borrows, compilation.memory
    local tracking = facts.tracking { borrows = registry, supply = compilation.supply }
    local original = {}
    for id in pairs path.flow.borrows do original[id] = true end
    local key_of = do(target, supplied)
        local keys = { tostring(target.definition.id.serial) }
        for index, info in ipairs supplied do
            for key, part in pairs info.components do
                if data.ComponentInfo.is(part, data.Borrowed) then
                    for _, origin in ipairs registry[part.borrow].origins do keys[#keys + 1] = index .. ":" .. provenance.key(key) .. ":" .. access_key(origin) end
                end
            end
        end
        table.sort(keys)
        return table.concat(keys, "|")
    end
    local same_flow = do(a, b)
        if not memory.same(a, b) then return false end
        for id, state in pairs a.borrows do
            local other = b.borrows[id]
            if other and (getmetatable(state) ~= getmetatable(other) or state.reason ~= other.reason) then return false end
        end
        return true
    end
    local effect_key = do(info)
        local parts = {}
        for _, field in ipairs effect_fields do for _, access in ipairs info[field] do parts[#parts + 1] = field .. access_key(access) end end
        for _, field in ipairs { "may_trap", "may_wait", "may_switch", "foreign_extent", "nonreturning" } do if info[field] then parts[#parts + 1] = field end end
        table.sort(parts)
        return table.concat(parts, "|")
    end
    local probe_for = do(info)
        local parts = { data.BorrowForm.is(info.form, data.Stored) and "stored" or "held" }
        for _, origin in ipairs info.origins do parts[#parts + 1] = access_key(origin) end
        if data.BorrowForm.is(info.form, data.Selected) then
            for _, alternative in ipairs info.form.alternatives do
                for _, origin in ipairs alternative.origins do parts[#parts + 1] = (data.BorrowForm.is(alternative.form, data.Stored) and "stored:" or "held:") .. access_key(origin) end
            end
        end
        table.sort(parts)
        local key = table.concat(parts, "|")
        local id = probes[key]
        if id == nil then
            id = compilation.supply.fresh(identity.BorrowId)
            probes[key], registry[id], changed = id, data.BorrowInfo { ..info, .id }, true
        end
        return id
    end
    local request = do(target, incoming, supplied)
        local key = key_of(target, supplied)
        local context = contexts[key]
        if context == nil then
            context = { bundle = target, input = facts.fork(incoming.flow), arguments = {}, result = provenance.plain(target.definition.signature.result), effects = effects.empty(), normal = false }
            for index, info in ipairs supplied do
                local components = {}
                for component_path, part in pairs info.components do
                    if data.ComponentInfo.is(part, data.Borrowed) then
                        local source = registry[part.borrow]
                        local borrow = memory.resident_borrow(context.input, { source }, { incoming.flow.borrows[part.borrow] })
                        components[component_path] = data.Borrowed { .borrow }
                    else components[component_path] = part end
                end
                context.arguments[index] = data.ValueInfo { type = info.type, .components, proofs = {} }
            end
            contexts[key], order[#order + 1], changed = context, context, true
        else
            local next_flow = facts.fork(incoming.flow)
            for index, info in ipairs supplied do
                local parts = {}
                for component_path, part in pairs info.components do parts[provenance.key(component_path)] = part end
                for component_path, destination in pairs context.arguments[index].components do
                    local source = parts[provenance.key(component_path)]
                    if source and data.ComponentInfo.is(source, data.Borrowed) and data.ComponentInfo.is(destination, data.Borrowed) then next_flow.borrows[destination.borrow] = incoming.flow.borrows[source.borrow] end
                end
            end
            local joined = tracking.agree({ context.input, next_flow }).flow
            memory.agree({ context.input, next_flow }, joined)
            if not same_flow(context.input, joined) then context.input = joined; changed = true end
        end
        return context
    end
    local root = request(bundle, path, arguments)
    local resolve = do(target, at, supplied, local_registry, local_states)
        local requested = {}
        for id in pairs local_states do requested[id] = probe_for(local_registry[id]) end
        local context = request(target, at, supplied)
        if context.normal then
            for id, probe in pairs requested do
                local state = context.output.borrows[probe]
                if state and data.BorrowState.is(state, data.Ended) then local_states[id] = state end
            end
            local after = facts.fork(context.output)
            for id, state in pairs at.flow.borrows do
                if after.borrows[id] == nil or data.BorrowState.is(state, data.Ended) then after.borrows[id] = state end
            end
            at.flow = after
        end
        return context.result, context.effects, context.normal
    end
    while changed do
        changed = false
        for _, context in ipairs order do
            local at = { ..path, flow = facts.fork(context.input) }
            -- Probes describe transfer of an arbitrary pre-existing borrow. Acquisitions
            -- inside a recursive frame never reset a caller frame's borrow.
            for _, id in pairs probes do at.flow.borrows[id] = data.Live {} end
            local result, observed, normal = run(context.bundle, at, context.arguments, compilation, fail, resolve)
            local different = normal ~= context.normal or effect_key(observed) ~= effect_key(context.effects)
            if normal and context.normal then
                if not same_flow(context.output, at.flow) or not provenance.same_info(context.result, context.output, result, at.flow, registry) then different = true end
            end
            context.output, context.result, context.effects, context.normal = at.flow, result, observed, normal
            if different then changed = true end
        end
    end
    if root.normal then
        path.flow = root.output
        -- Only actual caller borrows, resident components and the returned value leave the
        -- analysis activity. Probe identities and private formal states do not get published.
        for _, contents in pairs path.flow.contents do
            if data.Contents.is(contents, data.Resident) then for _, id in ipairs provenance.borrowed(contents.info) do original[id] = true end end
        end
        for _, id in ipairs provenance.borrowed(root.result) do original[id] = true end
        for id in pairs path.flow.borrows do if not original[id] then path.flow.borrows[id] = nil end end
    end
    return root.result, root.effects, root.normal
end
return { .project, .fingerprint, .substitute, .apply, .interface }
