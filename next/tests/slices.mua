-- Slices (syntax §12.2): the words of every view type are library Nua (lib/slice.nua) over the
-- compiler's view primitives. Indexes and ranges are checked at run time, or refused while
-- compiling when known to be outside; a read-only view is not a place to assign.

local ffi = require "ffi"
local native = require "tests.support.native"
local compile = require "nua.compile"

local refuses = do(source, expected)
    local done, problem = pcall(compile.compile, source, "refused.nua")
    assert(not done, "expected the compiler to refuse")
    assert(tostring(problem):find(expected, 1, true), tostring problem)
end

test "a view's elements, length and sub-views, held or stored":
    local library = native("slices_words", [[
local total = do(values: Slice U32): U64
    local sum: U64 = 0
    local i: U64 = 0
    while i < values.length do
        sum = sum + U64(values[i])
        i = i + 1
    end
    return sum
end
-- a held view of a Grow, sub-views of it, and a view crossing a native boundary (stored)
local sums = do(n: U32): U64
    local xs = Grow(U32) {}
    for i: U32 = 1, n do
        xs:push i
    end
    local all = xs:all()
    local middle = all:sub(1, all.length - 1)
    local inner = middle:sub(1, 2)
    return total(all) * 1000000 + (call total middle) * 1000 + U64(inner[0]) + inner.length
end
export sums
-- a held view survives growth: it reads the new storage
local grown = do(): U32
    local xs = Grow(U32) { 1, 2 }
    local head = xs:sub(0, 2)
    for i: U32 = 1, 100 do
        xs:push i
    end
    return head[0] * 10 + head[1] + U32(head.length) * 100
end
export grown
-- an index of any unsigned type
local narrow = do(i: U8): U32
    local xs = Grow(U32) { 5, 6, 7 }
    local all = xs:all()
    return all[i]
end
export narrow
]])
    -- 1..10: all 55; middle [1, 9) is 2..9 = 44; inner [1, 2) of it is the one element 3
    assert(library.sums(10) == 55 * 1000000 + 44 * 1000 + 3 + 1)
    assert(library.grown() == 12 + 200)
    assert(library.narrow(2) == 7)
end

test "a known index or range outside its view is refused while compiling; the rest checked when run":
    refuses([[
local f = do(): U32
    local xs = Grow(U32) { 1, 2, 3 }
    local all = xs:all()
    local head = all:sub(0, 2)
    return head[2]
end
export f
]], "index-range: index 2 is outside a slice of length 2")
    refuses([[
local f = do(): U64
    local xs = Grow(U32) { 1, 2, 3 }
    local all = xs:all()
    return (all:sub(2, 1)).length
end
export f
]], "index-range: the range 2..1 is reversed")
    refuses([[
local f = do(i: I32): U32
    local xs = Grow(U32) { 1 }
    local all = xs:all()
    return all[i]
end
export f
]], "an index is an unsigned integer, not I32")
    local _, text = native("slices_checked", [[
local at = do(values: Slice U32, i: U64): U32 = values[i]
export at
]])
    assert(text:find("slice index out of range", 1, true), text)
end

test "a read-only view is not a place to assign":
    refuses([[
local f = do(values: Slice U32): Unit
    values[0] = 1
end
export f
]], "not-a-place: a view is read-only")
end

test "a check a branch already proved is dropped; what is not proved keeps its check (§12.2)":
    local library, text = native("slices_proofs", [[
-- the loop condition proves i < length inside the body: no check there
local proof_total = do(values: Slice U32): U64
    local sum: U64 = 0
    local i: U64 = 0
    while i < values.length do
        sum = sum + U64(values[i])
        i = i + 1
    end
    return sum
end
export proof_total
-- an arm that returns: what follows is reached through the other one, whose facts hold
local proof_third = do(values: Slice U32): U32
    if values.length < 3 then return 0 end
    return values[2]
end
export proof_third
-- i changes after the test: the fact is about the old i, so the check stays
local proof_moved = do(values: Slice U32, i: U64): U32
    if i < values.length then
        i = i + 1
        return values[i]
    end
    return 0
end
export proof_moved
-- proved on one arm only: after the join it is not proved
local proof_joined = do(values: Slice U32, i: U64, flag: Bool): U32
    local ok: Bool = false
    if flag then
        if i < values.length then ok = true end
    end
    return values[i]
end
export proof_joined
]])
    local function_text = name -> text:match("\n[%w_]+ " .. name .. "%([^)]*%) {.-\n}")
    assert(not function_text("proof_total"):find("slice index out of range", 1, true), function_text "proof_total")
    assert(not function_text("proof_third"):find("slice index out of range", 1, true), function_text "proof_third")
    assert(function_text("proof_moved"):find("slice index out of range", 1, true), function_text "proof_moved")
    assert(function_text("proof_joined"):find("slice index out of range", 1, true), function_text "proof_joined")
    local values = ffi.new("uint32_t[3]", { 4, 5, 6 })
    local view = ffi.new(text:match("typedef struct (View_%d+) {"))
    view.data, view.length = values, 3
    assert(library.proof_total(view) == 15 and library.proof_third(view) == 6 and library.proof_moved(view, 1) == 6)
end

test "an owner where a view is expected lends its elements; a Slice.mut only when marked (§9.2)":
    local library = native("slices_lending", [[
local sum_of = do(values: Slice U32): U64
    local sum: U64 = 0
    local i: U64 = 0
    while i < values.length do
        sum = sum + U64(values[i])
        i = i + 1
    end
    return sum
end
local scale = do(values: Slice.mut U32, by: U32): Unit
    local i: U64 = 0
    while i < values.length do
        values[i] = values[i] * by
        i = i + 1
    end
end
local spaces = do(text: Str): U64
    local count: U64 = 0
    local i: U64 = 0
    while i < text.length do
        if text[i] == 32 then count = count + 1 end
        i = i + 1
    end
    return count
end
local Bag = struct { xs: Grow U32 }
local keep = do(xs: Grow U32): U64 = xs.length
local lent = do(n: U32): U64
    local xs = Grow(U32) {}
    for i: U32 = 1, n do
        xs:push i
    end
    local before = sum_of xs
    scale(Ref xs, 2)
    local after = sum_of xs
    local b = Bag { xs = Grow(U32) { 5, 6 } }
    local field = sum_of b.xs
    local text = Grow(U8) { 97, 32, 98, 32 }
    -- lent, not moved: each is still the caller's, then moved into keep
    return before * 1000000 + after * 1000 + field + spaces(text) * 100 + keep xs * 0
end
export lent
]])
    -- 1..4: 10, doubled 20; the field 11; two spaces
    assert(library.lent(4) == 10 * 1000000 + 20 * 1000 + 11 + 200)
    refuses([[
local scale = do(values: Slice.mut U32): Unit
    values[0] = 1
end
local f = do(): Unit
    local xs = Grow(U32) { 1 }
    scale xs
end
export f
]], "a Slice.mut U32 takes the elements of an owner marked at the call: f(Ref xs)")
end
