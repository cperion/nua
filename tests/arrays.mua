-- Fixed-length arrays (syntax §13): values whose elements are tracked while known; a run-time
-- index materializes them. Their words are Nua (lib/array.nua).

local ffi = require "ffi"
local native = require "tests.support.native"
local compile = require "nua.compile"

local refuses = do(source, expected)
    local done, problem = pcall(compile.compile, source, "refused.nua")
    assert(not done, "expected the compiler to refuse")
    assert(tostring(problem):find(expected, 1, true), tostring problem)
end

test "known contents fold; the array does not reach C (§13)":
    local library, text = native("arrays_fixed", [[
local array_fixed = do(): U32
    local a = Array(U32, 4) { 10, 20, 30, 40 }
    local b: Array(U32, 4)
    b[0] = a[3]
    b[1] = a[0] + a[1]
    return b[0] + b[1] + a.length
end
export array_fixed
]])
    assert(library.array_fixed() == 74)
    local body = text:match("uint32_t array_fixed%(void%) {.-\n}")
    assert(body:find("return 74u", 1, true), body)
end

test "a run-time index materializes the array; bounds are checked":
    local library, text = native("arrays_dynamic", [[
local Pair = struct { xs: Array(U32, 3), n: U32 }
local array_read = do(i: U64, k: U32): U32
    local a = Array(U32, 3) { k, k + 1, k + 2 }
    return a[i]
end
export array_read
local array_write = do(i: U64, k: U32): U32
    local a: Array(U32, 3)
    a[i] = k
    return a[0] * 10000 + a[1] * 100 + a[2]
end
export array_write
local array_copy = do(k: U32): U32
    local a = Array(U32, 2) { k, 1 }
    local b = a
    b[0] = 9
    return a[0] * 100 + b[0]
end
export array_copy
local array_field = do(i: U64): U32
    local p = Pair { xs = Array(U32, 3) { 1, 2, 3 }, n = 7 }
    p.xs[i] = 50
    return p.xs[0] + p.xs[1] + p.xs[2] + p.n
end
export array_field
local array_sum = do(values: Slice U32): U64
    local sum: U64 = 0
    local i: U64 = 0
    while i < values.length do
        sum = sum + U64(values[i])
        i = i + 1
    end
    return sum
end
local array_lent = do(k: U32): U64
    local a = Array(U32, 3) { k, 2, 3 }
    return array_sum a + array_sum(a:slice())
end
export array_lent
local array_passed = do(a: Array(U32, 2)): U32 = a[0] + a[1]
local array_through = do(k: U32): U32 = call array_passed (Array(U32, 2) { k, 3 })
export array_through
local array_zeroed = do(): U32
    local a = Array(U32, 1000)()
    return a[999]
end
export array_zeroed
]])
    assert(library.array_read(2, 5) == 7)
    assert(library.array_write(1, 3) == 300)
    assert(library.array_copy(4) == 409)
    assert(library.array_field(1) == 1 + 50 + 3 + 7)
    assert(library.array_lent(1) == 12)
    assert(library.array_through(4) == 7)
    assert(library.array_zeroed() == 0)
    assert(text:find("uint32_t e%[3%];"), text)
    assert(text:find("array index out of range", 1, true), text)
end

test "a known index outside an array is refused; every element is listed":
    refuses([[
local f = do(): U32
    local a = Array(U32, 4) { 1, 2, 3, 4 }
    return a[4]
end
export f
]], "index-range: index 4 is outside an array of length 4")
    refuses([[
local f = do(): U32
    local a = Array(U32, 2) { 1 }
    return a[0]
end
export f
]], "lists every element")
end
