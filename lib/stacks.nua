-- Data-stack policy. A stack never moves: it is address space reserved once,
-- committed by the system as it is touched. Reserving is the one foreign
-- mechanism; placement, growth, limits and lifetime bookkeeping are Nua.
local h = '"nua_rt.h"'
local Stack = cstruct("nua_stack", h, {
        { "data", Ptr U8 }, { "top", U64 }, { "cap", U64 }, { "region", U64 }, { "dead", U64 },
    })
local Set = cstruct("nua_stackset", h, { { "stacks", Ptr Stack }, { "n", U64 } })
-- the stack set in use on this thread: a task's while a worker runs it, otherwise
-- the thread's own. Read in place: both are thread-local objects the runtime defines.
local own = global(Set,
    { name = "nua_own_stacks", imported = true, thread_local = true, header = h })
local selected = global(Ptr Set,
    { name = "nua_cur_stacks", imported = true, thread_local = true, header = h })
local current = do(): Ptr Set
    local set = selected[0]
    if set ~= null Set then return set end
    return own
end
local resize_stacks = extern("realloc", { Ptr Stack, U64 }, Ptr Stack, { header = "<stdlib.h>" })
local free_stacks = extern("free", { Ptr Stack }, Unit, { header = "<stdlib.h>" })
local stack_bytes = extern("nua_stack_bytes", { Bool }, U64, { header = h })
local reserve_bytes = extern("nua_reserve", { U64 }, Ptr U8, { header = h })
local unreserve = extern("nua_unreserve", { Ptr U8, U64 }, Unit, { header = h })
local zero = extern("memset", { Ptr U8, I32, U64 }, Ptr U8, { header = "<string.h>" })
local move = extern("memmove", { Ptr U8, Ptr U8, U64 }, Ptr U8, { header = "<string.h>" })
local trap = extern("nua_trap", { CString }, Unit, { header = h })
local maximum = U64 0xffffffffffffffffULL
local stacks = { .Stack, .Set }
-- the stacks of a thread's own set below this index hold owner globals (design memory.md
-- §5.10): trap recovery leaves them
local owner_floor = global(U64, { name = "nua_owner_global_stacks" })
-- Growing the set of stacks is the cold path. The new stacks' address space is
-- one reservation, so a set costs a few kernel mappings however many tasks run;
-- a task's stacks reserve less than a thread's own.
-- Keep its policy visible to specialization with the surrounding access.
local add_stacks = do(context: Ptr Set, index: U64): Unit
    local n = context.n
    if n == 0 then n = 4 end
    while n <= index do n = n * 2 end
    local data = resize_stacks context.stacks (n * size_of Stack)
    if data == null Stack then trap "out of memory for data stacks" end
    -- the set adopts the moved headers now, so a failed reservation below
    -- leaves it consistent at its old size
    context.stacks = data
    local first = context.n
    local added = n - first
    zero(bytes data[first], 0, added * size_of Stack)
    local each = stack_bytes(context ~= own)
    if each > maximum / added then trap "data stack reservation too large" end
    local region = reserve_bytes(each * added)
    if region == null U8 then trap "no address space left to reserve data stacks" end
    local i = U64 0
    while i < added do
        local s = Ptr data[first + i]
        s.data = Ptr region[i * each]
        s.cap = each
        i = i + 1
    end
    data[first].region = each * added
    context.n = n
end
-- Claiming makes a stack exist; only allocation (begin, push) extends the set.
-- Access never allocates: an owner's stack was claimed when the owner began,
-- so a missing one is a broken invariant.
stacks.claim = do(index: U64): Ptr Stack
    local context = current()
    if index >= context.n then add_stacks context index end
    return Ptr context.stacks[index]
end
stacks.at = do(index: U64): Ptr Stack
    local context = current()
    if index >= context.n then trap "data stack was never claimed" end
    return Ptr context.stacks[index]
end
-- The one comparison growth pays: a stack's top never passes its reservation.
local reserve = do(s: Ptr Stack, need: U64): Unit
    if need > s.cap then
        trap "data stack full: raise NUA_THREAD_STACK_BYTES or NUA_TASK_STACK_BYTES"
    end
end
-- An unclaimed stack is empty: function prologues and epilogues record and
-- restore the tops of every index they may use, claimed or not.
stacks.top = do(index: U64): U64
    local context = current()
    if index >= context.n then return 0 end
    return context.stacks[index].top
end
stacks.begin = do(index: U64): U64
    local s = stacks.claim index
    local top = band (s.top + 15) bnot(U64 15)
    reserve s top
    s.top = top
    return top
end
-- An owner with arenas begins at one offset on each of its n consecutive stacks (design
-- memory.md §5.9), so releasing it resets every one of them to its base. The stacks below
-- that offset are untouched address space: raising a top commits nothing.
stacks.level = do(index: U64, n: U64): U64
    local top = U64 0
    local i = U64 0
    while i < n do
        local s = stacks.claim(index + i)
        local at = band (s.top + 15) bnot(U64 15)
        if at > top then top = at end
        i = i + 1
    end
    i = 0
    while i < n do
        local s = stacks.at(index + i)
        reserve s top
        s.top = top
        i = i + 1
    end
    return top
end
-- An arena (design memory.md §5.9) counts the bytes its owners abandoned. Its root begins
-- it with a record of the count it found, so a recursion's levels on the same stack each
-- count their own, and ending the root gives the count back.
local arena_record = U64 16
stacks.arena_record = arena_record
stacks.open_arena = do(index: U64, base: U64): Unit
    local s = stacks.at index
    if s.top ~= base then trap "an arena begins at its root's base" end
    stacks.push index arena_record
    local saved = Ptr U64 stacks.region(index, base, U64 8)
    saved[0] = s.dead
    s.dead = 0
end
stacks.close_arena = do(index: U64, base: U64): Unit
    local s = stacks.at index
    local saved = Ptr U64 stacks.region(index, base, U64 8)
    s.dead = saved[0]
    stacks.reset index base
end
-- the arena's contents end at once (its root was cleared): only the record stays
stacks.empty_arena = do(index: U64, base: U64): Unit
    local s = stacks.at index
    stacks.reset index (base + arena_record)
    s.dead = 0
end
stacks.abandon = do(index: U64, n: U64): Unit
    local s = stacks.at index
    s.dead = s.dead + n
end
-- the stack set this thread owns, whatever it is running
stacks.own_set = do(): Ptr Set return own end
stacks.keep_owner_globals = do(n: U64): Unit
    if n > owner_floor[0] then owner_floor[0] = n end
end
-- Pushing allocates, so it may claim. It never moves the bytes below the top.
stacks.push = do(index: U64, n: U64): U64
    local s = stacks.claim index
    local at = s.top
    if n > maximum - at then trap "data stack too large" end
    reserve s (at + n)
    s.top = at + n
    return at
end
stacks.reset = do(index: U64, top: U64): Unit
    local context = current()
    if index >= context.n then
        if top ~= 0 then trap "data stack reset above its top" end
        return
    end
    local s = Ptr context.stacks[index]
    if top > s.top then trap "data stack reset above its top" end
    s.top = top
end
-- The bytes [at, at + n) of one stack, checked once. The pointer stays valid
-- until the stack's top is reset below it.
local region = do(s: Ptr Stack, at: U64, n: U64): Ptr U8
    if at > s.top or n > s.top - at then trap "data stack view out of range" end
    if n == 0 then return null U8 end
    return Ptr s.data[at]
end
stacks.region = do(index: U64, at: U64, n: U64): Ptr U8
    return region (stacks.at index) at n
end
-- Regions of a stack already resolved once.
stacks.span = region
-- An owner occupying [base, base + used) at the top of its stack takes n more
-- bytes; returns where they begin. The check and the push resolve it once;
-- the owner claimed the stack when it began.
stacks.extend = do(index: U64, base: U64, used: U64, n: U64, what: CString): U64
    local s = stacks.at index
    local at = s.top
    if at - base ~= used then trap what end
    if n > maximum - at then trap "data stack too large" end
    reserve s (at + n)
    s.top = at + n
    return at
end
stacks.fill = do(at: Ptr U8, n: U64): Unit
    if n ~= 0 then zero at 0 n end
end
stacks.move = do(dst: Ptr U8, src: Ptr U8, n: U64): Unit
    if n ~= 0 then move dst src n end
end
stacks.bytes = stacks.region
stacks.copy = do(index: U64, dst: U64, src: U64, n: U64): Unit
    if n == 0 then return end
    local s = stacks.at index
    move (region s dst n) (region s src n) n
end
stacks.write = do(index: U64, dst: U64, src: Ptr U8, n: U64): Unit
    if n ~= 0 then move (stacks.region index dst n) src n end
end
stacks.zero = do(index: U64, at: U64, n: U64): Unit
    if n ~= 0 then zero (stacks.region index at n) 0 n end
end
stacks.free = do(set: Ptr Set): Unit
    local i = U64 0
    while i < set.n do
        local s = Ptr set.stacks[i]
        if s.region ~= 0 then unreserve s.data s.region end
        i = i + 1
    end
    free_stacks set.stacks
    set.stacks = null Stack
    set.n = 0
end
stacks.clear = do(set: Ptr Set): Unit
    local i = U64 0
    if set == own then i = owner_floor[0] end
    while i < set.n do
        set.stacks[i].top = 0
        set.stacks[i].dead = 0
        i = i + 1
    end
end
return stacks
