-- The native rules of `Compute` (compiler activities §3.2): for each numeric opcode, which
-- operand types it takes and what it yields, and how a known computation folds. Evaluation,
-- verification and both backends share these rules; adding an opcode means adding its rules
-- here, not a string `Compute` happens to accept.
--
-- The semantics are syntax §7.1: integers narrower than 64 bits wrap to their width after
-- every operation; unsigned arithmetic wraps; F32 rounds through a C float after every
-- operation; division and remainder truncate toward zero. Undefined behaviour in C (signed
-- overflow, a zero divisor, MIN / -1, a shift by the width or more, an out-of-range
-- float-to-integer conversion) is never folded: folding answers `invalid` with the reason.
-- A residual operation is the C operation itself.

local ffi = require "ffi"
local bit = require "bit"
local types = require "nua.types"
local data = require "nua.compiler.data"

local NativeType = types.NativeType
local is_kind = |type, kind| -> NativeType.is(type, kind)
local is_integer = type -> is_kind(type, types.IntegerType)
local is_float = type -> is_kind(type, types.FloatType)
local is_boolean = type -> is_kind(type, types.BooleanType)
local is_pointer = type -> is_kind(type, types.PointerType)
local is_numeric = type -> is_integer type or is_float type

------------------------------------------------------------------------------------------------
-- Integer bits. A constant holds 64 canonical bits; its type says how to read them.

local mask_of = width -> width == 64 and 0xffffffffffffffffULL or (bit.lshift(1ULL, width) - 1ULL)

-- the value as a signed or unsigned 64-bit integer
local signed_value = do(bits, width)
    if width == 64 then return ffi.cast("int64_t", bits) end
    local shift = 64 - width
    return bit.arshift(ffi.cast("int64_t", bit.lshift(bits, shift)), shift)
end
local unsigned_value = |bits, width| -> bit.band(ffi.cast("uint64_t", bits), mask_of width)

-- the canonical bits of a 64-bit integer, wrapped to the width
local canonical = |value, width| -> bit.band(ffi.cast("uint64_t", value), mask_of width)

local signed_limits = do(width)
    local maximum = ffi.cast("int64_t", bit.rshift(mask_of width, 1))
    return -maximum - 1LL, maximum
end

local FoldingDecision = oneof { folded: data.NativeConstant, not_foldable: Unit, invalid: String }
local integer_constant = |value, width| -> FoldingDecision.folded(data.IntegerBits { bits = canonical(value, width) })
local boolean_constant = value -> FoldingDecision.folded(data.BooleanBit { .value })
local invalid = reason -> FoldingDecision.invalid reason

-- F32 arithmetic rounds through a C float after every operation
local round = |value, type| -> type.bits == 32 and tonumber(ffi.cast("float", value)) or value
local float_constant = |value, type| -> FoldingDecision.folded(data.FloatBits { value = round(value, type) })

-- signed results that leave the type's range are undefined behaviour
local signed_result = do(value, width, opcode)
    local low, high = signed_limits width
    if value < low or value > high then return invalid(opcode .. " overflows " .. ("I%d"):format(width) .. " (undefined behaviour in C)") end
    return integer_constant(value, width)
end

-- 64-bit signed products and sums cannot be computed wider; their overflow is detected
local signed_64 = do(opcode, a, b)
    local low, high = signed_limits 64
    local overflow = invalid(opcode .. " overflows I64 (undefined behaviour in C)")
    if opcode == "add" then
        if (b > 0LL and a > high - b) or (b < 0LL and a < low - b) then return overflow end
        return integer_constant(a + b, 64)
    end
    if opcode == "subtract" then
        if (b < 0LL and a > high + b) or (b > 0LL and a < low + b) then return overflow end
        return integer_constant(a - b, 64)
    end
    if a == 0LL or b == 0LL then return integer_constant(0LL, 64) end
    if (a == -1LL and b == low) or (b == -1LL and a == low) then return overflow end
    local product = a * b
    if product / b ~= a then return overflow end
    return integer_constant(product, 64)
end

-- the operands of an integer fold, read as the type reads them
local integer_operands = do(type, arguments)
    local width, signed = type.bits, type.signed
    local read = bits -> signed and signed_value(bits, width) or unsigned_value(bits, width)
    local right = arguments[2]
    return define
        .type
        .width
        .signed
        a = read(arguments[1].bits.bits)
        .right
        b = right and read(right.bits.bits)
    end
end

-- add, subtract and multiply of integers: unsigned wraps; signed overflow is undefined
local arithmetic = do(opcode, combine)
    return do(operands)
        local a, b, width = operands.a, operands.b, operands.width
        if not operands.signed then return integer_constant(combine(ffi.cast("uint64_t", a), ffi.cast("uint64_t", b)), width) end
        if width == 64 then return signed_64(opcode, a, b) end
        return signed_result(combine(a, b), width, opcode)
    end
end
-- division and remainder truncate toward zero; a zero divisor and MIN / -1 are undefined
local division = do(opcode, combine)
    return do(operands)
        local a, b, width = operands.a, operands.b, operands.width
        if b == 0 then return invalid(opcode == "divide" and "division by zero (undefined behaviour in C)" or "remainder by zero (undefined behaviour in C)") end
        if operands.signed and b == -1LL and a == signed_limits width then
            return invalid(("%s of the minimum I%d by -1 (undefined behaviour in C)"):format(opcode, width))
        end
        return integer_constant(combine(a, b), width)
    end
end
-- a shift by a count outside the width is undefined; so is a signed left shift of a negative
-- value or one whose result does not fit
local shift = do(opcode, shifted)
    return do(operands)
        local type, width, a, right = operands.type, operands.width, operands.a, operands.right
        local count = right.type.signed and signed_value(right.bits.bits, right.type.bits) or unsigned_value(right.bits.bits, right.type.bits)
        if count < 0 or count >= width then
            return invalid(("a shift by %s is undefined for %s"):format((tostring(count):gsub("U?LL$", "")), types.describe type))
        end
        local amount = tonumber count
        if opcode == "shift_left" and operands.signed then
            local _, high = signed_limits width
            if a < 0LL or a > bit.arshift(high, amount) then
                return invalid("shift_left overflows " .. types.describe type .. " (undefined behaviour in C)")
            end
        end
        return integer_constant(shifted(a, width, amount), width)
    end
end
local bitwise = combine -> |operands| -> integer_constant(combine(operands.a, operands.b), operands.width)
local integer_comparison = compare -> |operands| -> boolean_constant(compare(operands.a, operands.b))
local negate_integer = do(operands)
    local a, width = operands.a, operands.width
    if not operands.signed then return integer_constant(-ffi.cast("uint64_t", a), width) end
    if width == 64 then
        if a == signed_limits 64 then return invalid "negation overflows I64 (undefined behaviour in C)" end
        return integer_constant(-a, 64)
    end
    return signed_result(-a, width, "negation")
end

-- folds of floats and Booleans, from their values
local float_arithmetic = combine -> |type, a, b| -> float_constant(combine(a, b), type)
local value_comparison = compare -> |type, a, b| -> boolean_constant(compare(a, b))
local boolean_logic = combine -> |a, b| -> boolean_constant(combine(a, b))

-- conversions follow C: integers wrap to the target width, floats truncate toward zero and
-- must fit, integers become the nearest float
local fold_convert = do(result, argument)
    local source = argument.type
    if is_integer source then
        local value = source.signed and signed_value(argument.bits.bits, source.bits) or unsigned_value(argument.bits.bits, source.bits)
        if is_integer result then return integer_constant(value, result.bits) end
        return float_constant(tonumber value, result)
    end
    local value = argument.bits.value
    if is_float result then return float_constant(value, result) end
    if value ~= value then return invalid("converting NaN to " .. types.describe result .. " (undefined behaviour in C)") end
    local truncated = value >= 0 and math.floor value or math.ceil value
    local low, high
    if result.signed then
        low, high = signed_limits(result.bits)
        low, high = tonumber low, tonumber high
    else
        low, high = 0, tonumber(mask_of(result.bits))
    end
    if truncated < low or truncated > high or (result.bits == 64 and truncated >= 2 ^ 63 and result.signed) then
        return invalid(("%s does not fit %s (undefined behaviour in C)"):format(tostring value, types.describe result))
    end
    if result.signed then return integer_constant(ffi.cast("int64_t", truncated), result.bits) end
    return integer_constant(ffi.cast("uint64_t", truncated), result.bits)
end

-- A NaN's bits are not determined by the value a FloatBits holds (and LuaJIT may read an
-- arbitrary NaN pattern as another kind of value), so a reinterpretation from or to a NaN is
-- not folded: the C operation keeps its exact bits.
local nan_bits = do(bits, width)
    local exponent_mask = width == 32 and 0x7f800000ULL or 0x7ff0000000000000ULL
    local mantissa_mask = width == 32 and 0x007fffffULL or 0x000fffffffffffffULL
    local pattern = bit.band(ffi.cast("uint64_t", bits), width == 32 and 0xffffffffULL or 0xffffffffffffffffULL)
    return bit.band(pattern, exponent_mask) == exponent_mask and bit.band(pattern, mantissa_mask) ~= 0ULL
end
local fold_reinterpret = do(result, argument)
    local source = argument.type
    -- an address into static data is the same address as another pointer or reference
    if data.NativeConstant.is(argument.bits, data.StaticAddress) then return FoldingDecision.folded(argument.bits) end
    if is_float source and argument.bits.value ~= argument.bits.value then return FoldingDecision.not_foldable() end
    if is_integer source and is_float result and nan_bits(argument.bits.bits, result.bits) then return FoldingDecision.not_foldable() end
    if is_float source and is_integer result then
        local bits
        if source.bits == 32 then
            bits = ffi.cast("uint32_t*", ffi.new("float[1]", argument.bits.value))[0]
        else
            bits = ffi.cast("uint64_t*", ffi.new("double[1]", argument.bits.value))[0]
        end
        return integer_constant(ffi.cast("uint64_t", bits), result.bits)
    end
    if is_integer source and is_float result then
        local cell = ffi.new("uint64_t[1]", argument.bits.bits)
        local value
        if result.bits == 32 then value = ffi.cast("float*", cell)[0] else value = ffi.cast("double*", cell)[0] end
        return FoldingDecision.folded(data.FloatBits { value = tonumber value })
    end
    if is_integer source and is_integer result then return integer_constant(argument.bits.bits, result.bits) end
    return FoldingDecision.not_foldable()
end

-- undefined behaviour the known operands alone prove, whatever the unknown ones hold: a known
-- zero integer divisor, a known shift count outside the width
local proven_undefined = do(opcode, arguments)
    local first, right = arguments[1], arguments[2]
    if right == nil or not data.Operand.is(right, data.Constant) or not is_integer(right.type) then return nil end
    local value = right.type.signed and signed_value(right.bits.bits, right.type.bits) or unsigned_value(right.bits.bits, right.type.bits)
    if (opcode == "divide" or opcode == "remainder") and is_integer(first.type) and value == 0 then
        return opcode == "divide" and "division by zero (undefined behaviour in C)" or "remainder by zero (undefined behaviour in C)"
    end
    if (opcode == "shift_left" or opcode == "shift_right_signed" or opcode == "shift_right_unsigned") and (value < 0 or value >= first.type.bits) then
        return ("a shift by %s is undefined for %s"):format((tostring(value):gsub("U?LL$", "")), types.describe(first.type))
    end
    return nil
end

------------------------------------------------------------------------------------------------
-- The opcodes. Each names its operand count, its type rule (nil when the operands suit it and
-- its result type, else the reason), and how it folds known operands: `integer` from the
-- operands as their type reads them, `float` and `boolean` from their values, or `whole` from
-- the result type and the operand, for the conversions. An opcode without a fold for a type
-- is not folded there.

local described = types.describe
local both_same = do(arguments, what)
    if arguments[1] == arguments[2] then return nil end
    return what .. " needs two operands of one type"
end
local yields_operand = do(opcode, what)
    return do(result, arguments)
        return both_same(arguments, opcode) or (result ~= arguments[1] and what or nil)
    end
end
local is_integer_or_boolean = type -> is_integer type or is_boolean type
-- a type rule: the first operand must be of a kind `admits`, then `then_check` decides
local operand_rule = do(admits, refusal, then_check)
    return do(result, arguments)
        if not admits(arguments[1]) then return refusal .. " is not defined for " .. described(arguments[1]) end
        return then_check(result, arguments)
    end
end
local arithmetic_entry = do(opcode, combine)
    return define
        operands = 2
        check = operand_rule(is_numeric, opcode, yields_operand(opcode, opcode .. " yields its operands' type"))
        integer = arithmetic(opcode, combine)
        float = float_arithmetic combine
    end
end
local bitwise_entry = do(opcode, combine, logic)
    return define
        operands = 2
        check = operand_rule(is_integer_or_boolean, opcode, yields_operand(opcode, opcode .. " yields its operands' type"))
        integer = bitwise combine
        boolean = boolean_logic logic
    end
end
local shift_check = do(result, arguments)
    if not is_integer(arguments[1]) then return "a shift is not defined for " .. described(arguments[1]) end
    if not is_integer(arguments[2]) then return "a shift count must be an integer, got " .. described(arguments[2]) end
    return result ~= arguments[1] and "a shift yields its left operand's type" or nil
end
local shift_entry = |opcode, shifted| -> { operands = 2, check = shift_check, integer = shift(opcode, shifted) }
local yields_bool = |opcode| -> |result, arguments| -> both_same(arguments, opcode) or (result ~= types.Bool and "a comparison yields Bool" or nil)
local equality_entry = do(opcode, compare)
    return define
        operands = 2
        check = operand_rule(type -> is_numeric type or is_boolean type or is_pointer type or NativeType.is(type, types.FunctionType), "equality", yields_bool opcode)
        integer = integer_comparison compare
        float = value_comparison compare
        boolean = boolean_logic compare
    end
end
local ordering_entry = do(opcode, compare)
    return define
        operands = 2
        check = operand_rule(type -> is_numeric type or is_pointer type, "ordering", yields_bool opcode)
        integer = integer_comparison compare
        float = value_comparison compare
    end
end

local Opcodes = define
    add = arithmetic_entry("add", |x, y| -> x + y)
    subtract = arithmetic_entry("subtract", |x, y| -> x - y)
    multiply = arithmetic_entry("multiply", |x, y| -> x * y)
    divide = define
        operands = 2
        check = operand_rule(is_numeric, "divide", yields_operand("divide", "divide yields its operands' type"))
        integer = division("divide", |x, y| -> x / y)
        float = float_arithmetic(|x, y| -> x / y)
    end
    remainder = define
        operands = 2
        check = operand_rule(is_integer, "remainder", yields_operand("remainder", "remainder yields its operands' type"))
        integer = division("remainder", |x, y| -> x % y)
    end
    negate = define
        operands = 1
        check = operand_rule(is_numeric, "negation", |result, arguments| -> result ~= arguments[1] and "negation yields its operand's type" or nil)
        integer = negate_integer
        float = |type, a, b| -> float_constant(-a, type)
    end
    bit_not = define
        operands = 1
        check = operand_rule(is_integer_or_boolean, "bit_not", |result, arguments| -> result ~= arguments[1] and "bit_not yields its operand's type" or nil)
        integer = operands -> integer_constant(bit.bnot operands.a, operands.width)
        boolean = |a, b| -> boolean_constant(not a)
    end
    bit_and = bitwise_entry("bit_and", bit.band, |x, y| -> x and y)
    bit_or = bitwise_entry("bit_or", bit.bor, |x, y| -> x or y)
    bit_xor = bitwise_entry("bit_xor", bit.bxor, |x, y| -> x ~= y)
    shift_left = shift_entry("shift_left", |a, width, amount| -> bit.lshift(ffi.cast("uint64_t", a), amount))
    shift_right_signed = shift_entry("shift_right_signed", |a, width, amount| -> bit.arshift(signed_value(canonical(a, width), width), amount))
    shift_right_unsigned = shift_entry("shift_right_unsigned", |a, width, amount| -> bit.rshift(unsigned_value(canonical(a, width), width), amount))
    equal = equality_entry("equal", |x, y| -> x == y)
    not_equal = equality_entry("not_equal", |x, y| -> x ~= y)
    less = ordering_entry("less", |x, y| -> x < y)
    less_equal = ordering_entry("less_equal", |x, y| -> x <= y)
    convert = define
        operands = 1
        check = do(result, arguments)
            if not is_numeric(arguments[1]) or not is_numeric result then return ("cannot convert %s to %s"):format(described(arguments[1]), described result) end
            return nil
        end
        whole = fold_convert
    end
    reinterpret = define
        operands = 1
        check = do(result, arguments)
            local first, target = arguments[1], { pointer_bits = 64 }
            local scalar = type -> is_numeric type or is_boolean type or is_pointer type or NativeType.is(type, types.ReferenceType) or NativeType.is(type, types.AtomicType)
            if not scalar first or not scalar result or types.layout(first, target).size ~= types.layout(result, target).size then
                return ("cannot reinterpret %s as %s"):format(described first, described result)
            end
            return nil
        end
        whole = fold_reinterpret
    end
    pointer_offset = define
        operands = 2
        check = do(result, arguments)
            if not is_pointer(arguments[1]) or not is_integer(arguments[2]) then return "pointer_offset takes a pointer and an integer" end
            return result ~= arguments[1] and "pointer_offset yields its pointer's type" or nil
        end
        -- an address into static data moves within it, by elements of its pointer's target
        all = do(result, arguments)
            local base, count = arguments[1], arguments[2]
            if not data.NativeConstant.is(base.bits, data.StaticAddress) then return FoldingDecision.not_foldable() end
            local size = types.layout(result.target, { pointer_bits = 64 }).size
            local elements = count.type.signed and tonumber(ffi.cast("int64_t", count.bits.bits)) or tonumber(count.bits.bits)
            local offset = base.bits.offset + elements * size
            if offset < 0 or offset > #base.bits.bytes then return invalid "an address past the static data it points into" end
            return FoldingDecision.folded(data.StaticAddress { bytes = base.bits.bytes, .offset })
        end
    end
    pointer_difference = define
        operands = 2
        check = do(result, arguments)
            if not is_pointer(arguments[1]) then return "pointer_difference takes two pointers" end
            return both_same(arguments, "pointer_difference") or (result ~= types.I64 and "pointer_difference yields I64" or nil)
        end
    end
end

-- Types: nil when the operands suit the opcode and its result type, else the reason.
local check_types = do(opcode, result, arguments)
    local entry = Opcodes[opcode]
    local count = entry and entry.operands or 2
    if #arguments ~= count then return ("%s takes %d operand%s, got %d"):format(opcode, count, count == 1 and "" or "s", #arguments) end
    if entry == nil then return "unknown opcode " .. tostring opcode end
    return entry.check(result, arguments)
end

-- fold a computation whose operands are all constants; types must already be checked. A
-- computation with unknown operands is refused when its known ones prove undefined behaviour.
local fold = do(opcode, result, arguments)
    for _, argument in ipairs arguments do
        if data.Operand.is(argument, data.Constant) and data.NativeConstant.is(argument.bits, data.ForeignValue) then return FoldingDecision.not_foldable() end
    end
    local undefined = proven_undefined(opcode, arguments)
    if undefined then return invalid undefined end
    for _, argument in ipairs arguments do
        if not data.Operand.is(argument, data.Constant) then return FoldingDecision.not_foldable() end
    end
    local entry = Opcodes[opcode]
    if entry and entry.whole then return entry.whole(result, arguments[1]) end
    if entry and entry.all then return entry.all(result, arguments) end
    local first = arguments[1].type
    if entry == nil or is_pointer first then return FoldingDecision.not_foldable() end
    local value_of = argument -> argument and argument.bits.value
    if is_integer first and entry.integer then return entry.integer(integer_operands(first, arguments)) end
    if is_float first and entry.float then return entry.float(first, value_of(arguments[1]), value_of(arguments[2])) end
    if is_boolean first and entry.boolean then return entry.boolean(value_of(arguments[1]), value_of(arguments[2])) end
    return FoldingDecision.not_foldable()
end

-- the value of an integer constant, as its type reads it
local integer_value = constant -> constant.type.signed and signed_value(constant.bits.bits, constant.type.bits)
    or unsigned_value(constant.bits.bits, constant.type.bits)

-- the operand a computation is equal to whatever its unknown operand holds, or nil: a zero
-- offset, a conversion to its own type, an integer's neutral element. Never a float's: x + 0
-- is not x for a negative zero.
local is_constant_integer = do(operand, value)
    return data.Operand.is(operand, data.Constant) and is_integer(operand.type)
        and data.NativeConstant.is(operand.bits, data.IntegerBits) and integer_value(operand) == value
end
local neutral_right = define
    add = 0
    subtract = 0
    multiply = 1
    bit_or = 0
    bit_xor = 0
    shift_left = 0
    shift_right_signed = 0
    shift_right_unsigned = 0
    divide = 1
end
local neutral_left = define
    add = 0
    multiply = 1
    bit_or = 0
    bit_xor = 0
end
local identity_of = do(opcode, result, arguments)
    local first, second = arguments[1], arguments[2]
    if opcode == "convert" or opcode == "reinterpret" then return first.type == result and first or nil end
    if opcode == "pointer_offset" then return is_constant_integer(second, 0) and first or nil end
    if not is_integer(result) or first.type ~= result then return nil end
    if neutral_right[opcode] and is_constant_integer(second, neutral_right[opcode]) then return first end
    if neutral_left[opcode] and second.type == result and is_constant_integer(first, neutral_left[opcode]) then return second end
    return nil
end

-- a computation has no effect of its own: its validity is its types and, for a known one,
-- its fold
local pure = || -> data.Effects {
    reads = {}, writes = {}, moves = {}, ends = {}, consumes = {},
    may_trap = false, may_wait = false, may_switch = false, foreign_extent = false, nonreturning = false, synchronizes = false,
}

-- integer constants made from Lua numbers or 64-bit cdata, wrapped to the type's width
local integer = |type, value| -> data.Constant { .type, bits = data.IntegerBits { bits = canonical(value, type.bits) } }
local float = |type, value| -> data.Constant { .type, bits = data.FloatBits { value = round(value, type) } }
local boolean = value -> data.Constant { type = types.Bool, bits = data.BooleanBit { .value } }

return define
    .FoldingDecision
    .check_types
    .fold
    .identity_of
    .pure
    .integer
    .float
    .boolean
    .integer_value
    .is_integer
    .is_float
    .is_boolean
    .is_pointer
    .is_numeric
end
