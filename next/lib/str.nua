-- The text words (syntax §14.1): what `Str`'s methods do, written in Nua. Over text known while
-- compiling they run while compiling; over text known in part (a literal needle, a dynamic
-- haystack) what is known unrolls. `Str` is a view of bytes, so its elements, length and
-- sub-views are the words of the Slice family (lib/slice.nua); these are its own members.

local str = {}

str.Found = oneof { at: U64, missing: Unit }
str.Order = oneof { less: Unit, same: Unit, greater: Unit }

-- a Lua string where a `Str` is expected: static text, known while compiling (§16.1)
function Str.__cast(value)
    if type value == "string" then return static_text value end
    return nil
end

-- equal bytes; the loop runs over b, so a known b unrolls
str.equals = do(a: Str, b: Str): Bool
    if a.length ~= b.length then
        return false
    end
    local i: U64 = 0
    while i < b.length do
        if a[i] ~= b[i] then
            return false
        end
        i = i + 1
    end
    return true
end

-- the same, with b known while compiling: b is a Lua string here (a compile-time parameter), so
-- the loop over it is Lua's and unrolls into one comparison per byte
str.equals_known = do(a: Str, b): Bool
    if a.length ~= #b then
        return false
    end
    local same: Bool = true
    for k = 1, #b do
        same = same and a[k - 1] == b:byte k
    end
    return same
end

str.starts_with = do(s: Str, prefix: Str): Bool
    if prefix.length > s.length then
        return false
    end
    local i: U64 = 0
    while i < prefix.length do
        if s[i] ~= prefix[i] then
            return false
        end
        i = i + 1
    end
    return true
end

str.starts_with_known = do(s: Str, prefix): Bool
    if s.length < #prefix then
        return false
    end
    local same: Bool = true
    for k = 1, #prefix do
        same = same and s[k - 1] == prefix:byte k
    end
    return same
end

str.ends_with = do(s: Str, suffix: Str): Bool
    if suffix.length > s.length then
        return false
    end
    local at: U64 = s.length - suffix.length
    local i: U64 = 0
    while i < suffix.length do
        if s[at + i] ~= suffix[i] then
            return false
        end
        i = i + 1
    end
    return true
end

str.ends_with_known = do(s: Str, suffix): Bool
    if s.length < #suffix then
        return false
    end
    local same: Bool = true
    for k = 1, #suffix do
        same = same and s[s.length - (#suffix - k + 1)] == suffix:byte k
    end
    return same
end

-- the first position of t in s
str.find = do(s: Str, t: Str): str.Found
    if t.length > s.length then
        return str.Found.missing()
    end
    local last: U64 = s.length - t.length
    local i: U64 = 0
    while i <= last do
        local j: U64 = 0
        while j < t.length and s[i + j] == t[j] do
            j = j + 1
        end
        if j == t.length then
            return str.Found.at i
        end
        i = i + 1
    end
    return str.Found.missing()
end

-- the same with a needle known while compiling: each position is tested by an unrolled
-- comparison
str.find_known = do(s: Str, t): str.Found
    if #t > s.length then
        return str.Found.missing()
    end
    local last: U64 = s.length - #t
    local i: U64 = 0
    while i <= last do
        local hit: Bool = true
        for k = 1, #t do
            hit = hit and s[i + (k - 1)] == t:byte k
        end
        if hit then
            return str.Found.at i
        end
        i = i + 1
    end
    return str.Found.missing()
end

-- byte order, then length
str.compare = do(a: Str, b: Str): str.Order
    local i: U64 = 0
    while i < a.length and i < b.length do
        if a[i] < b[i] then
            return str.Order.less()
        end
        if a[i] > b[i] then
            return str.Order.greater()
        end
        i = i + 1
    end
    if a.length < b.length then
        return str.Order.less()
    end
    if a.length > b.length then
        return str.Order.greater()
    end
    return str.Order.same()
end

local space = do(c: U8): Bool = c == 32 or c == 9 or c == 10 or c == 13

str.trim = do(s: Str): Str
    local a: U64 = 0
    local b: U64 = s.length
    while a < b and space s[a] do
        a = a + 1
    end
    while b > a and space s[b - 1] do
        b = b - 1
    end
    return s:sub(a, b)
end

-- the parts between separator bytes, each given to body
str.split = do(s: Str, separator: U8, body): Unit
    local start: U64 = 0
    local i: U64 = 0
    while i < s.length do
        if s[i] == separator then
            body s:sub(start, i)
            start = i + 1
        end
        i = i + 1
    end
    body s:sub(start, s.length)
end

-- the lines: the parts between newlines, without a last empty one
str.lines = do(s: Str, body): Unit
    local start: U64 = 0
    local i: U64 = 0
    while i < s.length do
        if s[i] == 10 then
            body s:sub(start, i)
            start = i + 1
        end
        i = i + 1
    end
    if start < s.length then
        body s:sub(start, s.length)
    end
end

-- numbers: s:parse(T) gives oneof { value: T, bad: Unit }; overflow is bad
local parsed = {}
str.parsed = do(T)
    if not parsed[T] then parsed[T] = oneof { value: T, bad: Unit } end
    return parsed[T]
end

local parse_words = {}
for _, T in ipairs { U8, U16, U32, U64 } do
    local P = str.parsed T
    parse_words[T] = do(s: Str): P
        if s.length == 0 then
            return P.bad()
        end
        local max: T = ~(T 0)
        local v: T = 0
        local i: U64 = 0
        while i < s.length do
            local c: U8 = s[i]
            if c < 48 or c > 57 then
                return P.bad()
            end
            local d = T(c - 48)
            if v > (max - d) / 10 then
                return P.bad()
            end
            v = v * 10 + d
            i = i + 1
        end
        return P.value v
    end
end

for _, pair in ipairs { { I8, U8 }, { I16, U16 }, { I32, U32 }, { I64, U64 } } do
    local T, U = pair[1], pair[2]
    local P = str.parsed T
    parse_words[T] = do(s: Str): P
        local i: U64 = 0
        local negative: Bool = false
        if s.length > 0 and (s[0] == 45 or s[0] == 43) then
            negative = s[0] == 45
            i = 1
        end
        if i == s.length then
            return P.bad()
        end
        -- the magnitude, up to 2^(bits-1) - 1, or 2^(bits-1) when negative
        local limit: U = ~(U 0) >> 1
        if negative then
            limit = limit + 1
        end
        local m: U = 0
        while i < s.length do
            local c: U8 = s[i]
            if c < 48 or c > 57 then
                return P.bad()
            end
            local d = U(c - 48)
            if m > (limit - d) / 10 then
                return P.bad()
            end
            m = m * 10 + d
            i = i + 1
        end
        if negative then
            return P.value T(U 0 - m)
        end
        return P.value(T m)
    end
end

-- the methods: a Lua string argument (a needle known while compiling) picks the word that
-- takes it as a compile-time parameter
local known = value -> type value == "string"

function Str:equals(other)
    if known other then return str.equals_known(self, other) end
    return str.equals(self, other)
end

function Str:starts_with(prefix)
    if known prefix then return str.starts_with_known(self, prefix) end
    return str.starts_with(self, prefix)
end

function Str:ends_with(suffix)
    if known suffix then return str.ends_with_known(self, suffix) end
    return str.ends_with(self, suffix)
end

function Str:find(needle)
    if known needle then return str.find_known(self, needle) end
    return str.find(self, needle)
end

function Str:compare(other)
    return str.compare(self, other)
end

function Str:trim()
    return str.trim self
end

-- `s:split(",") do(part) … end`: the separator is one byte; the body is supplied after
function Str:split(separator)
    local byte = separator
    if known separator then
        if #separator ~= 1 then error("split separates at one byte, not " .. ("%q"):format(separator), 0) end
        byte = separator:byte()
    end
    return str.split(self, byte)
end

function Str:lines()
    return str.lines self
end

function Str:parse(T)
    local word = parse_words[T]
    if word == nil then error("parse gives an integer type, not " .. tostring T, 0) end
    return word self
end

return str
