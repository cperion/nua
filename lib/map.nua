-- Collection algorithms over storage projections. The compiler supplies only
-- representation access and the activity that lends one entry's snapshots.
local map = {}
local zero = __S.zero_value
local iterators = {}

function map.each(T, storage, body)
    local by_storage = iterators[T]
    if not by_storage then by_storage = {}; iterators[T] = by_storage end
    local by_body = by_storage[storage]
    if not by_body then by_body = {}; by_storage[storage] = by_body end
    if by_body[body] then return by_body[body] end
    -- Distinct activities are distinct specializations: a nested traversal is
    -- not recursion with a changing compile-time callback parameter.
    -- The iteration guard rejects structural mutation, so the capacity holds;
    -- the body is opaque, so the table is acquired again for every entry.
    local each = do(m: Ref T): Unit
        local capacity = storage.header(m).cap
        local slot = U32 0
        while slot < capacity do
            local table = storage.acquire m
            local entry = table.entries[slot]
            if entry.hash ~= 0 then storage.lend(table, entry, body) end
            slot = slot + 1
        end
    end
    by_body[body] = each
    return each
end

local hash = require "nua.hash"
local keys = require "nua.key"
local stacks = require "nua.stacks"
local trap = extern("nua_trap", { CString }, Unit)
local slice_parts = __S.slice_parts
local none = U32 0xffffffff
local libraries = {}

-- Every operation acquires the table once and probes, reads and writes inside
-- that acquisition. Only growth (a push onto the table's stack) and arena
-- compaction move storage; the table is acquired again after them.
function map.library(T, storage, Entry, Result, string_keys)
    if libraries[T] then return libraries[T] end
    local K, V = T.key, T.elem
    local EP, View = Ptr Entry, storage.View
    local equal = keys.equal K
    local digest = string_keys and hash.text or keys.hash K
    local header, acquire, entries, stored_key = storage.header, storage.acquire, storage.entries, storage.key
    local maximum = storage.maximum
    local api = {}

    local distance = do(h: U64, slot: U32, capacity: U32): U32
        local low = U32 h
        local delta = slot - low
        local mask = capacity - 1
        return band delta mask
    end
    local byte_count = do(capacity: U32): U64
        local count = U64 capacity
        count = count + 1
        local width = size_of Entry
        if count > maximum() / width then trap "Map is full" end
        return count * width
    end
    local check_top = do(m: Ref T): Unit
        local h = header m
        local bytes = U64 0
        if h.cap ~= 0 then bytes = byte_count h.cap end
        local top = stacks.top h.stack
        if top - h.base ~= bytes then trap "Map grew while it was not at the top of its data stack" end
    end
    local check_mutation = do(m: Ref T): Unit
        local h = header m
        if h.iterating ~= 0 then trap "Map structural mutation during iteration" end
    end
    -- the slot holding key, or none
    local probe = do(table: View, key: K, hashed: U64): U32
        local capacity = table.cap
        local steps = U32 0
        local mask = capacity - 1
        local low = U32 hashed
        while steps < capacity do
            local candidate = low + steps
            local slot = band candidate mask
            local entry = Ptr table.entries[slot]
            local resident = entry.hash
            if resident == 0 then return none end
            local prior = distance resident slot capacity
            if prior < steps then return none end
            if resident == hashed then
                local found = stored_key table entry.key
                if equal found key then return slot end
            end
            steps = steps + 1
        end
        return none
    end
    -- Robin Hood insertion of an absent key into an acquired table with room
    local insert = do(table: EP, capacity: U32, value: Entry): Unit
        local entry = value
        local mask = capacity - 1
        local low = U32 entry.hash
        local slot = band low mask
        local steps = U32 0
        while true do
            local at = Ptr table[slot]
            local resident = at.hash
            if resident == 0 then
                at[0] = entry
                return
            end
            local prior = distance resident slot capacity
            if prior < steps then
                local old = at[0]
                at[0] = entry
                entry = old
                steps = prior
            end
            local next_slot = slot + 1
            slot = band next_slot mask
            steps = steps + 1
        end
    end
    local grow = do(m: Ref T): Unit
        local h = header m
        local old_capacity = h.cap
        if old_capacity >= 0x80000000 then trap "Map is full" end
        local capacity = U32 8
        if old_capacity ~= 0 then capacity = old_capacity * 2 end
        local bytes = byte_count capacity
        local base = h.base
        local used = U64 0
        if old_capacity ~= 0 then used = byte_count old_capacity end
        local fresh = stacks.extend(h.stack, base, used, bytes,
            "Map grew while it was not at the top of its data stack")
        -- rehash into the spare bytes above the table, then move the table down
        local s = stacks.at h.stack
        local spare = stacks.span s fresh bytes
        stacks.fill spare bytes
        local old_bytes = U64 old_capacity * size_of Entry
        local source = EP stacks.span(s, base, old_bytes)
        local target = EP spare
        local slot = U32 0
        while slot < old_capacity do
            local entry = Ptr source[slot]
            if entry.hash ~= 0 then insert target capacity entry[0] end
            slot = slot + 1
        end
        stacks.move (stacks.span s base bytes) spare bytes
        local top = base + bytes
        stacks.reset h.stack top
        h.cap = capacity
    end
    local append
    if string_keys then
        -- key's bytes at target. The key may lie in this arena: stacks never
        -- move, and compaction writes above the arena, so its bytes are intact.
        local place = do(s: Ptr stacks.Stack, target: U64, key: Str): Unit
            local n = U64 key.length
            local destination = stacks.span s target n
            local ptr, len = slice_parts key
            stacks.move destination ptr n
        end
        append = do(m: Ref T, key: Str): U64
            local a = storage.strmap m
            local stack = a.arena_stack
            local base = a.arena_base
            local length = a.arena_len
            local dead = a.dead
            local n = U64 key.length
            local offset = length
            if dead >= 4096 and dead >= length / 2 then
                local live = length - dead
                if n > maximum() - live then trap "StrMap key arena is full" end
                local bytes = live + n
                local fresh = stacks.extend(stack, base, length, bytes,
                    "StrMap grew while its arena was not at the top of its data stack")
                -- compact the live keys above the arena, then move them down
                local s = stacks.at stack
                local keys_now = stacks.span s base length
                local compacted = stacks.span s fresh bytes
                local table = acquire m
                local out = U64 0
                local slot = U32 0
                while slot < table.cap do
                    local entry = Ptr table.entries[slot]
                    if entry.hash ~= 0 then
                        local size = U64 entry.key.len
                        stacks.move(Ptr compacted[out], Ptr keys_now[entry.key.offset], size)
                        entry.key.offset = out
                        out = out + size
                    end
                    slot = slot + 1
                end
                offset = out
                place s (fresh + out) key
                stacks.move (stacks.span s base bytes) compacted bytes
                local end_at = base + bytes
                stacks.reset stack end_at
                a.arena_len = bytes
                a.dead = n
            else
                stacks.extend(stack, base, length, n,
                    "StrMap grew while its arena was not at the top of its data stack")
                place (stacks.at stack) (base + offset) key
                a.arena_len = length + n
                a.dead = dead + n
            end
            return offset
        end
    end
    api.put = do(m: Ref T, key: K, value: V, only_missing): Unit
        local hashed = digest key
        local table = acquire m
        local slot = probe table key hashed
        if slot ~= none then
            if not only_missing then
                local entry = Ptr table.entries[slot]
                entry.value = value
            end
            return
        end
        check_mutation m
        check_top m
        local entry = zero Entry
        entry.hash = hashed
        entry.value = value
        if string_keys then
            entry.key.offset = append m key
            entry.key.len = key.length
        else entry.key = key end
        local h = header m
        local length = h.len
        if h.cap == 0 or length >= h.cap - h.cap / 8 then grow m end
        local capacity = h.cap
        local target = entries(m, h.base, capacity)
        insert target capacity entry
        h.len = length + 1
        if string_keys then
            local a = storage.strmap m
            local n = U64 key.length
            a.dead = a.dead - n
        end
    end
    api.has = do(m: Ref T, key: K): Bool
        local hashed = digest key
        local table = acquire m
        local slot = probe table key hashed
        return slot ~= none
    end
    api.find = do(m: Ref T, key: K): Result
        local hashed = digest key
        local table = acquire m
        local slot = probe table key hashed
        if slot == none then return Result.missing() end
        local entry = Ptr table.entries[slot]
        return Result.found entry.value
    end
    api.locate = do(m: Ref T, key: K): Ptr V
        local hashed = digest key
        local table = acquire m
        local slot = probe table key hashed
        if slot == none then trap "map-key: missing key" end
        local entry = Ptr table.entries[slot]
        return Ptr entry.value
    end
    api.remove = do(m: Ref T, key: K): Bool
        local hashed = digest key
        local table = acquire m
        local slot = probe table key hashed
        if slot == none then return false end
        check_mutation m
        local capacity = table.cap
        local mask = capacity - 1
        local removed = Ptr table.entries[slot]
        local removed_bytes = U64 0
        if string_keys then removed_bytes = U64 removed.key.len end
        local moving = Bool true
        while moving do
            local next_slot = slot + 1
            next_slot = band next_slot mask
            local entry = Ptr table.entries[next_slot]
            local resident = entry.hash
            local prior = distance resident next_slot capacity
            if resident == 0 or prior == 0 then moving = false
            else
                table.entries[slot] = entry[0]
                slot = next_slot
            end
        end
        table.entries[slot] = zero Entry
        local h = header m
        local length = h.len - 1
        h.len = length
        if string_keys then
            local a = storage.strmap m
            a.dead = a.dead + removed_bytes
            if length == 0 then
                stacks.reset a.arena_stack a.arena_base
                a.arena_len = 0
                a.dead = 0
            end
        end
        return true
    end
    api.length = do(m: Ref T): U64 return U64 header(m).len end
    -- `copy m` into a new, empty map: the table, and for text keys the arena
    -- the stored keys point into by offset
    api.copy = do(m: Ref T, from: Ref T): Unit
        local source = header from
        local h = header m
        if source.cap ~= 0 then
            local bytes = byte_count source.cap
            local at = stacks.extend(h.stack, h.base, U64 0, bytes,
                "Map copy target was not at the top of its data stack")
            stacks.move (stacks.region h.stack at bytes) (stacks.region source.stack source.base bytes) bytes
        end
        h.len = source.len
        h.cap = source.cap
        if string_keys then
            local a = storage.strmap m
            local b = storage.strmap from
            local n = b.arena_len
            if n ~= 0 then
                local at = stacks.extend(a.arena_stack, a.arena_base, U64 0, n,
                    "StrMap copy target was not at the top of its data stack")
                stacks.move (stacks.region a.arena_stack at n) (stacks.region b.arena_stack b.arena_base n) n
            end
            a.arena_len = n
            a.dead = b.dead
        end
    end
    libraries[T] = api
    return api
end

-- Immutable host descriptions emit these same ordinary comparisons for dynamic
-- keys; known keys execute the words while specializing, without a native heap.
function map.known(K, V, Result, entries)
    local equal = keys.equal K
    local api = {}
    api.find = do(key: K): Result
        for _, entry in ipairs entries do
            if equal(key, entry[1]) then return Result.found entry[2] end
        end
        return Result.missing()
    end
    api.has = do(key: K): Bool
        for _, entry in ipairs entries do
            if equal(key, entry[1]) then return true end
        end
        return false
    end
    api.get = do(key: K): V
        for _, entry in ipairs entries do
            if equal(key, entry[1]) then return entry[2] end
        end
        trap "map-key: missing key in known map"
        return zero V  -- unreachable after the runtime trap
    end
    api.each = do(body): Unit
        for _, entry in ipairs entries do body(entry[1], entry[2]) end
    end
    return api
end

return map
