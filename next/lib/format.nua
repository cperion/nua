-- Formatting (syntax §14.2): ordinary Nua words. Known inputs fold; dynamic inputs residualize
-- these same loops with their caller.

local chars = import "chars"
local format = {}
local Digits = chars.Chars 20

format.u64 = do(value: U64): Digits
    local reversed: Array U8 20
    local n = value
    local count: U32 = 0
    while true do
        reversed[count] = U8(n % 10) + 48
        count = count + 1
        n = n / 10
        if n == 0 then break end
    end
    local out = Digits()
    out.len = count
    local i: U32 = 0
    while i < count do
        out.bytes[i] = reversed[count - i - 1]
        i = i + 1
    end
    return out
end

format.i64 = do(value: I64): Digits
    local magnitude = U64 value
    if value < 0 then magnitude = U64 0 - magnitude end
    local digits = format.u64 magnitude
    local out = Digits()
    local start: U32 = 0
    if value < 0 then
        out.bytes[0] = 45
        start = 1
    end
    out.len = digits.len + start
    local i: U32 = 0
    while i < digits.len do
        out.bytes[i + start] = digits.bytes[i]
        i = i + 1
    end
    return out
end

format.boolean = do(value: Bool): Str
    if value then return "true" end
    return "false"
end

format.f64 = import("float").text

return format
