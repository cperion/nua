local ffi = require "ffi"
local data = require "nua.compiler.data"
local identity = require "nua.identity"
local types = require "nua.types"

local refuses = do(test, expected)
    local done, problem = pcall test
    assert(not done, "expected a refusal")
    if expected then assert(tostring(problem):find(expected, 1, true), tostring problem) end
end

local constant = |type, value| -> data.Constant { .type, bits = data.IntegerBits { bits = ffi.new("uint64_t", value) } }

-- one definition: entry(%x): %y = add %x 1; return %y
local build = do()
    local supply = identity.supply()
    local fresh = supply.fresh
    local origin = fresh identity.OriginId
    local definition = fresh identity.DefinitionId
    local entry = fresh identity.BlockId
    local y = fresh identity.ValueId
    local x = data.Parameter { .definition, index = 1, type = types.U32 }
    local site = data.Site { id = fresh identity.InstructionId, .origin }
    local add = data.Compute with
        .site
        result = y
        type = types.U32
        opcode = "add"
        arguments = { x, constant(types.U32, 1) }
    end
    local result = data.Result { value = y, type = types.U32 }
    local block = data.Block with
        id = entry
        arguments = {}
        instructions = { add }
        terminator = data.Return { .origin, value = result }
    end
    local signature = data.Signature { parameters = { types.U32 }, result = types.U32, abi = "nua_boundary", variadic = false }
    local built = data.Definition with
        id = definition
        word = fresh identity.WordId
        kind = "native_word"
        .signature
        .entry
        blocks = { block }
        places = {}
        .origin
    end
    return define
        .supply
        .built
        .x
        .result
        .y
        .origin
        .entry
    end
end

test "a definition is built from checked records":
    local made = build()
    assert(data.Instruction.is(made.built.blocks[1].instructions[1], data.Compute))
    assert(data.Terminator.is(made.built.blocks[1].terminator, data.Return))
end

test "malformed nodes are refused where they are built":
    local made = build()
    local fresh = made.supply.fresh
    local site = data.Site { id = fresh identity.InstructionId, origin = made.origin }
    refuses(|| -> data.Compute { .site, result = made.y, type = types.U32, opcode = "power", arguments = {} }, "numeric opcode")
    refuses(|| -> data.Load { .site, result = made.y, place = made.y }, "PlaceId")
    refuses(|| -> data.Store { .site, place = fresh identity.PlaceId, value = 5 }, "operand")
    refuses(|| -> data.Pack { .site, result = made.y, type = types.U32, components = { made.x, nil, made.x } }, "list of operand")
    refuses(|| -> data.Fence { .site, order = "sequential", extra = true })
    refuses(|| -> data.Block { id = made.entry, arguments = {}, instructions = { made.x }, terminator = data.Trap { origin = made.origin, message = made.x } }, "list of instruction")
end

test "integer constants are 64 exact bits":
    local big = data.IntegerBits { bits = ffi.new("uint64_t", -1) }
    assert(big.bits == 0xffffffffffffffffULL)
    refuses(|| -> data.IntegerBits { bits = 3 }, "64 bits")
end

test "operands have one canonical key for fact maps":
    local made = build()
    assert(data.operand_key(made.result) == made.y)
    local again = data.Parameter { definition = made.x.definition, index = 1, type = types.U32 }
    assert(data.operand_key(again) == data.operand_key(made.x))
    local second = data.Parameter { definition = made.x.definition, index = 2, type = types.U32 }
    assert(data.operand_key(second) ~= data.operand_key(made.x))
    refuses(|| -> data.operand_key(constant(types.U8, 1)), "no facts")
end

test "borrow facts: a held path or a stored pointer, live or ended":
    local made = build()
    local fresh = made.supply.fresh
    local place = fresh identity.PlaceId
    local path = data.BorrowPath { root = place, steps = { data.ContentsStep {} } }
    local held = data.BorrowInfo with
        id = fresh identity.BorrowId
        form = data.Held { .path }
        origins = { data.Access { .place, path = { data.ContentsStep {} } } }
        mutable = false
        lifetime = fresh identity.LifetimeId
        acquired = made.origin
    end
    assert(data.BorrowForm.is(held.form, data.Held) and data.BorrowState.is(data.Live {}, data.Live))
    local ended = data.Ended { at = made.origin, reason = "grew" }
    assert(data.BorrowState.is(ended, data.Ended))
    refuses(|| -> data.Ended { at = made.origin, reason = "compacted" }, "reason a borrow ended")
end
