-- Floats as text (syntax §14.2): Nua words (lib/float.nua). The shortest decimal that reads back
-- as the same value, in the layout of C's %.{p}g; checked against libc's own shortest search.

local ffi = require "ffi"
local native = require "tests.support.native"
local compile = require "nua.compile"

-- the text libc gives at the fewest digits that read back
local shortest_by_libc = do(value)
    if value ~= value then return "nan" end
    if value == math.huge then return "inf" end
    if value == -math.huge then return "-inf" end
    for precision = 1, 17 do
        local text = ("%." .. precision .. "g"):format(value)
        if tonumber(text) == value then return text end
    end
end

test "the shortest text of any float, as libc finds it":
    local library = native("floats_text", [[
local float = import "float"
local float_digits = do(value: F64): float.Digits = float.text value
export float_digits
]])
    local text_of = do(value)
        local digits = library.float_digits(value)
        return ffi.string(digits.bytes.e, digits.len)
    end
    local edge = {
        0.1, 0.2, 0.3, 1.5, 100, 123456, 1e5, 1e6, 1e21, 1e22, 1e23, 1e-5, 0.0001, 0.00012345,
        2 ^ 53, 2 ^ 63, 2 ^ -1074, 2.2250738585072014e-308, 1.7976931348623157e308, 5e-324,
        4.35, 9.5367431640625e-07, 3.141592653589793, -2.5, 1 / 3, 0, math.huge, -math.huge,
    }
    for _, value in ipairs edge do
        assert(text_of(value) == shortest_by_libc(value), ("%.17g: %s, not %s"):format(value, text_of(value), shortest_by_libc(value)))
    end
    assert(text_of(0 / 0) == "nan" or text_of(0 / 0) == "-nan" or text_of(0/0) == "nan")
    assert(text_of(-0.0) == "-0")
    math.randomseed(20261109)
    local cell = ffi.new("uint64_t[1]")
    local as_double = ffi.cast("double *", cell)
    for round = 1, 20000 do
        local high, low = math.random(0, 0xffffffff), math.random(0, 0xffffffff)
        -- finite values only, by their exponent bits: a NaN read through a pointer is not a
        -- value LuaJIT can hold safely
        if math.floor(high / 1048576) % 2048 ~= 2047 then
            cell[0] = ffi.cast("uint64_t", high) * 4294967296ULL + ffi.cast("uint64_t", low)
            local value = as_double[0]
            local got, expected = text_of(value), shortest_by_libc(value)
            assert(got == expected, ("%.17g: %s, not %s"):format(value, got, expected))
        end
    end
end

test "a known float folds; Text writes floats":
    local library, text = native("floats_write", [[
local float = import "float"
local float_known = do(): U32
    local digits = float.text 0.1
    return digits.len
end
export float_known
local written_length = do(x: F64, n: U32): U64
    local out = Text {}
    out:write("x = ", x, ", n = ", n, ", ", true, ", ", 1.5)
    return out.length
end
export written_length
]])
    assert(library.float_known() == 3)
    assert(text:match("uint32_t float_known%(void%) {.-\n}"):find("return 3u", 1, true), text:match("uint32_t float_known%(void%) {.-\n}"))
    -- "x = 2.5, n = 7, true, 1.5"
    assert(library.written_length(2.5, 7) == #"x = 2.5, n = 7, true, 1.5")
end
