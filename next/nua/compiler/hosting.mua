-- Hosting (compiler activities §5.1): the host-level values of words and applications.
--
-- `word { name, source, line, requirements, result, body }` is what a typed lambda becomes: a
-- word with its requirements (a native type, or none for host supply) and its native result,
-- both evaluated once, where the word is made. An untyped lambda in a typed body is a word with
-- no result type: it evaluates in place, its result whatever it returns (a match's handlers).
-- Applying a word or an application in Lua supplies arguments (syntax §3.8): `affine 4` is an
-- application that remembers 4 and runs no body. A saturated application is applied (§3.7,
-- compiler activities §5.1 `Hosting.apply`) by the applier of the compilation that made the
-- word: inside a hook or host helper it evaluates in place, residualizing with its caller;
-- from top-level host code it runs while compiling, its arguments all known.

local types = require "nua.types"

local Word = {}
local Application = {}

local is_word = value -> getmetatable value == Word
local is_application = value -> getmetatable value == Application

local supply = do(application, arguments)
    local supplied = {}
    for index, argument in ipairs application.supplied do supplied[index] = argument end
    for _, argument in ipairs arguments do supplied[#supplied + 1] = argument end
    if #supplied > #application.word.requirements then
        error(("%s takes %d arguments, %d supplied"):format(application.word.name, #application.word.requirements, #supplied), 3)
    end
    return setmetatable({ word = application.word, .supplied }, Application)
end

-- supply from Lua: a saturated application is applied by its word's applier
local supplied_from_lua = do(application, arguments)
    local next = supply(application, arguments)
    if #next.supplied == #next.word.requirements and next.word.applier then return next.word.applier(next) end
    return next
end
Word.__call = |word, ...| -> supplied_from_lua(setmetatable({ .word, supplied = {} }, Application), { ... })
Word.__tostring = word -> "word " .. word.name
Application.__call = |application, ...| -> supplied_from_lua(application, { ... })
Application.__tostring = application -> ("application of %s (%d of %d supplied)"):format(application.word.name, #application.supplied, #application.word.requirements)

-- `applier(application)`: how the compilation making the word applies it saturated from Lua
local word = do(description, applier)
    local name = description.name
    for index, requirement in ipairs description.requirements do
        if requirement.type ~= nil and not check(types.NativeType, requirement.type) then
            error(("%s:%d: the parameter '%s' of %s is annotated with %s, not a native type"):format(
                description.source, description.line, requirement.name, name, tostring requirement.type), 2)
        end
    end
    if description.result ~= nil and not check(types.NativeType, description.result) then
        error(("%s:%d: the result of %s is annotated with %s, not a native type"):format(
            description.source, description.line, name, tostring description.result), 2)
    end
    return setmetatable(define
        .name
        source = description.source
        line = description.line
        requirements = description.requirements
        result = description.result
        body = description.body
        tail_calls = description.tail_calls == true
        .applier
    end, Word)
end

-- the word and its supplied arguments, of a word or an application
local supplied_of = do(value)
    if is_word value then return value, {} end
    if is_application value then return value.word, value.supplied end
    return nil
end

local saturated = application -> #application.supplied == #application.word.requirements

-- a primitive: one of the few operations the compiler supplies to the Nua library (trap, effect
-- declarations, views, element references, drop), named so evaluation can dispatch on it
-- Applied from Lua (a hook, a host helper), a primitive is applied by its compilation's
-- `applier`, on the path the host bridge binds.
local primitive_object = meta with
    tostring = primitive -> primitive.name
    call = function(primitive, ...)
        if primitive.applier == nil then error(primitive.name .. " is applied inside an evaluation", 2) end
        return primitive.applier(primitive, { ... })
    end
end
local Primitive = getmetatable(primitive_object {})
-- `by_place`: its argument is captured as a place, never moved (copy)
local primitive = |name, applier, by_place| -> primitive_object { .name, .applier, .by_place }
local is_primitive = value -> getmetatable value == Primitive

return define
    .word
    .is_word
    .is_application
    .supply
    .supplied_of
    .saturated
    .primitive
    .is_primitive
    application = |word_value, arguments| -> supply(setmetatable({ word = word_value, supplied = {} }, Application), arguments)
end
