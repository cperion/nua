-- The evaluation vocabulary, part: Owners: release at scope ends, returns and conditional moves; methods and traps.
-- A part adds its verbs to the one vocabulary E (compiler activities §5.2); parts reach one
-- another only through E, and the evaluation's construction capabilities through core.

local ffi = require "ffi"
local identity = require "nua.identity"
local types = require "nua.types"
local data = require "nua.compiler.data"
local cells = require "nua.compiler.evaluation.cells"
local graph = require "nua.compiler.graph"
local facts = require "nua.compiler.facts"
local rules = require "nua.compiler.rules"
local hosting = require "nua.compiler.hosting"
local platform = require "nua.compiler.platform"
local effects = require "nua.compiler.effects"
local borrow_paths = require "nua.compiler.borrow_paths"
local provenance = require "nua.compiler.provenance"
local boundaries = require "nua.compiler.boundaries"
local NativeValue, Operand, Contents = data.NativeValue, data.Operand, data.Contents
local is_native = value -> check(NativeValue, value)
local lua_type = type

return do(E, core)
    local supply, fresh, tracking, memory, fail, site, origin_of, remember_borrows, enter, append, terminate, remember_reference, definitions = core.supply, core.fresh, core.tracking, core.memory, core.fail, core.site, core.origin_of, core.remember_borrows, core.enter, core.append, core.terminate, core.remember_reference, core.definitions
    local compilation = core.compilation
    --------------------------------------------------------------------------------------------
    -- releasing owners (syntax §9.2): a buffer through its library's release word, a record
    -- through its owning fields; the place is moved, its borrows end

    -- `place` and `steps`, when given, name where the value is held: a part moved out of it is
    -- not released
    E.release_value = do(path, value, place, steps)
        if place and E.vacated_at(path, place, steps) then return end
        -- a type that owns allocations of its own releases them by its `__release` hook (the
        -- buffer's release word, buffers §4.1): the owning contents first, then the storage
        local release = is_native value and E.member_of(value.type, "__release")
        if release then
            local holder = E.new_place(path, "released", value.type)
            path.flow.contents[holder.id] = data.Tracked { .value }
            E.apply(path, release, { E.reference_to(path, E.place_cell(holder.id, "released")) }, false)
            path.flow.contents[holder.id] = data.Moved { at = origin_of path }
            return
        end
        if is_native value and E.is_sum value.type then return E.release_sum(path, value, place, steps) end
        if E.is_aggregate value and types.owns value.type then
            for _, field in ipairs(E.fields_of value.type) do
                if types.owns field.type then
                    local under = nil
                    if place then
                        under = {}
                        for position, step in ipairs steps do under[position] = step end
                        under[#under + 1] = data.FieldStep { name = field.name }
                    end
                    E.release_value(path, E.part(path, value, field.name), place, under)
                end
            end
        end
    end
    -- `copy x` (syntax §9.2): a type's `__copy` hook (a buffer, a view), else the walk the
    -- type gives: owner fields copied, value fields as values, a sum's active payload
    E.copy_of = do(path, given)
        local value = E.deref(path, given)
        if not is_native value then return given end
        local hook = E.member_of(value.type, "__copy")
        if hook then
            local word = hosting.supplied_of hook
            local by_reference = word and word.requirements[1].type and types.NativeType.is(word.requirements[1].type, types.ReferenceType)
            if not by_reference then return E.apply(path, hook, { value }, false) end
            if E.is_reference given and types.NativeType.is(given.type, types.ReferenceType) then return E.apply(path, hook, { given }, false) end
            -- a header held only as a value: lent from a place that does not own it
            local holder = E.new_place(path, "copied", value.type)
            path.flow.contents[holder.id] = data.Tracked { .value }
            local result = E.apply(path, hook, { E.reference_to(path, E.place_cell(holder.id, "copied")) }, false)
            path.flow.contents[holder.id] = data.Moved { at = origin_of path }
            return result
        end
        if not types.owns value.type then return value end
        if E.is_aggregate value then
            local parts = {}
            for _, field in ipairs(E.fields_of value.type) do parts[field.name] = E.copy_of(path, E.part(path, value, field.name)) end
            return data.Aggregate { type = value.type, packed = nil, .parts }
        end
        local copied = do(at, name)
            local payload = E.payload_of(at, value, name)
            return data.Tagged { type = value.type, alternative = name, payload = payload and E.copy_of(at, payload) }
        end
        if E.is_tagged value then return copied(path, value.alternative) end
        return E.dispatch_tag(path, value, copied, "the copy of " .. types.describe value.type)
    end

    E.release_place = do(path, place)
        local contents = path.flow.contents[place]
        if not contents or not (Contents.is(contents, data.Tracked) or Contents.is(contents, data.Resident)) then return end
        local value = Contents.is(contents, data.Resident) and E.load(path, compilation.places[place]) or contents.value
        E.release_value(path, value, place, {})
        append(path, data.Ends { site = site path, target = data.Access { .place, path = {} }, reason = "released" })
    end
    -- release the live owners among `places`, from index `first`, newest first
    E.release_live = do(path, places, first)
        for position = #places, first, -1 do
            local place = places[position]
            if types.owns(compilation.places[place].type) then E.release_place(path, place) end
        end
    end

    -- the end of a block: its owners that are still live are released, newest first
    -- blocks open and close scopes: a place's scope chain decides what it outlives (§9.5)
    E.scope_begin = do(path)
        local invocation = path.invocation
        if invocation == nil then return end
        invocation.scopes = invocation.scopes or {}
        invocation.scope_count = (invocation.scope_count or 0) + 1
        invocation.scopes[#invocation.scopes + 1] = invocation.scope_count
    end
    E.scope_end = do(path, declared)
        local invocation = path.invocation
        if invocation and invocation.scopes and #invocation.scopes > 0 then invocation.scopes[#invocation.scopes] = nil end
        if path.dead then return end
        for position = #declared, 1, -1 do
            local cell = declared[position]
            if cells.Cell.is(cell, cells.PlaceCell) and types.owns(compilation.places[cell.place].type) then E.release_place(path, cell.place) end
        end
    end

    -- `trap "why"`: the path ends here, at run time, with the message
    E.trap = do(path, message)
        local constant = data.Constant { type = types.Str, bits = data.StaticBytes { bytes = tostring message } }
        terminate(path, data.Trap { origin = origin_of path, message = constant })
        path.dead = true
        return nil
    end


end
