-- Boundary-owned completion relations and finite recursive region ports.
-- A design experiment over the existing program family, not an adopted native ABI.
local supplied = ...
local mua = require "mua.init"
local boundary = supplied or assert(mua.loadfile "docs/design/compiler-boundary-probe.mua") "module"
local v, copy = boundary.v, boundary.v.copy_keys
local storage = assert(mua.loadfile "docs/design/compiler-completion-probe.mua")(v)
local yes, no = (v.boolean true).operand, (v.boolean false).operand
local same = do(left) = do(right)
    return left == right or left and right and v.Operand.is(left, v.BooleanConstant) and
    v.Operand.is(right, v.BooleanConstant) and left.value == right.value
end
local sorted = do(set)
    local items = {}
    for item in pairs set do items[#items + 1] = item end
    table.sort items
    return items
end
local inert = do(node, recurse, profile) end

-- Collect a flat registry and checked facts over its Call/BeginOwned instructions.
-- A recursive reference names a registered definition; definitions do not embed themselves.
local contracts = do(root)
    local registry, profiles, groups = {}, {}, {}
    local collect
    collect = do(definition)
        if registry[definition.identity] then
            assert(registry[definition.identity] == definition, "conflicting source definition")
            return
        end
        assert(not definition.completion_mode, "region planning needs logical input")
        registry[definition.identity] = definition
        profiles[definition.identity] = { .definition, own = {}, calls = {} }
        for _, child in ipairs(definition.callees or {}) do collect child end
    end
    collect root
    local gathering = v.Instruction.pass "collect region equations" with
        Add = inert
        Load = inert
        Store = inert
        Expose = inert
        EndContents = inert
        BeginExtent = inert
        TransferOwned = inert
        BorrowOwned = inert
        ObserveBorrow = inert
        EndOwned = inert
        ReleaseExtent = inert
        CompleteBoundary = inert
        StackTop = inert
        StackWrite = inert
        Greater = inert
        ExternalGrowth = inert
        BeginOwned = do(node, recurse, profile)
            profile.own[node.allocation.identity] = profile.definition.identity .. "/" .. node.allocation.identity
        end
        Call = do(node, recurse, profile)
            assert(registry[node.callee], "unregistered region callee")
            profile.calls[#profile.calls + 1] = node
        end
    end
    for _, name in ipairs(sorted registry) do
        local definition = registry[name]
        v.verify_graph(definition, registry)
        for _, block in ipairs definition.blocks do
            for _, node in ipairs block.instructions do gathering(node, profiles[name]) end
        end
    end

    local serial, stack, indices, low, stacked = 0, {}, {}, {}, {}
    local connect
    connect = do(name)
        serial += 1
        indices[name], low[name], stacked[name] = serial, serial, true
        stack[#stack + 1] = name
        for _, call in ipairs profiles[name].calls do
            local target = call.callee
            if not indices[target] then connect target; low[name] = math.min(low[name], low[target])
            elseif stacked[target] then low[name] = math.min(low[name], indices[target]) end
        end
        if low[name] == indices[name] then
            local group = { members = {}, domain = {} }
            while true do
                local member = table.remove stack
                stacked[member], profiles[member].group = nil, group
                group.members[#group.members + 1] = member
                if member == name then break end
            end
            table.sort group.members
            group.identity = table.concat(group.members, "+")
            groups[#groups + 1] = group  -- Tarjan finishes callees before their callers.
        end
    end
    for _, name in ipairs(sorted registry) do if not indices[name] then connect name end end
    local imported = do(profile) = do(call) = do(role)
        if profile.group == profiles[call.callee].group then return role end
        return profile.definition.identity .. "/" .. call.result.identity .. "/" .. role
    end
    local additions, rounds = 0, 0
    for _, group in ipairs groups do
        -- Freeze the universe BEFORE agreement. Internal recursive edges substitute
        -- the same ports, never prefix another call-depth name or completion history.
        for _, name in ipairs group.members do
            local profile = profiles[name]
            profile.seed, profile.support = {}, {}
            for _, role in pairs profile.own do profile.seed[role] = true end
            for _, call in ipairs profile.calls do
                if profiles[call.callee].group ~= group then
                    for _, role in ipairs profiles[call.callee].roles do profile.seed[imported profile call role] = true end
                end
            end
            for role in pairs profile.seed do group.domain[role] = true end
        end
        local changed = true
        while changed do
            changed = false
            rounds += 1
            for _, name in ipairs group.members do
                local profile = profiles[name]
                local contribute = do(role)
                    assert(group.domain[role],
                        "agreement invented a role outside its finite universe")
                    if not profile.support[role] then
                        profile.support[role], changed = true, true
                        additions += 1
                    end
                end
                for role in pairs profile.seed do contribute role end
                for _, call in ipairs profile.calls do
                    if profiles[call.callee].group == group then
                        for role in pairs profiles[call.callee].support do contribute role end
                    end
                end
            end
        end
        for _, name in ipairs group.members do profiles[name].roles = sorted profiles[name].support end
    end
    local bound = 0
    for _, group in ipairs groups do bound += #group.members * #sorted group.domain end
    assert(additions <= bound, "agreement exceeded finite fact bound")
    return define
        .registry
        .profiles
        .groups
        .imported
        .additions
        .rounds
        .bound
    end
end

-- One activity per preparation, with closed instruction handlers and privately owned output.
local prepare = do(root)
    assert(root.result_type ~= "Owned U32", "receiver result needs an outward authority contract")
    for _, parameter in ipairs root.parameters do
        assert(parameter.native_type ~= "Owned U32",
            "receiving inputs need an enclosing authority contract")
    end
    local agreement = contracts root
    local prepared, by_name = {}, {}
    for _, name in ipairs(sorted agreement.registry) do
        local source, profile = agreement.registry[name], agreement.profiles[name]
        local receiving = source == root
        local parameters, regions, captures, assignments = copy source.parameters, {}, {}, {}
        for ordinal, role in ipairs profile.roles do
            local index = receiving and (v.wide(ordinal - 1)).operand or
            v.Parameter { identity = "region.position." .. ordinal, native_type = "U64" }
            local assignment = { role = "region." .. ordinal, .index }
            if receiving then
                assignment.mark = v.Result { identity = assignment.role .. ".mark", native_type = "U64" }
                captures[#captures + 1] = v.Lease { .index, mark = assignment.mark }
            else
                parameters[#parameters + 1] = index
                regions[#regions + 1] = index
            end
            assignments[role] = assignment
        end
        local output, serial = storage.realization "region.words", 0
        local fresh = do(stem) serial += 1; return "region." .. stem .. "." .. serial end
        local block = identity -> { .identity, arguments = {}, instructions = {} }
        local jump = do(target) = do(arguments)
            return v.Jump { edge = v.Edge { .target, .arguments }, at = "completion relation" }
        end
        local choice = do(into) = do(condition) = do(when_true) = do(when_false)
            if v.Operand.is(condition, v.BooleanConstant) then
                if condition.value then return when_true into else return when_false into end
            end
            local left = block(fresh "yes")
            local right = block(fresh "no")
            local joined = block(fresh "join")
            local result = v.BlockArgument { identity = fresh "selected", native_type = "Bool" }
            joined.arguments[1] = result
            into.terminator = v.Branch with
                .condition
                when_true = v.Edge { target = left.identity, arguments = {} }
                when_false = v.Edge { target = right.identity, arguments = {} }
                at = "guard completion"
            end
            output.publish into
            local left_value, right_value
            left, left_value = when_true left
            left.terminator = jump joined.identity ({ left_value })
            output.publish left
            right, right_value = when_false right
            right.terminator = jump joined.identity ({ right_value })
            output.publish right
            return joined, result
        end
        local either = do(into) = do(left) = do(right)
            if same left right then return into, left end
            if same left no then return into, right end
            if same right no then return into, left end
            return choice into left do(part) return part, yes end do(part) return part, right end
        end
        local restore = do(into) = do(role) = do(guard) = do(pending)
            return choice into guard do(part)
                return output.word part ("restore") assignments[role], no
            end do(part) return part, pending end
        end
        local memberships, relations, incoming, outgoing, extra_edges = {}, {}, {}, {}, {}
        for _, original in ipairs source.blocks do
            for _, edge in ipairs(v.edges original.terminator) do
                incoming[edge.target] = incoming[edge.target] or {}
                incoming[edge.target][#incoming[edge.target] + 1] = { .edge,
                    predecessor = original.identity }
                extra_edges[edge] = {}
            end
        end
        local record = do(owner) = do(members)
            memberships[owner.identity] = members
            local entries = {}
            for _, role in ipairs profile.roles do
                if members[role] then entries[#entries + 1] = v.CompletionMember with
                    index = assignments[role].index
                    guard = members[role]
                end end
            end
            relations[#relations + 1] = v.CompletionFact { operand = owner, members = entries }
        end
        local written, pending
        local merge = do(edges) = do(values)
            local first, equal = values[1], true
            for _, value in ipairs values do if not same first value then equal = false end end
            if equal then return first end
            local argument = v.BlockArgument { identity = fresh "membership", native_type = "Bool" }
            written.arguments[#written.arguments + 1] = argument
            for index, item in ipairs edges do
                local extras = extra_edges[item.edge]
                extras[#extras + 1] = values[index]
            end
            return argument
        end
        local keep = do(node, recurse) output.append written node end
        local unsupported = do(node, recurse) error "regional planning needs an explicit contract for this instruction" end
        local transforming = v.Instruction.pass "realize boundary completion relations" with
            Add = keep
            Load = keep
            Store = keep
            Expose = keep
            EndContents = keep
            BeginExtent = keep
            BorrowOwned = keep
            ObserveBorrow = keep
            Greater = keep
            ReleaseExtent = unsupported
            StackTop = unsupported
            StackWrite = unsupported
            ExternalGrowth = unsupported
            CompleteBoundary = do(node, recurse) end
            BeginOwned = do(node, recurse)
                local role = assert profile.own[node.allocation.identity]
                output.append written (v.BeginOwned { ..node, index = assignments[role].index })
                if receiving then record node.result ({[role] = yes }) end
            end
            TransferOwned = do(node, recurse)
                output.append written node
                if receiving then record node.result (assert memberships[node.source.identity]) end
            end
            EndOwned = do(node, recurse)
                output.append written node
                if receiving then
                    local members = assert memberships[node.owner.identity]
                    for _, role in ipairs profile.roles do
                        if members[role] then written,
                            pending[role] = restore written role members[role] pending[role] end
                    end
                end
            end
            Call = do(node, recurse)
                local target = agreement.profiles[node.callee]
                local arguments, members = copy node.arguments, {}
                if receiving then
                    for _, value in ipairs node.arguments do
                        if value.native_type == "Owned U32" then
                            for _, role in ipairs profile.roles do
                                local guard = (assert memberships[value.identity])[role]
                                if guard then written,
                                    members[role] = either written (members[role] or no) guard end
                            end
                        end
                    end
                end
                for _, role in ipairs target.roles do
                    local local_role = agreement.imported profile node role
                    arguments[#arguments + 1] = assignments[local_role].index
                    if receiving then members[local_role] = yes end
                end
                output.append written (v.Call with ..node
                    callee = node.callee .. ".regions"
                    .arguments
                end)
                if receiving then
                    if node.result.native_type == "Owned U32" then record node.result members
                    else
                        for _, role in ipairs profile.roles do
                            if members[role] then written,
                                pending[role] = restore written role members[role] pending[role] end
                        end
                    end
                end
            end
        end
        for _, original in ipairs source.blocks do
            written = { ..original, arguments = copy original.arguments, instructions = {} }
            pending = {}
            if receiving then
                if original.identity == source.entry then
                    for _, role in ipairs profile.roles do
                        pending[role] = yes
                        written = output.word written ("capture") assignments[role]
                    end
                else
                    local edges = assert incoming[original.identity]
                    for index, argument in ipairs original.arguments do
                        if argument.native_type == "Owned U32" then
                            local members = {}
                            for _, role in ipairs profile.roles do
                                local values = {}
                                for _, item in ipairs edges do
                                    local supplied = assert memberships[item.edge.arguments[index].identity]
                                    values[#values + 1] = supplied[role] or no
                                end
                                local guard = merge edges values
                                if not same guard no then members[role] = guard end
                            end
                            record argument members
                        end
                    end
                    for _, role in ipairs profile.roles do
                        local values = {}
                        for _, item in ipairs edges do values[#values + 1] = outgoing[item.predecessor][role] end
                        pending[role] = merge edges values
                    end
                end
            end
            for _, node in ipairs original.instructions do transforming node end
            if receiving and #v.edges original.terminator == 0 then
                for _, role in ipairs profile.roles do written, pending[role] = restore written role pending[role] pending[role] end
            end
            written.terminator = original.terminator
            output.publish written
            outgoing[original.identity] = copy pending
        end
        local edge = do(original)
            local arguments = copy original.arguments
            for _, value in ipairs(extra_edges[original] or {}) do arguments[#arguments + 1] = value end
            return v.Edge { ..original, .arguments }
        end
        local ending = v.Terminator.pass "transport local relation guards" with
            Jump = do(node, recurse) = v.Jump { ..node, edge = edge node.edge }
            Branch = do(node, recurse) = v.Branch with ..node
                when_true = edge node.when_true
                when_false = edge node.when_false
            end
            Return = do(node, recurse) = node
            Trap = do(node, recurse) = node
        end
        local by_role, blocks = {}, {}
        for _, assignment in pairs assignments do by_role[assignment.role] = assignment end
        for _, original in ipairs output.blocks do
            local instructions = {}
            for _, node in ipairs original.instructions do
                if v.Instruction.is(node, v.StackTop) then node = v.StackTop with ..node
                    index = by_role[node.role].index
                end
                elseif v.Instruction.is(node, v.StackWrite) then node = v.StackWrite with ..node
                    index = by_role[node.role].index
                end end
                instructions[#instructions + 1] = node
            end
            blocks[#blocks + 1] = v.Block with ..original
                .instructions
                terminator = ending original.terminator
            end
        end
        local definition = v.Definition with ..source
            identity = source.identity .. ".regions"
            .parameters
            .blocks
            .regions
            .captures
            leases = {}
            callees = {}
            completion_relations = relations
            completion_mode = receiving and "region-receiver" or "region-borrower"
            region_scope = profile.group.identity
        end
        prepared[#prepared + 1], by_name[definition.identity] = definition, definition
    end
    local definition, children = assert by_name[root.identity .. ".regions"], {}
    for _, child in ipairs prepared do if child ~= definition then children[#children + 1] = child end end
    definition = v.Definition { ..definition, callees = children }
    by_name[definition.identity] = definition
    for _, program in pairs by_name do v.verify_graph(program, by_name) end
    return { .definition, .agreement, definitions = by_name }
end

-- Explicit cyclic IR fixtures: source recursion construction is NOT claimed by this probe.
-- A frame ends its cell before descending; the base frame returns its current cell.
-- Repeated instances retain a prefix on the same finite ports, under the root's marks.
local recursive_source = do(mutual)
    local names = mutual and { "cycle-a", "cycle-b" } or { "cycle" }
    local allocations, extents = {}, {}
    for _, name in ipairs names do
        local extent = v.Extent { identity = name .. ".extent", .name }
        local allocation = v.Allocation with
            identity = name .. ".allocation"
            extent = extent.identity
            origin = v.Origin with
                identity = name .. ".contents"
                holding = name .. ".allocation"
                guarantee = "stable"
            end
        end
        extents[#extents + 1], allocations[#allocations + 1] = extent, allocation
    end
    local definitions = {}
    for ordinal, name in ipairs names do
        local limit = v.Parameter { identity = "limit", native_type = "U32" }
        local depth = v.Parameter { identity = "depth", native_type = "U32" }
        local owner = v.Result { identity = "cell", native_type = "Owned U32" }
        local more = v.Result { identity = "more", native_type = "Bool" }
        local next_depth = v.Result { identity = "next", native_type = "U32" }
        local returned = v.Result { identity = "deeper", native_type = "Owned U32" }
        local allocation = allocations[ordinal]
        local target = names[ordinal % #names + 1]
        local returns = {}
        for _, extent in ipairs extents do returns[#returns + 1] = extent.identity end
        definitions[#definitions + 1] = v.Definition with
            identity = name
            parameters = { limit, depth }
            places = {}
            entry = "entry"
            blocks = {
                v.Block with
                    identity = "entry"
                    arguments = {}
                    instructions = {
                        v.BeginExtent { extent = allocation.extent, at = "frame region" },
                        v.BeginOwned with
                            result = owner
                            .allocation
                            initial = (v.unsigned 9).operand
                            at = "frame cell"
                        end,
                        v.Greater with
                            result = more
                            left = limit
                            right = depth
                            at = "remaining recursion"
                        end,
                    }
                    terminator = v.Branch with
                        condition = more
                        when_true = v.Edge { target = "descend", arguments = {} }
                        when_false = v.Edge { target = "base", arguments = {} }
                        at = "recursive choice"
                    end
                end,
                v.Block with
                    identity = "descend"
                    arguments = {}
                    instructions = {
                        v.EndOwned { .owner, at = "retain ended prefix" },
                        v.Add with
                            result = next_depth
                            left = depth
                            right = (v.unsigned 1).operand
                            at = "next level"
                        end,
                        v.Call with
                            result = returned
                            callee = target
                            arguments = { limit, next_depth }
                            instances = {}
                            at = "recursive edge"
                        end,
                    }
                    terminator = v.Return { value = returned, at = "forward without reset" }
                end,
                v.Block with
                    identity = "base"
                    arguments = {}
                    instructions = {}
                    terminator = v.Return { value = owner, at = "base result" }
                end,
            }
            result_type = "Owned U32"
            references = {}
            return_origins = {}
            .extents
            .allocations
            owners = {
                v.OwnershipFact { operand = owner, allocations = { allocation } },
                v.OwnershipFact { operand = returned, .allocations },
            }
            return_extents = returns
        end
    end
    local limit = v.Parameter { identity = "limit", native_type = "U32" }
    local result = v.Result { identity = "result", native_type = "Owned U32" }
    local sibling = v.Result { identity = "sibling", native_type = "Owned U32" }
    local view = v.Result { identity = "view", native_type = "Ref U32" }
    local other_view = v.Result { identity = "other-view", native_type = "Ref U32" }
    local extent = v.Extent { identity = "sibling.extent", name = "live sibling" }
    local allocation = v.Allocation with
        identity = "sibling.allocation"
        extent = extent.identity
        origin = v.Origin with
            identity = "sibling.contents"
            holding = "sibling.allocation"
            guarantee = "stable"
        end
    end
    local all, origins, root_extents = copy allocations, {}, copy extents
    all[#all + 1], root_extents[#root_extents + 1] = allocation, extent
    for _, item in ipairs allocations do origins[#origins + 1] = item.origin end
    return v.Definition with
        identity = mutual and "mutual-receiver" or "recursive-receiver"
        parameters = { limit }
        places = {}
        entry = "entry"
        blocks = {
            v.Block with
                identity = "entry"
                arguments = {}
                instructions = {
                    v.BeginExtent { extent = extent.identity, at = "sibling region" },
                    v.BeginOwned with
                        result = sibling
                        .allocation
                        initial = (v.unsigned 2).operand
                        at = "sibling"
                    end,
                    v.Call with
                        .result
                        callee = names[1]
                        arguments = { limit, (v.unsigned 0).operand }
                        instances = {}
                        at = "enter cyclic region"
                    end,
                    v.BorrowOwned { result = view, owner = result, at = "result view" },
                    v.ObserveBorrow { reference = view, at = "result observation" },
                    v.EndOwned { owner = result, at = "complete recursive result" },
                    v.BorrowOwned { result = other_view, owner = sibling, at = "surviving sibling" },
                    v.ObserveBorrow { reference = other_view, at = "after result reset" },
                    v.EndOwned { owner = sibling, at = "sibling end" },
                    v.CompleteBoundary { at = "receiving exit" },
                }
                terminator = v.Return { value = (v.unsigned 0).operand, at = "done" }
            end,
        }
        result_type = "U32"
        references = {
            v.ReferenceFact { operand = view, .origins },
            v.ReferenceFact { operand = other_view, origins = { allocation.origin } },
        }
        return_origins = {}
        extents = root_extents
        allocations = all
        owners = {
            v.OwnershipFact { operand = sibling, allocations = { allocation } },
            v.OwnershipFact { operand = result, .allocations },
        }
        return_extents = {}
        callees = definitions
    end
end

local replacement_source = do(mutual)
    local source = recursive_source mutual
    local callees = {}
    for _, definition in ipairs source.callees do
        local parameter = v.Parameter { identity = "carried", native_type = "Owned U32" }
        local extent = v.Extent { identity = "carried.extent", name = "incoming owner" }
        local allocation = v.Allocation with
            identity = "carried.allocation"
            extent = extent.identity
            origin = v.Origin with
                identity = "carried.contents"
                holding = "carried.allocation"
                guarantee = "stable"
            end
        end
        local parameters, allocations, extents, owners = copy definition.parameters, copy definition.allocations, copy definition.extents, copy definition.owners
        parameters[#parameters + 1], allocations[#allocations + 1], extents[#extents + 1] = parameter, allocation, extent
        owners[#owners + 1] = v.OwnershipFact { operand = parameter, allocations = { allocation } }
        local blocks, created = {}, definition.blocks[1].instructions[2].result
        for _, block in ipairs definition.blocks do
            local instructions = {}
            if block.identity == definition.entry then instructions[#instructions + 1] = v.EndOwned with
                owner = parameter
                at = "replace incoming owner"
            end end
            for _, node in ipairs block.instructions do
                if v.Instruction.is(node, v.Call) then
                    local arguments = copy node.arguments
                    arguments[#arguments + 1] = created
                    instructions[#instructions + 1] = v.Call { ..node, .arguments }
                elseif not v.Instruction.is(node, v.EndOwned) then instructions[#instructions + 1] = node end
            end
            blocks[#blocks + 1] = v.Block { ..block, .instructions }
        end
        callees[#callees + 1] = v.Definition with ..definition
            .parameters
            .allocations
            .extents
            .owners
            .blocks
        end
    end
    local initial = v.Result { identity = "initial", native_type = "Owned U32" }
    local extent = v.Extent { identity = "initial.extent", name = "initial owner" }
    local allocation = v.Allocation with
        identity = "initial.allocation"
        extent = extent.identity
        origin = v.Origin with
            identity = "initial.contents"
            holding = "initial.allocation"
            guarantee = "stable"
        end
    end
    local extents, allocations, owners, instructions = copy source.extents, copy source.allocations, copy source.owners, {}
    extents[#extents + 1], allocations[#allocations + 1] = extent, allocation
    owners[#owners + 1] = v.OwnershipFact { operand = initial, allocations = { allocation } }
    for _, node in ipairs source.blocks[1].instructions do
        if v.Instruction.is(node, v.Call) then
            instructions[#instructions + 1] = v.BeginExtent { extent = extent.identity, at = "initial region" }
            instructions[#instructions + 1] = v.BeginOwned with
                result = initial
                .allocation
                initial = (v.unsigned 1).operand
                at = "initial owner"
            end
            local arguments = copy node.arguments
            arguments[#arguments + 1] = initial
            node = v.Call { ..node, .arguments }
        end
        instructions[#instructions + 1] = node
    end
    return v.Definition with ..source
        identity = source.identity .. ".replacement"
        .callees
        .allocations
        .extents
        .owners
        blocks = { v.Block { ..source.blocks[1], .instructions } }
    end
end

local accept_exchanged = do(source)
    local before, count = boundary.write_program source, boundary.construction_count()
    local plan = prepare source
    print("=== boundary-owned completion relations ===\n" .. boundary.write_program plan.definition)
    for _, prefix in ipairs { 0, 64 } do
        for _, choice in ipairs { false, true } do
            for _, swap in ipairs { false, true } do
                local checked = boundary.ledger_for_inputs plan.definition ({ .choice, .swap }) prefix
                local selected = choice and 1 or 3
                local expected = swap and "2," .. selected or selected .. ",2"
                assert(table.concat(checked.observations, ",") == expected and checked.calls == 2)
                print("exchange " .. tostring choice .. "/" .. tostring swap .. "/" .. prefix .. ": " .. table.concat(checked.trace,
                        "; "))
            end
        end
    end
    assert(boundary.write_program source == before and boundary.construction_count() == count,
        "region planning replayed source")
    assert(boundary.write_program((prepare source).definition) == boundary.write_program plan.definition,
        "region planning changed accepted output")
    print "PASS: exchanged-component acceptance; 8 independent prefix/Boolean checks."
    return plan
end
local api = define
    .prepare
    .contracts
    .recursive_source
    .replacement_source
    .accept_exchanged
end
if supplied then return api end

local join = assert(mua.loadfile "docs/design/compiler-join-probe.mua")(boundary)
for _, right in ipairs { 4294967294, 4294967295 } do
    local known = v.construct "known-u32-comparison" ({}) "Bool" do(evaluation) return do(path) return do(inputs)
                return evaluation.greater path (v.unsigned 4294967295) (v.unsigned right)
            end end end
    assert(#known.blocks == 1 and #known.blocks[1].instructions == 0 and
        known.blocks[1].terminator.value.value == (right < 4294967295))
end
local witnesses, checks, rejections = 1, 8, 0
local exchanged_source = join.exchanged_source()
local exchanged = accept_exchanged exchanged_source
local witness = do(source) = do(expected)
    local before, count = boundary.write_program source, boundary.construction_count()
    local plan = prepare source
    local snapshot = boundary.write_program plan.definition
    print("=== " .. source.identity .. " ===\n" .. snapshot)
    local visit
    visit = do(index) = do(inputs) = do(prefix)
        if index <= #source.parameters then
            for _, value in ipairs { false, true } do
                local next_inputs = copy inputs
                next_inputs[source.parameters[index].identity] = value
                visit (index + 1) next_inputs prefix
            end
        else
            local result = boundary.ledger_for_inputs plan.definition inputs prefix
            local observations, calls = expected inputs
            assert(table.concat(result.observations, ",") == observations and result.calls == calls,
                "region realization changed values or native effects")
            checks += 1
        end
    end
    for _, prefix in ipairs { 0, 64 } do visit 1 ({}) prefix end
    assert(boundary.write_program source == before and boundary.construction_count() == count)
    assert(boundary.write_program((prepare source).definition) == snapshot,
        "nondeterministic region output")
    witnesses += 1
    return plan
end
witness (boundary.unequal_source()) do(inputs)
    return inputs.flag and not inputs.choice and "3,2" or "1,2", inputs.flag and 1 or 0
end
witness (join.joined_root "regional-swap-before-join" { swap = true, target = boundary.forwarding }) do(inputs)
    local left, right = inputs.swap and 2 or 1, inputs.swap and 1 or 2
    if inputs.flag and not inputs.choice then left = 3 end
    return left .. "," .. right, inputs.flag and 3 or 1
end
local nested = witness (join.joined_root "regional-nested-joins" { nested = true,
        target = boundary.replace }) do(inputs)
    return inputs.flag and not inputs.choice and "3,2" or "1,2", 1 + (inputs.flag and (inputs.nested and 3 or 1) or 0)
end
local replace_variant = assert nested.definitions[boundary.replace.identity .. ".regions"]
assert(#replace_variant.parameters == 3 and #replace_variant.regions == 1,
    "argument history changed the native contract")
witness join.native_root do(inputs)
    return inputs.flag and not inputs.choice and "3,2" or "1,2", inputs.flag and 4 or 3
end
witness (join.joined_root "regional-retained-work" { target = join.prefix_replace }) do(inputs)
    return inputs.flag and not inputs.choice and "9,2" or "1,2", inputs.flag and 2 or 1
end
witness (join.joined_root "regional-early-exit" { early = true, target = boundary.replace }) do(inputs)
    if not inputs.flag and inputs.early then return "", 0 end
    return inputs.flag and not inputs.choice and "3,2" or "1,2", inputs.flag and 2 or 1
end
local cyclic = {}
for _, replacing in ipairs { false, true } do
    for _, mutual in ipairs { false, true } do
        local construct = replacing and replacement_source or recursive_source
        local source = construct mutual
        local before = boundary.write_program source
        local plan = prepare source
        local snapshot = boundary.write_program plan.definition
        local port_count = mutual and 2 or 1
        print("=== " .. source.identity .. " ===\n" .. snapshot)
        print("agreement facts " .. plan.agreement.additions .. "/" .. plan.agreement.bound .. ", rounds " .. plan.agreement.rounds)
        for _, child in ipairs plan.definition.callees do
            assert(#child.regions == port_count and #child.parameters == port_count + (replacing and 3 or 2))
            assert(#child.captures == 0 and #child.leases == 0,
                "recursive frame acquired reset authority")
        end
        for _, prefix in ipairs { 0, 64 } do
            for _, limit in ipairs { 0, 1, 2, 7, 31 } do
                local result = boundary.ledger_for_inputs plan.definition ({ .limit }) prefix
                assert(table.concat(result.observations, ",") == "9,2" and result.calls == limit + 1 and result.deepest == limit + 2)
                local found = false
                for _, cell in pairs result.cells do
                    if cell.returned_to_root and cell.payload == 9 and cell.low == result.positions[cell.index].floor + 4 * math.floor(limit / port_count) then found = true end
                end
                assert(found, "recursive retained prefix disappeared")
                print("depth " .. limit .. ", prefix " .. prefix .. ": " .. table.concat(result.trace,
                        "; "))
                checks += 1
            end
        end
        assert(boundary.write_program source == before and boundary.write_program((prepare source).definition) == snapshot)
        cyclic[#cyclic + 1] = plan
        witnesses += 1
    end
end

-- Invalid realized programs, not valid-source rejections.
local bad = do(name) = do(fragment) = do(body)
    local ok, problem = pcall body
    assert(not ok and tostring(problem):find(fragment, 1, true), name .. ": " .. tostring problem)
    rejections += 1
    print("refused " .. name .. ": " .. tostring problem)
end
local nodes = do(program) = do(change)
    local blocks = {}
    for _, block in ipairs program.blocks do
        local instructions = {}
        for _, node in ipairs block.instructions do
            for _, replacement in ipairs(change node) do instructions[#instructions + 1] = replacement end
        end
        blocks[#blocks + 1] = v.Block { ..block, .instructions }
    end
    return v.Definition { ..program, .blocks }
end
local root = exchanged.definition
local fresh_index, sibling_index, member_fact
for _, block in ipairs root.blocks do
    for _, node in ipairs block.instructions do
        if v.Instruction.is(node, v.Call) and node.callee == boundary.replace.identity .. ".regions" then fresh_index = node.arguments[#node.arguments] end
        if v.Instruction.is(node, v.BeginOwned) and node.initial.value == 2 then sibling_index = node.index end
    end
end
for _, fact in ipairs root.completion_relations do
    if v.Operand.is(fact.operand, v.BlockArgument) then member_fact = fact; break end
end
assert(fresh_index and sibling_index and member_fact)
local change_members = do(change)
    local relations = {}
    for _, fact in ipairs root.completion_relations do
        if fact == member_fact then
            local members = {}
            for _, member in ipairs fact.members do
                local next_member = change member
                if next_member then members[#members + 1] = next_member end
            end
            fact = v.CompletionFact { ..fact, .members }
        end
        relations[#relations + 1] = fact
    end
    return v.Definition { ..root, completion_relations = relations }
end
local lost = change_members do(member) if member.index.value ~= fresh_index.value then return member end end
bad "lost empty obligation after join" "component lost a completion obligation" do()
    boundary.ledger_for_inputs lost ({ choice = true, swap = false }) 64
end
local stolen = change_members do(member)
    return member.index.value == fresh_index.value and v.CompletionMember { ..member, guard = yes } or member
end
bad "stolen sibling obligation without payload" "component stole another completion obligation" do()
    boundary.ledger_for_inputs stolen ({ choice = true, swap = true }) 64
end
local wrong_edge = do(edge)
    local target
    for _, block in ipairs root.blocks do if block.identity == edge.target then target = block end end
    local first, second
    for index, argument in ipairs target.arguments do
        if argument == member_fact.members[1].guard then first = index end
        if argument == member_fact.members[2].guard then second = index end
    end
    if not first or not second then return edge end
    local arguments = copy edge.arguments
    arguments[first], arguments[second] = arguments[second], arguments[first]
    return v.Edge { ..edge, .arguments }
end
local ending = v.Terminator.pass "mutate correlation" with
    Jump = do(node, recurse) = v.Jump { ..node, edge = wrong_edge node.edge }
    Branch = do(node, recurse) = v.Branch with ..node
        when_true = wrong_edge node.when_true
        when_false = wrong_edge node.when_false
    end
    Return = do(node, recurse) = node
    Trap = do(node, recurse) = node
end
local blocks = {}
for _, block in ipairs root.blocks do blocks[#blocks + 1] = v.Block with ..block
    terminator = ending block.terminator
end end
local wrong = v.Definition { ..root, .blocks }
bad "owner and guard take different edges" "completion relation does not cover current header" do()
    boundary.ledger_for_inputs wrong ({ choice = true, swap = false }) 64
end
local missing = nodes root do(node)
    if v.Instruction.is(node, v.Call) and node.callee == boundary.replace.identity .. ".regions" then
        local arguments = copy node.arguments
        table.remove arguments
        node = v.Call { ..node, .arguments }
    end
    return { node }
end
bad "missing native position" "native call arity mismatch" do() boundary.ledger_for_inputs missing ({ choice = true,
            swap = false }) 64 end
local alias = nodes root do(node)
    if v.Instruction.is(node, v.Call) and node.callee == boundary.replace.identity .. ".regions" then
        local arguments = copy node.arguments
        arguments[#arguments] = sibling_index
        node = v.Call { ..node, .arguments }
    end
    return { node }
end
bad "fresh region aliases live sibling" "nonrecursive fresh region clips a caller holding" do() boundary.ledger_for_inputs alias ({ choice = true,
            swap = false }) 64 end
local capture
for _, item in ipairs root.captures do if item.index.value == fresh_index.value then capture = item end end
local capture_node
for _, block in ipairs root.blocks do
    for _, node in ipairs block.instructions do if v.Instruction.is(node, v.StackTop) and node.result == capture.mark then capture_node = node end end
end
local late = nodes root do(node)
    if node == capture_node then return {} end
    if v.Instruction.is(node, v.Call) and node.callee == boundary.replace.identity .. ".regions" then return { node,
            capture_node } end
    return { node }
end
bad "capture after native acquisition despite dominance" "call invents a region outside its boundary" do() boundary.ledger_for_inputs late ({ choice = false,
            swap = false }) 64 end
local omitted = nodes root do(node)
    if v.Instruction.is(node, v.StackWrite) and node.index.value == fresh_index.value then return {} end
    return { node }
end
bad "unused reservation abandoned" "completion lost or duplicated" do() boundary.ledger_for_inputs omitted ({ choice = true,
            swap = false }) 64 end
local duplicated = nodes root do(node)
    if v.Instruction.is(node, v.StackWrite) and node.index.value == fresh_index.value then return { node,
            node } end
    return { node }
end
bad "empty reservation completed twice" "frame has no completion authority" do() boundary.ledger_for_inputs duplicated ({ choice = true,
            swap = false }) 64 end
local mismarked = nodes root do(node)
    if v.Instruction.is(node, v.StackWrite) and node.index.value == fresh_index.value then node = v.StackWrite with ..node
        top = root.captures[1].mark
    end end
    return { node }
end
bad "another region's original mark" "restore replaced original boundary mark" do() boundary.ledger_for_inputs mismarked ({ choice = true,
            swap = false }) 64 end

local recursive = cyclic[1].definition
local child = recursive.callees[1]
local mutate_child = do(replacement)
    return v.Definition { ..recursive, callees = { replacement } }
end
local local_mark = v.Result { identity = "forged.mark", native_type = "U64" }
local observed = nodes child do(node)
    if v.Instruction.is(node, v.BeginOwned) then
        return { v.StackTop with
            result = local_mark
            role = "forged"
            index = child.regions[1]
            at = "recapture"
        end, node }
    end
    return { node }
end
local unauthorized = nodes observed do(node)
    if v.Instruction.is(node, v.EndOwned) then
        return { node,
            v.StackWrite with
                role = "forged"
                index = child.regions[1]
                top = local_mark
                at = "callee reset"
            end }
    end
    return { node }
end
