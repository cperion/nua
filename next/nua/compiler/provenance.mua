-- Component/place provenance. Payload and wildcard paths are facts, not addresses. All
-- resident borrows have Stored(None); only a load can bind them to an SSA observation.
local data = require "nua.compiler.data"
local types = require "nua.types"
local identity = require "nua.identity"
local paths = require "nua.compiler.borrow_paths"
local rules = require "nua.compiler.rules"

-- the key, the access step and the component of each step kind: passes over the closed families
local ComponentKeys = define
    FieldComponent = |step, recurse| -> "f:" .. ("%q"):format(step.name)
    AlternativeComponent = |step, recurse| -> "a:" .. ("%q"):format(step.name)
    PayloadComponent = |step, recurse| -> "payload"
    AnyElementComponent = |step, recurse| -> "*"
    ElementComponent = |step, recurse| -> data.Operand.is(step.index, data.Constant) and ("i:" .. tostring(step.index.bits.bits)) or "*"
end
local key_of_component = data.Component.pass "key a component step" with ..ComponentKeys end
local component_key = do(path)
    local parts = {}
    for _, step in ipairs path do parts[#parts + 1] = key_of_component step end
    return table.concat(parts, "/")
end

local ComponentsOfSteps = define
    FieldStep = |step, recurse| -> data.FieldComponent { name = step.name }
    AlternativeStep = |step, recurse| -> data.AlternativeComponent { name = step.name }
    ContentsStep = |step, recurse| -> data.PayloadComponent {}
    AnyElement = |step, recurse| -> data.AnyElementComponent {}
    KnownElement = |step, recurse| -> data.ElementComponent { index = rules.integer(types.U64, step.index) }
end
local component_of_step = data.AccessStep.pass "the component an access step names" with ..ComponentsOfSteps end
local components = do(access)
    local result = {}
    for _, step in ipairs access do result[#result + 1] = component_of_step step end
    return result
end

local StepsOfComponents = define
    FieldComponent = |step, recurse| -> data.FieldStep { name = step.name }
    AlternativeComponent = |step, recurse| -> data.AlternativeStep { name = step.name }
    PayloadComponent = |step, recurse| -> data.ContentsStep {}
    AnyElementComponent = |step, recurse| -> data.AnyElement {}
    ElementComponent = do(step, recurse)
        if data.Operand.is(step.index, data.Constant) then return data.KnownElement { index = tonumber(step.index.bits.bits) } end
        return data.AnyElement {}
    end
end
local step_of_component = data.Component.pass "the access step a component names" with ..StepsOfComponents end
local access_path = do(path)
    local result = {}
    for _, step in ipairs path do result[#result + 1] = step_of_component step end
    return result
end
local concat = do(first, second)
    local result = {}
    for _, step in ipairs first do result[#result + 1] = step end
    for _, step in ipairs second do result[#result + 1] = step end
    return result
end
local root_places = setmetatable({}, { __mode = "k" })
local base_place = do(place, places)
    if #place.path == 0 then return place.id end
    local found = root_places[place.root]
    if found and places[found] then return found end
    for id, candidate in pairs places do
        if candidate.root == place.root and #candidate.path == 0 then root_places[place.root] = id; return id end
    end
    error("provenance: a component place has no declared root", 0)
end
local accesses = do(place, places, borrows)
    local result = {}
    local suffix = access_path place.path
    if data.PlaceRoot.is(place.root, data.IndirectRoot) then
        for _, origin in ipairs assert(borrows[place.root.borrow]).origins do
            result[#result + 1] = data.Access { place = origin.place, path = concat(origin.path, suffix) }
        end
    elseif not data.PlaceRoot.is(place.root, data.RawRoot) then
        result[1] = data.Access { place = base_place(place, places), path = suffix }
    end
    return result
end
local borrowed = do(info)
    local result = {}
    for _, component in pairs info.components do
        if data.ComponentInfo.is(component, data.Borrowed) then result[#result + 1] = component.borrow end
    end
    return result
end
local is_payload = do(path)
    for _, component in ipairs path do if data.Component.is(component, data.PayloadComponent) then return true end end
    return false
end
-- the components of a value's facts, by key
local by_key = do(info)
    local indexed = {}
    for path, component in pairs info.components do indexed[component_key path] = component end
    return indexed
end
-- each borrowed component of `destination` whose key `source` also borrows at:
-- act(destination's component, source's component)
local each_borrowed_pair = do(destination, source, act)
    local sources = by_key source
    for path, part in pairs destination.components do
        local from = sources[component_key path]
        if from and data.ComponentInfo.is(part, data.Borrowed) and data.ComponentInfo.is(from, data.Borrowed) then act(part, from) end
    end
end
-- each pair of references at the same position in two native values (the value an edge
-- carries and the one its target receives): act(source's borrow, target's borrow)
local each_reference_pair
each_reference_pair = do(source, target, act)
    if data.NativeValue.is(source, data.Reference) and data.NativeValue.is(target, data.Reference) then
        act(source.borrow, target.borrow)
    elseif data.NativeValue.is(source, data.Aggregate) and data.NativeValue.is(target, data.Aggregate) then
        for name, part in pairs target.parts do
            if source.parts[name] then each_reference_pair(source.parts[name], part, act) end
        end
    end
end
-- whether an extraction along `path` reads the component at `key`: a payload component is never
-- read, and the key agrees with the path as far as both go
local extracted_by = do(path, key)
    if is_payload key then return false end
    for position = 1, math.min(#key, #path) do
        local a, b = key[position], path[position]
        if getmetatable a ~= getmetatable b or a.name ~= b.name then return false end
    end
    return true
end
local plain = native_type -> data.ValueInfo { type = native_type, components = types.owns(native_type) and { [{}] = data.Owning {} } or {}, proofs = {} }
local same_origins = do(a, b)
    local left, right = paths.union({}, a), paths.union({}, b)
    if #left ~= #right then return false end
    for index, origin in ipairs left do
        if origin.place ~= right[index].place or component_key(components(origin.path)) ~= component_key(components(right[index].path)) then return false end
    end
    return true
end
local same_info = do(a, af, b, bf, registry)
    local indexed = {}
    for path, part in pairs a.components do indexed[component_key path] = part end
    local count = 0
    for path, part in pairs b.components do
        count += 1
        local previous = indexed[component_key path]
        if previous == nil or getmetatable(previous) ~= getmetatable(part) then return false end
        if data.ComponentInfo.is(part, data.Borrowed) then
            if not same_origins(registry[previous.borrow].origins, registry[part.borrow].origins) then return false end
            local left, right = af.borrows[previous.borrow], bf.borrows[part.borrow]
            if left == nil or right == nil or getmetatable(left) ~= getmetatable(right) or left.reason ~= right.reason then return false end
        end
    end
    local other = 0
    for _ in pairs indexed do other += 1 end
    return count == other
end
local is_memory = place -> place ~= nil and #place.path > 0
local value_info
value_info = do(value, lookup)
    if data.NativeValue.is(value, data.Reference) then return data.ValueInfo { type = value.type, components = { [{}] = data.Borrowed { borrow = value.borrow } }, proofs = {} } end
    if data.NativeValue.is(value, data.Aggregate) then
        local components = types.NativeType.is(value.type, types.BufferType) and { [{}] = data.Owning {} } or {}
        local packed = value.packed and lookup and lookup(value.packed)
        if packed then for key, part in pairs packed.components do components[key] = part end end
        for name, part in pairs value.parts do
            for key in pairs components do if key[1] and data.Component.is(key[1], data.FieldComponent) and key[1].name == name then components[key] = nil end end
            for key, component in pairs value_info(part, lookup).components do components[concat({ data.FieldComponent { .name } }, key)] = component end
        end
        return data.ValueInfo { type = value.type, .components, proofs = {} }
    end
    return value.operand and lookup and not data.Operand.is(value.operand, data.Constant) and lookup(value.operand) or plain(value.type)
end

-- whether an access names some element of a buffer rather than a known one
local any_element = do(access)
    for _, step in ipairs access.path do
        if data.AccessStep.is(step, data.AnyElement) then return true end
    end
    return false
end
-- whether storing through these accesses may leave what was there: when they are several, or
-- one is any element, the store is weak and the old contents join the new
local weak_store = do(targets)
    if #targets > 1 then return true end
    for _, target in ipairs targets do
        if any_element target then return true end
    end
    return false
end
-- the components of a value's facts under a component prefix, keyed by the rest of their path
local components_under = do(info, prefix)
    local selected = {}
    for key, part in pairs info.components do
        local match = #key >= #prefix
        for index, step in ipairs prefix do
            if not key[index] or getmetatable key[index] ~= getmetatable step or key[index].name ~= step.name then match = false end
        end
        if match then
            local rest = {}
            for index = #prefix + 1, #key do rest[#rest + 1] = key[index] end
            selected[rest] = part
        end
    end
    return selected
end

-- The memory facts of one activity (a stateful vocabulary, writing compilers §4.6): what
-- storage reached through borrows holds, as resident value facts on interned places. Its
-- capabilities are the activity's registries and supply, the borrow tracking, and the path
-- overlap it decides with.
local working = do(compilation, tracking, overlap)
    local registry, places, fresh = compilation.borrows, compilation.places, compilation.supply.fresh
    local interned = {}
    -- the place standing for the storage an access names, one per access, declared to `writer`
    local intern = do(access, native_type, writer)
        local path = components access.path
        local key = access.place.serial .. ":" .. component_key(path)
        local place = interned[key]
        if place == nil and #path == 0 then place = assert(places[access.place]); interned[key] = place end
        if place == nil then
            local base = assert(places[access.place])
            place = data.Place { id = fresh(identity.PlaceId), type = native_type, root = base.root, .path, lifetime = base.lifetime, origin = base.origin }
            interned[key], places[place.id] = place, place
        end
        if writer and not writer.has_place(place.id) then writer.declare(place) end
        return place
    end
    -- a stored borrow resident in memory, joining the origins of `infos`; ended if any of
    -- their `states` ended
    local resident_borrow = do(flow, infos, states, acquired)
        local origins, state, mutable = {}, data.Live {}, true
        for index, info in ipairs infos do
            origins = paths.union(origins, info.origins)
            mutable = mutable and info.mutable
            if states[index] and data.BorrowState.is(states[index], data.Ended) then state = states[index] end
        end
        local info = data.BorrowInfo { ..infos[1], id = fresh(identity.BorrowId), form = data.Stored {}, .origins, .mutable, acquired = acquired or infos[1].acquired }
        registry[info.id], flow.borrows[info.id] = info, state
        return info.id
    end
    -- the facts of several rows ({ info, flow }) joined component by component, each borrowed
    -- component a resident borrow in `destination`
    local merge_info = do(rows, destination, acquired)
        local groups, result = {}, {}
        for _, row in ipairs rows do
            for path, part in pairs row.info.components do
                local key = component_key path
                local group = groups[key]
                if group == nil then group = { .path, .part, infos = {}, states = {} }; groups[key] = group end
                if data.ComponentInfo.is(part, data.Borrowed) then
                    group.infos[#group.infos + 1] = registry[part.borrow]
                    group.states[#group.states + 1] = assert(row.flow.borrows[part.borrow], "resident borrow has no state")
                end
            end
        end
        for _, group in pairs groups do
            result[group.path] = #group.infos > 0 and data.Borrowed { borrow = resident_borrow(destination, group.infos, group.states, acquired) } or group.part
        end
        return data.ValueInfo { type = rows[1].info.type, components = result, proofs = {} }
    end
    -- an owner's value facts with what its memory holds: its own components but payloads, and
    -- the resident contents of storage it roots
    local capture = do(flow, owner, info)
        local parts = {}
        for key, part in pairs info.components do
            if not is_payload key then parts[key] = part end
        end
        for id, contents in pairs flow.contents do
            if places[id] and is_memory(places[id]) and data.Contents.is(contents, data.Resident) then
                for _, access in ipairs accesses(places[id], places, registry) do
                    if access.place == owner then
                        local prefix = components(access.path)
                        for key, part in pairs contents.info.components do parts[concat(prefix, key)] = part end
                    end
                end
            end
        end
        return data.ValueInfo { type = info.type, components = parts, proofs = {} }
    end
    -- a buffer's payload components grouped by element: each group is the facts of one
    -- element's storage, at its access path
    local payloads = do(info)
        local groups = {}
        for key, part in pairs info.components do
            local type, prefix = info.type, {}
            for index, step in ipairs key do
                prefix[#prefix + 1] = step
                if data.Component.is(step, data.FieldComponent) and types.NativeType.is(type, types.RecordType) then
                    for _, field in ipairs type.fields do if field.name == step.name then type = field.type; break end end
                elseif data.Component.is(step, data.PayloadComponent) and types.NativeType.is(type, types.BufferType) and key[index + 1] then
                    prefix[#prefix + 1] = key[index + 1]
                    local name = component_key(prefix)
                    local group = groups[name] or { path = access_path(prefix), info = data.ValueInfo { type = type.element, components = {}, proofs = {} } }
                    local rest = {}
                    for position = index + 2, #key do rest[#rest + 1] = key[position] end
                    group.info.components[rest] = part
                    groups[name] = group
                    break
                end
            end
        end
        return groups
    end
    -- `info` stored through the targets: the facts of each target's storage
    local store = do(path, targets, info, acquired)
        local weak = #targets > 1
        for _, target in ipairs targets do
            local place = intern(target, info.type, path.writer)
            local rows = { { .info, flow = path.flow } }
            weak = weak or any_element target
            local old = path.flow.contents[place.id]
            if weak and old and data.Contents.is(old, data.Resident) then rows[#rows + 1] = { info = old.info, flow = path.flow } end
            path.flow.contents[place.id] = data.Resident { info = merge_info(rows, path.flow, acquired) }
        end
    end
    -- the rows of facts that tracked or resident contents overlapping `target` contribute: the
    -- contents of exactly that storage, or the components under the target's remaining path
    local overlapping_rows = do(flow, target, native_type, writer, rows)
        for id, candidate in pairs flow.contents do
            local place = places[id]
            local resident = data.Contents.is(candidate, data.Resident)
            if place and (resident or data.Contents.is(candidate, data.Tracked)) then
                local access = accesses(place, places, registry)[1]
                if access and access.place == target.place and overlap(access.path, target.path) and #access.path <= #target.path then
                    local info = resident and candidate.info or value_info(candidate.value, writer and writer.information)
                    local suffix = {}
                    for index = #access.path + 1, #target.path do suffix[#suffix + 1] = target.path[index] end
                    if #suffix == 0 then
                        if info.type == native_type then rows[#rows + 1] = { .info, .flow } end
                    else
                        local selected = components_under(info, components suffix)
                        if next selected then rows[#rows + 1] = { info = data.ValueInfo { type = native_type, components = selected, proofs = {} }, .flow } end
                    end
                end
            end
        end
    end
    -- what memory holds at the targets, as one value's facts; nil when nothing is known
    local read = do(flow, targets, native_type, writer)
        local rows = {}
        for _, target in ipairs targets do
            local exact = interned[target.place.serial .. ":" .. component_key(components(target.path))]
            local contents = exact and flow.contents[exact.id]
            if not any_element target and contents and data.Contents.is(contents, data.Resident) then
                rows[#rows + 1] = { info = contents.info, .flow }
            else
                overlapping_rows(flow, target, native_type, writer, rows)
            end
        end
        if #rows == 0 then return nil end
        return merge_info(rows, flow)
    end
    -- memory after several paths join: storage resident on every path (or memory on any)
    -- holds the join of what each path has there
    local agree = do(flows, destination, lookup)
        local ids = {}
        for _, flow in ipairs flows do
            for id, contents in pairs flow.contents do
                if places[id] and data.Contents.is(contents, data.Resident) then
                    local present = true
                    for _, incoming in ipairs flows do if incoming.contents[id] == nil then present = false end end
                    if is_memory(places[id]) or present then ids[id] = true end
                end
            end
        end
        for id in pairs ids do
            local rows = {}
            for _, flow in ipairs flows do
                local contents = flow.contents[id]
                if contents and data.Contents.is(contents, data.Resident) then rows[#rows + 1] = { info = contents.info, .flow }
                elseif contents and data.Contents.is(contents, data.Tracked) then rows[#rows + 1] = { info = value_info(contents.value, lookup), .flow } end
            end
            destination.contents[id] = data.Resident { info = merge_info(rows, destination) }
        end
    end
    -- whether two flows have the same memory facts
    local same = do(left, right)
        for _, pair in ipairs { { left, right }, { right, left } } do
            for id, contents in pairs pair[1].contents do
                if places[id] and data.Contents.is(contents, data.Resident) then
                    local other = pair[2].contents[id]
                    if not (other and data.Contents.is(other, data.Resident) and same_info(contents.info, pair[1], other.info, pair[2], registry)) then return false end
                end
            end
        end
        return true
    end
    -- a flow starting with the memory facts of `schema`, under borrows of its own
    local seed = do(schema, destination, writer)
        for id, contents in pairs schema.contents do
            if places[id] and data.Contents.is(contents, data.Resident) then
                if writer and not writer.has_place(id) then writer.declare(places[id]) end
                destination.contents[id] = data.Resident { info = merge_info({ { info = contents.info, flow = schema } }, destination) }
            end
        end
    end
    -- what memory holds at or under `target` is no longer known
    local forget = do(flow, target)
        for id in pairs flow.contents do
            local place = places[id]
            if place and is_memory(place) then
                local access = accesses(place, places, registry)[1]
                if access and access.place == target.place and #access.path >= #target.path and overlap(access.path, target.path) then flow.contents[id] = nil end
            end
        end
    end
    return define
        .intern
        .resident_borrow
        .merge_info
        .capture
        .payloads
        .store
        .read
        .agree
        .same
        .seed
        .forget
    end
end
return define
    key = component_key
    .by_key
    .each_borrowed_pair
    .each_reference_pair
    .extracted_by
    .weak_store
    .components_under
    .components
    .access_path
    .concat
    .base_place
    .accesses
    .borrowed
    .is_payload
    .plain
    .same_origins
    .same_info
    .is_memory
    .value_info
    .working
end
