-- Publish construction-owned facts for a sealed definition. No compiler-wide registry is
-- copied: rejected branches/rounds and other definitions cannot leak into this product.
local data = require "nua.compiler.data"
local types = require "nua.types"
local graph = require "nua.compiler.graph"
local verify = require "nua.compiler.verify"
local effects = require "nua.compiler.effects"
local provenance = require "nua.compiler.provenance"

local plain = provenance.plain

-- the facts of an instruction's result, inferred from its kind where its operands' facts carry
-- through: a record pack nests each part's components under its field, an extraction takes
-- the components under its path. Answers its type and components; nil leaves the result plain
-- at the instruction's own type.
local Inferring = define ..graph.Inert
    Load = do(instruction, recurse, definition, information)
        return definition.places[instruction.place].type, {}
    end
    Address = do(instruction, recurse, definition, information)
        return types.pointer(definition.places[instruction.place].type), {}
    end
    Pack = do(instruction, recurse, definition, information)
        local native_type, components = instruction.type, {}
        if not types.NativeType.is(native_type, types.RecordType) then return native_type, components end
        for index, operand in ipairs instruction.components do
            for path, part in pairs(information(operand).components) do
                local nested = { data.FieldComponent { name = native_type.fields[index].name } }
                for _, step in ipairs path do nested[#nested + 1] = step end
                components[nested] = part
            end
        end
        return native_type, components
    end
    Extract = do(instruction, recurse, definition, information)
        return instruction.type, provenance.components_under(information(instruction.aggregate), instruction.path)
    end
end
local inferred = data.Instruction.pass "the facts of an instruction's result" with ..Inferring end

local publish = do(definition, fragment)
    local values = {}
    for key, info in pairs fragment.values do values[key] = info end
    local information = do(operand)
        if data.Operand.is(operand, data.Constant) then return plain operand.type end
        local key = data.operand_key operand
        if values[key] == nil then values[key] = plain operand.type end
        return values[key]
    end
    -- Remember the facts of representation assembly, not just the scalar operands. The
    -- evaluator's explicit reference facts take precedence over representation inference.
    for index, native_type in ipairs definition.signature.parameters do
        information(data.Parameter { definition = definition.id, .index, type = native_type })
    end
    for _, block in ipairs definition.blocks do
        for index, argument in ipairs block.arguments do
            information(data.BlockArgument { block = block.id, .index, type = argument.type })
        end
        for _, instruction in ipairs block.instructions do
            for _, operand in ipairs(verify.operands_of instruction) do information operand end
            if instruction.result and values[instruction.result] == nil then
                local native_type, components = inferred(instruction, definition, information)
                if native_type == nil then native_type, components = instruction.type, {} end
                if native_type then
                    values[instruction.result] = next(components) and data.ValueInfo { type = native_type, .components, proofs = {} } or plain(native_type)
                end
            end
        end
        for _, operand in ipairs(verify.terminator_operands block.terminator) do information operand end
    end
    local edges, joins, terminators = {}, {}, {}
    for _, block in ipairs definition.blocks do
        local terminator = block.terminator
        terminators[block.id] = effects.ending(terminator)
        for _, edge in ipairs(graph.edges_of terminator) do
            local arguments = {}
            for index, operand in ipairs edge.arguments do arguments[index] = information operand end
            local row = data.EdgeFacts { edge = edge.id, flow = assert(fragment.terminal_flows[block.id]), .arguments }
            edges[edge.id] = row
            local join = joins[edge.target]
            if join == nil then
                join = data.JoinRelation { block = edge.target, incoming = {} }
                joins[edge.target] = join
            end
            join.incoming[#join.incoming + 1] = row
        end
    end
    return data.DefinitionFacts {
        .values, borrows = fragment.borrows, entries = fragment.entries,
        .edges, .joins, sites = fragment.sites, .terminators,
    }
end
-- The facts of a definition a rewrite changed, rebuilt from those of the definition it came
-- from. `renaming` maps the key of an operand that moved to its new operand, or `false` if it is
-- gone. Snapshots survive with their sites and blocks; what depends on the graph (edge rows,
-- joins, terminator effects, the facts of new results) is derived again by `publish`. A snapshot
-- is provenance at its own point: no consumer reads an operand out of it after evaluation.
local recompute = do(definition, previous, renaming)
    local values, defined = {}, {}
    for index, native_type in ipairs definition.signature.parameters do
        defined[data.operand_key(data.Parameter { definition = definition.id, .index, type = native_type })] = true
    end
    local entries, sites, terminal_flows = {}, {}, {}
    for _, block in ipairs definition.blocks do
        entries[block.id] = previous.entries[block.id]
        for index, argument in ipairs block.arguments do
            defined[data.operand_key(data.BlockArgument { block = block.id, .index, type = argument.type })] = true
        end
        local first_edge = graph.edges_of(block.terminator)[1]
        local ending = first_edge and previous.edges[first_edge.id] and previous.edges[first_edge.id].flow
        for _, instruction in ipairs block.instructions do
            -- an instruction a pass added (a budget point) observes the flow its block ends with
            sites[instruction.site.id] = previous.sites[instruction.site.id]
                or (ending and data.SiteFacts { before = ending, after = ending, effects = effects.of instruction })
            if instruction.result then defined[instruction.result] = true end
        end
        if first_edge then terminal_flows[block.id] = previous.edges[first_edge.id].flow end
    end
    for key, info in pairs previous.values do
        local moved = renaming and renaming[key]
        if moved then
            values[data.operand_key moved] = info
        elseif moved == nil and defined[key] then
            values[key] = info
        end
    end
    return publish(definition, define
        .values
        borrows = previous.borrows
        .entries
        .sites
        .terminal_flows
    end)
end

return define
    .publish
    .recompute
end
