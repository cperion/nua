-- The C backend: a ready program as C text. An instruction pass and a terminator pass answer
-- statements; every value and block parameter is declared at the top of its function, so a
-- `goto` never enters the scope of a declaration. Edge arguments are assigned at once, through
-- temporaries. Narrow integers compute in 32 bits and are cast back to their width, so C's
-- promotions cannot introduce undefined behaviour (syntax §7.1); a residual operation is
-- otherwise the C operation itself.

local bit = require "bit"
local types = require "nua.types"
local data = require "nua.compiler.data"
local graph = require "nua.compiler.graph"
local rules = require "nua.compiler.rules"
local platform = require "nua.compiler.platform"
local verify = require "nua.compiler.verify"

local NativeType, Instruction, Terminator, Operand = types.NativeType, data.Instruction, data.Terminator, data.Operand

local fail = message -> error("C backend: " .. message, 2)

-- records are named once per process, so the C types of separate compilations never clash
-- (a host declaring them through the FFI cannot redefine a struct)
local record_names = setmetatable({}, { __mode = "k" })
local record_count = 0
local record_name = do(record)
    local found = record_names[record]
    if found then return found end
    record_count += 1
    local base_name = NativeType.is(record, types.BufferType) and "Buffer" or NativeType.is(record, types.ViewType) and "View" or (record.name:gsub("[^%w_]", "_"))
    found = ("%s_%d"):format(base_name, record_count)
    record_names[record] = found
    return found
end

local unsupported = |node, recurse| -> fail(types.describe node .. " has no C spelling yet")
local CSpelling = define
    IntegerType = |node, recurse| -> (node.signed and "int" or "uint") .. node.bits .. "_t"
    FloatType = |node, recurse| -> node.bits == 32 and "float" or "double"
    BooleanType = |node, recurse| -> "bool"
    UnitType = |node, recurse| -> "void"
    PointerType = |node, recurse| -> recurse node.target .. " *"
    ReferenceType = |node, recurse| -> recurse node.target .. " *"
    ViewType = |node, recurse| -> record_name node
    FixedArrayType = unsupported
    RecordType = |node, recurse| -> record_name node
    SumType = |node, recurse| -> record_name node
    BufferType = |node, recurse| -> record_name node
    FunctionType = unsupported
end
local c_type = NativeType.pass "spell a native type in C" with ..CSpelling end

-- the fields of a type C spells as a struct: a record's, a buffer's header's, a view's; every
-- other type has none
local no_fields = |node, recurse| -> nil
local Fields = define
    IntegerType = no_fields
    FloatType = no_fields
    BooleanType = no_fields
    UnitType = no_fields
    PointerType = no_fields
    ReferenceType = no_fields
    ViewType = |node, recurse| -> { { name = "data", type = types.pointer node.element }, { name = "length", type = types.U64 } }
    FixedArrayType = no_fields
    RecordType = |node, recurse| -> node.fields
    SumType = no_fields
    BufferType = do(node, recurse)
        local fields = {
            { name = "data", type = types.pointer node.element },
            { name = "length", type = types.U64 },
            { name = "capacity", type = types.U64 },
        }
        if node.pinned then fields[4] = { name = "limit", type = types.U64 } end
        return fields
    end
    FunctionType = no_fields
end
local fields_of = NativeType.pass "the fields of a type C spells as a struct" with ..Fields end
local is_record_like = native_type -> fields_of native_type ~= nil
local is_sum = native_type -> NativeType.is(native_type, types.SumType)
-- the C name of a sum's tag constant for an alternative
local tag_name = |sum_type, name| -> record_name sum_type .. "_" .. name
-- a sum in C (syntax §11.1): its tag constants, then a tag and a union of the payloads that are
-- not Unit (no union when none has a payload)
local sum_declaration = do(sum_type)
    local name = record_name sum_type
    local constants, members = {}, {}
    for index, alternative in ipairs sum_type.alternatives do
        constants[#constants + 1] = ("%s = %d"):format(tag_name(sum_type, alternative.name), index - 1)
        if alternative.payload ~= types.Unit then members[#members + 1] = ("%s %s;"):format(c_type alternative.payload, alternative.name) end
    end
    local union = #members > 0 and (" union { %s } as;"):format(table.concat(members, " ")) or ""
    return ("enum { %s };\ntypedef struct %s { uint32_t tag;%s } %s;"):format(table.concat(constants, ", "), name, union, name)
end

-- the C declarations of the records a program uses, each after the records it holds
local record_declarations = do(program)
    local done, order = {}, {}
    local visit
    visit = do(native_type)
        if NativeType.is(native_type, types.PointerType) or NativeType.is(native_type, types.ReferenceType) then return visit(native_type.target) end
        if is_sum native_type and not done[native_type] then
            done[native_type] = true
            for _, alternative in ipairs native_type.alternatives do visit(alternative.payload) end
            order[#order + 1] = sum_declaration native_type
            return
        end
        if not is_record_like native_type or done[native_type] then return end
        done[native_type] = true
        for _, field in ipairs(fields_of native_type) do visit(field.type) end
        local fields = {}
        for _, field in ipairs(fields_of native_type) do fields[#fields + 1] = ("%s %s;"):format(c_type field.type, field.name) end
        order[#order + 1] = ("typedef struct %s { %s } %s;"):format(record_name native_type, table.concat(fields, " "), record_name native_type)
    end
    for _, definition in ipairs(graph.definitions_in_order program) do
        for _, parameter in ipairs definition.signature.parameters do visit(parameter) end
        visit(definition.signature.result)
        for _, block in ipairs definition.blocks do
            for _, argument in ipairs block.arguments do visit(argument.type) end
            for _, instruction in ipairs block.instructions do
                if instruction.type then visit(instruction.type) end
            end
        end
    end
    return order
end

local narrow = type -> rules.is_integer type and type.bits < 32
local wide_of = type -> type.signed and "int32_t" or "uint32_t"

-- a constant as a C expression of its exact type: a pass over the kinds of its bits
local is_pointer_like = native_type -> rules.is_pointer native_type or NativeType.is(native_type, types.ReferenceType)
local integer_text = do(constant)
    local type = constant.type
    if is_pointer_like type then
        if constant.bits.bits ~= 0ULL then fail "a pointer constant other than null has no C spelling" end
        return ("((%s)0)"):format(c_type type)
    end
    local value = rules.integer_value constant
    local digits = tostring(value):gsub("U?LL$", "")
    if not type.signed then
        if type.bits == 64 then return "UINT64_C(" .. digits .. ")" end
        if type.bits == 32 then return digits .. "u" end
        return ("(%s)%su"):format(c_type type, digits)
    end
    local minimum = -bit.lshift(1LL, type.bits - 1)
    if type.bits == 64 then
        if value == minimum then return "INT64_MIN" end
        return "INT64_C(" .. digits .. ")"
    end
    if value == minimum then return ("(%s)(%s - 1)"):format(c_type type, tostring(value + 1):gsub("LL$", "")) end
    if type.bits == 32 then return value < 0 and "(" .. digits .. ")" or digits end
    return ("(%s)%s"):format(c_type type, digits)
end
local float_text = do(constant)
    local value, single = constant.bits.value, constant.type.bits == 32
    if value ~= value then return single and "NAN" or "(double)NAN" end
    if value == math.huge then return single and "INFINITY" or "(double)INFINITY" end
    if value == -math.huge then return single and "(-INFINITY)" or "(-(double)INFINITY)" end
    local text = ("%.17g"):format(value)
    if not text:find("[%.eEn]") then text = text .. ".0" end
    return single and text .. "f" or text
end
-- bytes as a C string literal: printable ASCII as itself, every other byte in octal (an octal
-- escape takes at most three digits, so a following digit never joins it)
local c_string = do(bytes)
    local parts = {}
    for index = 1, #bytes do
        local byte = bytes:byte index
        if byte >= 32 and byte < 127 and byte ~= 34 and byte ~= 92 and byte ~= 63 then parts[index] = string.char byte
        else parts[index] = ("\\%03o"):format(byte) end
    end
    return '"' .. table.concat parts .. '"'
end
local unspelled_constant = do(bits, recurse, constant)
    if is_pointer_like constant.type then fail "a pointer constant other than null has no C spelling" end
    fail("a constant of " .. types.describe constant.type .. " has no C spelling yet")
end
local constant_text
local Constants = define
    IntegerBits = |bits, recurse, constant| -> integer_text constant
    FloatBits = |bits, recurse, constant| -> float_text constant
    BooleanBit = |bits, recurse, constant| -> bits.value and "true" or "false"
    UnitBits = |bits, recurse, constant| -> "0"
    AggregateBits = do(bits, recurse, constant)
        local parts = {}
        for index, field in ipairs(fields_of constant.type) do
            parts[index] = constant_text(data.Constant { type = field.type, bits = bits.parts[index] })
        end
        return ("((%s){ %s })"):format(c_type constant.type, table.concat(parts, ", "))
    end
    StaticBytes = unspelled_constant
    SymbolAddress = unspelled_constant
    StaticAddress = |bits, recurse, constant| -> ("((%s)%s + %d)"):format(c_type constant.type, c_string bits.bytes, bits.offset)
    DefinitionAddress = unspelled_constant
end
local constant_bits_text = data.NativeConstant.pass "spell a constant in C" with ..Constants end
constant_text = constant -> constant_bits_text(constant.bits, constant)

local binary_symbols = define
    add = "+"
    subtract = "-"
    multiply = "*"
    divide = "/"
    remainder = "%"
    bit_and = "&"
    bit_or = "|"
    bit_xor = "^"
    shift_left = "<<"
    shift_right_signed = ">>"
    shift_right_unsigned = ">>"
    equal = "=="
    not_equal = "!="
    less = "<"
    less_equal = "<="
end

-- one definition's C function (a stateful vocabulary, writing compilers §4.6): the names of
-- its values, blocks and local homes, and the declarations they need, belong to it
local emit_definition = do(definition, c_name, program, names_of_definitions)
    local names = {}
    local declarations = {}
    local value_count, block_count = 0, 0
    local value_name = do(id, type)
        local found = names[id]
        if found then return found end
        value_count += 1
        found = "v" .. value_count
        names[id] = found
        if type ~= types.Unit then declarations[#declarations + 1] = ("    %s %s;"):format(c_type type, found) end
        return found
    end
    local labels, parameters_of, blocks_by_id = {}, {}, {}
    for _, block in ipairs definition.blocks do
        blocks_by_id[block.id] = block
        block_count += 1
        labels[block.id] = "block" .. block_count
        parameters_of[block.id] = {}
        for index, parameter in ipairs block.arguments do
            local name = ("block%d_%d"):format(block_count, index)
            parameters_of[block.id][index] = name
            declarations[#declarations + 1] = ("    %s %s;"):format(c_type parameter.type, name)
        end
    end
    local operand
    -- a local that needs memory (its address crosses a call) is a C variable of its own
    local homes = {}
    local home_count = 0
    local local_home = do(place)
        local found = homes[place.id]
        if found then return found end
        home_count += 1
        found = "home" .. home_count
        homes[place.id] = found
        declarations[#declarations + 1] = ("    %s %s;"):format(c_type place.type, found)
        return found
    end
    -- the C lvalue of a place: a raw or indirect place is its pointer dereferenced
    local through_pointer = |root, recurse, place| -> "*" .. operand root.pointer
    local unspelled_root = |root, recurse, place| -> fail("a place rooted in " .. tostring(getmetatable root) .. " has no C spelling yet")
    local Lvalues = define
        LocalRoot = |root, recurse, place| -> local_home place
        GlobalRoot = unspelled_root
        ParameterRoot = |root, recurse, place| -> "(*p" .. root.parameter .. ")"
        IndirectRoot = through_pointer
        ForeignRoot = unspelled_root
        RawRoot = through_pointer
    end
    local root_lvalue = data.PlaceRoot.pass "spell a place in C" with ..Lvalues end
    -- a component place (a field of a resident record, of storage behind a pointer) is its
    -- root's lvalue followed by its path; a local one lives in its root place's home
    local root_places = {}
    local root_place = do(place)
        local found = root_places[place.root]
        if found then return found end
        for _, candidate in pairs definition.places do
            if candidate.root == place.root and #candidate.path == 0 then found = candidate end
        end
        if found == nil then fail "a component place has no root place" end
        root_places[place.root] = found
        return found
    end
    local Components = define
        FieldComponent = |component, recurse| -> "." .. component.name
        AlternativeComponent = |component, recurse| -> ".as." .. component.name
        PayloadComponent = |component, recurse| -> fail "a payload component has no C spelling as a place"
        ElementComponent = |component, recurse| -> fail "an element component has no C spelling as a place"
        AnyElementComponent = |component, recurse| -> fail "an element component has no C spelling as a place"
    end
    local component_text = data.Component.pass "spell a place component in C" with ..Components end
    local place_text = do(place)
        if #place.path == 0 then return root_lvalue(place.root, place) end
        local base = data.PlaceRoot.is(place.root, data.LocalRoot) and root_place place or place
        local text = "(" .. root_lvalue(place.root, base) .. ")"
        for _, component in ipairs place.path do text = text .. component_text component end
        return text
    end
    local Naming = define
        Constant = |node, recurse| -> constant_text node
        Parameter = |node, recurse| -> "p" .. node.index
        BlockArgument = |node, recurse| -> parameters_of[node.block][node.index]
        Result = |node, recurse| -> value_name(node.value, node.type)
    end
    operand = Operand.pass "spell an operand in C" with ..Naming end

    -- the right-hand side of each opcode, from the instruction and its operands; any other
    -- opcode is a binary operation
    local binary = do(node, a, b)
        local opcode = node.opcode
        local symbol = binary_symbols[opcode]
        if symbol == nil then fail("the opcode " .. opcode .. " has no C spelling yet") end
        if node.type == types.Bool and (opcode == "bit_and" or opcode == "bit_or" or opcode == "bit_xor") then
            return ("%s %s %s;"):format(operand a, opcode == "bit_xor" and "!=" or symbol, operand b)
        end
        if narrow node.type and node.type == a.type then
            local wide = wide_of node.type
            return ("(%s)((%s)%s %s (%s)%s);"):format(c_type node.type, wide, operand a, symbol, wide, operand b)
        end
        return ("%s %s %s;"):format(operand a, symbol, operand b)
    end
    local Opcodes = define
        convert = |node, a, b| -> ("(%s)%s;"):format(c_type node.type, operand a)
        pointer_offset = |node, a, b| -> ("%s + %s;"):format(operand a, operand b)
        pointer_difference = |node, a, b| -> ("(int64_t)(%s - %s);"):format(operand a, operand b)
        reinterpret = do(node, a, b)
            local from, to = a.type, node.type
            if is_pointer_like from and is_pointer_like to then return ("(%s)%s;"):format(c_type to, operand a) end
            if rules.is_pointer from or rules.is_pointer to then return ("(%s)(uintptr_t)%s;"):format(c_type to, operand a) end
            return ("nua_reinterpret_%s_%s(%s);"):format(c_type from, c_type to, operand a)
        end
        negate = do(node, a, b)
            if rules.is_float node.type then return "-" .. operand a .. ";" end
            if narrow node.type then return ("(%s)(-(%s)%s);"):format(c_type node.type, wide_of node.type, operand a) end
            if not node.type.signed then return ("(%s)0 - %s;"):format(c_type node.type, operand a) end
            return "-" .. operand a .. ";"
        end
        bit_not = do(node, a, b)
            if node.type == types.Bool then return "!" .. operand a .. ";" end
            if narrow node.type then return ("(%s)~(%s)%s;"):format(c_type node.type, wide_of node.type, operand a) end
            return "~" .. operand a .. ";"
        end
    end

    local Statements = define
        Compute = do(node, recurse)
            local spell = Opcodes[node.opcode] or binary
            return value_name(node.result, node.type) .. " = " .. spell(node, node.arguments[1], node.arguments[2])
        end
        Pack = do(node, recurse)
            -- a sum: its tag, and the payload in the union member of its alternative
            if is_sum node.type then
                local alternative = node.type.alternatives[tonumber(node.components[1].bits.bits) + 1]
                local payload = node.components[2] and (", .as.%s = %s"):format(alternative.name, operand node.components[2]) or ""
                return ("%s = (%s){ .tag = %s%s };"):format(value_name(node.result, node.type), c_type node.type, tag_name(node.type, alternative.name), payload)
            end
            if not is_record_like node.type then fail("packing " .. types.describe node.type .. " has no C spelling yet") end
            local components = {}
            for index, component in ipairs node.components do components[index] = operand component end
            return ("%s = (%s){ %s };"):format(value_name(node.result, node.type), c_type node.type, table.concat(components, ", "))
        end
        Extract = do(node, recurse)
            local text = operand node.aggregate
            for _, component in ipairs node.path do
                if data.Component.is(component, data.FieldComponent) then
                    text = text .. "." .. component.name
                elseif data.Component.is(component, data.AlternativeComponent) then
                    text = text .. ".as." .. component.name
                else
                    fail "extracting an element has no C spelling yet"
                end
            end
            return ("%s = %s;"):format(value_name(node.result, node.type), text)
        end
        Load = do(node, recurse)
            local place = definition.places[node.place]
            return ("%s = %s;"):format(value_name(node.result, place.type), place_text place)
        end
        Store = |node, recurse| -> ("%s = %s;"):format(place_text(definition.places[node.place]), operand node.value)
        Address = |node, recurse| -> ("%s = &%s;"):format(value_name(node.result, types.pointer(definition.places[node.place].type)), place_text(definition.places[node.place]))
        Check = |node, recurse| -> fail "check has no C spelling yet"
        Invoke = do(node, recurse)
            if not data.Callee.is(node.callee, data.DirectNua) then fail "an indirect or foreign call has no C spelling yet" end
            local arguments = {}
            for index, argument in ipairs node.arguments do arguments[index] = operand argument end
            local call = ("%s(%s);"):format(names_of_definitions[node.callee.definition], table.concat(arguments, ", "))
            if node.result then
                local callee = program.definitions[node.callee.definition]
                return value_name(node.result, callee.signature.result) .. " = " .. call
            end
            return call
        end
        Atomic = |node, recurse| -> fail "atomic has no C spelling yet"
        Fence = |node, recurse| -> fail "fence has no C spelling yet"
        LifetimeStart = |node, recurse| -> nil
        LifetimeEnd = |node, recurse| -> nil
        Moves = |node, recurse| -> nil
        Ends = |node, recurse| -> nil
        Budget = |node, recurse| -> nil
        Mechanism = do(node, recurse)
            local binding = platform.bindings[node.binding]
            if binding == nil then fail("the mechanism " .. node.binding .. " is not declared") end
            local arguments = {}
            for index, argument in ipairs node.arguments do arguments[index] = operand argument end
            local call = ("%s(%s);"):format(binding.c_symbol, table.concat(arguments, ", "))
            if node.result then return value_name(node.result, binding.result) .. " = " .. call end
            return call
        end
    end
    local statement = Instruction.pass "write an instruction as C" with ..Statements end

    local go = do(edge)
        if #edge.arguments == 0 then return "goto " .. labels[edge.target] .. ";" end
        local temporaries, assignments = {}, {}
        local target_parameters = parameters_of[edge.target]
        local target_block = blocks_by_id[edge.target]
        for index, argument in ipairs edge.arguments do
            temporaries[index] = ("%s t%d = %s;"):format(c_type(target_block.arguments[index].type), index, operand argument)
            assignments[index] = ("%s = t%d;"):format(target_parameters[index], index)
        end
        return ("{ %s %s } goto %s;"):format(table.concat(temporaries, " "), table.concat(assignments, " "), labels[edge.target])
    end
    local Endings = define
        Jump = |node, recurse| -> go node.edge
        Branch = |node, recurse| -> ("if (%s) %s else %s"):format(operand node.condition, go node.when_true, go node.when_false)
        Return = do(node, recurse)
            if node.value == nil or node.value.type == types.Unit then return "return;" end
            return "return " .. operand node.value .. ";"
        end
        Trap = do(node, recurse)
            local message = node.message
            if data.Operand.is(message, data.Constant) and data.NativeConstant.is(message.bits, data.StaticBytes) then
                local bytes = message.bits.bytes
                local escaped = bytes:gsub('[%c"\\]', character -> ("\\%03o"):format(character:byte()))
                return ('nua_fatal_trap((uint8_t *)"%s", %d); __builtin_unreachable();'):format(escaped, #bytes)
            end
            return "__builtin_trap();"
        end
    end
    local ending = Terminator.pass "write a terminator as C" with ..Endings end

    -- A chain of tests of one operand against constants prints as a `switch` (syntax §11.3):
    -- a block whose branch tests `x == k`, its false edge into blocks that hold only the next
    -- test of the same `x` and reach nowhere else first. A sum's tag is spelled by its constants.
    local uses, defined_by, predecessors = {}, {}, {}
    for _, block in ipairs definition.blocks do
        for _, instruction in ipairs block.instructions do
            if instruction.result then defined_by[instruction.result] = instruction end
            for _, used in ipairs(verify.operands_of instruction) do
                if Operand.is(used, data.Result) then uses[used.value] = (uses[used.value] or 0) + 1 end
            end
        end
        for _, used in ipairs(verify.terminator_operands block.terminator) do
            if Operand.is(used, data.Result) then uses[used.value] = (uses[used.value] or 0) + 1 end
        end
        for _, edge in ipairs(graph.edges_of block.terminator) do predecessors[edge.target] = (predecessors[edge.target] or 0) + 1 end
    end
    -- the test a block ends with: `x == k` computed last, used only by its branch
    local test_of = do(block)
        local terminator, last = block.terminator, block.instructions[#block.instructions]
        if not Terminator.is(terminator, data.Branch) or not last or not Instruction.is(last, data.Compute) or last.opcode ~= "equal" then return nil end
        if not Operand.is(terminator.condition, data.Result) or terminator.condition.value ~= last.result or uses[last.result] ~= 1 then return nil end
        local subject, constant = last.arguments[1], last.arguments[2]
        if Operand.is(subject, data.Constant) or not Operand.is(constant, data.Constant) then return nil end
        if #terminator.when_true.arguments > 0 or #terminator.when_false.arguments > 0 then return nil end
        return { .subject, .constant, edge = terminator.when_true, otherwise = terminator.when_false }
    end
    local switches, absorbed = {}, {}
    for _, block in ipairs definition.blocks do
        local first = not absorbed[block.id] and test_of block
        if first then
            local cases, otherwise = { first }, first.otherwise
            while true do
                local next_block = blocks_by_id[otherwise.target]
                local test = next_block and #next_block.arguments == 0 and #next_block.instructions == 1 and predecessors[next_block.id] == 1 and test_of next_block
                if not test or data.operand_key(test.subject) ~= data.operand_key(first.subject) then break end
                cases[#cases + 1] = test
                absorbed[next_block.id] = true
                otherwise = test.otherwise
            end
            if #cases >= 2 then
                switches[block.id] = { subject = first.subject, .cases, .otherwise }
            else
                for _, case in ipairs cases do absorbed[case.otherwise.target] = nil end
            end
        end
    end
    -- the sum whose tag a subject is, if it is one
    local tag_sum = do(subject)
        local extract = Operand.is(subject, data.Result) and defined_by[subject.value]
        if extract and Instruction.is(extract, data.Extract) and #extract.path == 1 and data.Component.is(extract.path[1], data.FieldComponent)
            and extract.path[1].name == "tag" and NativeType.is(extract.aggregate.type, types.SumType) then
            return extract.aggregate.type
        end
        return nil
    end
    -- the spelling of a case: a tag constant when the subject is a sum's tag
    local case_text = do(subject, constant)
        local sum_type = tag_sum subject
        local alternative = sum_type and sum_type.alternatives[tonumber(constant.bits.bits) + 1]
        if alternative then return tag_name(sum_type, alternative.name) end
        return constant_text constant
    end
    -- what the default of a switch on a tag stands for: the one alternative no case names
    local default_comment = do(switch)
        local sum_type = tag_sum switch.subject
        if sum_type == nil or #switch.cases ~= #sum_type.alternatives - 1 then return "" end
        local named = {}
        for _, case in ipairs switch.cases do named[tonumber(case.constant.bits.bits) + 1] = true end
        for index, alternative in ipairs sum_type.alternatives do
            if not named[index] then return (" /* %s */"):format(tag_name(sum_type, alternative.name)) end
        end
        return ""
    end
    local switch_text = do(switch)
        local lines = { ("switch (%s) {"):format(operand switch.subject) }
        for _, case in ipairs switch.cases do lines[#lines + 1] = ("    case %s: %s"):format(case_text(switch.subject, case.constant), go case.edge) end
        lines[#lines + 1] = ("    default:%s %s"):format(default_comment switch, go switch.otherwise)
        lines[#lines + 1] = "    }"
        return table.concat(lines, "\n")
    end

    local body = {}
    for _, block in ipairs definition.blocks do
        if not absorbed[block.id] then
            body[#body + 1] = labels[block.id] .. ":;"
            local switch = switches[block.id]
            local count = switch and #block.instructions - 1 or #block.instructions
            for position = 1, count do
                local text = statement(block.instructions[position])
                if text then body[#body + 1] = "    " .. text end
            end
            body[#body + 1] = "    " .. (switch and switch_text switch or ending block.terminator)
        end
    end
    local signature = definition.signature
    local parameters = {}
    for index, type in ipairs signature.parameters do parameters[index] = ("%s p%d"):format(c_type type, index) end
    local exported = program.exported[definition.id]
    local header = ("%s%s %s(%s)"):format(exported and "" or "static ", c_type signature.result, c_name, #parameters > 0 and table.concat(parameters, ", ") or "void")
    local text = header .. " {\n" .. table.concat(declarations, "\n") .. (#declarations > 0 and "\n" or "") .. table.concat(body, "\n") .. "\n}\n"
    return text, header .. ";"
end

-- the whole program: exported definitions under their C names, the others named after their
-- word; every prototype first, so definitions may call one another in any order
local emit = do(program)
    local parts = { "#include \"nua_platform.h\"\n#include <stdint.h>\n#include <stdbool.h>\n#include <math.h>\n" }
    local names, exported = {}, {}
    for _, export in ipairs program.exports do
        names[export.definition] = export.name
        exported[export.definition] = true
    end
    local ordered = graph.definitions_in_order program
    local count = 0
    for _, definition in ipairs ordered do
        if names[definition.id] == nil then
            count += 1
            local info = program.words[definition.word]
            local word_name = info and info.name:gsub("[^%w_]", "_") or "definition"
            names[definition.id] = ("%s_%d"):format(word_name, count)
        end
    end
    local view = { ..program, .exported }
    local bodies, prototypes, exported_prototypes = {}, {}, {}
    for _, definition in ipairs ordered do
        local text, prototype = emit_definition(definition, names[definition.id], view, names)
        bodies[#bodies + 1] = text
        prototypes[#prototypes + 1] = prototype
        if exported[definition.id] then exported_prototypes[#exported_prototypes + 1] = prototype end
    end
    local declarations = record_declarations program
    if #declarations > 0 then parts[#parts + 1] = table.concat(declarations, "\n") .. "\n" end
    parts[#parts + 1] = table.concat(prototypes, "\n") .. "\n"
    -- a host declaring the exports needs the records they use first
    local interface = {}
    for _, declaration in ipairs declarations do interface[#interface + 1] = declaration end
    for _, prototype in ipairs exported_prototypes do interface[#interface + 1] = prototype end
    exported_prototypes = interface
    for _, text in ipairs bodies do parts[#parts + 1] = text end
    return table.concat(parts, "\n"), exported_prototypes
end

return define
    .emit
    .c_type
    .constant_text
end
