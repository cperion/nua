-- Native representation adapters are ordinary words over explicit records.
-- The compiler supplies only the checked-owner -> representation projection.
local stacks = require "nua.stacks"
local h = '"nua_rt.h"'
local layout = {}
local slice_parts, make_slice = __S.slice_parts, __S.make_slice
layout.Store = cstruct("nua_store", h, {
        { "stack", U64 },
        { "base", U64 }, { "len", U32 }, { "live", U32 }, { "free_head", U32 }, { "token", U64 },
    })
layout.Grow = cstruct("nua_grow", h, { { "stack", U64 }, { "base", U64 }, { "len", U64 } })
layout.Id = cstruct("nua_id", h, { { "token", U64 }, { "slot", U32 }, { "gen", U32 } })
layout.Map = cstruct("nua_map", h, {
        { "stack", U64 },
        { "base", U64 }, { "width", U64 }, { "len", U32 }, { "live", U32 }, { "free_head", U32 },
        { "iterating", U32 },
        { "index_stack", U64 }, { "index_base", U64 }, { "cap", U32 }, { "used", U32 },
    })
layout.StrMap = cstruct("nua_strmap", h, {
        { "entries", layout.Map },
        { "arena_stack", U64 }, { "arena_base", U64 }, { "arena_len", U64 }, { "dead", U64 },
    })
local token = extern("nua_next_token", {}, U64, { header = h })
local trap = extern("nua_trap", { CString }, Unit, { header = h })
local maximum = U64 0xffffffffffffffffULL
local Void = opaque "void"
local VP = Ptr Void
local ReadMap = cstruct("const nua_map", h, {
        { "stack", U64 }, { "base", U64 }, { "width", U64 }, { "len", U32 },
    })
local ReadMapPtr = Ptr ReadMap
layout.map_address = do(map: ReadMapPtr, slot: U32): VP
    if slot >= map.len then trap "Map: invalid bucket" end
    local width = map.width
    local at = map.base + U64 slot * width
    return VP stacks.region(map.stack, at, width)
end
layout.store_new = do(stack: U64): layout.Store
    local base = stacks.begin stack
    local id = token()
    return layout.Store with
        .stack
        .base
        len = 0
        live = 0
        free_head = 0xffffffff
        token = id
    end
end
layout.grow_new = do(stack: U64): layout.Grow
    return layout.Grow { .stack, base = stacks.begin stack, len = 0 }
end
layout.map_new = do(stack: U64, index_stack: U64, width: U64): layout.Map
    if width < 8 or width % 8 ~= 0 or stack == index_stack then trap "Map: invalid entry layout" end
    return layout.Map with
        .stack
        base = stacks.begin stack
        .width
        len = 0
        live = 0
        free_head = 0xffffffff
        iterating = 0
        .index_stack
        index_base = stacks.begin index_stack
        cap = 0
        used = 0
    end
end
layout.strmap_new = do(table_stack: U64, index_stack: U64, arena_stack: U64, width: U64): layout.StrMap
    -- nua_strkey is the full fixed prefix, including native trailing padding.
    local Key = cstruct("nua_strkey", h, { { "hash", U64 }, { "offset", U64 }, { "len", U64 } })
    if table_stack == arena_stack or index_stack == arena_stack or width < size_of Key then
        trap "Map(Str, V): invalid storage layout"
    end
    local entries = layout.map_new table_stack index_stack width
    local base = stacks.begin arena_stack
    return layout.StrMap with
        .entries
        .arena_stack
        arena_base = base
        arena_len = 0
        dead = 0
    end
end
layout.iter_new = do(stack: U64, map: Ptr layout.Map): layout.Grow
    local s = stacks.claim stack
    if stack == map.stack or stack == map.index_stack or s.map_counter ~= null U32 then trap "Map: invalid iteration guard stack" end
    if map.iterating == U32 0xffffffff then trap "Map: too many nested iterations" end
    local id = token()
    local guard = layout.grow_new stack
    stacks.push stack 1
    guard.len = 1
    s = stacks.at stack
    s.map_counter = Ptr map.iterating
    s.map_guard_base = guard.base
    s.map_guard_token = id
    map.iterating = map.iterating + 1
    return guard
end
-- A representation supplies its header and acquires its items: one stack
-- resolution and one range check, valid while the owner lives (stacks never move).
function layout.storage(T, R, Elem, Slot, view, make_id, components)
    local is_store = Slot ~= nil
    local Item = Slot or Elem
    local Items = Ptr Item
    local p = { .Item }
    p.init = do(self: Ref T, stack: U64): Unit
        local h = view self
        if is_store then h[0] = layout.store_new stack else h[0] = layout.grow_new stack end
    end
    p.header = do(self: Ref T): Ptr R return view self end
    p.width = do(): U64 = size_of Item
    p.items = do(self: Ref T): Items
        local h = view self
        local bytes = U64 h.len * size_of Item
        return Items stacks.region(h.stack, h.base, bytes)
    end
    local IdType = is_store and Id Elem or U32
    p.id = do(self: Ref T, index: U32, gen: U32): IdType
        return make_id { token = view(self).token, slot = index, .gen }
    end
    p.components = components
    p.maximum = do(): U64 = maximum
    return p
end
function layout.maps(T, Entry, view)
    local str = T.kind == "strmap"
    local EP = Ptr Entry
    local Cells = Ptr U32
    local Stored = Entry.index.key.type
    -- One acquisition of a table: its slots (which never move), its index
    -- cells and, for text keys, the live arena bytes the stored keys point into.
    local View = Struct { entries: EP, len: U32, cells: Cells, cap: U32 }
    if str then View = Struct { entries: EP, len: U32, cells: Cells, cap: U32, arena: Ptr U8 } end
    local header = do(self: Ref T): Ptr layout.Map
        local h = view self
        if str then return Ptr h.entries end
        return h
    end
    -- the slots, as many as the map has used so far
    local entries = do(self: Ref T): EP
        local h = header self
        local bytes = U64 h.len * size_of Entry
        return EP stacks.region(h.stack, h.base, bytes)
    end
    local cells = do(self: Ref T): Cells
        local h = header self
        local bytes = U64 h.cap * 4
        return Cells stacks.region(h.index_stack, h.index_base, bytes)
    end
    local p = { .View, .header, .entries, .cells }
    p.init = do(self: Ref T, stack: U64, index: U64, arena: U64): Unit
        local h = view self
        if str then h[0] = layout.strmap_new stack index arena (size_of Entry)
        else h[0] = layout.map_new stack index (size_of Entry) end
    end
    p.iter = do(self: Ref T, guard: Ptr layout.Grow, stack: U64): Unit
        guard[0] = layout.iter_new stack (header self)
    end
    p.strmap = do(self: Ref T): Ptr layout.StrMap return view self end
    p.acquire = do(self: Ref T): View
        local h = header self
        local table = entries self
        local index = cells self
        if str then
            local s = view self
            local arena = stacks.region s.arena_stack s.arena_base s.arena_len
            return View { entries = table, len = h.len, cells = index, cap = h.cap, .arena }
        end
        return View { entries = table, len = h.len, cells = index, cap = h.cap }
    end
    -- the key a stored key denotes, inside the view that holds its bytes
    p.key = do(table: View, stored: Stored): T.key
        if str then return make_slice(Str, Ptr table.arena[stored.offset], stored.len) end
        return stored
    end
    p.maximum = do(): U64 = maximum
    return p
end
local function project(value, path)
    for field in path:gmatch "[^.]+" do value = value[field] end
    return value
end
function layout.releaser(Meta, stack, base)
    return do(owner: Ptr Meta): Unit
        stacks.reset(project(owner, stack), project(owner, base))
    end
end
return layout
