-- Native definitions (compiler activities §6.3): the registry of a compilation's native
-- functions, each the specialization of a word on the known part of its supply.
--
-- A specification gives each requirement either a known argument (a host value, or a known
-- native constant), which becomes part of the key, or a dynamic native type, which becomes a
-- parameter. `request` answers the definition of a specification, building it the first time:
-- the identity is registered before the body is evaluated, so a recursive request inside it
-- answers the same identity instead of building again. A build evaluates the word in place on
-- a fresh entry block, with the known arguments as constants and the others as parameters.

local identity = require "nua.identity"
local types = require "nua.types"
local data = require "nua.compiler.data"
local paths_of = require "nua.compiler.evaluation.path"
local graph = require "nua.compiler.graph"
local facts = require "nua.compiler.facts"
local rules = require "nua.compiler.rules"
local analysis = require "nua.compiler.analysis"
local boundaries = require "nua.compiler.boundaries"
local specifications = require "nua.compiler.specifications"

local Supplied = specifications.Supplied

-- host values in keys: numbers, strings and booleans by value, anything else by identity
local host_serials = setmetatable({}, { __mode = "k" })
local host_count = 0
local host_key = do(value)
    local kind = type value
    if kind == "number" or kind == "string" or kind == "boolean" or kind == "nil" then return kind .. ":" .. tostring value end
    local serial = host_serials[value]
    if serial == nil then
        host_count += 1
        serial = host_count
        host_serials[value] = serial
    end
    return "host:" .. serial
end

-- a known native argument in a key: integers, floats, booleans and unit by value
local unkeyed = do(bits, recurse, constant)
    error("definitions: a known argument of " .. types.describe constant.type .. " cannot key a definition yet", 4)
end
local constant_key_of_bits = data.NativeConstant.pass "a known constant in a definition's key" with
    IntegerBits = |bits, recurse, constant| -> tostring bits.bits
    FloatBits = |bits, recurse, constant| -> ("%.17g"):format(bits.value)
    BooleanBit = |bits, recurse, constant| -> tostring bits.value
    UnitBits = |bits, recurse, constant| -> "unit"
    AggregateBits = do(bits, recurse, constant)
        local parts = {}
        for index, part in ipairs bits.parts do parts[index] = recurse(part, constant) end
        return "{" .. table.concat(parts, ",") .. "}"
    end
    StaticBytes = unkeyed
    SymbolAddress = unkeyed
    ForeignValue = unkeyed
    StaticAddress = |bits, recurse, constant| -> ("static:%d:%q"):format(bits.offset, bits.bytes)
    ZeroBits = |bits, recurse, constant| -> "zero"
    DefinitionAddress = unkeyed
end
local constant_key = constant -> constant_key_of_bits(constant.bits, constant)

-- `E`: the evaluation vocabulary, whose verbs build each definition
local defining = do(compilation, E)
    local supply = compilation.supply
    local fresh = supply.fresh
    local entries = {}      -- key -> { id, state }
    local definitions = {}  -- DefinitionId -> Definition
    local definition_facts = {}
    local words = {}        -- word -> WordId
    local word_infos = {}   -- WordId -> WordInfo
    local bundles, jobs, order = {}, {}, {}
    local current = nil

    local word_id = do(word)
        local found = words[word]
        if found then return found end
        found = fresh identity.WordId
        words[word] = found
        local requirements = {}
        for index, requirement in ipairs word.requirements do
            requirements[index] = data.Requirement { name = requirement.name, native_type = requirement.type, opened = false }
        end
        word_infos[found] = data.WordInfo { id = found, name = word.name, .requirements, result_type = word.result, origin = compilation.origin(word.source, word.line) }
        return found
    end

    -- the key of a specification: the word, then each argument known by its value or dynamic by
    -- its type; the ABI and the word's identity keep different boundaries apart
    local key_part = Supplied.pass "a supplied requirement in a definition's key" with
        KnownHost = |entry, recurse| -> host_key entry.value
        KnownNative = |entry, recurse| -> ("known %s %s"):format(types.describe entry.value.type, constant_key entry.value.operand)
        Dynamic = |entry, recurse| -> "dynamic " .. types.describe entry.type
    end
    local key_of = do(word, specification, abi)
        local parts = { tostring(word_id(word).serial), abi }
        for _, entry in ipairs specification do parts[#parts + 1] = key_part entry end
        return table.concat(parts, "|")
    end

    -- the argument a parameter supplies inside its definition: a reference or a view is a
    -- borrow of the caller's storage, a value carrying borrows has their facts, any other value
    -- is the parameter itself
    local parameter_argument = do(path, id, position, native_type)
        local operand = data.Parameter { definition = id, index = position, type = native_type }
        if types.NativeType.is(native_type, types.ReferenceType) then return E.parameter_reference(path, id, position, native_type, operand) end
        if types.NativeType.is(native_type, types.ViewType) then return E.parameter_view(path, id, position, native_type, operand) end
        if types.borrows native_type then return E.parameter_value(path, id, position, native_type, operand) end
        return E.value_of_operand(native_type, operand)
    end

    local build = do(id, word, specification, abi, kind, source, line)
        local parent = current
        current = id
        jobs[id].dependencies = {}
        local parameter_types = {}
        for _, entry in ipairs specification do
            if specifications.is_dynamic entry then parameter_types[#parameter_types + 1] = entry.type end
        end
        local outcome = graph.building(nil, supply, do(writer)
            local entry = writer.block "entry"
            local path = paths_of.entry(writer, entry, facts.empty(), source, line, id)
            local arguments, position = {}, 0
            for index, entry in ipairs specification do
                if specifications.is_dynamic entry then
                    position += 1
                    arguments[index] = parameter_argument(path, id, position, entry.type)
                else
                    arguments[index] = entry.value
                end
            end
            E.enter path
            local value = E.invoke(path, word, arguments)
            if not path.dead then
                local returned = nil
                if value ~= nil and word.result ~= types.Unit then returned = E.materialize(path, value) end
                E.terminate(path, data.Return { origin = compilation.origin(source, line), value = returned })
            end
            return "adopt"
        end)
        local fragment = outcome { built = f -> f, discarded = || -> error "a definition's construction was discarded" }
        local blocks = graph.seal fragment
        definitions[id] = data.Definition with
            .id
            word = word_id word
            .kind
            signature = data.Signature { parameters = parameter_types, result = word.result, .abi, variadic = false }
            entry = blocks[1].id
            .blocks
            places = fragment.places
            origin = compilation.origin(source, line)
        end
        definition_facts[id] = analysis.publish(definitions[id], fragment)
        bundles[id] = { definition = definitions[id], facts = definition_facts[id], contract = boundaries.project(definitions[id], definition_facts[id], 0) }
        jobs[id].fingerprint = boundaries.fingerprint(bundles[id])
        -- a dependency the finished definition no longer calls is dropped
        local called = graph.called_definitions(definitions[id])
        for dependency in pairs jobs[id].dependencies do
            if not called[dependency] then jobs[id].dependencies[dependency] = nil end
        end
        current = parent
        return id
    end

    local bundle_of = id -> bundles[id]
    local contract_of = do(id)
        if current then jobs[current].dependencies[id] = jobs[id].fingerprint or "pending" end
        return bundles[id]
    end
    local register = do(id, word, specification, abi, source, line)
        jobs[id] = { .word, .specification, .abi, source = source or word.source, line = line or word.line, dependencies = {} }
        order[#order + 1] = id
    end
    local rebuild = do(id)
        local job = jobs[id]
        build(id, job.word, job.specification, job.abi, "native_word", job.source, job.line)
    end
    local close = do()
        local changed = true
        while changed do
            changed = false
            for _, id in ipairs order do
                local stale = false
                for dependency, seen in pairs jobs[id].dependencies do
                    if seen ~= jobs[dependency].fingerprint then stale = true end
                end
                if stale then rebuild(id); changed = true end
            end
        end
    end
    local request = do(word, specification, abi, source, line)
        local key = key_of(word, specification, abi)
        local found = entries[key]
        if found then return found.id end
        local id = fresh identity.DefinitionId
        entries[key] = { .id, state = "building" }
        register(id, word, specification, abi, source, line)
        rebuild(id)
        entries[key].state = "complete"
        return id
    end

    -- an export, built with its own C name. When nothing in its interface owns storage, its C
    -- ABI is the Nua boundary's (they differ only for owning results, §3.1), so it is also the
    -- definition a recursive request for the same specification finds.
    local define_export = do(word, specification, source, line)
        local id = fresh identity.DefinitionId
        local owning = types.owns word.result
        for index, entry in ipairs specification do
            if specifications.is_dynamic entry and types.owns entry.type then owning = true end
        end
        local key = not owning and key_of(word, specification, "nua_boundary")
        if key and entries[key] == nil then entries[key] = { .id, state = "building" } end
        register(id, word, specification, "c_boundary", source, line)
        rebuild(id)
        close()
        if key and entries[key].id == id then entries[key].state = "complete" end
        return id
    end

    -- the ABI a definition is built for (an exported one is "c_boundary")
    local abi_of = id -> jobs[id] and jobs[id].abi

    return define
        .request
        .define_export
        .abi_of
        .word_id
        .contract_of
        .bundle_of
        definitions = || -> definitions
        facts = || -> definition_facts
        contracts = do()
            local result = {}
            for id, bundle in pairs bundles do result[id] = bundle.contract end
            return result
        end
        words = || -> word_infos
    end
end

return define
    .defining
end
