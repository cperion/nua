-- Owned collection policy is Nua; p supplies the representation header and
-- acquires its items. Data stacks never move, so an acquisition stays valid
-- across pushes; it is repeated only to see the new length.
local stacks = require "nua.stacks"
local storage = {}
local trap = extern("nua_trap", { CString }, Unit)
local slice_parts = __S.slice_parts
local retire, restructure, borrows, grows = __S.retire, __S.restructure, __S.borrows, __S.grows
local make_slice = __S.make_slice
local none = U32 0xffffffff
local maximum = U64 0xffffffffffffffffULL
local occupied = U32 0xfffffffe
local retired = U32 0xfffffffd

-- Room for one more item at the top of the owner's data stack.
local function extend(T, p, what, counts_slots)
    local message = what .. " grew while it was not at the top of its data stack"
    return do(owner: Ref T, length: U64, width: U64): Unit
        local h = p.header owner
        -- a Store counts slots in a U32 (its Ids name them): no product overflows
        if not counts_slots then
            -- the byte count must not wrap (a division check: a widened U32
            -- length would make a comparison with the maximum a tautology)
            local bytes = length * width
            if bytes / width ~= length then trap(what .. " is full") end
        end
        stacks.extend h.stack h.base (length * width) width message
    end
end

function storage.store(T, Id, p)
    local Item = p.Item
    local api = {}
    local grow = extend(T, p, "Store", true)
    -- the slot an Id names while it is current, or null
    local occupant = do(s: Ref T, id: Id): Ptr Item
        local token, slot, generation = p.components id
        local h = p.header s
        if token ~= h.token or slot >= h.len then return null Item end
        local items = p.items s
        local entry = Ptr items[slot]
        if entry.gen ~= generation or entry.next ~= occupied then return null Item end
        return entry
    end
    api.has = do(s: Ref T, id: Id): Bool
        local entry = occupant s id
        return entry ~= null Item
    end
    api.locate = do(s: Ref T, id: Id): Ptr T.elem
        local entry = occupant s id
        if entry == null Item then trap "stale or foreign Id in Store" end
        return Ptr entry.value
    end
    api.add = do(s: Ref T, value: T.elem): Id
        grows s
        local h = p.header s
        local slot = h.free_head
        local entry = null Item
        if slot ~= none then
            local items = p.items s
            entry = Ptr items[slot]
            h.free_head = entry.next
        else
            slot = h.len
            if slot >= retired then trap "Store is full" end
            grow(s, U64 slot, p.width())
            h.len = slot + 1
            local items = p.items s
            entry = Ptr items[slot]
            entry.gen = 1
        end
        entry.next = occupied
        -- written through the owner's pointer: a borrow stored in the value is checked against it
        local owned = borrows(s, p.items s)
        owned[slot].value = value
        h.live = h.live + 1
        return p.id s slot entry.gen
    end
    api.remove = do(s: Ref T, id: Id): Bool
        local entry = occupant s id
        if entry == null Item then return false end
        -- a removed slot is reused: borrows of the store's elements end here
        retire(s, "an element of '%s' was removed")
        local token, slot, generation = p.components id
        local h = p.header s
        h.live = h.live - 1
        if generation == none then
            entry.next = retired
        else
            entry.gen = generation + 1
            entry.next = h.free_head
            h.free_head = slot
        end
        return true
    end
    api.length = do(s: Ref T): U64 return U64 p.header(s).live end
    -- `copy s` into a new, empty store: the same slots, generations and token,
    -- so the original's Ids name the same entities in the copy
    api.copy = do(s: Ref T, from: Ref T): Unit
        local source = p.header from
        local h = p.header s
        local bytes = U64 source.len * p.width()
        if bytes ~= 0 then
            local at = stacks.extend(h.stack, h.base, U64 0, bytes,
                "Store copy target was not at the top of its data stack")
            stacks.move (stacks.region h.stack at bytes) (stacks.region source.stack source.base bytes) bytes
        end
        h.len = source.len
        h.live = source.live
        h.free_head = source.free_head
        h.token = source.token
    end
    return api
end

function storage.grow(T, p)
    local api = {}
    local what = T.kind == "rtarray" and "Array" or (T.elem == U8 and "Text" or "Grow")
    local grow = extend(T, p, what)
    api.clear = do(g: Ref T): Unit
        retire(g, "'%s' was cleared")
        local h = p.header g
        stacks.reset h.stack h.base
        h.len = 0
    end
    -- keep the first n elements: the storage above them is released
    api.truncate = do(g: Ref T, n: U64): Unit
        retire(g, "'%s' was truncated")
        local h = p.header g
        if n > h.len then trap "Grow truncate beyond its length" end
        stacks.reset h.stack (h.base + n * p.width())
        h.len = n
    end
    -- the last element, removed
    api.pop = do(g: Ref T): T.elem
        retire(g, "'%s' was popped")
        local h = p.header g
        if h.len == 0 then trap "Grow pop of an empty Grow" end
        local last = h.len - 1
        local items = p.items g
        local value = items[last]
        stacks.reset h.stack (h.base + last * p.width())
        h.len = last
        return value
    end
    if T.elem == U8 then
        api.append = do(g: Ref T, text: Str): Unit
            local n = text.length
            if n == 0 then return end
            local h = p.header g
            local length = h.len
            -- text may be bytes of this stack, even of this Text: growth leaves
            -- them where they are, and the new bytes lie above them
            local bytes = n
            local top = stacks.extend(h.stack, h.base, length, bytes,
                "Text grew while it was not at the top of its data stack")
            local ptr, len = slice_parts text
            stacks.write h.stack top ptr bytes
            h.len = length + n
        end
    end
    if T.elem == U8 then
        -- g:write(a, b, ...): each part as text. Known parts join while specializing and
        -- become one literal; each runtime part is the conversion its type needs.
        local format = require "nua.format"
        local strings = require "nua.strings"
        local value_of, known_text = __S.value_of, strings.known_text
        -- a host number or boolean is the typed value Nua would give it
        local function normalize(part)
            if type part == "boolean" then return __S.known(Bool, part) end
            if type part == "number" then
                -- negative zero stays a float
                if part == math.floor part and math.abs part < 2 ^ 53 and not (part == 0 and 1 / part == -math.huge) then
                    return I64 part
                end
                return F64 part
            end
            return part
        end
        -- what a runtime part is: "bool", "int", "signed", "float", "str", "cstring" or "other"
        local function kind_of(part)
            local t = value_of(part, nil, "write").T
            if t.kind == "bool" then return "bool" end
            if t.kind == "int" then return t.signed and "signed" or "int" end
            if t.kind == "float" then return "float" end
            if t == Str then return "str" end
            if t.kind == "cstr" then return "cstring" end
            return "other"
        end
        local function reject(part)
            __S.fail("write: cannot write a " .. value_of(part, nil, "write").T.display ..
                " as text (numbers, Bool, Str, CString)", 2)
        end
        local function known_cstring(part)
            local v = value_of(part, nil, "write")
            if v.k == "known" and v.T.kind == "cstr" then return v.v end
        end
        local function append(g, text)
            __S.bump_checked
            api.append(g, text)
        end
        -- the text written so far that is known goes out as one literal
        local function flush(g, pending)
            if pending ~= "" then append(g, pending) end
            return ""
        end
        -- known text joins what is pending; anything else is written after it
        local function put(g, pending, text)
            local known = known_text text
            if known then return pending .. known end
            flush(g, pending)
            append(g, text)
            return ""
        end
        api.write = do(g: Ref T, ..parts): Unit
            grows g
            local pending = ""
            for i = 1, parts.length do
                local part = normalize parts[i]
                if type part == "string" then
                    pending = pending .. part
                else
                    local kind = kind_of part
                    if kind == "bool" then
                        pending = put(g, pending, format.boolean part)
                    elseif kind == "signed" then
                        local digits = format.i64(I64 part)
                        pending = put(g, pending, digits:str())
                    elseif kind == "int" then
                        local digits = format.u64(U64 part)
                        pending = put(g, pending, digits:str())
                    elseif kind == "float" then
                        pending = flush(g, pending)
                        local digits = format.f64(F64 part)
                        append(g, digits:str())
                    elseif kind == "str" then
                        pending = put(g, pending, part)
                    elseif kind == "cstring" then
                        local known = known_cstring part
                        if known then pending = pending .. known
                        else pending = put(g, pending, strings.of part) end
                    else
                        reject part
                    end
                end
            end
            flush(g, pending)
        end
        -- the text as a Str borrowing it, of the length it has now: the text may grow while
        -- the Str is used; clearing it ends the Str
        api.str = do(g: Ref T): Str
            return strings.of(api.all g)
        end
    end
    api.push = do(g: Ref T, value: T.elem): Unit
        grows g
        local h = p.header g
        local length = h.len
        grow(g, length, p.width())
        h.len = length + 1
        -- the elements are reached through a pointer attached to the owner: a borrow stored
        -- in one is checked against the owner (design memory.md §10.1)
        local items = borrows(g, p.items g)
        items[length] = value
    end
    api.locate = do(g: Ref T, index: U64): Ptr T.elem
        local h = p.header g
        if index >= h.len then trap "Grow index out of range" end
        local items = p.items g
        return Ptr items[index]
    end
    api.items = p.items
    api.length = do(g: Ref T): U64 return p.header(g).len end
    -- the elements as a read-only slice borrowing the owner, of the length it has now:
    -- growing keeps it valid (stacks never move); clear, pop and truncate end it
    api.all = do(g: Ref T): Slice T.elem
        local h = p.header g
        local view = Slice(p.items g, h.len)
        return borrows(g, view)
    end
    -- an empty owner takes n zeroed elements (Array(T, n) {} with a runtime n)
    api.allocate = do(g: Ref T, n: U64): Unit
        local h = p.header g
        local bytes = n * p.width()
        if bytes / p.width() ~= n then trap "Array is too large" end
        if bytes ~= 0 then
            local at = stacks.extend(h.stack, h.base, U64 0, bytes,
                "Array was not at the top of its data stack when built")
            stacks.zero h.stack at bytes
        end
        h.len = n
    end
    -- an empty owner takes a copy of n elements (copy of a Slice)
    api.fill_from = do(g: Ref T, items: Ptr T.elem, n: U64): Unit
        local h = p.header g
        local bytes = n * p.width()
        if bytes ~= 0 then
            local at = stacks.extend(h.stack, h.base, U64 0, bytes,
                "copy target was not at the top of its data stack")
            stacks.write h.stack at (Ptr U8 items) bytes
        end
        h.len = n
    end
    -- `copy g` into a new, empty Grow
    api.copy = do(g: Ref T, from: Ref T): Unit
        local source = p.header from
        local h = p.header g
        local bytes = source.len * p.width()
        if bytes ~= 0 then
            local at = stacks.extend(h.stack, h.base, U64 0, bytes,
                "Grow copy target was not at the top of its data stack")
            stacks.move (stacks.region h.stack at bytes) (stacks.region source.stack source.base bytes) bytes
        end
        h.len = source.len
    end
    return api
end
return storage
