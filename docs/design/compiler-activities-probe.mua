-- Executable design experiment, not a replacement compiler or backend-ready IR.
-- Run from Nua's root with the local Mua checkout:
--   .local/bin/luajit ../mua/mua.lua docs/design/compiler-activities-probe.mua
-- Fixtures supply staged closures directly. No new source AST or old-evaluator fallback.
local load_mode = ...
local ffi = require "ffi"

------------------------------------------------------------------------------------------------
-- Checked shapes. These small families describe one program, not one representation per pass.

local list_of = element -> checker("list of " .. tostring element, do(value)
        if type value ~= "table" then return false end
        local count = 0
        for key, item in pairs value do
            if type key ~= "number" or key < 1 or key % 1 ~= 0 or not check(element, item) then
                return false
            end
            count += 1
        end
        return count == #value
    end)
local NativeType = checker("probe native type", value ->
    value == "U32" or value == "Bool" or value == "Ref U32" or value == "Owned U32" or value == "U64" or value == "Unit")
local Unsigned = checker("U32 constant", value ->
    type value == "number" and value >= 0 and value < 4294967296 and value % 1 == 0)
local Guarantee = checker("storage guarantee", value -> value == "stable" or value == "shared")

local Operand = family "program operand"
local UnsignedConstant = struct { value: Unsigned }
local BooleanConstant = struct { value: Boolean }
local Wide = checker("native U64 constant", value -> ffi.istype("uint64_t", value))
local WideConstant = struct { value: Wide }
local UnitConstant = struct {}
local Parameter = struct { identity: String, native_type: NativeType }
local BlockArgument = struct { identity: String, native_type: NativeType }
local Result = struct { identity: String, native_type: NativeType }
Operand { UnsignedConstant,
    BooleanConstant, WideConstant, UnitConstant, Parameter, BlockArgument, Result }
local Operands = list_of Operand
local Arguments = list_of BlockArgument
local Parameters = list_of Parameter

local operand_type = Operand.pass "operand type" with
    UnsignedConstant = do(node, recurse) = "U32"
    BooleanConstant = do(node, recurse) = "Bool"
    WideConstant = do(node, recurse) = "U64"
    UnitConstant = do(node, recurse) = "Unit"
    Parameter = do(node, recurse) = node.native_type
    BlockArgument = do(node, recurse) = node.native_type
    Result = do(node, recurse) = node.native_type
end
local write_operand = Operand.pass "print operand" with
    UnsignedConstant = do(node, recurse) = tostring node.value
    BooleanConstant = do(node, recurse) = tostring node.value
    WideConstant = do(node, recurse) = tostring node.value
    UnitConstant = do(node, recurse) = "unit"
    Parameter = do(node, recurse) = "%" .. node.identity
    BlockArgument = do(node, recurse) = "%" .. node.identity
    Result = do(node, recurse) = "%" .. node.identity
end
local same_operand = left -> right ->
getmetatable left == getmetatable right and
(left == right or left.value ~= nil and left.value == right.value)

local Place = struct { identity: String, name: String, native_type: NativeType }
local Places = list_of Place
-- An origin names one contents lifetime, not just an address or an owning header.
local Origin = struct { identity: String, holding: String, guarantee: Guarantee }
local Origins = list_of Origin
local ReferenceFact = struct { operand: Operand, origins: Origins }
local ReferenceFacts = list_of ReferenceFact
local Names = list_of String
-- A reclamation group is a proof input, not a physical stack/offset assignment.
local Extent = struct { identity: String, name: String }
local Extents = list_of Extent
local Allocation = struct { identity: String, extent: String, origin: Origin }
local Allocations = list_of Allocation
local OwnershipFact = struct { operand: Operand, allocations: Allocations }
local OwnershipFacts = list_of OwnershipFact
local Placement = struct { allocation: String, extent: String, role: String, mark: Result }
local Placements = list_of Placement
local Instance = struct { formal: String, allocation: Allocation }
local Instances = list_of Instance
local Lease = struct { index: Operand, mark: Operand }
local Leases = list_of Lease
-- Receiver-local completion relations. These are checked proof data, not owner ABI fields.
local CompletionMember = struct { index: Operand, guard: Operand }
local CompletionMembers = list_of CompletionMember
local CompletionFact = struct { operand: Operand, members: CompletionMembers }
local CompletionFacts = list_of CompletionFact
local Definition
local Definitions = list_of(checker("native definition", value -> check(Definition, value)))

local Instruction = family "program instruction"
local Add = struct { result: Result, left: Operand, right: Operand, at: String }
local Load = struct { result: Result, place: String, at: String }
local Store = struct { place: String, value: Operand, at: String }
-- Abstract external address observation: may synchronously mutate the initialized U32 place.
-- It models the evaluation boundary, not an implemented foreign ABI or runtime algorithm.
local Expose = struct { place: String, at: String }
local EndContents = struct { origin: Origin, at: String }
local BeginExtent = struct { extent: String, at: String }
local BeginOwned = struct
    result: Result
    allocation: Allocation
    initial: Operand
    at: String
    index: Optional Operand
end
local TransferOwned = struct { result: Result, source: Operand, at: String }
local BorrowOwned = struct { result: Result, owner: Operand, at: String }
local ObserveBorrow = struct { reference: Operand, at: String }
local EndOwned = struct { owner: Operand, at: String }
local ReleaseExtent = struct { extent: String, at: String }
local CompleteBoundary = struct { at: String }
local StackTop = struct { result: Result, role: String, at: String, index: Optional Operand }
local StackWrite = struct { role: String, top: Operand, at: String, index: Optional Operand }
local Call = struct
    result: Result
    callee: String
    arguments: Operands
    instances: Instances
    at: String
end
local Greater = struct { result: Result, left: Operand, right: Operand, at: String }
-- An external live owner grows on its existing role; the storage ledger supplies its interval.
local ExternalGrowth = struct { role: String, amount: Unsigned, at: String }
Instruction { Add, Load, Store, Expose, EndContents, BeginExtent, BeginOwned,
    TransferOwned, BorrowOwned, ObserveBorrow, EndOwned, ReleaseExtent, CompleteBoundary,
    StackTop, StackWrite, Greater, ExternalGrowth, Call }
local Instructions = list_of Instruction

local Edge = struct { target: String, arguments: Operands }
local Terminator = family "program terminator"
local Jump = struct { edge: Edge, at: String }
local Branch = struct { condition: Operand, when_true: Edge, when_false: Edge, at: String }
local Return = struct { value: Operand, at: String }
local Trap = struct { message: String, at: String }
Terminator { Jump, Branch, Return, Trap }
local Block = struct
    identity: String
    arguments: Arguments
    instructions: Instructions
    terminator: Terminator
end
local Blocks = list_of Block
Definition = struct
    identity: String
    parameters: Parameters
    places: Places
    entry: String
    blocks: Blocks
    result_type: NativeType
    references: ReferenceFacts
    return_origins: Origins
    extents: Extents
    allocations: Allocations
    owners: OwnershipFacts
    return_extents: Names
    placement: Optional Placements
    callees: Optional Definitions
    completion_mode: Optional String
    captures: Optional Leases
    leases: Optional Leases
    regions: Optional Operands
    region_scope: Optional String
    completion_relations: Optional CompletionFacts
end

-- Evaluation descriptions are not expression trees. Their leaves are already-fixed operands.
local Staged = family "staged native value"
local Scalar = struct { operand: Operand }
local Reference = struct { operand: Operand, origins: Origins }
local Owner = struct { operand: Operand, allocations: Allocations }
Staged { Scalar, Reference, Owner }
local Contents = family "place contents knowledge"
local Uninitialized = struct {}
local Tracked = struct { value: Staged }
local InMemory = struct {}
local Moved = struct {}
Contents { Uninitialized, Tracked, InMemory, Moved }

local write_origins = do(origins)
    local written = {}
    for _, origin in ipairs origins do
        written[#written + 1] = origin.identity .. "/" .. origin.holding .. "/" .. origin.guarantee
    end
    return table.concat(written, ", ")
end
local write_arguments = do(arguments)
    local written = {}
    for _, argument in ipairs arguments do written[#written + 1] = write_operand argument end
    return table.concat(written, ", ")
end
local write_edge = edge -> edge.target .. "(" .. write_arguments edge.arguments .. ")"
local write_instruction = Instruction.pass "print instruction" with
    Add = do(node, recurse)
        return write_operand node.result .. " = add " .. write_operand node.left .. ", " ..
        write_operand node.right
    end
    Load = do(node, recurse) = write_operand node.result .. " = load @" .. node.place
    Store = do(node, recurse) = "store @" .. node.place .. ", " .. write_operand node.value
    Expose = do(node, recurse) = "expose @" .. node.place
    EndContents = do(node, recurse) = "end contents " .. node.origin.identity
    BeginExtent = do(node, recurse) = "begin extent " .. node.extent
    BeginOwned = do(node, recurse) = write_operand node.result .. " = begin owned " ..
    node.allocation.identity .. " in " .. node.allocation.extent .. " initialized " .. write_operand node.initial
    TransferOwned = do(node, recurse) = write_operand node.result .. " = transfer " .. write_operand node.source
    BorrowOwned = do(node, recurse) = write_operand node.result .. " = borrow " .. write_operand node.owner
    ObserveBorrow = do(node, recurse) = "observe " .. write_operand node.reference
    EndOwned = do(node, recurse) = "end owned " .. write_operand node.owner
    ReleaseExtent = do(node, recurse) = "release extent " .. node.extent
    CompleteBoundary = do(node, recurse) = "complete boundary (pending realization)"
    StackTop = do(node, recurse) = write_operand node.result .. " = stack.top " .. node.role
    StackWrite = do(node, recurse) = "stack.top " .. node.role .. " <- " .. write_operand node.top
    Greater = do(node, recurse) = write_operand node.result .. " = greater " .. write_operand node.left .. ", " .. write_operand node.right
    ExternalGrowth = do(node, recurse) = "external growth " .. node.role .. " by " .. node.amount
    Call = do(node, recurse) = write_operand node.result .. " = call " .. node.callee .. "(" .. write_arguments node.arguments .. ")"
end
local write_terminator = Terminator.pass "print terminator" with
    Jump = do(node, recurse) = "jump " .. write_edge node.edge
    Branch = do(node, recurse)
        return "branch " .. write_operand node.condition .. ", " .. write_edge node.when_true ..
        ", " .. write_edge node.when_false
    end
    Return = do(node, recurse) = "return " .. write_operand node.value
    Trap = do(node, recurse) = "trap " .. node.message
end
local write_contents = Contents.pass "print contents knowledge" with
    Uninitialized = do(node, recurse) = "uninitialized"
    Tracked = do(node, recurse) = "tracked " .. write_operand node.value.operand
    InMemory = do(node, recurse) = "memory"
    Moved = do(node, recurse) = "moved"
end
local write_definition = do(definition)
    local lines = { "definition " .. definition.identity .. "(" ..
        write_arguments definition.parameters .. ") -> " .. definition.result_type }
    for _, place in ipairs definition.places do
        lines[#lines + 1] = "  place @" .. place.identity .. " " .. place.name .. ": " .. place.native_type
    end
    for _, fact in ipairs definition.references do
        lines[#lines + 1] = "  reference " .. write_operand fact.operand .. " borrows [" ..
        write_origins fact.origins .. "]"
    end
    for _, extent in ipairs definition.extents do
        lines[#lines + 1] = "  extent " .. extent.identity .. " " .. extent.name
    end
    for _, fact in ipairs definition.owners do
        local candidates = {}
        for _, allocation in ipairs fact.allocations do
            candidates[#candidates + 1] = allocation.identity .. "/" .. allocation.extent
        end
        lines[#lines + 1] = "  owner " .. write_operand fact.operand .. " candidates [" .. table.concat(candidates,
            ", ") .. "]"
    end
    for _, lease in ipairs(definition.leases or {}) do
        lines[#lines + 1] = "  lease " .. write_operand lease.index .. " at " .. write_operand lease.mark
    end
    for _, capture in ipairs(definition.captures or {}) do
        lines[#lines + 1] = "  completion authority " .. write_operand capture.index .. " at " .. write_operand capture.mark
    end
    if definition.region_scope then
        lines[#lines + 1] = "  region " .. definition.region_scope .. " " .. definition.completion_mode ..
        " positions [" .. write_arguments(definition.regions or {}) .. "]"
    end
    for _, fact in ipairs(definition.completion_relations or {}) do
        local members = {}
        for _, member in ipairs fact.members do
            members[#members + 1] = write_operand member.index .. " if " .. write_operand member.guard
        end
        lines[#lines + 1] = "  completion " .. write_operand fact.operand .. " [" .. table.concat(members,
            ", ") .. "]"
    end
    for _, assignment in ipairs(definition.placement or {}) do
        lines[#lines + 1] = "  placement " .. assignment.allocation .. "/" .. assignment.extent .. " -> " .. assignment.role .. " captured " .. write_operand assignment.mark
    end
    for _, block in ipairs definition.blocks do
        lines[#lines + 1] = block.identity .. "(" .. write_arguments block.arguments .. "):"
        for _, instruction in ipairs block.instructions do
            lines[#lines + 1] = "  " .. write_instruction instruction .. (instruction.index and (" [position " .. write_operand instruction.index .. "]") or "")
        end
        lines[#lines + 1] = "  " .. write_terminator block.terminator
    end
    lines[#lines + 1] = "return origins [" .. write_origins definition.return_origins .. "]"
    lines[#lines + 1] = "return reclamation [" .. table.concat(definition.return_extents, ", ") .. "]"
    return table.concat(lines, "\n")
end

------------------------------------------------------------------------------------------------
-- The verifier does not execute source closures. It checks the produced graph independently.
-- Intraprocedural control flow is acyclic here. A flat registry can resolve cyclic
-- native calls without embedding cyclic Definition tables or replaying source.

local copy_keys = do(source)
    local result = {}
    for key, value in pairs source do result[key] = value end
    return result
end
local intersect = do(left)
    return do(right)
        local result = {}
        for key, value in pairs left do if right[key] then result[key] = value end end
        return result
    end
end
local merge_origins = do(left)
    return do(right)
        local result, seen = {}, {}
        for _, origins in ipairs { left, right } do
            for _, origin in ipairs origins do
                local earlier = seen[origin.identity]
                if earlier then
                    assert(earlier.holding == origin.holding and earlier.guarantee == origin.guarantee,
                        "conflicting origin identity")
                else
                    seen[origin.identity] = origin
                    result[#result + 1] = origin
                end
            end
        end
        return result
    end
end
local same_origins = do(left)
    return do(right)
        local union = merge_origins left right
        return #union == #left and #union == #right
    end
end
local edges = Terminator.pass "outgoing edges" with
    Jump = do(node, recurse) = { node.edge }
    Branch = do(node, recurse) = { node.when_true, node.when_false }
    Return = do(node, recurse) = {}
    Trap = do(node, recurse) = {}
end
local result_of = Instruction.pass "instruction definition" with
    Add = do(node, recurse) = node.result
    Load = do(node, recurse) = node.result
    Store = do(node, recurse) = nil
    Expose = do(node, recurse) = nil
    EndContents = do(node, recurse) = nil
    BeginExtent = do(node, recurse) = nil
    BeginOwned = do(node, recurse) = node.result
    TransferOwned = do(node, recurse) = node.result
    BorrowOwned = do(node, recurse) = node.result
    ObserveBorrow = do(node, recurse) = nil
    EndOwned = do(node, recurse) = nil
    ReleaseExtent = do(node, recurse) = nil
    CompleteBoundary = do(node, recurse) = nil
    StackTop = do(node, recurse) = node.result
    StackWrite = do(node, recurse) = nil
    Greater = do(node, recurse) = node.result
    ExternalGrowth = do(node, recurse) = nil
    Call = do(node, recurse) = node.result
end

-- Finite acyclic proof alternatives. These are compiler facts, not runtime drop flags,
-- reference counts, a second IR, or a proposed scalable loop-analysis representation.
local merge_allocations = do(left) = do(right)
    local result, seen = {}, {}
    for _, allocations in ipairs { left, right } do
        for _, allocation in ipairs allocations do
            if seen[allocation.identity] then
                assert(seen[allocation.identity] == allocation, "conflicting allocation identity")
            else
                seen[allocation.identity] = allocation
                result[#result + 1] = allocation
            end
        end
    end
    return result
end
local same_allocations = do(left) = do(right)
    local union = merge_allocations left right
    return #union == #left and #union == #right
end
local allocation_origins = do(allocations)
    local origins = {}
    for _, allocation in ipairs allocations do origins[#origins + 1] = allocation.origin end
    return origins
end
local new_ownership = do()
    return { values = {},
        holdings = {},
        references = {}, ended = {}, begun = {}, released = {}, pending = {}, allocated = {} }
end
local copy_ownership = do(facts)
    return { values = copy_keys facts.values, holdings = copy_keys facts.holdings,
        references = copy_keys facts.references, ended = copy_keys facts.ended,
        begun = copy_keys facts.begun,
        released = copy_keys facts.released,
        pending = copy_keys facts.pending, allocated = copy_keys facts.allocated }
end
local held_allocation = do(facts) = do(operand)
    local allocation = assert(facts.values[operand.identity],
        "owner has no allocation on this path")
    assert(facts.holdings[allocation.identity] == operand.identity, "owner was moved or ended")
    assert(not facts.released[allocation.extent], "owner's reclamation group was released")
    return allocation
end
local check_origins = do(facts) = do(origins)
    for _, origin in ipairs origins do
        assert(not facts.ended[origin.identity], "borrow of ended contents " .. origin.identity)
    end
end
local transfer_facts = do(facts) = do(source) = do(destination)
    local allocation = held_allocation facts source
    facts.values[destination.identity] = allocation
    facts.holdings[allocation.identity] = destination.identity
end
local end_facts = do(facts) = do(operand)
    local allocation = held_allocation facts operand
    facts.holdings[allocation.identity] = nil
    facts.ended[allocation.origin.identity] = true
end
local release_facts = do(facts) = do(extent)
    assert(facts.begun[extent], "reclamation group was not begun on this path")
    assert(not facts.released[extent], "reclamation group released twice")
    for _, operand in pairs facts.holdings do
        assert(facts.values[operand].extent ~= extent, "release would reclaim a live holding")
    end
    facts.released[extent] = true
end
local edge_ownership = do(facts) = do(arguments) = do(supplied)
    local incoming, captures, consumed = copy_ownership facts, {}, {}
    -- Capture every edge input before changing any custody, including swaps.
    for index, argument in ipairs arguments do
        local source = supplied[index]
        if argument.native_type == "Owned U32" then
            local allocation = held_allocation facts source
            assert(not consumed[allocation.identity], "edge duplicates an owning holding")
            consumed[allocation.identity] = true
            captures[index] = allocation
        elseif argument.native_type == "Ref U32" then
            incoming.references[argument.identity] = assert(facts.references[source.identity],
                "edge reference has no origins")
        end
    end
    for index, allocation in pairs captures do
        local destination = arguments[index].identity
        incoming.values[destination], incoming.holdings[allocation.identity] = allocation, destination
    end
    return incoming
end

-- Native-call summaries are derived from the same checked graph, not supplied by fixtures.
local verify_lifetimes
local input_allocations = do(definition)
    local imported = {}
    for _, parameter in ipairs definition.parameters do
        if parameter.native_type == "Owned U32" then
            for _, fact in ipairs definition.owners do
                if fact.operand == parameter then
                    assert(#fact.allocations == 1, "native input needs one formal holding")
                    imported[parameter.identity] = fact.allocations[1]
                end
            end
            assert(imported[parameter.identity], "missing input ownership")
        end
    end
    return imported
end
local call_states = do(callee) = do(node) = do(facts)
    local formal_inputs = input_allocations callee
    local bindings, consumed, declared, actuals = {}, {}, {}, {}
    for _, allocation in ipairs callee.allocations do declared[allocation.identity] = allocation end
    for index, parameter in ipairs callee.parameters do
        if formal_inputs[parameter.identity] then
            local allocation = held_allocation facts node.arguments[index]
            assert(not consumed[allocation.identity], "call duplicates an owning holding")
            consumed[allocation.identity] = true
            bindings[formal_inputs[parameter.identity].identity] = allocation
        end
    end
    for _, instance in ipairs node.instances do
        assert(declared[instance.formal], "unknown native allocation site")
        assert(not bindings[instance.formal], "duplicate native allocation binding")
        assert(not facts.allocated[instance.allocation.identity] and not actuals[instance.allocation.identity],
            "native fresh allocation aliases an existing allocation identity")
        actuals[instance.allocation.identity] = true
        bindings[instance.formal] = instance.allocation
    end
    for _, allocation in ipairs callee.allocations do assert(bindings[allocation.identity],
            "missing native allocation binding") end
    local summary = verify_lifetimes callee
    local alternatives = {}
    for _, outcome in ipairs summary.outcomes do
        assert(not outcome.trap, "probe native-call trap needs an unwind contract")
        local next_facts = copy_ownership facts
        for identity in pairs consumed do next_facts.holdings[identity] = nil end
        for _, allocation in pairs outcome.facts.allocated do
            local actual = assert bindings[allocation.identity]
            next_facts.begun[actual.extent] = true
            next_facts.allocated[actual.identity] = actual
            if outcome.facts.ended[allocation.origin.identity] then next_facts.ended[actual.origin.identity] = true end
        end
        if outcome.returned then
            local actual = bindings[outcome.returned.identity]
            next_facts.values[node.result.identity], next_facts.holdings[actual.identity] = actual, node.result.identity
        end
        alternatives[#alternatives + 1] = next_facts
    end
    return alternatives
end
verify_lifetimes = do(definition)
    local blocks, references, owners, extents, allocations = {}, {}, {}, {}, {}
    for _, block in ipairs definition.blocks do blocks[block.identity] = block end
    for _, fact in ipairs definition.references do references[fact.operand.identity] = fact.origins end
    for _, fact in ipairs definition.owners do owners[fact.operand.identity] = fact.allocations end
    for _, extent in ipairs definition.extents do
        assert(not extents[extent.identity], "duplicate reclamation group")
        extents[extent.identity] = extent
    end
    for _, allocation in ipairs definition.allocations do
        assert(not allocations[allocation.identity], "duplicate allocation")
        assert(extents[allocation.extent], "allocation names an unknown reclamation group")
        assert(allocation.origin.holding == allocation.identity,
            "allocation origin names a different holding")
        allocations[allocation.identity] = allocation
    end
    local callees, outcomes, interference, call_outputs = {}, {}, {}, {}
    for _, callee in ipairs(definition.callees or {}) do callees[callee.identity] = callee end
    local initial = new_ownership()
    for _, parameter in ipairs definition.parameters do
        if parameter.native_type == "Ref U32" then
            initial.references[parameter.identity] = references[parameter.identity]
        elseif parameter.native_type == "Owned U32" then
            local candidates = owners[parameter.identity]
            assert(#candidates == 1, "probe imported owner needs one boundary-relative allocation")
            local allocation = candidates[1]
            assert(allocations[allocation.identity] == allocation, "unknown imported allocation")
            assert(not initial.holdings[allocation.identity], "two parameters own one holding")
            initial.values[parameter.identity], initial.holdings[allocation.identity] = allocation, parameter.identity
            initial.begun[allocation.extent] = true
            initial.allocated[allocation.identity] = allocation
        end
    end
    local observing = do(facts) = do(operand)
        if operand_type operand == "Ref U32" then
            check_origins facts (assert(facts.references[operand.identity],
                    "reference has no path origins"))
        end
    end
    local checking = Instruction.pass "verify ownership and lifetime obligations" with
        Add = do(node, recurse, facts) end
        Load = do(node, recurse, facts) end
        Store = do(node, recurse, facts) observing facts node.value end
        Expose = do(node, recurse, facts) end
        EndContents = do(node, recurse, facts) facts.ended[node.origin.identity] = true end
        BeginExtent = do(node, recurse, facts)
            assert(extents[node.extent], "unknown reclamation group")
            assert(not facts.begun[node.extent], "reclamation group begun twice")
            facts.begun[node.extent] = true
        end
        BeginOwned = do(node, recurse, facts)
            local allocation = node.allocation
            assert(allocations[allocation.identity] == allocation, "unknown allocation")
            assert(facts.begun[allocation.extent] and not facts.released[allocation.extent],
                "allocation outside live reclamation group")
            for _,
            earlier in pairs facts.values do assert(earlier ~= allocation, "allocation begun twice") end
            for held in pairs facts.holdings do
                interference[allocation.identity] = interference[allocation.identity] or {}
                interference[held] = interference[held] or {}
                interference[allocation.identity][held],
                interference[held][allocation.identity] = true, true
            end
            facts.allocated[allocation.identity] = allocation
            facts.values[node.result.identity],
            facts.holdings[allocation.identity] = allocation, node.result.identity
        end
        TransferOwned = do(node, recurse, facts) transfer_facts facts node.source node.result end
        BorrowOwned = do(node, recurse, facts)
            local allocation = held_allocation facts node.owner
            facts.references[node.result.identity] = { allocation.origin }
        end
        ObserveBorrow = do(node, recurse, facts) observing facts node.reference end
        EndOwned = do(node, recurse, facts) end_facts facts node.owner end
        ReleaseExtent = do(node, recurse, facts) release_facts facts node.extent end
        CompleteBoundary = do(node, recurse, facts)
            assert(next facts.holdings == nil, "boundary leaves a live owning temporary")
            for extent in pairs facts.begun do if not facts.released[extent] then facts.pending[extent] = true end end
        end
        StackTop = do(node, recurse, facts) end
        Greater = do(node, recurse, facts) end
        ExternalGrowth = do(node, recurse, facts) end
        StackWrite = do(node, recurse, facts) end
        Call = do(node, recurse, facts)
            local alternatives = call_states (assert(callees[node.callee], "unknown callee")) node facts
            if node.result.native_type == "Owned U32" then
                local candidates = call_outputs[node.result.identity] or {}
                for _,
                after in ipairs alternatives do candidates = merge_allocations (candidates) { assert after.values[node.result.identity] } end
                call_outputs[node.result.identity] = candidates
            end
            return alternatives
        end
    end
    local returned_extents, edge_paths, walk_paths = {}, {}, nil
    -- Bounded path evidence for storage normalization. These are compiler facts over
    -- this graph, not another program or runtime cleanup flags.
    walk_paths = do(block) = do(facts) = do(visited) = do(selections)
        visited = copy_keys visited
        local alternatives = { facts }
        for _, instruction in ipairs block.instructions do
            visited[instruction] = true
            local following = {}
            for _, before in ipairs alternatives do
                for _, after in ipairs(checking(instruction, before) or { before }) do following[#following + 1] = after end
            end
            alternatives = following
        end
        for _, facts in ipairs alternatives do
            local ending = block.terminator
            if Terminator.is(ending, Return) or Terminator.is(ending, Trap) then
                local returned_allocation
                if Terminator.is(ending, Return) then
                    observing facts ending.value
                    if operand_type ending.value == "Owned U32" then returned_allocation = held_allocation facts ending.value end
                end
                for allocation in pairs facts.holdings do
                    assert(returned_allocation and returned_allocation.identity == allocation,
                        "live holding exits without transfer")
                end
                for extent in pairs facts.begun do
                    if not facts.released[extent] then
                        assert(returned_allocation or facts.pending[extent],
                            "exit leaves reclamation work unowned")
                        if returned_allocation then returned_extents[extent] = true end
                    end
                end
                outcomes[#outcomes + 1] = { .facts, .visited, .ending,
                    returned = returned_allocation, trap = Terminator.is(ending, Trap) }
            else
                for _, edge in ipairs(edges ending) do
                    local target = blocks[edge.target]
                    local seen, selected = copy_keys visited, copy_keys selections
                    seen[edge], selected[target.identity] = true, edge
                    edge_paths[edge] = edge_paths[edge] or {}
                    edge_paths[edge][#edge_paths[edge] + 1] = { visited = seen,
                        selections = selected }
                    walk_paths target (edge_ownership facts target.arguments edge.arguments) seen selected
                end
            end
        end
    end
    walk_paths blocks[definition.entry] initial ({}) {}
    for identity, candidates in pairs call_outputs do
        assert(same_allocations candidates owners[identity],
            "native result ownership contract mismatch")
    end
    local supplied = {}
    for _, extent in ipairs definition.return_extents do
        assert(returned_extents[extent] and not supplied[extent],
            "incorrect returned reclamation contract")
        supplied[extent] = true
    end
    for extent in pairs returned_extents do assert(supplied[extent],
            "returned header lost reclamation obligation") end
    return { .outcomes, .interference, .edge_paths }
end

local verify_graph = do(definition, registry)
    local blocks, predecessors, bindings, places, references, owners = {}, {}, {}, {}, {}, {}
    local register = do(operand)
        assert(not bindings[operand.identity], "duplicate value identity")
        bindings[operand.identity] = operand
    end
    local callees, declared = copy_keys(registry or {}), {}
    for _, callee in ipairs(definition.callees or {}) do
        assert(not declared[callee.identity], "duplicate native definition")
        assert(not callees[callee.identity] or callees[callee.identity] == callee,
            "conflicting registered native definition")
        callees[callee.identity], declared[callee.identity] = callee, true
    end
    for _, parameter in ipairs definition.parameters do register parameter end
    for _, place in ipairs definition.places do
        assert(not places[place.identity], "duplicate place identity")
        places[place.identity] = place
    end
    for _, block in ipairs definition.blocks do
        assert(not blocks[block.identity], "duplicate block identity")
        blocks[block.identity], predecessors[block.identity] = block, {}
        for _, argument in ipairs block.arguments do register argument end
        for _, instruction in ipairs block.instructions do
            local result = result_of instruction
            if result then register result end
        end
    end
    assert(blocks[definition.entry], "missing entry")
    assert(#blocks[definition.entry].arguments == 0, "entry arguments are definition parameters")
    for _, fact in ipairs definition.references do
        assert(operand_type fact.operand == "Ref U32", "reference fact on non-reference")
        assert(bindings[fact.operand.identity] == fact.operand, "reference fact has no definition")
        assert(not references[fact.operand.identity], "duplicate reference fact")
        assert(#fact.origins > 0, "probe reference requires an origin")
        references[fact.operand.identity] = fact.origins
    end
    for _, fact in ipairs definition.owners do
        assert(operand_type fact.operand == "Owned U32", "ownership fact on non-owner")
        assert(bindings[fact.operand.identity] == fact.operand, "ownership fact has no definition")
        assert(not owners[fact.operand.identity] and #fact.allocations > 0,
            "invalid ownership fact")
        owners[fact.operand.identity] = fact.allocations
    end
    for _, port in ipairs(definition.regions or {}) do
        assert(Operand.is(port, Parameter) and operand_type port == "U64" and bindings[port.identity] == port,
            "region port is not a canonical native parameter")
    end
    local completed_owners = {}
    for _, fact in ipairs(definition.completion_relations or {}) do
        assert(not completed_owners[fact.operand.identity], "duplicate completion fact")
        completed_owners[fact.operand.identity] = true
        assert(bindings[fact.operand.identity] == fact.operand and operand_type fact.operand == "Owned U32",
            "completion relation lacks a canonical owner")
        for _, member in ipairs fact.members do
            assert(operand_type member.index == "U64" and operand_type member.guard == "Bool",
                "invalid completion relation operands")
            for _, value in ipairs { member.index, member.guard } do
                assert(not value.identity or bindings[value.identity] == value,
                    "completion relation operand is not canonical")
            end
        end
    end
    for identity, operand in pairs bindings do
        if operand_type operand == "Ref U32" then assert(references[identity],
                "missing reference facts") end
        if operand_type operand == "Owned U32" then assert(owners[identity],
                "missing ownership facts") end
    end
    for _, block in ipairs definition.blocks do
        for _, edge in ipairs(edges block.terminator) do
            assert(blocks[edge.target], "missing edge target")
            local incoming = predecessors[edge.target]
            incoming[#incoming + 1] = { block = block.identity, arguments = edge.arguments }
        end
    end
    assert(#predecessors[definition.entry] == 0, "entry has a predecessor")

    local visiting, visited, reverse_order = {}, {}, {}
    local visit
    visit = do(identity)
        assert(not visiting[identity], "probe verifier does not implement cyclic regions")
        if visited[identity] then return end
        visiting[identity] = true
        for _, edge in ipairs(edges blocks[identity].terminator) do visit edge.target end
        visiting[identity], visited[identity] = nil, true
        reverse_order[#reverse_order + 1] = identity
    end
    visit definition.entry
    assert(#reverse_order == #definition.blocks, "unreachable published block")

    local outgoing, return_origins = {}, {}
    for index = #reverse_order, 1, -1 do
        local identity = reverse_order[index]
        local block = blocks[identity]
        local available, stored = {}, {}
        if identity == definition.entry then
            for _, parameter in ipairs definition.parameters do available[parameter.identity] = true end
        else
            local incoming = predecessors[identity]
            available = copy_keys outgoing[incoming[1].block].available
            stored = copy_keys outgoing[incoming[1].block].stored
            for _, edge in ipairs incoming do
                local facts = outgoing[edge.block]
                available = intersect available facts.available
                stored = intersect stored facts.stored
                assert(#edge.arguments == #block.arguments, "edge arity mismatch")
            end
            for position, argument in ipairs block.arguments do
                local origins, candidates = {}, {}
                for _, edge in ipairs incoming do
                    local operand = edge.arguments[position]
                    assert(operand_type operand == operand_type argument, "edge type mismatch")
                    if argument.native_type == "Ref U32" then
                        origins = merge_origins origins (assert(references[operand.identity],
                                "missing reference facts"))
                    elseif argument.native_type == "Owned U32" then
                        candidates = merge_allocations candidates (assert(owners[operand.identity],
                                "missing ownership facts"))
                    end
                end
                if argument.native_type == "Ref U32" then
                    assert(same_origins origins (assert(references[argument.identity],
                                "missing join origins")),
                        "reference join lost or invented origins")
                end
                if argument.native_type == "Owned U32" then
                    assert(same_allocations candidates owners[argument.identity],
                        "owner join lost or invented allocation")
                end
                available[argument.identity] = true
            end
        end
        local use = do(operand)
            if operand.identity then
                assert(bindings[operand.identity] == operand, "operand identity is not canonical")
                assert(available[operand.identity], "operand does not dominate use")
            end
            return operand_type operand
        end
        -- Availability is a graph fact. Liveness is checked below on ownership alternatives,
        -- keeping a selected pointer correlated with the holding that survived its edge.
        local observe = use
        local require_stored = do(identity)
            assert(places[identity], "unknown place")
            assert(stored[identity], "memory observed before initialization")
            assert(places[identity].native_type == "U32", "probe memory access requires U32")
        end
        -- These handlers capture one block's analysis, not a mutable 'current block' slot.
        local checking = Instruction.pass "check instruction" with
            Add = do(node, recurse)
                assert(use node.left == "U32" and use node.right == "U32", "add type mismatch")
                assert(node.result.native_type == "U32", "add result type mismatch")
            end
            Load = do(node, recurse)
                require_stored node.place
                assert(node.result.native_type == "U32", "load result type mismatch")
            end
            Store = do(node, recurse)
                assert(places[node.place], "unknown store place")
                assert(places[node.place].native_type ~= "Owned U32",
                    "owner store requires transfer")
                assert(observe node.value == places[node.place].native_type, "store type mismatch")
                stored[node.place] = true
            end
            Expose = do(node, recurse) require_stored node.place end
            EndContents = do(node, recurse) end
            BeginExtent = do(node, recurse) end
            BeginOwned = do(node, recurse)
                assert(use node.initial == "U32" and node.result.native_type == "Owned U32",
                    "owned initialization type mismatch")
                assert(same_allocations (owners[node.result.identity]) { node.allocation },
                    "allocation fact mismatch")
            end
            TransferOwned = do(node, recurse)
                assert(use node.source == "Owned U32" and node.result.native_type == "Owned U32",
                    "transfer type mismatch")
                assert(same_allocations owners[node.source.identity] owners[node.result.identity],
                    "transfer lost allocation")
            end
            BorrowOwned = do(node, recurse)
                assert(use node.owner == "Owned U32" and node.result.native_type == "Ref U32",
                    "owner borrow type mismatch")
                assert(same_origins (allocation_origins owners[node.owner.identity]) references[node.result.identity],
                    "owner borrow lost origin")
            end
            ObserveBorrow = do(node, recurse) assert(use node.reference == "Ref U32",
                    "borrow observation type mismatch") end
            EndOwned = do(node, recurse) assert(use node.owner == "Owned U32", "end type mismatch") end
            ReleaseExtent = do(node, recurse) end
            CompleteBoundary = do(node, recurse) end
            StackTop = do(node, recurse) assert(node.result.native_type == "U64", "top must be U64") end
            StackWrite = do(node, recurse) assert(use node.top == "U64", "top write must be U64") end
            Greater = do(node, recurse)
                local native_type = use node.left
                assert((native_type == "U64" or native_type == "U32") and use node.right == native_type and node.result.native_type == "Bool",
                    "comparison type mismatch")
            end
            ExternalGrowth = do(node, recurse) end
            Call = do(node, recurse)
                local callee = assert(callees[node.callee], "unknown native target")
                assert(#node.arguments == #callee.parameters, "native call arity mismatch")
                for index, parameter in ipairs callee.parameters do
                    assert(use node.arguments[index] == parameter.native_type,
                        "native argument type mismatch")
                end
                assert(node.result.native_type == callee.result_type, "native result type mismatch")
                for _, instance in ipairs node.instances do
                    local found = false
                    for _,
                    allocation in ipairs definition.allocations do if instance.allocation == allocation then found = true end end
                    assert(found, "native instance is not a declared allocation")
                end
            end
        end
        for index, instruction in ipairs block.instructions do
            if Instruction.is(instruction, CompleteBoundary) then
                assert(index == #block.instructions and (Terminator.is(block.terminator, Return) or Terminator.is(block.terminator,
                            Trap)),
                    "pending completion must immediately precede its boundary exit")
            end
            if instruction.index then assert(use instruction.index == "U64", "position must be U64") end
            checking instruction
            local result = result_of instruction
            if result then available[result.identity] = true end
        end
        local checking_end = Terminator.pass "check terminator" with
            Jump = do(node, recurse) end
            Branch = do(node, recurse) assert(use node.condition == "Bool", "branch type mismatch") end
            Return = do(node, recurse)
                assert(observe node.value == definition.result_type, "return type mismatch")
                if definition.result_type == "Ref U32" then
                    return_origins = merge_origins return_origins references[node.value.identity]
                end
            end
            Trap = do(node, recurse) end
        end
        checking_end block.terminator
        for _, edge in ipairs(edges block.terminator) do
            for _, argument in ipairs edge.arguments do use argument end
        end
        outgoing[identity] = { .available, .stored }
    end
    assert(same_origins return_origins definition.return_origins,
        "incorrect return-origin contract")
    return definition
end
local verify = do(definition)
    assert(not definition.placement and not definition.completion_mode,
        "realized storage needs graph and storage verification, not logical verification")
    verify_graph definition
    verify_lifetimes definition
    return definition
end

------------------------------------------------------------------------------------------------
-- One evaluation activity. Helpers capture its output; path facts are explicit and forked.
-- All public helper arguments are curried, including the two delayed arms of a conditional.

local unsigned = value -> Scalar { operand = UnsignedConstant { .value } }
local boolean = value -> Scalar { operand = BooleanConstant { .value } }
local wide = value -> Scalar { operand = WideConstant { value = ffi.new("uint64_t", value) } }
local unit = do() = Scalar { operand = UnitConstant {} }
local parameter = native_type -> identity -> Scalar with
    operand = Parameter { .identity, .native_type }
end
local reference_parameter = identity -> origins -> Reference with
    operand = Parameter { .identity, native_type = "Ref U32" }
    .origins
end
local owner_parameter = identity -> allocations -> Owner with
    operand = Parameter { .identity, native_type = "Owned U32" }
    .allocations
end

-- This vocabulary groups the ownership shapes/contracts, not activity state. Besides naming
-- the subsystem it avoids LuaJIT's 60-upvalue limit in the deliberately single-file probe.
local Ownership = define
    .Owner
    .Moved
    .Extent
    .Allocation
    .OwnershipFact
    .BeginExtent
    .BeginOwned
    .TransferOwned
    .BorrowOwned
    .ObserveBorrow
    .EndOwned
    .ReleaseExtent
    .new_ownership
    .copy_ownership
    .held_allocation
    .check_origins
    .transfer_facts
    .end_facts
    .release_facts
    .edge_ownership
    .merge_allocations
    .same_allocations
    .allocation_origins
end
local Storage = define
    .StackTop
    .StackWrite
    .Greater
    .ExternalGrowth
    .CompleteBoundary
    .WideConstant
end
local NativeCalls = define
    .Call
    .Instance
    .input_allocations
    .call_states
end
local construct = do(name)
    return do(inputs)
        return do(result_type)
            return do(body)
                local Owner, Moved, Extent, Allocation, OwnershipFact = Ownership.Owner, Ownership.Moved,
                Ownership.Extent, Ownership.Allocation, Ownership.OwnershipFact
                local BeginExtent, BeginOwned, TransferOwned, BorrowOwned = Ownership.BeginExtent,
                Ownership.BeginOwned, Ownership.TransferOwned, Ownership.BorrowOwned
                local ObserveBorrow, EndOwned, ReleaseExtent = Ownership.ObserveBorrow, Ownership.EndOwned, Ownership.ReleaseExtent
                local new_ownership, copy_ownership, held_allocation, check_origins = Ownership.new_ownership,
                Ownership.copy_ownership, Ownership.held_allocation, Ownership.check_origins
                local transfer_facts, end_facts, release_facts, edge_ownership = Ownership.transfer_facts,
                Ownership.end_facts, Ownership.release_facts, Ownership.edge_ownership
                local merge_allocations, same_allocations, allocation_origins = Ownership.merge_allocations,
                Ownership.same_allocations, Ownership.allocation_origins
                local StackTop, StackWrite, Greater, ExternalGrowth, CompleteBoundary, WideConstant =
                Storage.StackTop, Storage.StackWrite, Storage.Greater, Storage.ExternalGrowth, Storage.CompleteBoundary, Storage.WideConstant
                local blocks, places, reference_facts, trace = {}, {}, {}, {}
                local parameters, seen_parameters, seen_references = {}, {}, {}
                local owned_paths, declared_places = {}, {}
                local extents, allocations, owner_facts, return_extents = {}, {}, {}, {}
                local callees, callee_names = {}, {}
                local extent_by_identity, seen_owners = {}, {}
                local return_origins, next_identity, completed = {}, 0, false
                local fresh = do(label)
                    next_identity += 1
                    return label .. "_" .. next_identity
                end
                local site = operation -> name .. "/" .. operation
                local new_block = do(label)
                    local block = { identity = fresh label, arguments = {}, instructions = {} }
                    blocks[#blocks + 1] = block
                    return block
                end
                local entry = new_block "entry"
                local path = { block = entry, locals = {}, contents = {}, memory = {},
                    alternatives = { new_ownership() } }
                owned_paths[path] = true
                local live = do(path)
                    assert(not completed, "evaluation activity is complete")
                    assert(owned_paths[path], "path belongs to another activity")
                    assert(path.block, "operation on terminated path")
                end
                local remember_reference = do(value)
                    local identity = value.operand.identity
                    assert(identity, "reference operand must have an identity")
                    if seen_references[identity] then
                        assert(same_origins seen_references[identity] value.origins,
                            "one operand acquired conflicting reference facts")
                    else
                        seen_references[identity] = value.origins
                        reference_facts[#reference_facts + 1] = ReferenceFact with
                            operand = value.operand
                            origins = value.origins
                        end
                    end
                end
                local remember_owner = do(value)
                    local identity = value.operand.identity
                    if seen_owners[identity] then
                        assert(same_allocations seen_owners[identity] value.allocations,
                            "conflicting ownership facts")
                    else
                        seen_owners[identity] = value.allocations
                        owner_facts[#owner_facts + 1] = OwnershipFact with
                            operand = value.operand
                            allocations = value.allocations
                        end
                    end
                end
                local validate_value = Staged.pass "check staged use" with
                    Scalar = do(node, recurse, path)
                        assert(operand_type node.operand ~= "Ref U32", "reference lacks origins")
                        assert(operand_type node.operand ~= "Owned U32",
                            "owner lacks holding facts")
                    end
                    Reference = do(node, recurse, path)
                        assert(operand_type node.operand == "Ref U32", "reference type mismatch")
                        for _, facts in ipairs path.alternatives do
                            check_origins facts (facts.references[node.operand.identity] or node.origins)
                        end
                        remember_reference node
                    end
                    Owner = do(node, recurse, path)
                        assert(operand_type node.operand == "Owned U32", "owner type mismatch")
                        for _,
                        facts in ipairs path.alternatives do held_allocation facts node.operand end
                        remember_owner node
                    end
                end
                local record = do(path)
                    return do(label)
                        local facts = {}
                        for _, place in ipairs path.locals do
                            facts[#facts + 1] = place.name .. "=" .. write_contents path.contents[place.identity]
                        end
                        trace[#trace + 1] = label .. " [" .. table.concat(facts, "; ") .. "]"
                        if #extents > 0 then
                            for index, alternative in ipairs path.alternatives do
                                local holdings = {}
                                for allocation, operand in pairs alternative.holdings do
                                    holdings[#holdings + 1] = allocation .. "->%" .. operand
                                end
                                table.sort holdings
                                trace[#trace + 1] = "  ownership alternative " .. index .. " [" .. table.concat(holdings,
                                    ", ") .. "]"
                            end
                        end
                    end
                end
                local emit = do(path)
                    return do(instruction)
                        live path
                        path.block.instructions[#path.block.instructions + 1] = instruction
                    end
                end
                local contents = do(path)
                    return do(place)
                        live path
                        assert(declared_places[place.identity] == place,
                            "place belongs to another activity")
                        return assert(path.contents[place.identity], "place is outside this path")
                    end
                end
                local declare = do(path)
                    return do(label)
                        return do(native_type)
                            live path
                            local place = Place with
                                identity = fresh "place"
                                name = label
                                .native_type
                            end
                            declared_places[place.identity] = place
                            places[#places + 1], path.locals[#path.locals + 1] = place, place
                            path.contents[place.identity] = Uninitialized {}
                            record path ("declare " .. label)
                            return place
                        end
                    end
                end
                local read = do(path)
                    return do(place)
                        local fact = contents path place
                        assert(not Contents.is(fact, Moved), "read of moved " .. place.name)
                        assert(place.native_type ~= "Owned U32",
                            "owner read requires move or borrow")
                        assert(not Contents.is(fact, Uninitialized),
                            "read of uninitialized " .. place.name)
                        local value
                        if Contents.is(fact, Tracked) then
                            value = fact.value
                        else
                            assert(place.native_type == "U32",
                                "probe memory reads implement U32 only")
                            local result = Result { identity = fresh "read", native_type = place.native_type }
                            emit path (Load { .result, place = place.identity, at = site "read" })
                            value = Scalar { operand = result }
                        end
                        validate_value(value, path)
                        record path ("read " .. place.name .. " -> " .. write_operand value.operand)
                        return value
                    end
                end
                local transfer_owner, end_owner_value
                local write = do(path)
                    return do(place)
                        return do(value)
                            local previous = contents path place
                            validate_value(value, path)
                            assert(operand_type value.operand == place.native_type,
                                "write type mismatch")
                            if place.native_type == "Owned U32" then
                                -- Capture the supplied owner before ending the overwritten holding.
                                local captured = transfer_owner path value
                                if Contents.is(previous, Tracked) then end_owner_value path previous.value end
                                path.contents[place.identity] = Tracked { value = captured }
                                record path ("replace owner " .. place.name)
                                return
                            end
                            if path.memory[place.identity] then
                                assert(place.native_type == "U32",
                                    "probe memory writes implement U32 only")
                                emit path (Store with
                                    place = place.identity
                                    value = value.operand
                                    at = site "write"
                                end)
                                path.contents[place.identity] = InMemory {}
                            else
                                path.contents[place.identity] = Tracked { .value }
                            end
                            record path ("write " .. place.name)
                        end
                    end
                end
                -- Each operation changes its path facts and produces its required work together.
                transfer_owner = do(path) = do(value)
                    live path
                    assert(Staged.is(value, Owner), "transfer needs an owner")
                    validate_value(value, path)
                    local result = Result { identity = fresh "holding", native_type = "Owned U32" }
                    emit path (TransferOwned with
                        .result
                        source = value.operand
                        at = site "transfer"
                    end)
                    for _, facts in ipairs path.alternatives do transfer_facts facts value.operand result end
                    local transferred = Owner { operand = result, allocations = value.allocations }
                    remember_owner transferred
                    return transferred
                end
                end_owner_value = do(path) = do(value)
                    live path
                    validate_value(value, path)
                    emit path (EndOwned { owner = value.operand, at = site "end owned" })
                    for _, facts in ipairs path.alternatives do end_facts facts value.operand end
                end
                local owner_at = do(path) = do(place)
                    local fact = contents path place
                    assert(not Contents.is(fact, Moved), "use of moved " .. place.name)
                    assert(Contents.is(fact, Tracked) and Staged.is(fact.value, Owner),
                        "place does not hold an owner")
                    validate_value(fact.value, path)
                    return fact.value
                end
                local group = do(name) = do(path)
                    live path
                    local extent = Extent { identity = fresh "extent", .name }
                    extents[#extents + 1], extent_by_identity[extent.identity] = extent, extent
                    emit path (BeginExtent { extent = extent.identity, at = site "begin extent" })
                    for _, facts in ipairs path.alternatives do facts.begun[extent.identity] = true end
                    record path ("begin extent " .. name)
                    return extent
                end
                local owned = do(name) = do(path) = do(extent) = do(initial)
                    live path
                    assert(extent_by_identity[extent.identity] == extent,
                        "foreign reclamation group")
                    validate_value(initial, path)
                    assert(operand_type initial.operand == "U32", "owned initialization needs U32")
                    local identity = fresh "allocation"
                    local origin = Origin with
                        identity = identity .. ".contents"
                        holding = identity
                        guarantee = "stable"
                    end
                    local allocation = Allocation { .identity, extent = extent.identity, .origin }
                    allocations[#allocations + 1] = allocation
                    local result = Result { identity = fresh "owner", native_type = "Owned U32" }
                    emit path (BeginOwned with
                        .result
                        .allocation
                        initial = initial.operand
                        at = site "begin owned"
                    end)
                    for _, facts in ipairs path.alternatives do
                        assert(facts.begun[extent.identity] and not facts.released[extent.identity],
                            "allocation outside live reclamation group")
                        facts.values[result.identity], facts.holdings[identity] = allocation, result.identity
                        facts.allocated[identity] = allocation
                    end
                    local value = Owner { operand = result, allocations = { allocation } }
                    remember_owner value
                    local place = declare path (name) "Owned U32"
                    path.contents[place.identity] = Tracked { .value }
                    record path ("begin owned " .. name)
                    return place
                end
                local take = do(path) = do(place)
                    local value = transfer_owner path (owner_at path place)
                    path.contents[place.identity] = Moved {}
                    record path ("move " .. place.name)
                    return value
                end
                local drop = do(path) = do(place)
                    end_owner_value path (owner_at path place)
                    path.contents[place.identity] = Moved {}
                    record path ("end holding " .. place.name)
                end
                local borrow = do(path) = do(place)
                    local owner = owner_at path place
                    local result = Result { identity = fresh "borrow", native_type = "Ref U32" }
                    emit path (BorrowOwned with
                        .result
                        owner = owner.operand
                        at = site "borrow owned"
                    end)
                    for _, facts in ipairs path.alternatives do
                        facts.references[result.identity] = { (held_allocation facts owner.operand).origin }
                    end
                    local value = Reference { operand = result, origins = allocation_origins owner.allocations }
                    remember_reference value
                    record path ("borrow " .. place.name)
                    return value
                end
                local observe = do(path) = do(value)
                    live path
                    assert(Staged.is(value, Reference), "observe needs a reference")
                    validate_value(value, path)
                    emit path (ObserveBorrow { reference = value.operand, at = site "observe borrow" })
                    record path ("observe " .. write_operand value.operand)
                end
                local reclaim = do(path) = do(extent)
                    live path
                    assert(extent_by_identity[extent.identity] == extent,
                        "foreign reclamation group")
                    for _, facts in ipairs path.alternatives do release_facts facts extent.identity end
                    emit path (ReleaseExtent { extent = extent.identity, at = site "release extent" })
                    record path ("reclaim " .. extent.name)
                end
                local end_scope = do(path) = do(outer_count)
                    for index = #path.locals, outer_count + 1, -1 do
                        local place = path.locals[index]
                        if place.native_type == "Owned U32" and Contents.is(path.contents[place.identity],
                            Tracked) then drop path place end
                    end
                end
                local release_all = do(path)
                    local pending = false
                    for _, facts in ipairs path.alternatives do
                        assert(next facts.holdings == nil,
                            "boundary leaves a live owning temporary")
                        for extent in pairs facts.begun do if not facts.released[extent] then facts.pending[extent], pending = true, true end end
                    end
                    if pending then emit path (CompleteBoundary { at = site "complete boundary" }) end
                end
                local stack_top = do(path) = do(role)
                    local result = Result { identity = fresh "top", native_type = "U64" }
                    emit path (StackTop { .result, .role, at = site "observe stack top" })
                    return Scalar { operand = result }
                end
                local stack_write = do(path) = do(role) = do(value)
                    validate_value(value, path)
                    assert(operand_type value.operand == "U64", "top write must be U64")
                    emit path (StackWrite with
                        .role
                        top = value.operand
                        at = site "restore stack top"
                    end)
                end
                local greater = do(path) = do(left) = do(right)
                    live path
                    local native_type = operand_type left.operand
                    assert((native_type == "U64" or native_type == "U32") and operand_type right.operand == native_type,
                        "comparison needs equal unsigned types")
                    if left.operand.value ~= nil and right.operand.value ~= nil then
                        return Scalar { operand = BooleanConstant { value = left.operand.value > right.operand.value } }
                    end
                    local result = Result { identity = fresh "greater", native_type = "Bool" }
                    emit path (Greater with
                        .result
                        left = left.operand
                        right = right.operand
                        at = site "compare tops"
                    end)
                    return Scalar { operand = result }
                end
                local external_growth = do(path) = do(role) = do(amount)
                    emit path (ExternalGrowth { .role, .amount, at = site "external growth" })
                end
                local call = do(path) = do(callee) = do(arguments)
                    live path
                    verify callee
                    assert(#arguments == #callee.parameters, "native call arity mismatch")
                    assert(callee.result_type ~= "Ref U32",
                        "probe native reference results need a summary")
                    if callee_names[callee.identity] then assert(callee_names[callee.identity] == callee,
                            "conflicting native definition")
                    else callees[#callees + 1], callee_names[callee.identity] = callee, callee end
                    local supplied = {}
                    for index, value in ipairs arguments do
                        validate_value(value, path)
                        assert(operand_type value.operand == callee.parameters[index].native_type,
                            "native argument type mismatch")
                        assert(operand_type value.operand ~= "Ref U32",
                            "probe native reference arguments need a summary")
                        supplied[index] = value.operand
                    end
                    local imported, groups, instances = {}, {}, {}
                    for _, allocation in pairs(NativeCalls.input_allocations callee) do imported[allocation.identity] = true end
                    for _, allocation in ipairs callee.allocations do
                        if not imported[allocation.identity] then
                            if not groups[allocation.extent] then
                                local extent = Extent with
                                    identity = fresh "call_extent"
                                    name = callee.identity .. "/" .. allocation.extent
                                end
                                groups[allocation.extent] = extent
                                extents[#extents + 1], extent_by_identity[extent.identity] = extent, extent
                            end
                            local identity = fresh "call_allocation"
                            local actual = Allocation with
                                .identity
                                extent = groups[allocation.extent].identity
                                origin = Origin with
                                    identity = identity .. ".contents"
                                    holding = identity
                                    guarantee = allocation.origin.guarantee
                                end
                            end
                            allocations[#allocations + 1] = actual
                            instances[#instances + 1] = NativeCalls.Instance with
                                formal = allocation.identity
                                allocation = actual
                            end
                        end
                    end
                    local result = Result { identity = fresh "call_result", native_type = callee.result_type }
                    local node = NativeCalls.Call with
                        .result
                        callee = callee.identity
                        arguments = supplied
                        .instances
                        at = site "native call"
                    end
                    local alternatives, candidates = {}, {}
                    for _, facts in ipairs path.alternatives do
                        for _, after in ipairs(NativeCalls.call_states callee node facts) do
                            alternatives[#alternatives + 1] = after
                            if after.values[result.identity] then candidates = merge_allocations (candidates) { after.values[result.identity] } end
                        end
                    end
                    emit path node
                    path.alternatives = alternatives
                    if callee.result_type == "Owned U32" then
                        local value = Owner { operand = result, allocations = candidates }
                        remember_owner value
                        return value
                    end
                    return Scalar { operand = result }
                end
                local return_scalar = do(path) = do(value)
                    live path
                    assert(Staged.is(value, Scalar) and operand_type value.operand == result_type,
                        "probe early exit needs its scalar result")
                    end_scope path 0
                    release_all path
                    path.block.terminator = Return { value = value.operand, at = site "early return" }
                    path.block = nil
                end
                local inline = do(path) = do(body)
                    live path
                    local outer_count = #path.locals
                    local result = body path
                    assert(path.block, "probe inline callback must supply a continuation")
                    validate_value(result, path)
                    -- Capture the result before ending the invocation's remaining local holdings.
                    if Staged.is(result, Owner) then result = transfer_owner path result end
                    end_scope path outer_count
                    for index = #path.locals, outer_count + 1, -1 do
                        path.contents[path.locals[index].identity], path.locals[index] = nil, nil
                    end
                    validate_value(result, path)
                    record path ("inline return " .. write_operand result.operand)
                    return result
                end
                local flush = do(path)
                    return do(place)
                        local fact = contents path place
                        if Contents.is(fact, Tracked) then
                            validate_value(fact.value, path)
                            emit path (Store with
                                place = place.identity
                                value = fact.value.operand
                                at = site "flush"
                            end)
                        end
                    end
                end
                local add = do(path)
                    return do(left)
                        return do(right)
                            live path
                            validate_value(left, path)
                            validate_value(right, path)
                            assert(operand_type left.operand == "U32" and operand_type right.operand == "U32",
                                "add requires U32")
                            if Operand.is(left.operand, UnsignedConstant) and Operand.is(right.operand,
                                UnsignedConstant) then
                                return unsigned ((left.operand.value + right.operand.value) % 4294967296)
                            end
                            local result = Result { identity = fresh "sum", native_type = "U32" }
                            emit path (Add with
                                .result
                                left = left.operand
                                right = right.operand
                                at = site "add"
                            end)
                            return Scalar { operand = result }
                        end
                    end
                end
                local expose = do(path)
                    return do(place)
                        assert(place.native_type == "U32",
                            "probe address exposure implements U32 only")
                        assert(not Contents.is(contents path place, Uninitialized),
                            "expose uninitialized place")
                        flush path place
                        emit path (Expose { place = place.identity, at = site "expose" })
                        path.memory[place.identity], path.contents[place.identity] = true, InMemory {}
                        record path ("expose " .. place.name)
                    end
                end
                local trap = do(path)
                    return do(message)
                        live path
                        end_scope path 0
                        release_all path
                        path.block.terminator = Trap { .message, at = site "trap" }
                        path.block = nil
                        record (path) "terminated"
                    end
                end
                local end_contents = do(path)
                    return do(origin)
                        emit path (EndContents { .origin, at = site "end contents" })
                        for _, facts in ipairs path.alternatives do facts.ended[origin.identity] = true end
                        record path ("end " .. origin.identity)
                    end
                end
                local fork = do(path)
                    return do(block)
                        local inner = { .block,
                            locals = copy_keys path.locals, contents = copy_keys path.contents,
                            memory = copy_keys path.memory }
                        inner.alternatives = {}
                        for _, facts in ipairs path.alternatives do inner.alternatives[#inner.alternatives + 1] = copy_ownership facts end
                        owned_paths[inner] = true
                        return inner
                    end
                end
                local choose = do(path)
                    return do(condition)
                        return do(when_true)
                            return do(when_false)
                                live path
                                validate_value(condition, path)
                                assert(operand_type condition.operand == "Bool",
                                    "condition requires Bool")
                                if Operand.is(condition.operand, BooleanConstant) then
                                    if condition.operand.value then when_true path else when_false path end
                                    return path.block ~= nil
                                end
                                local left = fork path (new_block "left")
                                local right = fork path (new_block "right")
                                path.block.terminator = Branch with
                                    condition = condition.operand
                                    when_true = Edge { target = left.block.identity, arguments = {} }
                                    when_false = Edge { target = right.block.identity, arguments = {} }
                                    at = site "branch"
                                end
                                when_true left
                                when_false right
                                local continuing, arguments = {}, {}
                                for _, arm in ipairs { left, right } do
                                    if arm.block then
                                        end_scope arm (#path.locals)
                                        continuing[#continuing + 1] = arm
                                        arguments[#arguments + 1] = {}
                                    end
                                end
                                if #continuing == 0 then path.block = nil; return false end
                                local joined = new_block "joined"
                                local joined_contents, joined_memory = {}, {}
                                -- Only places visible at entry participate; arm-local places do not escape.
                                for _, place in ipairs path.locals do
                                    local uninitialized, memory, moved = false, false, false
                                    for _, arm in ipairs continuing do
                                        local fact = arm.contents[place.identity]
                                        uninitialized = uninitialized or Contents.is(fact,
                                            Uninitialized)
                                        memory = memory or arm.memory[place.identity] or false
                                        moved = moved or Contents.is(fact, Moved)
                                    end
                                    joined_memory[place.identity] = memory
                                    if uninitialized or moved then
                                        if place.native_type == "Owned U32" then
                                            for _, arm in ipairs continuing do
                                                if Contents.is(arm.contents[place.identity],
                                                    Tracked) then drop arm place end
                                            end
                                        end
                                        joined_contents[place.identity] = moved and Moved {} or Uninitialized {}
                                    elseif memory then
                                        -- An exposing arm and a still-private arm need a coherent memory join.
                                        for _, arm in ipairs continuing do flush arm place end
                                        joined_contents[place.identity] = InMemory {}
                                    else
                                        local first = continuing[1].contents[place.identity].value
                                        local equal, origins, candidates = true, {}, {}
                                        for _, arm in ipairs continuing do
                                            local value = arm.contents[place.identity].value
                                            equal = equal and same_operand first.operand value.operand
                                            if Staged.is(value, Reference) then origins = merge_origins origins value.origins end
                                            if Staged.is(value, Owner) then candidates = merge_allocations candidates value.allocations end
                                        end
                                        local operand = first.operand
                                        if not equal then
                                            operand = BlockArgument { identity = fresh "merged", native_type = place.native_type }
                                            joined.arguments[#joined.arguments + 1] = operand
                                            for index, arm in ipairs continuing do
                                                local supplied = arguments[index]
                                                supplied[#supplied + 1] = arm.contents[place.identity].value.operand
                                            end
                                        end
                                        local value
                                        if place.native_type == "Ref U32" then
                                            value = Reference { .operand, .origins }
                                            remember_reference value
                                        elseif place.native_type == "Owned U32" then
                                            value = Owner { .operand, allocations = candidates }
                                            remember_owner value
                                        else
                                            value = Scalar { .operand }
                                        end
                                        joined_contents[place.identity] = Tracked { .value }
                                    end
                                end
                                local alternatives = {}
                                for index, arm in ipairs continuing do
                                    for _, facts in ipairs arm.alternatives do
                                        alternatives[#alternatives + 1] = edge_ownership facts joined.arguments arguments[index]
                                    end
                                    arm.block.terminator = Jump with
                                        edge = Edge { target = joined.identity, arguments = arguments[index] }
                                        at = site "join"
                                    end
                                end
                                path.block, path.contents, path.memory = joined, joined_contents, joined_memory
                                path.alternatives = alternatives
                                record (path) "join"
                                return true
                            end
                        end
                    end
                end
                for _, input in ipairs inputs do
                    if Staged.is(input, Reference) then
                        path.alternatives[1].references[input.operand.identity] = input.origins
                    elseif Staged.is(input, Owner) then
                        assert(#input.allocations == 1, "probe imported owner needs one allocation")
                        local allocation = input.allocations[1]
                        if not extent_by_identity[allocation.extent] then
                            local extent = Extent { identity = allocation.extent, name = "imported" }
                            extent_by_identity[extent.identity], extents[#extents + 1] = extent, extent
                        end
                        allocations[#allocations + 1] = allocation
                        local facts = path.alternatives[1]
                        assert(not facts.holdings[allocation.identity],
                            "two parameters own one holding")
                        facts.values[input.operand.identity], facts.holdings[allocation.identity] = allocation, input.operand.identity
                        facts.begun[allocation.extent] = true
                        facts.allocated[allocation.identity] = allocation
                    end
                    validate_value(input, path)
                    if Operand.is(input.operand, Parameter) then
                        assert(not seen_parameters[input.operand.identity],
                            "duplicate supplied parameter")
                        seen_parameters[input.operand.identity] = true
                        parameters[#parameters + 1] = input.operand
                    end
                end
                local evaluation = define
                    .declare
                    .read
                    .write
                    .add
                    .expose
                    .trap
                    .end_contents
                    .choose
                    .group
                    .owned
                    .take
                    .drop
                    .borrow
                    .observe
                    .reclaim
                    .inline
                    .stack_top
                    .stack_write
                    .greater
                    .external_growth
                    .return_scalar
                    .call
                end
                -- This owner closes its handlers on rejection as well as successful publication.
                -- Protected completion does not undo any arbitrary Lua effects of the fixture.
                local evaluate_and_close = do()
                    -- Fixture closures are deliberately opaque; this is not a second source tree.
                    local result = body evaluation path inputs
                    if path.block then
                        assert(result, "continuing body did not return a staged value")
                        validate_value(result, path)
                        if Staged.is(result, Owner) then result = transfer_owner path result end
                        end_scope path 0
                        validate_value(result, path)
                        if Staged.is(result, Owner) then
                            local seen = {}
                            for _, facts in ipairs path.alternatives do
                                for extent in pairs facts.begun do
                                    if not facts.released[extent] then seen[extent] = true end
                                end
                            end
                            for extent in pairs seen do return_extents[#return_extents + 1] = extent end
                            table.sort return_extents
                        else
                            release_all path
                        end
                        path.block.terminator = Return { value = result.operand, at = site "return" }
                        if Staged.is(result, Reference) then return_origins = result.origins end
                        record path ("return " .. write_operand result.operand)
                    else
                        assert(result == nil, "terminated body fabricated a result")
                    end
                    local published_blocks = {}
                    for _, block in ipairs blocks do published_blocks[#published_blocks + 1] = Block block end
                    return verify(Definition with
                        identity = name
                        .parameters
                        .places
                        entry = entry.identity
                        blocks = published_blocks
                        .result_type
                        references = reference_facts
                        .return_origins
                        .extents
                        .allocations
                        owners = owner_facts
                        .return_extents
                        .callees
                    end)
                end
                local accepted, definition = pcall evaluate_and_close
                completed = true
                if not accepted then error(definition, 0) end
                return definition, trace
            end
        end
    end
end

------------------------------------------------------------------------------------------------
-- The original branch-local allocation/control requirements. Physical captures are not fixtures.
local branch_local = do(evaluation) return do(path) return do(inputs)
            local result = evaluation.declare (path) "result" "Owned U32"
            evaluation.choose path inputs[1] do(left)
                local region = evaluation.group "left-only group" left
                local owner = evaluation.owned "left owner" left region (unsigned 1)
                evaluation.write left result (evaluation.take left owner)
            end do(right)
                local region = evaluation.group "right-only group" right
                local owner = evaluation.owned "right owner" right region (unsigned 2)
                evaluation.write right result (evaluation.take right owner)
            end
            evaluation.observe path (evaluation.borrow path result)
            return unsigned 0
        end end end
local api = define
    .construct
    .verify
    .verify_graph
    .write_definition
    .write_operand
    .operand_type
    .result_of
    .edges
    .copy_keys
    .parameter
    .unsigned
    .boolean
    .wide
    .unit
    .branch_local
    .Operand
    .UnsignedConstant
    .BooleanConstant
    .WideConstant
    .UnitConstant
    .Parameter
    .BlockArgument
    .Result
    .Scalar
    .Instruction
    .Add
    .Load
    .Store
    .Expose
    .EndContents
    .BeginExtent
    .BeginOwned
    .TransferOwned
    .BorrowOwned
    .ObserveBorrow
    .EndOwned
    .ReleaseExtent
    .CompleteBoundary
    .StackTop
    .StackWrite
    .Greater
    .ExternalGrowth
    .Terminator
    .Jump
    .Branch
    .Return
    .Trap
    .Edge
    .Block
    .Definition
    .Placement
    .Call
    .Instance
    .Lease
    .CompletionMember
    .CompletionFact
    .OwnershipFact
    .ReferenceFact
    .Extent
    .Allocation
    .Origin
    .owner_parameter
    .input_allocations
    analyze = verify_lifetimes
end
if load_mode == "module" then return api end

------------------------------------------------------------------------------------------------
-- Fixtures supply the hosted-operation boundary directly. They are not parsed Nua programs.

local initialized = do(name) = do(evaluation) = do(path) = do(value)
    local place = evaluation.declare path name (operand_type value.operand)
    evaluation.write path place value
    return place
end
local instruction_count = do(definition) = do(kind)
    local count = 0
    for _, block in ipairs definition.blocks do
        for _, instruction in ipairs block.instructions do
            if Instruction.is(instruction, kind) then count += 1 end
        end
    end
    return count
end
local returned = do(definition)
    local result
    for _, block in ipairs definition.blocks do
        if Terminator.is(block.terminator, Return) then
            assert(not result, "fixture expected one return")
            result = block.terminator.value
        end
    end
    return result
end
local accepted, rejected = 0, 0
local inspect = do(name) = do(inputs) = do(result_type) = do(body)
    local definition, trace = construct name inputs result_type body
    print("\n=== " .. name .. " ===")
    for _, line in ipairs trace do print("  evaluation: " .. line) end
    print(write_definition definition)
    accepted += 1
    return definition
end
local refuse = do(name) = do(fragment) = do(body)
    local ok, message = pcall body
    assert(not ok, name .. " unexpectedly accepted")
    assert(tostring(message):find(fragment, 1, true), name .. ": " .. tostring message)
    print("\nREJECT " .. name .. ": " .. tostring message)
    rejected += 1
end

local snapshot = do(evaluation) = do(path) = do(inputs)
    local p = initialized "p" evaluation path (unsigned 1)
    local before = initialized "before" evaluation path (evaluation.read path p)
    evaluation.choose path inputs[1] do(left)
        evaluation.write left p (unsigned 2)
    end do(right)
        evaluation.write right p (unsigned 3)
    end
    local earlier = evaluation.read path before
    local current = evaluation.read path p
    return evaluation.add path earlier current
end
local known_true = inspect "known-true" { boolean true } "U32" snapshot
local known_false = inspect "known-false" { boolean false } "U32" snapshot
assert((returned known_true).value == 3 and (returned known_false).value == 4)
assert(#known_true.blocks == 1 and #known_false.blocks == 1)
local dynamic = inspect "dynamic-snapshot" { parameter "Bool" "flag" } "U32" snapshot
assert(#dynamic.blocks == 4 and #dynamic.blocks[4].arguments == 1)
assert(instruction_count dynamic Store == 0 and instruction_count dynamic Add == 1)
assert(dynamic.blocks[4].instructions[1].left.value == 1)
local original_print = write_definition dynamic

local wrap = inspect "native-u32-wrap" {} "U32" (do(evaluation) = do(path) = do(inputs)
        return evaluation.add path (unsigned 4294967295) (unsigned 1)
    end)
assert((returned wrap).value == 0 and instruction_count wrap Add == 0)
local selected_only = inspect "known-selects-only-one-arm" {} "U32" (do(evaluation) = do(path) = do(inputs)
        evaluation.choose path (boolean false) do(left)
            error "unselected arm was evaluated"
        end do(right) end
        return unsigned 8
    end)
assert((returned selected_only).value == 8)

local exposed = inspect "materialized-snapshot" {} "U32" (do(evaluation) = do(path) = do(inputs)
        local p = initialized "p" evaluation path (unsigned 7)
        evaluation.expose path p
        local earlier = evaluation.read path p
        evaluation.write path p (unsigned 9)
        local current = evaluation.read path p
        return evaluation.add path earlier current
    end)
local exposed_code = exposed.blocks[1].instructions
assert(#exposed_code == 6)
assert(Instruction.is(exposed_code[3], Load) and Instruction.is(exposed_code[4], Store))
assert(Instruction.is(exposed_code[5], Load))
assert(exposed_code[6].left == exposed_code[3].result and exposed_code[6].right == exposed_code[5].result)

local mixed_memory = inspect "exposure-in-one-arm" { parameter "Bool" "flag" } "U32" (do(evaluation) = do(path) = do(inputs)
        local p = initialized "p" evaluation path (unsigned 1)
        local before = evaluation.read path p
        evaluation.choose path inputs[1] do(left)
            evaluation.write left p (unsigned 2)
            evaluation.expose left p
        end do(right)
            evaluation.write right p (unsigned 3)
        end
        return evaluation.add path before (evaluation.read path p)
    end)
assert(instruction_count mixed_memory Store == 2 and instruction_count mixed_memory Expose == 1)
assert(instruction_count mixed_memory Load == 1 and #mixed_memory.blocks[4].arguments == 0)
assert(mixed_memory.blocks[3].instructions[1].value.value == 3)
local known_after_effect = inspect "known-result-keeps-effect" {} "U32" (do(evaluation) = do(path) = do(inputs)
        local p = initialized "p" evaluation path (unsigned 5)
        evaluation.expose path p
        return unsigned 42
    end)
assert((returned known_after_effect).value == 42 and instruction_count known_after_effect Expose == 1)

refuse "one-live-uninitialized-predecessor" "read of uninitialized" do()
    construct "uninitialized" { parameter "Bool" "flag" } "U32" (do(evaluation) = do(path) = do(inputs)
            local p = evaluation.declare (path) "p" "U32"
            evaluation.choose path inputs[1] do(left)
                evaluation.write left p (unsigned 2)
            end do(right) end
            return evaluation.read path p
        end)
end
local one_live = inspect "terminated-predecessor-contributes-no-facts" { parameter "Bool" "flag" } "U32" (do(evaluation) = do(path) = do(inputs)
        local p = evaluation.declare (path) "p" "U32"
        evaluation.choose path inputs[1] do(left)
            evaluation.write left p (unsigned 2)
        end do(right)
            evaluation.trap (right) "stop"
        end
        return evaluation.read path p
    end)
assert((returned one_live).value == 2 and #one_live.blocks[4].arguments == 0)
local both_dead = inspect "both-predecessors-terminate" { parameter "Bool" "flag" } "U32" (do(evaluation) = do(path) = do(inputs)
        local continuing = evaluation.choose path inputs[1] do(left)
            evaluation.trap (left) "left stop"
        end do(right)
            evaluation.trap (right) "right stop"
        end
        assert(not continuing)
    end)
assert(#both_dead.blocks == 3 and returned both_dead == nil)

-- Reference parameters borrow existing external contents. This does not model owner creation.
local stable = Origin { identity = "left.contents.1", holding = "left", guarantee = "stable" }
local shared = Origin { identity = "right.contents.1", holding = "right", guarantee = "shared" }
local reference_inputs = condition -> {
    condition, reference_parameter "left" { stable }, reference_parameter "right" { shared },
}
local reference_join = do(after) = do(evaluation) = do(path) = do(inputs)
    local selected = initialized "selected" evaluation path inputs[2]
    evaluation.choose path inputs[1] do(left)
        evaluation.write left selected inputs[2]
    end do(right)
        evaluation.write right selected inputs[3]
    end
    after evaluation path
    return evaluation.read path selected
end
local unchanged = do(evaluation) = do(path) end
local joined_reference = inspect "reference-origins-and-guarantees" (reference_inputs (parameter "Bool" "flag"))
"Ref U32" (reference_join unchanged)
assert(same_origins (joined_reference.return_origins) { stable, shared })
assert(joined_reference.references[3].origins[2].guarantee == "shared")
local end_right = do(evaluation) = do(path) evaluation.end_contents path shared end
local known_reference = inspect "known-reference-does-not-borrow-other-arm" (reference_inputs (boolean true))
"Ref U32" (reference_join end_right)
assert(same_origins (known_reference.return_origins) { stable })
refuse "selected-reference-may-borrow-ended-contents" "borrow of ended contents right.contents.1" do()
    construct "ended-reference" (reference_inputs (parameter "Bool" "flag")) "Ref U32" (reference_join end_right)
end

local live_reference = inspect "ended-origin-on-terminated-arm" (reference_inputs (parameter "Bool" "flag"))
"Ref U32" (do(evaluation) = do(path) = do(inputs)
        local selected = initialized "selected" evaluation path inputs[2]
        evaluation.choose path inputs[1] do(left) end do(right)
            evaluation.end_contents right stable
            evaluation.trap (right) "no continuation"
        end
        return evaluation.read path selected
    end)
assert(same_origins (live_reference.return_origins) { stable })

-- Ending a borrow that is never subsequently used is legal. A generated edge is not a new
-- source observation of the reference, even when it transports its pointer bits.
local unused_reference = inspect "unused-ended-reference" (reference_inputs (parameter "Bool" "flag"))
"U32" (do(evaluation) = do(path) = do(inputs)
        local selected = initialized "unused" evaluation path inputs[2]
        evaluation.choose path inputs[1] do(left)
            evaluation.end_contents left stable
        end do(right)
            evaluation.write right selected inputs[3]
        end
        return unsigned 0
    end)
assert((returned unused_reference).value == 0)

local nested_regions = inspect "nested-control-regions" { parameter "Bool" "outer",
    parameter "Bool" "inner" }
"U32" (do(evaluation) = do(path) = do(inputs)
        local p = initialized "p" evaluation path (unsigned 0)
        evaluation.choose path inputs[1] do(left)
            evaluation.choose left inputs[2] do(inner_left)
                evaluation.write inner_left p (unsigned 1)
            end do(inner_right)
                evaluation.write inner_right p (unsigned 2)
            end
        end do(right)
            evaluation.write right p (unsigned 3)
        end
        return evaluation.read path p
    end)
assert(#nested_regions.blocks == 7 and instruction_count nested_regions Store == 0)

------------------------------------------------------------------------------------------------
-- Deliberately bad graphs test the checker rather than asking two backends to agree.
-- Replacements own new lists/nodes; earlier inspected definitions are not mutated.

local replace_block = do(definition) = do(position) = do(replacement)
    local blocks = copy_keys definition.blocks
    blocks[position] = replacement
    return Definition { ..definition, .blocks }
end
refuse "constructor-native-width" "expects U32 constant" do()
    UnsignedConstant { value = -1 }
end
refuse "family-handler-coverage" "no handler for the kind" do()
    Instruction.pass "incomplete" {}
end
refuse "missing-block-target" "missing edge target" do()
    local block = Block with ..dynamic.blocks[1]
        terminator = Jump { edge = Edge { target = "missing", arguments = {} }, at = "corrupted target" }
    end
    verify(replace_block dynamic 1 block)
end
refuse "wrong-edge-arity" "edge arity mismatch" do()
    local block = Block with ..dynamic.blocks[2]
        terminator = Jump with
            edge = Edge { target = dynamic.blocks[4].identity, arguments = {} }
            at = "corrupted arity"
        end
    end
    verify(replace_block dynamic 2 block)
end
refuse "wrong-edge-type" "edge type mismatch" do()
    local block = Block with ..dynamic.blocks[2]
        terminator = Jump with
            edge = Edge with
                target = dynamic.blocks[4].identity
                arguments = { BooleanConstant { value = true } }
            end
            at = "corrupted type"
        end
    end
    verify(replace_block dynamic 2 block)
end
refuse "duplicate-value-definition" "duplicate value identity" do()
    local instruction = dynamic.blocks[4].instructions[1]
    local block = Block { ..dynamic.blocks[4], instructions = { instruction, instruction } }
    verify(replace_block dynamic 4 block)
end
refuse "sibling-value-does-not-dominate" "operand does not dominate use" do()
    local result = Result { identity = "sibling_only", native_type = "U32" }
    local instruction = Add with
        .result
        left = UnsignedConstant { value = 1 }
        right = UnsignedConstant { value = 2 }
        at = "sibling value"
    end
    local left = Block { ..dynamic.blocks[2], instructions = { instruction } }
    local joined = Block with ..dynamic.blocks[4]
        terminator = Return { value = result, at = "bad use" }
    end
    local changed = replace_block dynamic 2 left
    verify(replace_block changed 4 joined)
end
refuse "exposure-without-initial-store" "memory observed before initialization" do()
    local instructions = {}
    for index = 2, #exposed_code do instructions[#instructions + 1] = exposed_code[index] end
    local block = Block { ..exposed.blocks[1], .instructions }
    verify(replace_block exposed 1 block)
end
refuse "reference-join-loses-shared-origin" "reference join lost or invented origins" do()
    local references = copy_keys joined_reference.references
    references[3] = ReferenceFact { operand = references[3].operand, origins = { stable } }
    verify(Definition { ..joined_reference, .references, return_origins = { stable } })
end
refuse "reference-return-after-ending" "borrow of ended contents right.contents.1" do()
    local block = Block with ..joined_reference.blocks[4]
        instructions = {
            EndContents { origin = shared, at = "inserted ending" },
        }
    end
    verify(replace_block joined_reference 4 block)
end
refuse "return-contract-loses-origin" "incorrect return-origin contract" do()
    verify(Definition { ..joined_reference, return_origins = { stable } })
end

------------------------------------------------------------------------------------------------
-- Independent and nested activities, rejection, and completion must preserve earlier output.

local escaped_evaluation, escaped_path, escaped_place, nested_output
local outer = inspect "independent-nested-activity" {} "U32" (do(evaluation) = do(path) = do(inputs)
        local p = initialized "p" evaluation path (unsigned 2)
        local before = evaluation.read path p
        escaped_evaluation, escaped_path, escaped_place = evaluation, path, p
        nested_output = inspect "nested-activity" { parameter "Bool" "nested_flag" } "U32"
        do(child_evaluation) return do(child_path) return do(child_inputs)
                    refuse "path-from-another-activity" "path belongs to another activity" do()
                        evaluation.declare (child_path) "foreign" "U32"
                    end
                    initialized "child" child_evaluation child_path (unsigned 6)
                    refuse "place-from-another-activity" "place belongs to another activity" do()
                        child_evaluation.read child_path p
                    end
                    return snapshot child_evaluation child_path child_inputs
                end end end
        evaluation.write path p (unsigned 9)
        return evaluation.add path before (evaluation.read path p)
    end)
assert((returned outer).value == 11)
assert(#outer.blocks == 1 and #nested_output.blocks == 4)
refuse "escaped-handler-after-publication" "evaluation activity is complete" do()
    escaped_evaluation.write escaped_path escaped_place (unsigned 99)
end
local rejected_evaluation, rejected_path
refuse "construction-abandoned" "intentional probe rejection" do()
    construct "abandoned" {} "U32" do(evaluation) return do(path) return do(inputs)
                rejected_evaluation, rejected_path = evaluation, path
                error "intentional probe rejection"
            end end end
end
refuse "escaped-handler-after-rejection" "evaluation activity is complete" do()
    rejected_evaluation.declare (rejected_path) "too late" "U32"
end
local repeated = inspect "dynamic-snapshot" { parameter "Bool" "flag" } "U32" snapshot
assert(write_definition dynamic == original_print)
assert(write_definition repeated == original_print)
assert(dynamic ~= repeated and dynamic.blocks[1] ~= repeated.blocks[1])
assert((returned outer).value == 11);

------------------------------------------------------------------------------------------------
-- Second experiment: owners and references travel on the same control-flow edges.
-- A function scope keeps fixture locals separate from the vocabulary (LuaJIT's local limit).
local run_ownership_fixtures = do()
    local select_owner = do(evaluation) = do(path) = do(inputs)
        local left_group = evaluation.group "left result storage" path
        local right_group = evaluation.group "right result storage" path
        local left_owner = evaluation.owned "a" path left_group (unsigned 10)
        local right_owner = evaluation.owned "b" path right_group (unsigned 20)
        local selected = evaluation.declare (path) "selected" "Owned U32"
        local reference = evaluation.declare (path) "selected reference" "Ref U32"
        evaluation.choose path inputs[1] do(left)
            evaluation.write left reference (evaluation.borrow left left_owner)
            evaluation.write left selected (evaluation.take left left_owner)
            evaluation.drop left right_owner
        end do(right)
            evaluation.write right reference (evaluation.borrow right right_owner)
            evaluation.write right selected (evaluation.take right right_owner)
            evaluation.drop right left_owner
        end
        evaluation.observe path (evaluation.read path reference)
        evaluation.observe path (evaluation.borrow path selected)
        return evaluation.take path selected
    end
    local known_owner = inspect "known-owner-selection-keeps-both-allocations" { boolean true }
    "Owned U32" select_owner
    assert(instruction_count known_owner BeginOwned == 2 and instruction_count known_owner EndOwned == 1)
    assert(#known_owner.return_extents == 2 and instruction_count known_owner ReleaseExtent == 0)
    assert(known_owner.owners[#known_owner.owners].allocations[1] == known_owner.allocations[1])
    local known_other = inspect "known-false-owner-selection" { boolean false } "Owned U32" select_owner
    assert(known_other.owners[#known_other.owners].allocations[1] == known_other.allocations[2])
    local selected_owner = inspect "owner-and-reference-selected-together" { parameter "Bool" "flag" }
    "Owned U32" select_owner
    assert(#selected_owner.return_extents == 2 and #selected_owner.blocks[4].arguments == 2)
    assert(instruction_count selected_owner EndOwned == 2)

    local inline_owner = inspect "inline-owner-return-keeps-caller-continuation" { parameter "Bool" "flag" }
    "U32" (do(evaluation) = do(path) = do(inputs)
            local result = evaluation.inline path do(inner)
                return select_owner evaluation inner inputs
            end
            local kept = initialized "caller result" evaluation path result
            evaluation.observe path (evaluation.borrow path kept)
            return unsigned 7
        end)
    assert((returned inline_owner).value == 7 and instruction_count inline_owner CompleteBoundary == 1)

    local partial_fields = inspect "independently-moved-fields" {} "U32"
    do(evaluation) return do(path) return do(inputs)
                local region = evaluation.group "pair reclamation" path
                -- Explicit field places, not an implementation of aggregate layout.
                local left = evaluation.owned "pair.left" path region (unsigned 1)
                local right = evaluation.owned "pair.right" path region (unsigned 2)
                local moved_left = initialized "moved left" evaluation path (evaluation.take path left)
                local moved_right = initialized "moved right" evaluation path (evaluation.take path right)
                evaluation.drop path moved_left
                evaluation.observe path (evaluation.borrow path moved_right)
                evaluation.drop path moved_right
                evaluation.reclaim path region
                return unsigned 9
            end end end
    assert(instruction_count partial_fields EndOwned == 2 and instruction_count partial_fields ReleaseExtent == 1)

    local retained_prefix = inspect "returned-header-does-not-describe-whole-region" {} "Owned U32"
    do(evaluation) return do(path) return do(inputs)
                local region = evaluation.group "larger than returned header" path
                local scratch = evaluation.owned "consumed prefix" path region (unsigned 1)
                local result = evaluation.owned "later result" path region (unsigned 2)
                evaluation.drop path scratch
                return evaluation.take path result
            end end end
    assert(#retained_prefix.allocations == 2 and #retained_prefix.return_extents == 1)
    assert(instruction_count retained_prefix ReleaseExtent == 0)

    local returned_field = inspect "inline-return-of-one-field-retains-region" {} "U32"
    do(evaluation) return do(path) return do(inputs)
                local result = evaluation.inline path do(inner)
                    local region = evaluation.group "child pair" inner
                    local left = evaluation.owned "pair.left" inner region (unsigned 4)
                    evaluation.owned "pair.right" inner region (unsigned 5)
                    return evaluation.take inner left
                end
                local kept = initialized "kept field" evaluation path result
                evaluation.observe path (evaluation.borrow path kept)
                return unsigned 12
            end end end
    assert(instruction_count returned_field EndOwned == 2 and instruction_count returned_field CompleteBoundary == 1)

    local swapped = inspect "simultaneous-owner-edge-inputs" { parameter "Bool" "flag" } "U32"
    do(evaluation) return do(path) return do(inputs)
                local region = evaluation.group "pair" path
                local left = evaluation.owned "left" path region (unsigned 1)
                local right = evaluation.owned "right" path region (unsigned 2)
                evaluation.choose path inputs[1] do(arm)
                    local first = evaluation.take arm left
                    local second = evaluation.take arm right
                    evaluation.write arm left second
                    evaluation.write arm right first
                end do(arm) end
                evaluation.observe path (evaluation.borrow path left)
                evaluation.observe path (evaluation.borrow path right)
                return unsigned 0
            end end end
    assert(#swapped.blocks[4].arguments == 2 and instruction_count swapped EndOwned == 2)

    local replaced = inspect "capture-replacement-before-ending-old-holding" {} "U32"
    do(evaluation) return do(path) return do(inputs)
                local region = evaluation.group "replacement" path
                local old = evaluation.owned "destination" path region (unsigned 1)
                local fresh = evaluation.owned "supplied" path region (unsigned 2)
                evaluation.write path old (evaluation.take path fresh)
                evaluation.observe path (evaluation.borrow path old)
                return unsigned 0
            end end end
    local first_end
    for index, instruction in ipairs replaced.blocks[1].instructions do
        if Instruction.is(instruction, EndOwned) then first_end = index; break end
    end
    assert(Instruction.is(replaced.blocks[1].instructions[first_end - 1], TransferOwned))

    local imported_allocation = Allocation with
        identity = "argument allocation"
        extent = "argument extent"
        origin = Origin with
            identity = "argument contents"
            holding = "argument allocation"
            guarantee = "stable"
        end
    end
    local mixed_origin = inspect "mixed-argument-and-fresh-owner-result"
    { parameter "Bool" "flag", owner_parameter "argument" { imported_allocation } } "Owned U32"
    do(evaluation) return do(path) return do(inputs)
                local argument = initialized "argument place" evaluation path inputs[2]
                local region = evaluation.group "fresh result storage" path
                local fresh = evaluation.owned "fresh result" path region (unsigned 3)
                local result = evaluation.declare (path) "result" "Owned U32"
                evaluation.choose path inputs[1] do(left)
                    evaluation.write left result (evaluation.take left argument)
                    evaluation.drop left fresh
                end do(right)
                    evaluation.write right result (evaluation.take right fresh)
                    evaluation.drop right argument
                end
                return evaluation.take path result
            end end end
    assert(#mixed_origin.return_extents == 2 and instruction_count mixed_origin BeginOwned == 1)

    local conditional_move = inspect "move-on-one-edge-ends-unmoved-other-edge" { parameter "Bool" "flag" }
    "U32" (do(evaluation) = do(path) = do(inputs)
            local region = evaluation.group "conditional field" path
            local owner = evaluation.owned "field" path region (unsigned 1)
            evaluation.choose path inputs[1] do(left)
                local destination = initialized "arm destination" evaluation left (evaluation.take left owner)
                evaluation.observe left (evaluation.borrow left destination)
            end do(right) end
            return unsigned 0
        end)
    assert(instruction_count conditional_move EndOwned == 2 and instruction_count conditional_move CompleteBoundary == 1)
    local trapped_owner = inspect "trapping-path-completes-owned-storage" {} "U32"
    do(evaluation) return do(path) return do(inputs)
                local region = evaluation.group "trap scope" path
                evaluation.owned "temporary" path region (unsigned 1)
                evaluation.trap (path) "stop"
            end end end
    assert(returned trapped_owner == nil and instruction_count trapped_owner EndOwned == 1)
    assert(instruction_count trapped_owner CompleteBoundary == 1)

    -- A deliberately flattened analysis loses the correlation that the graph checker preserves.
    local flat_ended, union_origins = {}, {}
    for _, block in ipairs selected_owner.blocks do
        for _, instruction in ipairs block.instructions do
            if Instruction.is(instruction, EndOwned) then
                for _, fact in ipairs selected_owner.owners do
                    if fact.operand == instruction.owner then
                        for _, allocation in ipairs fact.allocations do flat_ended[allocation.origin.identity] = true end
                    end
                end
            end
        end
    end
    for _, fact in ipairs selected_owner.references do union_origins = merge_origins union_origins fact.origins end
    assert(#union_origins == 2 and flat_ended[union_origins[1].identity] and flat_ended[union_origins[2].identity])
    print "EVIDENCE: flat ending/origin unions would reject both live selected alternatives."

    local with_owner = do(body) = do(evaluation) = do(path) = do(inputs)
        local region = evaluation.group "fixture" path
        local owner = evaluation.owned "owner" path region (unsigned 1)
        return body evaluation path region owner
    end
    refuse "duplicated-owning-value" "owner was moved or ended" do()
        construct "duplicate" {} "U32" (with_owner do(evaluation) return do(path) return do(region) return do(owner)
                            local value = evaluation.take path owner
                            initialized "first" evaluation path value
                            initialized "second" evaluation path value
                            return unsigned 0
                        end end end end)
    end
    refuse "use-of-moved-owner-place" "use of moved owner" do()
        construct "moved" {} "U32" (with_owner do(evaluation) return do(path) return do(region) return do(owner)
                            evaluation.take path owner
                            evaluation.borrow path owner
                            return unsigned 0
                        end end end end)
    end
    refuse "retained-bytes-do-not-keep-borrow-live" "borrow of ended contents" do()
        construct "retained bytes" {} "U32" (with_owner do(evaluation) return do(path) return do(region) return do(owner)
                            local reference = evaluation.borrow path owner
                            evaluation.drop path owner
                            evaluation.observe path reference
                            return unsigned 0
                        end end end end)
    end
    refuse "replacement-ends-old-borrow" "borrow of ended contents" do()
        construct "replacement borrow" {} "U32" (with_owner do(evaluation) return do(path) return do(region) return do(owner)
                            local reference = evaluation.borrow path owner
                            local supplied = evaluation.owned "replacement" path region (unsigned 2)
                            evaluation.write path owner (evaluation.take path supplied)
                            evaluation.observe path reference
                            return unsigned 0
                        end end end end)
    end
    refuse "partial-move-cannot-release-sibling-storage" "release would reclaim a live holding" do()
        construct "partial release" {} "U32" (with_owner do(evaluation) return do(path) return do(region) return do(owner)
                            local sibling = evaluation.owned "sibling" path region (unsigned 2)
                            evaluation.drop path owner
                            evaluation.reclaim path region
                            return unsigned 0
                        end end end end)
    end
    refuse "reclamation-exactly-once" "reclamation group released twice" do()
        construct "double release" {} "U32" (with_owner do(evaluation) return do(path) return do(region) return do(owner)
                            evaluation.drop path owner
                            evaluation.reclaim path region
                            evaluation.reclaim path region
                            return unsigned 0
                        end end end end)
    end
    refuse "unused-owning-temporary-needs-cleanup" "boundary leaves a live owning temporary" do()
        construct "lost temporary" {} "U32" (with_owner do(evaluation) return do(path) return do(region) return do(owner)
                            evaluation.take path owner
                            return unsigned 0
                        end end end end)
    end
    refuse "inline-local-borrow-does-not-escape" "borrow of ended contents" do()
        construct "local borrow" {} "Ref U32" do(evaluation) return do(path) return do(inputs)
                    return evaluation.inline path do(inner)
                        local region = evaluation.group "inner" inner
                        local owner = evaluation.owned "local owner" inner region (unsigned 1)
                        return evaluation.borrow inner owner
                    end
                end end end
    end
    refuse "returned-header-missing-larger-reclamation-contract" "returned header lost reclamation obligation" do()
        verify(Definition { ..retained_prefix, return_extents = {} })
    end
    refuse "cleanup-before-result-capture" "owner was moved or ended" do()
        local instructions, inserted = {}, false
        for _, instruction in ipairs retained_prefix.blocks[1].instructions do
            if not inserted and Instruction.is(instruction, TransferOwned) then
                instructions[#instructions + 1] = EndOwned { owner = instruction.source, at = "bad early cleanup" }
                inserted = true
            end
            instructions[#instructions + 1] = instruction
        end
        local block = Block { ..retained_prefix.blocks[1], .instructions }
        verify(replace_block retained_prefix 1 block)
    end
    refuse "physical-reclamation-before-surviving-result" "release would reclaim a live holding" do()
        local instructions = copy_keys retained_prefix.blocks[1].instructions
        instructions[#instructions + 1] = ReleaseExtent with
            extent = retained_prefix.extents[1].identity
            at = "bad rewind"
        end
        verify(replace_block retained_prefix 1 (Block { ..retained_prefix.blocks[1], .instructions }))
    end
    refuse "edge-cannot-copy-an-owning-header" "edge duplicates an owning holding" do()
        local definition = selected_owner
        local last = definition.blocks[4]
        local source = last.terminator.value
        local first = BlockArgument { identity = "first_owner_copy", native_type = "Owned U32" }
        local second = BlockArgument { identity = "second_owner_copy", native_type = "Owned U32" }
        local blocks = copy_keys definition.blocks
        blocks[4] = Block with ..last
            terminator = Jump with
                edge = Edge { target = "bad_copies", arguments = { source, source } }
                at = "duplicated edge"
            end
        end
        blocks[#blocks + 1] = Block with
            identity = "bad_copies"
            arguments = { first, second }
            instructions = {}
            terminator = Return { value = first, at = "return copy" }
        end
        local owners = copy_keys definition.owners
        local candidates
        for _, fact in ipairs owners do if fact.operand == source then candidates = fact.allocations end end
        owners[#owners + 1] = OwnershipFact { operand = first, allocations = candidates }
        owners[#owners + 1] = OwnershipFact { operand = second, allocations = candidates }
        verify(Definition { ..definition, .blocks, .owners })
    end

    refuse "raw-store-cannot-copy-an-owner" "owner store requires transfer" do()
        local place = Place with
            identity = "raw_owner_slot"
            name = "forged owner copy"
            native_type = "Owned U32"
        end
        local places = copy_keys retained_prefix.places
        places[#places + 1] = place
        local instructions = copy_keys retained_prefix.blocks[1].instructions
        instructions[#instructions + 1] = Store with
            place = place.identity
            value = returned retained_prefix
            at = "raw header copy"
        end
        local changed = replace_block retained_prefix 1 (Block with ..retained_prefix.blocks[1]
            .instructions
        end)
        verify(Definition { ..changed, .places })
    end

    -- Acceptance must realize and independently check storage, not just publish pending work.
    if arg[1] == "--edge-reclamation" then
        local logical = inspect "branch-local-reclamation-groups" { parameter "Bool" "flag" } "U32" branch_local
        local completion = assert((require "mua.init").loadfile "docs/design/compiler-completion-probe.mua")(api)
        completion.accept logical
    end
end
run_ownership_fixtures

assert(write_definition dynamic == original_print)
print(("\nPASS: %d constructed cases; %d expected rejections. No native execution."):format(accepted,
        rejected))
