-- Slices (syntax §12.2): the words of every `Slice T`, `Slice.mut T` and `Str`, served once per
-- family. A view is a pointer and a U64 length; the compiler supplies only the primitives
-- over its borrow (`view_length`, `view_element_of`, `subview_of`), which check nothing. These
-- words check every index and range: at run time, or while compiling when the index and the
-- length are known (`index-range`), so the check costs nothing then.

local index = import "index"
local buffer_words = import("buffer").words

local made = setmetatable({}, { __mode = "k" })

local words = do(T, V)
    if made[V] then return made[V] end

    -- `s[i]`: the element's place, its index checked
    local element = do(self: V, at): Ref T
        index.unsigned at
        local i = U64 at
        local length = view_length self
        local outside = i >= length
        index.refuse_known(outside, ("index-range: index %s is outside a slice of length %s"):format(index.shown i, index.shown length))
        if outside then trap "slice index out of range" end
        return view_element_of self i
    end

    -- `s:sub(a, b)`: the view of `[a, b)`, checked
    local sub = do(self: V, first, limit): V
        index.unsigned first
        index.unsigned limit
        local a = U64 first
        local b = U64 limit
        local length = view_length self
        local reversed = a > b
        local beyond = b > length
        index.refuse_known(reversed, ("index-range: the range %s..%s is reversed"):format(index.shown a, index.shown b))
        index.refuse_known(beyond, ("index-range: the range %s..%s is outside a slice of length %s"):format(index.shown a, index.shown b, index.shown length))
        if reversed then trap "slice range out of bounds" end
        if beyond then trap "slice range out of bounds" end
        return subview_of self a (b - a)
    end

    -- `s.length`
    local member = do(self, name)
        if name == "length" then return view_length self end
        return nil
    end

    -- an owner where a view is expected lends its elements (syntax §9.2): a reference to a
    -- buffer of T, given by capture (a `Slice`) or marked at the call (`f(Ref xs)`)
    local lent = Ref(Buffer T)
    local fixed_lent = Ref(Buffer(T, false, true))
    local cast = do(value, view_type)
        local given = type_of value
        -- a buffer lends its elements (a `Grow T`, an `Array T`)
        if given == lent or given == fixed_lent then
            if V.mutable then return value:all_mut() end
            return value:all()
        end
        -- an array lends its elements too
        local array = given and given.target
        if array and array.count and array.element == T and not V.mutable then return value:slice() end
        return nil
    end

    -- `copy s`: the owner of a copy of the elements (syntax §9.2)
    local Owned = Buffer(T, false, true)
    local copied = do(self: V): Owned
        local built = buffer_words(T, Owned).build(view_length self, {})
        local i: U64 = 0
        while i < view_length self do
            built[i] = view_element_of self i
            i = i + 1
        end
        return built
    end

    local members = define
        __copy = copied
        __index = element
        __member = member
        __cast = cast
        .sub
    end
    -- a read-only view is not a place to assign (`not-a-place`); a `Slice.mut` is
    if not V.mutable then
        members.__newindex = do(self, at, value)
            error("not-a-place: a view is read-only; write through its storage or a Ptr", 0)
        end
    end
    made[V] = members
    return members
end

-- `view_of(p, n, body)` (syntax §12.6): a read-only view of foreign elements lent to the body:
-- it borrows a loan that ends with the body, so it cannot escape it
local foreign_view = do(pointer, count, body): Inferred
    local loan: U8 = 0
    local result = body(loaned_view (Ref loan) pointer count)
    end_loan(Ref loan)
    return result
end

-- the members of every view type (syntax §16.1: served once per family)
family Slice words

return define
    .words
    .foreign_view
end
