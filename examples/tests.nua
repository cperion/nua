-- Named tests execute beside the words they test during ordinary compilation.
-- A typed block uses native comparisons and control flow; a plain block is Lua.
local add = do(a: U32, b: U32): U32 = a + b

test "addition" do(): Unit
    assert(add 2 2 == 4)
    assert(add 40 2 == 42)
end

local triangular = do(n: U32): U32
    local total: U32 = 0
    for i: U32 = 1, n do
        total = total + i
    end
    return total
end

test "known native loop" do(): Unit
    assert(triangular 0 == 0)
    assert(triangular 4 == 10)
end

test "host assertions" do
    local result = host(triangular 5)
    assert(result == 15, "the first five integers sum to fifteen")
end
