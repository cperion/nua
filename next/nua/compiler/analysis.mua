-- Publish construction-owned facts for a sealed definition. No compiler-wide registry is
-- copied: rejected branches/rounds and other definitions cannot leak into this product.
local data = require "nua.compiler.data"
local types = require "nua.types"
local graph = require "nua.compiler.graph"
local verify = require "nua.compiler.verify"
local effects = require "nua.compiler.effects"

local plain = native_type -> data.ValueInfo {
    type = native_type,
    components = types.owns(native_type) and { [{}] = data.Owning {} } or {},
    proofs = {},
}

local publish = do(definition, fragment)
    local values = {}
    for key, info in pairs fragment.values do values[key] = info end
    local information = do(operand)
        if data.Operand.is(operand, data.Constant) then return plain operand.type end
        local key = data.operand_key operand
        if values[key] == nil then values[key] = plain operand.type end
        return values[key]
    end
    -- Remember the facts of representation assembly, not just the scalar operands. The
    -- evaluator's explicit reference facts take precedence over representation inference.
    for index, native_type in ipairs definition.signature.parameters do
        information(data.Parameter { definition = definition.id, .index, type = native_type })
    end
    for _, block in ipairs definition.blocks do
        for index, argument in ipairs block.arguments do
            information(data.BlockArgument { block = block.id, .index, type = argument.type })
        end
        for _, instruction in ipairs block.instructions do
            for _, operand in ipairs(verify.operands_of instruction) do information operand end
            if instruction.result then
                local native_type = instruction.type
                if data.Instruction.is(instruction, data.Load) then native_type = definition.places[instruction.place].type end
                if data.Instruction.is(instruction, data.Address) then native_type = types.pointer(definition.places[instruction.place].type) end
                if native_type and values[instruction.result] == nil then
                    local components = {}
                    if data.Instruction.is(instruction, data.Pack) and types.NativeType.is(native_type, types.RecordType) then
                        for index, operand in ipairs instruction.components do
                            for path, part in pairs(information(operand).components) do
                                local nested = { data.FieldComponent { name = native_type.fields[index].name } }
                                for _, step in ipairs path do nested[#nested + 1] = step end
                                components[nested] = part
                            end
                        end
                    elseif data.Instruction.is(instruction, data.Extract) then
                        for path, part in pairs(information(instruction.aggregate).components) do
                            local matches = #path >= #instruction.path
                            for index, step in ipairs instruction.path do
                                local actual = path[index]
                                if actual == nil or getmetatable(actual) ~= getmetatable(step) or actual.name ~= step.name then matches = false end
                            end
                            if matches then
                                local rest = {}
                                for index = #instruction.path + 1, #path do rest[#rest + 1] = path[index] end
                                components[rest] = part
                            end
                        end
                    end
                    values[instruction.result] = next(components) and data.ValueInfo { type = native_type, .components, proofs = {} } or plain(native_type)
                end
            end
        end
        for _, operand in ipairs(verify.terminator_operands block.terminator) do information operand end
    end
    local edges, joins, terminators = {}, {}, {}
    for _, block in ipairs definition.blocks do
        local terminator = block.terminator
        terminators[block.id] = effects.ending(terminator)
        for _, edge in ipairs(graph.edges_of terminator) do
            local arguments = {}
            for index, operand in ipairs edge.arguments do arguments[index] = information operand end
            local row = data.EdgeFacts { edge = edge.id, flow = assert(fragment.terminal_flows[block.id]), .arguments }
            edges[edge.id] = row
            local join = joins[edge.target]
            if join == nil then
                join = data.JoinRelation { block = edge.target, incoming = {} }
                joins[edge.target] = join
            end
            join.incoming[#join.incoming + 1] = row
        end
    end
    return data.DefinitionFacts {
        .values, borrows = fragment.borrows, entries = fragment.entries,
        .edges, .joins, sites = fragment.sites, .terminators,
    }
end
return define
    .publish
end
