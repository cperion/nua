-- Collection algorithms over storage projections. The compiler supplies only
-- representation access and the activity that lends one entry's snapshots.
local map = {}
local zero = __S.zero_value
local iterators = {}

function map.each(T, storage, body)
    local by_storage = iterators[T]
    if not by_storage then by_storage = {}; iterators[T] = by_storage end
    local by_body = by_storage[storage]
    if not by_body then by_body = {}; by_storage[storage] = by_body end
    if by_body[body] then return by_body[body] end
    -- Distinct activities are distinct specializations: a nested traversal is
    -- not recursion with a changing compile-time callback parameter.
    -- The compiler rejects structural mutation in the body, so the slots hold;
    -- the body is opaque, so the table is acquired again for every entry.
    local each = do(m: Ref T): Unit
        local count = storage.header(m).len
        local slot = U32 0
        while slot < count do
            local table = storage.acquire m
            local entry = table.entries[slot]
            if band entry.hash 0x8000000000000000ULL == 0 then storage.lend(table, entry, body) end
            slot = slot + 1
        end
    end
    by_body[body] = each
    return each
end

local hash = require "nua.hash"
local keys = require "nua.key"
local str = require "nua.str"
local stacks = require "nua.stacks"
local trap = extern("nua_trap", { CString }, Unit)
local slice_parts = __S.slice_parts
local retire, restructure, grows, borrows = __S.retire, __S.restructure, __S.grows, __S.borrows
local none = U32 0xffffffff
local libraries = {}

-- Entries live in slots that never move, so a borrow of an entry survives
-- insertions; a removed slot joins a free list (its hash has the top bit set and
-- names the next free slot). A separate index of slot numbers is rebuilt when
-- the map grows: cells hold slot + 1, zero is empty and 0xffffffff a removed
-- cell. Every operation acquires the table once and probes, reads and writes
-- inside that acquisition; only the index and the key arena move.
local free_bit = U64 0x8000000000000000ULL
local removed_cell = U32 0xffffffff
function map.library(T, storage, Entry, Result, string_keys, borrowed_keys)
    if libraries[T] then return libraries[T] end
    local K, V = T.key, T.elem
    local EP, View = Ptr Entry, storage.View
    local equal = borrowed_keys and str.equals or keys.equal K
    local text_digest = hash.text
    local key_digest = keys.hash K
    -- a stored hash has the top bit clear: the top bit marks a free slot
    local digest = do(key: K): U64
        local h = U64 0
        if string_keys or borrowed_keys then h = text_digest key else h = key_digest key end
        local low = band h 0x7fffffffffffffffULL
        return bor low 1
    end
    local header, acquire, entries, stored_key = storage.header, storage.acquire, storage.entries, storage.key
    local maximum = storage.maximum
    local api = {}

    local slot_bytes = do(count: U32): U64
        local width = size_of Entry
        local n = U64 count
        if n * width / width ~= n then trap "Map is full" end
        return n * width
    end
    local check_slots_top = do(m: Ref T): Unit
        local h = header m
        local top = stacks.top h.stack
        if top - h.base ~= slot_bytes h.len then trap "Map grew while it was not at the top of its data stack" end
    end
    local check_index_top = do(m: Ref T): Unit
        local h = header m
        local bytes = U64 h.cap * 4
        local top = stacks.top h.index_stack
        if top - h.index_base ~= bytes then trap "Map index grew while it was not at the top of its data stack" end
    end
    -- the index cell naming key's slot, or none
    local probe = do(table: View, key: K, hashed: U64): U32
        local capacity = table.cap
        if capacity == 0 then return none end
        local mask = capacity - 1
        local cell = band (U32 hashed) mask
        local steps = U32 0
        while steps < capacity do
            local at = table.cells[cell]
            if at == 0 then return none end
            if at ~= removed_cell then
                local entry = Ptr table.entries[at - 1]
                if entry.hash == hashed then
                    local found = stored_key table entry.key
                    if equal found key then return cell end
                end
            end
            cell = band (cell + 1) mask
            steps = steps + 1
        end
        return none
    end
    -- put slot + 1 in the first empty or removed cell on hashed's probe path
    local place = do(cells: Ptr U32, capacity: U32, hashed: U64, slot: U32): U32
        local mask = capacity - 1
        local cell = band (U32 hashed) mask
        while true do
            local at = cells[cell]
            if at == 0 or at == removed_cell then
                cells[cell] = slot + 1
                return at
            end
            cell = band (cell + 1) mask
        end
        return 0
    end
    -- rebuild the index for at least `needed` entries into the spare bytes above
    -- it, then move it down. Slots do not move.
    local rebuild = do(m: Ref T, needed: U32): Unit
        local h = header m
        local old_capacity = h.cap
        local capacity = U32 8
        while U64 capacity < U64 needed * 2 do
            if capacity >= 0x40000000 then trap "Map is full" end
            capacity = capacity * 2
        end
        local bytes = U64 capacity * 4
        local used = U64 old_capacity * 4
        local fresh = stacks.extend(h.index_stack, h.index_base, used, bytes,
            "Map index grew while it was not at the top of its data stack")
        local s = stacks.at h.index_stack
        local spare = stacks.span s fresh bytes
        stacks.fill spare bytes
        local target = Ptr U32 spare
        local table = acquire m
        local slot = U32 0
        while slot < table.len do
            local entry = Ptr table.entries[slot]
            if band entry.hash free_bit == 0 then place target capacity entry.hash slot end
            slot = slot + 1
        end
        stacks.move (stacks.span s h.index_base bytes) spare bytes
        local top = h.index_base + bytes
        stacks.reset h.index_stack top
        h.cap = capacity
        h.used = h.live
    end
    local append
    if string_keys then
        -- key's bytes at target. The key may lie in this arena: stacks never
        -- move, and compaction writes above the arena, so its bytes are intact.
        local place_key = do(s: Ptr stacks.Stack, target: U64, key: Str): Unit
            local n = U64 key.length
            local destination = stacks.span s target n
            local ptr, len = slice_parts key
            stacks.move destination ptr n
        end
        append = do(m: Ref T, key: Str): U64
            local a = storage.strmap m
            local stack = a.arena_stack
            local base = a.arena_base
            local length = a.arena_len
            local dead = a.dead
            local n = U64 key.length
            local offset = length
            if dead >= 4096 and dead >= length / 2 then
                local live = length - dead
                if n > maximum() - live then trap "Map(Str, V) key arena is full" end
                local bytes = live + n
                local fresh = stacks.extend(stack, base, length, bytes,
                    "Map(Str, V) grew while its arena was not at the top of its data stack")
                -- compact the live keys above the arena, then move them down
                local s = stacks.at stack
                local keys_now = stacks.span s base length
                local compacted = stacks.span s fresh bytes
                local table = acquire m
                local out = U64 0
                local slot = U32 0
                while slot < table.len do
                    local entry = Ptr table.entries[slot]
                    if band entry.hash free_bit == 0 then
                        local size = U64 entry.key.len
                        stacks.move(Ptr compacted[out], Ptr keys_now[entry.key.offset], size)
                        entry.key.offset = out
                        out = out + size
                    end
                    slot = slot + 1
                end
                offset = out
                place_key s (fresh + out) key
                stacks.move (stacks.span s base bytes) compacted bytes
                local end_at = base + bytes
                stacks.reset stack end_at
                a.arena_len = bytes
                a.dead = n
            else
                stacks.extend(stack, base, length, n,
                    "Map(Str, V) grew while its arena was not at the top of its data stack")
                place_key (stacks.at stack) (base + offset) key
                a.arena_len = length + n
                a.dead = dead + n
            end
            return offset
        end
    end
    api.put = do(m: Ref T, key: K, value: V, only_missing): Unit
        -- an insertion changes the structure; replacing the entry being visited does not
        restructure(m, "put", key)
        grows m
        local hashed = digest key
        local table = acquire m
        local cell = probe table key hashed
        if cell ~= none then
            if not only_missing then
                -- written through the owner's pointer: a stored borrow is checked against it
                local owned = borrows(m, table.entries)
                owned[table.cells[cell] - 1].value = value
            end
            return
        end
        check_index_top m
        local text_offset = U64 0
        if string_keys then text_offset = append m key end
        local h = header m
        -- the index keeps its load factor: removed cells count as used
        if h.cap == 0 or (U64 h.used + 1) * 4 > U64 h.cap * 3 then
            rebuild m (h.live + 1)
        end
        check_slots_top m
        local slot = h.free_head
        if slot ~= none then
            local at = acquire m
            local reused = Ptr at.entries[slot]
            h.free_head = U32 reused.hash
        else
            slot = h.len
            if slot >= 0xfffffffe then trap "Map is full" end
            stacks.extend(h.stack, h.base, slot_bytes slot, size_of Entry,
                "Map grew while it was not at the top of its data stack")
            h.len = slot + 1
        end
        local at = acquire m
        local entry = Ptr at.entries[slot]
        entry[0] = zero Entry
        entry.hash = hashed
        local owned = borrows(m, at.entries)
        owned[slot].value = value
        if string_keys then
            entry.key.offset = text_offset
            entry.key.len = key.length
        else owned[slot].key = key end
        local capacity = h.cap
        local previous = place at.cells capacity hashed slot
        if previous == 0 then h.used = h.used + 1 end
        h.live = h.live + 1
        if string_keys then
            local a = storage.strmap m
            local n = U64 key.length
            a.dead = a.dead - n
        end
    end
    api.has = do(m: Ref T, key: K): Bool
        local hashed = digest key
        local table = acquire m
        local cell = probe table key hashed
        return cell ~= none
    end
    api.find = do(m: Ref T, key: K): Result
        local hashed = digest key
        local table = acquire m
        local cell = probe table key hashed
        if cell == none then return Result.missing() end
        local entry = Ptr table.entries[table.cells[cell] - 1]
        return Result.found entry.value
    end
    api.locate = do(m: Ref T, key: K): Ptr V
        local hashed = digest key
        local table = acquire m
        local cell = probe table key hashed
        if cell == none then trap "map-key: missing key" end
        local entry = Ptr table.entries[table.cells[cell] - 1]
        return Ptr entry.value
    end
    api.remove = do(m: Ref T, key: K): Bool
        restructure(m, "remove")
        -- the slot is reused: only the borrows that may name this key end
        retire(m, "an entry of '%s' was removed", key)
        local hashed = digest key
        local table = acquire m
        local cell = probe table key hashed
        if cell == none then return false end
        local slot = table.cells[cell] - 1
        local entry = Ptr table.entries[slot]
        local removed_bytes = U64 0
        if string_keys then removed_bytes = U64 entry.key.len end
        table.cells[cell] = removed_cell
        local h = header m
        entry[0] = zero Entry
        entry.hash = bor free_bit (U64 h.free_head)
        h.free_head = slot
        local live = h.live - 1
        h.live = live
        if string_keys then
            local a = storage.strmap m
            a.dead = a.dead + removed_bytes
            if live == 0 then
                stacks.reset a.arena_stack a.arena_base
                a.arena_len = 0
                a.dead = 0
            end
        end
        if live == 0 then
            -- nothing is borrowed from an empty map: start over
            stacks.reset h.stack h.base
            h.len = 0
            h.free_head = none
            stacks.fill (stacks.span (stacks.at h.index_stack) h.index_base (U64 h.cap * 4)) (U64 h.cap * 4)
            h.used = 0
        end
        return true
    end
    api.length = do(m: Ref T): U64 return U64 header(m).live end
    -- `copy m` into a new, empty map: the slots, the index, and for text keys the
    -- arena the stored keys point into by offset
    api.copy = do(m: Ref T, from: Ref T): Unit
        local source = header from
        local h = header m
        if source.len ~= 0 then
            local bytes = slot_bytes source.len
            local at = stacks.extend(h.stack, h.base, U64 0, bytes,
                "Map copy target was not at the top of its data stack")
            stacks.move (stacks.region h.stack at bytes) (stacks.region source.stack source.base bytes) bytes
        end
        if source.cap ~= 0 then
            local bytes = U64 source.cap * 4
            local at = stacks.extend(h.index_stack, h.index_base, U64 0, bytes,
                "Map copy target was not at the top of its data stack")
            local target = stacks.region h.index_stack at bytes
            local origin = stacks.region source.index_stack source.index_base bytes
            stacks.move target origin bytes
        end
        h.len = source.len
        h.live = source.live
        h.free_head = source.free_head
        h.cap = source.cap
        h.used = source.used
        if string_keys then
            local a = storage.strmap m
            local b = storage.strmap from
            local n = b.arena_len
            if n ~= 0 then
                local at = stacks.extend(a.arena_stack, a.arena_base, U64 0, n,
                    "Map(Str, V) copy target was not at the top of its data stack")
                stacks.move (stacks.region a.arena_stack at n) (stacks.region b.arena_stack b.arena_base n) n
            end
            a.arena_len = n
            a.dead = b.dead
        end
    end
    libraries[T] = api
    return api
end

-- Immutable host descriptions emit these same ordinary comparisons for dynamic
-- keys; known keys execute the words while specializing, without a native heap.
function map.known(K, V, Result, entries)
    local equal = keys.equal K
    local api = {}
    api.find = do(key: K): Result
        for _, entry in ipairs entries do
            if equal(key, entry[1]) then return Result.found entry[2] end
        end
        return Result.missing()
    end
    api.has = do(key: K): Bool
        for _, entry in ipairs entries do
            if equal(key, entry[1]) then return true end
        end
        return false
    end
    api.get = do(key: K): V
        for _, entry in ipairs entries do
            if equal(key, entry[1]) then return entry[2] end
        end
        trap "map-key: missing key in known map"
        return zero V  -- unreachable after the runtime trap
    end
    api.each = do(body): Unit
        for _, entry in ipairs entries do body(entry[1], entry[2]) end
    end
    return api
end

-- The Map owner types as declarations (design memory.md §10.1): what a map is, the arguments
-- of its operations, and the few hooks that need the compiler (key capture, the `each` lock).
-- The algorithms are the words above.
local Mem = require "nua.memory"
local codegen = require "nua.cgen"
local types = require "nua.types"
local function fail(message) __S.fail(message, 2) end

local function sanitize(text)
    local clean = text:gsub("[^%w_]", "_")
    return clean
end

-- name: Map (any fixed key), StrMap (text keys copied into the map's arena), BorrowingMap
-- (the caller's text keys are kept)
function map.family(name)
    local is_str, borrowing = name == "StrMap", name == "BorrowingMap"
    local text_keys = is_str or borrowing
    local decl = {}
    decl.name, decl.keyed, decl.label = name, true, "Map"
    decl.suffix = name
    decl.iterates = true
    decl.header = require("nua.storage_layout")[is_str and "StrMap" or "Map"]
    decl.stacks = is_str and { { "entries.stack", "entries.base" }, { "entries.index_stack", "entries.index_base" },
        { "arena_stack", "arena_base" } } or { { "stack", "base" }, { "index_stack", "index_base" } }
    decl.index = "key"
    decl.index_stable = function(t) return not is_str end
    decl.newindex = "put"
    decl.methods = { "has", "find", "remove", "put", "ensure" }
    decl.args = { has = { "key" }, find = { "key" }, remove = { "key" }, put = { "stored_key", "value" },
        ensure = { "stored_key", "value" } }
    decl.arity = { has = 2, find = 2, remove = 2, put = 3, ensure = 3, each = 2 }
    decl.display = function(key, elem)
        if is_str then return "Map(Str, " .. elem.display .. ")" end
        if borrowing then return "Map.borrowing(Str, " .. elem.display .. ")" end
        return "Map(" .. key.display .. ", " .. elem.display .. ")"
    end
    decl.admit = function(key, elem)
        if not text_keys and not types.map_key(key) then
            return "Map key must have fixed semantic equality, not " .. key.display
        end
        if not types.map_value(elem) then
            if is_str then return "Map(Str, V) value must be fixed-size owned data, not " .. elem.display end
            if borrowing then return "Map.borrowing value must be fixed-size data, not " .. elem.display end
            return "Map value must be fixed-size owned data, not " .. elem.display
        end
    end
    -- the names, entry types and native representation of this compilation's type
    decl.setup = function(t)
        keys.check_key(t.key)
        local prefix = is_str and "StrMap" or borrowing and "MapBorrowing" or ("Map_" .. sanitize(codegen.ctype(t.key)))
        local n = __S.unique_global(prefix .. "_" .. sanitize(codegen.ctype(t.elem)))
        local stored = t.key
        if is_str then stored = __S.struct(n .. "Bytes", { { "offset", U64 }, { "len", U64 } }) end
        rawset(t, "cname", n)
        rawset(t, "entry", __S.struct(n .. "Entry", { { "hash", U64 }, { "key", stored }, { "value", t.elem } }))
        rawset(t, "lookup", __S.oneof(n .. "Lookup", { { "found", t.elem }, { "missing", Unit } }))
        rawset(t, "representation", Mem.layouts_module()[is_str and "StrMap" or "Map"])
        rawset(t, "iteration_owners", {})
    end
    decl.receive = function(t, p)
        -- the keys it compares against are borrows
        if borrowing then __S.check_stored(p) end
    end
    decl.key = function(t, x)
        if text_keys then return require("nua.strings").as_str(x, "Map(Str, V) key") end
        return __S.coerce(x, t.key, "Map key")
    end
    decl.capture_key = function(t, kv)
        if __S.is_known(kv) then return kv end
        local text = __S.expr_key(__S.ex(__S.value_of(kv)))
        local captured
        if not text_keys then
            captured = Mem.fix_index(kv, "capturing a map key")
        else
            local view = rawget(kv, "view")
            captured = Mem.capture(kv, "capturing a map key")
            if view then rawset(captured, "view", view) end
        end
        -- the captured temporary stands for the key it came from (iteration and removal compare keys)
        if __S.is_value(captured) then rawset(captured, "key_text", text) end
        return captured
    end
    -- the slot and index projections; an entry's key and value go to an activity, and a text
    -- key is a view of the arena that ends when the activity returns
    decl.projection = function(t)
        local storage = require("nua.storage_layout").maps(t, t.entry, function(x)
            local p = Mem.receiver(x, t.display)
            decl.receive(t, p)
            return Mem.view(p, t.representation)
        end)
        local iterating = t.iteration_owners
        storage.lend = function(table, entry, body)
            local k, v = storage.key(table, __S.dot(entry, "key")), __S.dot(entry, "value")
            local owner = iterating[#iterating]
            if owner then __S.set_iteration_key(owner, __S.expr_key(__S.ex(__S.value_of(k)))) end
            if is_str then
                local ptr, len = __S.slice_parts(k)
                local token = __S.activity_token()
                k = __S.make_slice(Str, ptr, len, token)
                local ok, err = pcall(body, k, v)
                if not ok then token.ended = true; error(err, 0) end
                __S.end_view(token, nil, "a Map(Str, V) key cannot outlive its iteration")
            else body(k, v) end
        end
        __S.arity[storage.lend] = 3
        return storage
    end
    decl.api = function(T, Id, p)
        local words = map.library(T, p, T.entry, T.lookup, is_str, borrowing)
        local api = {}
        for name, word in pairs(words) do api[name] = word end
        api.put = function(m, key, value) return words.put(m, key, value, false) end
        api.ensure = function(m, key, value) return words.put(m, key, value, true) end
        return api
    end
    -- `copy m`: the new map receives m's table and keys
    decl.init = function(api, owner, indices, from)
        api.layout.init(owner, indices[1], indices[2], indices[3] or indices[1])
        if from.copy_of then
            api.copy(owner, __S.Ref(from.copy_of))
            -- borrowed keys and values the source holds are held by the copy too
            if borrowing then __S.hold_stored(rawget(owner, "place"), from.copy_of) end
        end
    end
    decl.construct = function(t)
        return function(x)
            if type(x) ~= "table" or __S.is_staged(x) or next(x) then fail(t.display .. " {} takes no fields") end
            return Mem.fresh(t)
        end
    end
    -- m:each body: the map's structure is fixed inside the body, which is checked while compiling
    decl.extra = function(t)
        local methods = {}
        methods.each = function(self, body)
            if type(body) ~= "function" and not __S.is_word(body) then fail(t.display .. ":each needs an activity") end
            local p = Mem.receiver(self, t.display)
            decl.receive(t, p)
            local storage = Mem.storage_library(t).layout
            local iterating = t.iteration_owners
            __S.fixed(__S.Ref(p), function()
                iterating[#iterating + 1] = p
                local ok, err = pcall(function() map.each(t, storage, body)(__S.Ref(p)) end)
                iterating[#iterating] = nil
                if not ok then error(err, 0) end
            end)
        end
        return methods
    end
    return decl
end

-- Map.known(K, V) {...}: an immutable map description. Known keys execute the words while
-- specializing; dynamic keys emit the same ordinary comparisons.
function map.describe_known(t, entries)
    if type(entries) ~= "table" or __S.is_staged(entries) then fail("known map needs an entry list") end
    local count = #entries
    if count > 0xffffffff then fail("known map is full") end
    for index in pairs(entries) do
        if type(index) ~= "number" or index % 1 ~= 0 or index < 1 or index > count then
            fail("known map needs a dense entry list")
        end
    end
    local str = t.family == "StrMap"
    local strings = require "nua.strings"
    local function key(x)
        if str then return strings.as_str(x, "known Map(Str, V) key") end
        return __S.coerce(x, t.key, "known Map key")
    end
    local copied = {}
    local equal = keys.equal(t.key)
    for i = 1, count do
        local pair = entries[i]
        if type(pair) ~= "table" or __S.is_staged(pair) or pair[1] == nil or pair[2] == nil then
            fail("known map entry " .. i .. " needs a key and value")
        end
        local k, v = key(pair[1]), __S.coerce(pair[2], t.elem, "known map value")
        if not __S.is_known(k) or not __S.is_known(v) then fail("known map keys and values must be known") end
        -- A known owner-backed text view must become immutable bytes, not a
        -- retained view of a local that may subsequently change.
        if str then k = strings.as_str(__S.known_text(k), "known Map(Str, V) key") end
        for j = 1, i - 1 do
            if __S.host(equal(k, copied[j][1])) then fail("duplicate semantic key in known map at entry " .. i) end
        end
        copied[i] = { k, v }
    end
    local api = map.known(t.key, t.elem, t.lookup, copied)
    local object = newproxy(true)
    local function checked(_, k)
        k = key(k)
        if __S.is_known(k) and not __S.host(api.has(k)) then fail("map-key: missing key in known map") end
        return api.get(k)
    end
    local methods = {}
    methods.find = function(_, k) return api.find(key(k)) end
    methods.has = function(_, k) return api.has(key(k)) end
    methods.each = function(_, body) return api.each(body) end
    for _, fn in pairs(methods) do __S.arity[fn] = 2 end
    local mt = getmetatable(object)
    mt.__nua_index = checked
    mt.__index = function(_, name)
        if name == "length" then return __S.known(U64, count) end
        if methods[name] then return methods[name] end
        if name == "put" or name == "ensure" or name == "remove" then fail("known maps are immutable") end
        return checked(object, name)
    end
    mt.__newindex = function() fail("known maps are immutable; indexing yields a value, not a place") end
    mt.__tostring = function() return "known " .. t.display end
    return object
end

return map
