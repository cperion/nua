-- Completion joins over the same program IR. No backend or native execution.
-- Run from Nua's root with the current neighboring Mua checkout.
local shared_boundary = ...
local mua = require "mua.init"
local boundary = type shared_boundary == "table" and shared_boundary or
assert(mua.loadfile "docs/design/compiler-boundary-probe.mua") "module"
local v, copy = boundary.v, boundary.v.copy_keys
local controls = do(names)
    local parameters = {}
    for _, name in ipairs names do parameters[#parameters + 1] = v.parameter "Bool" name end
    return parameters
end
local pair = do(evaluation) = do(path)
    local region = evaluation.group "pair proposal" path
    local left = evaluation.owned "pair.left" path region (v.unsigned 1)
    local right = evaluation.owned "pair.right" path region (v.unsigned 2)
    return left, right
end
local swap = do(evaluation) = do(path) = do(left) = do(right)
    local a = evaluation.take path left
    local b = evaluation.take path right
    evaluation.write path left b
    evaluation.write path right a
end
local finish = do(evaluation) = do(path) = do(left) = do(right)
    local sibling = evaluation.borrow path right
    local returned = evaluation.call path boundary.relay ({ evaluation.take path left })
    local result = boundary.bind "returned field" evaluation path returned
    evaluation.observe path (evaluation.borrow path result)
    evaluation.drop path result
    -- This observation follows the other component's physical completion, not just its move.
    evaluation.observe path sibling
    return v.unsigned 0
end
local joined_root = do(name) = do(options)
    local names = options.swap and { "flag", "choice", "swap" } or
    options.nested and { "flag", "choice", "nested" } or
    options.early and { "flag", "choice", "early" } or { "flag", "choice" }
    return boundary.construct name (controls names) "U32" do(evaluation) return do(path) return do(inputs)
                local left, right = pair evaluation path
                if options.swap then
                    evaluation.choose path inputs[3] do(branch) swap evaluation branch left right end do(branch) end
                end
                evaluation.choose path inputs[1] do(branch)
                    local value = evaluation.call branch options.target ({ inputs[2],
                            evaluation.take branch left })
                    evaluation.write branch left value
                    if options.nested then
                        evaluation.choose branch inputs[3] do(inner)
                            local value = evaluation.call inner boundary.forwarding ({ inputs[2],
                                    evaluation.take inner left })
                            evaluation.write inner left value
                        end do(inner) end
                    end
                end do(branch)
                    if options.early then
                        evaluation.choose branch inputs[3] do(early)
                            evaluation.return_scalar early (v.unsigned 0)
                        end do(continuing) end
                    end
                end
                return finish evaluation path left right
            end end end
end
local prefix_replace = boundary.construct "argument-or-retained-prefix"
{ v.parameter "Bool" "choice", boundary.formal_owner "argument" } "Owned U32"
do(evaluation) return do(path) return do(inputs)
            local argument = boundary.bind "argument" evaluation path inputs[2]
            local selected = evaluation.declare (path) "selected" "Owned U32"
            evaluation.choose path inputs[1] do(branch)
                evaluation.write branch selected (evaluation.take branch argument)
            end do(branch)
                evaluation.drop branch argument
                local scratch_region = evaluation.group "retained prefix" branch
                local scratch = evaluation.owned "scratch" branch scratch_region (v.unsigned 8)
                evaluation.drop branch scratch
                local region = evaluation.group "returned suffix" branch
                local result = evaluation.owned "result" branch region (v.unsigned 9)
                evaluation.write branch selected (evaluation.take branch result)
            end
            return evaluation.take path selected
        end end end
local native_join = boundary.construct "native-unequal-join"
{ v.parameter "Bool" "flag", v.parameter "Bool" "choice", boundary.formal_owner "argument" } "Owned U32"
do(evaluation) return do(path) return do(inputs)
            local argument = boundary.bind "argument" evaluation path inputs[3]
            evaluation.choose path inputs[1] do(branch)
                local value = evaluation.call branch boundary.replace ({ inputs[2],
                        evaluation.take branch argument })
                evaluation.write branch argument value
            end do(branch) end
            return evaluation.call path boundary.relay ({ evaluation.take path argument })
        end end end
local native_root = boundary.construct "join-inside-leased-definition" (controls { "flag",
        "choice" }) "U32"
do(evaluation) return do(path) return do(inputs)
            local left, right = pair evaluation path
            local value = evaluation.call path native_join ({ inputs[1],
                    inputs[2], evaluation.take path left })
            evaluation.write path left value
            return finish evaluation path left right
        end end end

-- The original exchanged-component source is shared, not rewritten for a new planner.
local exchanged_source = do()
    return boundary.construct "exchange-long-short-components" (controls { "choice",
            "swap" }) "U32"
    do(evaluation) return do(path) return do(inputs)
                local left, right = pair evaluation path
                local value = evaluation.call path boundary.replace ({ inputs[1],
                        evaluation.take path left })
                evaluation.write path left value
                evaluation.choose path inputs[2] do(branch) swap evaluation branch left right end do(branch) end
                return finish evaluation path left right
            end end end
end
if type shared_boundary == "table" then
    return define
        .exchanged_source
        .joined_root
        .native_root
        .prefix_replace
    end
end

local witnesses, executions, rejections = 0, 0, 0
local matrix = do(parameters) = do(check)
    local visit
    visit = do(index) = do(inputs) = do(prefix)
        if index > #parameters then check inputs prefix; return end
        for _, value in ipairs { false, true } do
            local supplied = copy inputs
            supplied[parameters[index].identity] = value
            visit (index + 1) supplied prefix
        end
    end
    for _, prefix in ipairs { 0, 64 } do visit 1 ({}) prefix end
end
local witness = do(logical) = do(expected) = do(extra)
    local before, count = boundary.write_program logical, boundary.construction_count()
    local prepare = boundary.planning()
    local plan = prepare logical ({}) true
    local snapshot = boundary.write_program plan.definition
    print("\n=== " .. logical.identity .. ": logical ===\n" .. before)
    print("=== normalized native program ===\n" .. snapshot)
    for _, proof in ipairs plan.normalizations do
        print("extend slot " .. proof.item .. " with " .. proof.component.role ..
            " on " .. #proof.missing .. " unused incoming edges")
    end
    matrix logical.parameters do(inputs) return do(prefix)
            local checked = boundary.ledger_for_inputs plan.definition inputs prefix
            local observations, calls = expected inputs
            assert(table.concat(checked.observations, ",") == observations,
                "wrong normalized field result")
            assert(checked.calls == calls,
                "normalization moved, duplicated, or flattened a native call")
            extra plan checked inputs
            print("ledger " .. prefix .. ": " .. table.concat(checked.trace, "; "))
            executions += 1
        end end
    local again = boundary.planning()
    assert(boundary.write_program((again logical ({}) true).definition) == snapshot and
        boundary.write_program logical == before and boundary.construction_count() == count,
        "normalization replayed source or modified accepted output")
    witnesses += 1
    return plan
end
local nothing = do(plan) = do(checked) = do(inputs) end
local original = witness (boundary.unequal_source()) do(inputs)
    return inputs.flag and not inputs.choice and "3,2" or "1,2", inputs.flag and 1 or 0
end do(plan) return do(checked) return do(inputs)
            assert(#plan.normalizations == 1 and #plan.fresh == 3, "invented a padding role")
            assert(plan.fresh[3].hoisted, "extra role capture stayed inside its branch")
            if not inputs.flag or inputs.choice then
                for _, cell in pairs checked.cells do assert(cell.index ~= 2,
                        "unused role allocated payload") end
            end
        end end end
local swapped = witness (joined_root "swap-before-unequal-join" { swap = true,
        target = boundary.forwarding }) do(inputs)
    local left, right = inputs.swap and 2 or 1, inputs.swap and 1 or 2
    if inputs.flag and not inputs.choice then left = 3 end
    return left .. "," .. right, inputs.flag and 3 or 1
end do(plan) return do(checked) return do(inputs)
            assert(#plan.normalizations == 1 and #plan.fresh == 3)
            if inputs.flag then assert(checked.deepest == 3,
                    "forwarding no longer crosses three frames") end
        end end end
local nested = witness (joined_root "nested-unequal-joins" { nested = true,
        target = boundary.replace }) do(inputs)
    return inputs.flag and not inputs.choice and "3,2" or "1,2",
    1 + (inputs.flag and (inputs.nested and 3 or 1) or 0)
end do(plan) return do(checked) return do(inputs)
            assert(#plan.normalizations == 3 and #plan.fresh == 4,
                "nested role extension lost its proof")
        end end end
local native = witness native_root do(inputs)
    return inputs.flag and not inputs.choice and "3,2" or "1,2", inputs.flag and 4 or 3
end nothing
local retained = witness (joined_root "retained-prefix-unequal-join" { target = prefix_replace }) do(inputs)
    return inputs.flag and not inputs.choice and "9,2" or "1,2", inputs.flag and 2 or 1
end do(plan) return do(checked) return do(inputs)
            if inputs.flag and not inputs.choice then
                local found = false
                for _, cell in pairs checked.cells do
                    if cell.payload == 9 then
                        assert(cell.low == checked.positions[cell.index].floor + 4,
                            "retained prefix disappeared")
                        found = true
                    end
                end
                assert(found, "retained-prefix call did not run")
            end
        end end end

local early = witness (joined_root "early-exit-before-role-acquisition" { early = true,
        target = boundary.replace }) do(inputs)
    if not inputs.flag and inputs.early then return "", 0 end
    return inputs.flag and not inputs.choice and "3,2" or "1,2", inputs.flag and 2 or 1
end nothing

-- Invalid physical plans, never valid source programs counted as expected rejections.
local bad_plan = do(name) = do(fragment) = do(body)
    local ok, problem = pcall body
    assert(not ok and tostring(problem):find(fragment, 1, true), name .. ": " .. tostring problem)
    rejections += 1
    print("refused " .. name .. ": " .. tostring problem)
end
local change_edges = do(program) = do(change)
    local ending = v.Terminator.pass "mutate normalized edge operands" with
        Jump = do(node, recurse, instructions) = v.Jump with ..node
            edge = change node.edge instructions
        end
        Branch = do(node, recurse, instructions) = v.Branch with ..node
            when_true = change node.when_true instructions
            when_false = change node.when_false instructions
        end
        Return = do(node, recurse, instructions) = node
        Trap = do(node, recurse, instructions) = node
    end
    local blocks = {}
    for _, block in ipairs program.blocks do
        local instructions = copy block.instructions
        local terminator = ending(block.terminator, instructions)
        blocks[#blocks + 1] = v.Block { ..block, .instructions, .terminator }
    end
    return v.Definition { ..program, .blocks }
end
local original_snapshot = boundary.write_program original.definition
local sibling_padding = change_edges original.definition do(edge) return do(instructions)
        if #edge.arguments ~= 5 then return edge end
        local arguments = copy edge.arguments
        arguments[4], arguments[5] = original.fresh[2].index, original.fresh[2].mark
        return v.Edge { ..edge, .arguments }
    end end
v.verify_graph sibling_padding
bad_plan "pad from a surviving sibling" "restore clips surviving sibling/holding" do()
    boundary.ledger_for_inputs sibling_padding ({ flag = false, choice = false }) 64
end
local mixed_marks = change_edges original.definition do(edge) return do(instructions)
        if #edge.arguments ~= 5 then return edge end
        local arguments = copy edge.arguments
        arguments[5] = original.fresh[1].mark
        return v.Edge { ..edge, .arguments }
    end end
v.verify_graph mixed_marks
bad_plan "extra position with another position's mark" "restore replaced original boundary mark" do()
    boundary.ledger_for_inputs mixed_marks ({ flag = false, choice = false }) 64
end
local serial = 0
local recaptured = change_edges original.definition do(edge) return do(instructions)
        if #edge.arguments ~= 5 then return edge end
        serial += 1
        local result = v.Result { identity = "invalid.join.recapture." .. serial, native_type = "U64" }
        instructions[#instructions + 1] = v.StackTop with
            .result
            index = original.fresh[3].index
            role = "invalid later capture"
            at = "after optional native allocation"
        end
        local arguments = copy edge.arguments
        arguments[5] = result
        return v.Edge { ..edge, .arguments }
    end end
v.verify_graph recaptured  -- Dominance is insufficient: the later value reaches the join legally.
bad_plan "replace pre-call mark with an edge-local top" "restore replaced original boundary mark" do()
    boundary.ledger_for_inputs recaptured ({ flag = true, choice = false }) 0
end
local missing = change_edges original.definition do(edge) return do(instructions)
        if #edge.arguments ~= 5 then return edge end
        local arguments = copy edge.arguments
        arguments[4], arguments[5] = nil, nil
        return v.Edge { ..edge, .arguments }
    end end
bad_plan "lose normalized edge operands" "edge arity mismatch" do() v.verify_graph missing end
local blocks = {}
for _, block in ipairs original.definition.blocks do
    local instructions = {}
    for _, node in ipairs block.instructions do
        if not (v.Instruction.is(node, v.StackWrite) and node.role:find("boundary.join.", 1, true) == 1 and
            node.role:match "%.2$") then instructions[#instructions + 1] = node end
    end
    blocks[#blocks + 1] = v.Block { ..block, .instructions }
end
local omitted = v.verify_graph(v.Definition { ..original.definition, .blocks })
bad_plan "omit completion of the unused extended role" "completion lost or duplicated" do()
    boundary.ledger_for_inputs omitted ({ flag = false, choice = false }) 0
end
local repeated_blocks = {}
for _, block in ipairs original.definition.blocks do
    local instructions = {}
    for _, node in ipairs block.instructions do
        instructions[#instructions + 1] = node
        if v.Instruction.is(node, v.StackWrite) and node.role:find("boundary.join.", 1, true) == 1 and
        node.role:match "%.2$" then instructions[#instructions + 1] = node end
    end
    repeated_blocks[#repeated_blocks + 1] = v.Block { ..block, .instructions }
end
local repeated_empty = v.verify_graph(v.Definition with ..original.definition
    blocks = repeated_blocks
end)
bad_plan "duplicate completion even when the role has no payload" "frame has no completion authority" do()
    boundary.ledger_for_inputs repeated_empty ({ flag = false, choice = false }) 0
end
local wrong_primary = change_edges swapped.definition do(edge) return do(instructions)
        if #edge.arguments ~= 5 then return edge end
        local arguments = copy edge.arguments
        arguments[2], arguments[3] = swapped.fresh[1].index, swapped.fresh[1].mark
        return v.Edge { ..edge, .arguments }
    end end
v.verify_graph wrong_primary
bad_plan "normalization forgets the earlier field swap" "incoming holding is not covered by its component" do()
    boundary.ledger_for_inputs wrong_primary ({ flag = false, choice = false, swap = true }) 64
end
local early_blocks = {}
for _, block in ipairs early.definition.blocks do
    local instructions = {}
    for _, node in ipairs block.instructions do
        if not (v.Instruction.is(node, v.StackWrite) and node.role == early.fresh[3].role) then
            instructions[#instructions + 1] = node
        end
    end
    early_blocks[#early_blocks + 1] = v.Block { ..block, .instructions }
end
local lost_unused_exit = v.verify_graph(v.Definition { ..early.definition, blocks = early_blocks })
bad_plan "hoisted role abandoned at an early exit" "completion lost or duplicated" do()
    boundary.ledger_for_inputs lost_unused_exit ({ flag = false, choice = false, early = true }) 64
end
assert(boundary.write_program original.definition == original_snapshot,
    "mutants changed accepted output")
assert(not package.loaded["nua.stage"], "old evaluator was loaded")
print(("\nPASS: %d completion-join witnesses; %d prefix/Boolean checks; %d invalid-plan/IR rejections. No native execution."):format(
        witnesses, executions, rejections))

-- This separate valid-program acceptance formerly failed in the vector planner.
-- Use the explicit boundary-relation experiment now, never a fallback or a rejection.
-- Its source closure above is unchanged; the old failure logs remain historical evidence.
if arg[1] == "--exchanged-components" then
    local exchanged = exchanged_source()
    print("\n=== exchanged-component source ===\n" .. boundary.write_program exchanged)
    local regions = assert(mua.loadfile "docs/design/compiler-region-probe.mua")(boundary)
    regions.accept_exchanged exchanged
end
