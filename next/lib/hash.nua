-- SipHash-2-4 as ordinary Nua, streaming across chunks; explicit keys let the whole algorithm
-- run while compiling. The process's key is platform state.

local hash = {}

local State = struct { v0: U64, v1: U64, v2: U64, v3: U64, tail: U64, length: U64, used: U32 }
hash.State = State

local rotate = do(x: U64, n): U64 = (x << n) | (x >> (64 - n))

local sip_round = do(h: Ref State): Unit
    h.v0 = h.v0 + h.v1
    h.v1 = rotate(h.v1, 13) ~ h.v0
    h.v0 = rotate(h.v0, 32)
    h.v2 = h.v2 + h.v3
    h.v3 = rotate(h.v3, 16) ~ h.v2
    h.v0 = h.v0 + h.v3
    h.v3 = rotate(h.v3, 21) ~ h.v0
    h.v2 = h.v2 + h.v1
    h.v1 = rotate(h.v1, 17) ~ h.v2
    h.v2 = rotate(h.v2, 32)
end

local block = do(h: Ref State, word: U64): Unit
    h.v3 = h.v3 ~ word
    sip_round h
    sip_round h
    h.v0 = h.v0 ~ word
end

hash.init = do(k0: U64, k1: U64): State
    return State with
        v0 = k0 ~ 0x736f6d6570736575ULL
        v1 = k1 ~ 0x646f72616e646f6dULL
        v2 = k0 ~ 0x6c7967656e657261ULL
        v3 = k1 ~ 0x7465646279746573ULL
        tail = 0
        length = 0
        used = 0
    end
end

local byte = do(h: Ref State, value: U8): Unit
    h.tail = h.tail | (U64 value << (h.used * 8))
    h.used = h.used + 1
    if h.used == 8 then
        block(h, h.tail)
        h.tail = 0
        h.used = 0
    end
end

hash.bytes = do(h: Ref State, text: Str): Unit
    h.length = h.length + text.length
    local i: U64 = 0
    while i < text.length do
        byte(h, text[i])
        i = i + 1
    end
end

hash.u64 = do(h: Ref State, value: U64): Unit
    h.length = h.length + 8
    if h.used == 0 then
        block(h, value)
    else
        for at = 0, 7 do
            byte(h, U8((value >> (at * 8)) & 255))
        end
    end
end

hash.finish = do(h: Ref State): U64
    block(h, h.tail | ((h.length & 255) << 56))
    h.v2 = h.v2 ~ 255
    sip_round h
    sip_round h
    sip_round h
    sip_round h
    return (h.v0 ~ h.v1) ~ (h.v2 ~ h.v3)
end

hash.sip24 = do(text: Str, k0: U64, k1: U64): U64
    local h = hash.init(k0, k1)
    hash.bytes(Ref h, text)
    return hash.finish(Ref h)
end

-- the process's keyed state: its key is platform state
hash.process = do(): State = hash.init(platform.hash_seed 0, platform.hash_seed 1)

return hash
