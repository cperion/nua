local compile = require "nua.compile"
local native = require "tests.support.native"

local refuses = do(source, expected)
    local done, problem = pcall(compile.compile, source, "refused.nua")
    assert(not done, "expected the compiler to refuse")
    assert(tostring(problem):find(expected, 1, true), tostring problem)
end

test "supply, then evaluate: a partial application is exported with its known arguments":
    local library, text = native("affine", [[
local affine = do(scale: U32, bias: U32, x: U32): U32 = scale * x + bias
local transform = affine 4 3
export transform
]])
    assert(library.transform(5) == 23)
    assert(library.transform(0) == 3)
    assert(text:find("4u", 1, true) and text:find("3u", 1, true))
end

test "known computation folds away":
    local library, text = native("folded", [[
local seven = do(): U32 = 1 + 2 * 3
export seven
]])
    assert(library.seven() == 7)
    assert(text:find("return 7u;", 1, true), text)
end

test "a dynamic branch joins its arms":
    local library = native("max", [[
local max = do(a: U32, b: U32): U32
    if a < b then return b end
    return a
end
export max
local clamp = do(x: I32): I32
    local y = x
    if x < 0 then
        y = 0
    elseif x > 100 then
        y = 100
    end
    return y
end
export clamp
]])
    assert(library.max(3, 9) == 9 and library.max(9, 3) == 9)
    assert(library.clamp(-5) == 0 and library.clamp(50) == 50 and library.clamp(500) == 100)
end

test "narrow integers wrap at run time as they do when known":
    local library = native("wrap", [[
local add = do(a: U8, b: U8): U8 = a + b
export add
local known = do(): U8 = add 200 100
export known
]])
    assert(library.add(200, 100) == 44)
    assert(library.known() == 44)
end

test "a loop whose rounds stay known runs at compile time (syntax §6.3)":
    local library, text = native("triangular", [[
local triangular = do(n: U32): U32
    local total: U32 = 0
    for i: U32 = 1, n do
        total = total + i
    end
    return total
end
local fifteen = do(): U32 = triangular 5
export fifteen
local runtime_sum = do(n: U32): U32 = triangular n
export runtime_sum
]])
    assert(library.fifteen() == 15)
    assert(text:find("return 15u;", 1, true), text)
    assert(library.runtime_sum(0) == 0 and library.runtime_sum(4) == 10 and library.runtime_sum(100) == 5050)
end

test "a typed for never steps past its limit, even at the edge of its type":
    local library = native("edges", [[
local count_to = do(limit: U8): U32
    local steps: U32 = 0
    for i: U8 = 250, limit do
        steps = steps + 1
    end
    return steps
end
export count_to
]])
    assert(library.count_to(255) == 6)
    assert(library.count_to(249) == 0)
end

test "rounds that turn dynamic part way keep the known rounds before them":
    local library, text = native("mixed", [[
local mixed_loop = do(x: U32): U32
    local acc: U32 = 1
    for i: U32 = 1, 4 do
        if i == 3 then acc = acc + x else acc = acc * 2 end
    end
    return acc
end
export mixed_loop
]])
    -- rounds 1 and 2 doubled acc at compile time; round 3 onward runs: (4 + x) * 2
    assert(library.mixed_loop(5) == 18 and library.mixed_loop(0) == 8)
    assert(text:find("4u", 1, true), text)
end

test "break and continue leave and restart a round":
    local library = native("until", [[
local sum_until = do(x: U32): U32
    local total: U32 = 0
    local i: U32 = 0
    while true do
        i = i + 1
        if i > x then break end
        if i == 3 then continue end
        total = total + i
    end
    return total
end
export sum_until
]])
    assert(library.sum_until(5) == 1 + 2 + 4 + 5)
    assert(library.sum_until(0) == 0)
end

test "a generation-time for unrolls over host numbers (syntax §6.1)":
    local library, text = native("generation", [[
local make_sum = do(n)
    return do(x: U32): U32
        local total = x
        for i = 1, n do
            total = total + i
        end
        return total
    end
end
local add6 = make_sum 3
export add6
]])
    assert(library.add6(10) == 16)
end

test "undefined behaviour is refused, never folded":
    refuses([[
local broken = do(): I32
    local big: I32 = 2147483647
    return big + 1
end
export broken
]], "overflows I32")
    -- two host literals are host arithmetic; the sum then meets I32 and does not fit
    refuses([[
local broken = do(): I32 = 2147483647 + 1
export broken
]], "2147483648 does not fit I32")
    refuses([[
local broken = do(x: U32): U32 = x / 0
export broken
]], "division by zero")
end

test "literals take their partner's type, with a range check (syntax §7.2)":
    refuses([[
local broken = do(a: U8): U8 = a + 300
export broken
]], "300 does not fit U8")
end

test "recursion under known control keeps unfolding (syntax §6.5)":
    local library, text = native("cube", [[
local function pow(x: U32, n: U32): U32
    if n == 0 then return 1 end
    return x * pow x (n - 1)
end
local cube = do(x: U32): U32 = pow x 3
export cube
]])
    assert(library.cube(3) == 27 and library.cube(5) == 125)
    -- no native function for pow: the three multiplications are in cube itself
    assert(not text:find("pow_", 1, true), text)
end

test "tail re-entries are loops in place; a non-tail re-entry is a native function (syntax §6.2)":
    local library, text = native("recursion", [[
local function gcd(a: U32, b: U32): U32
    if b == 0 then return a end
    return gcd b (a % b)
end
export gcd
local function factorial(n: U64): U64
    if n < 2 then return 1 end
    return n * factorial (n - 1)
end
export factorial
local function count_down(k: U32, x: U32): U32
    if x == 0 then return k end
    return count_down (k + 1) (x - 1)
end
local walk = do(x: U32): U32 = count_down 0 x
export walk
]])
    assert(library.gcd(48, 18) == 6 and library.gcd(17, 5) == 1 and library.gcd(5, 0) == 5)
    assert(library.factorial(20) == 2432902008176640000ULL)
    assert(library.walk(0) == 0 and library.walk(1000) == 1000)
    -- a tail re-entry of the same shape is a loop in place, not a function (syntax §6.2)
    assert(not text:find("count_down", 1, true) and not text:find("gcd(p2", 1, true), text)
    -- walk's loop starts with k generalized from its known 0 and x from the parameter
    assert(text:find("t1 = 0u; uint32_t t2 = p1;", 1, true), text)
    -- a non-tail re-entry becomes a native function: factorial calls itself
    assert(text:find("= factorial(v", 1, true), text)
end

test "mutual recursion meets one definition per word":
    local library = native("parity", [[
local is_odd
local function is_even(n: U32): Bool
    if n == 0 then return true end
    return is_odd (n - 1)
end
is_odd = do(n: U32): Bool
    if n == 0 then return false end
    return is_even (n - 1)
end
export is_even
]])
    assert(library.is_even(10) == true and library.is_even(7) == false and library.is_even(0) == true)
end

test "call crosses a native boundary, specialized on the known supply (compiler activities §8.1)":
    local library, text = native("boundary", [[
local affine = do(scale: U32, bias: U32, x: U32): U32 = scale * x + bias
local transform = affine 4 3
local twice = do(x: U32): U32 = call transform x + call transform (x + 1)
export twice
]])
    assert(library.twice(5) == 23 + 27)
    -- one definition of affine with scale 4 and bias 3, called twice
    local _, definitions = text:gsub("static uint32_t affine_%d+%(uint32_t p1%) {", "")
    assert(definitions == 1, text)
    local _, calls = text:gsub("affine_%d+%(", "")
    assert(calls == 4, text)    -- prototype, definition, two calls
end

test "call needs a saturated application":
    refuses([[
local affine = do(scale: U32, x: U32): U32 = scale * x
local broken = do(x: U32): U32 = call affine x
export broken
]], "call needs a saturated application")
end

test "records are carried field by field through a loop (syntax §6.4)":
    local library, text = native("fib_pair", [[
local Pair = struct { a: U32, b: U32 }
local fib_pair = do(n: U32): U32
    local p = Pair { a = 0, b = 1 }
    for i: U32 = 1, n do
        p = Pair { a = p.b, b = p.a + p.b }
    end
    return p.a * 1000 + p.b
end
export fib_pair
]])
    assert(library.fib_pair(0) == 1 and library.fib_pair(1) == 1001 and library.fib_pair(10) == 55089)
end

test "an unchanged known field stays known inside the loop and after it":
    local library, text = native("panel", [[
local Panel = struct { gap: U32, padding: U32, count: U32 }
local panel_extent = do(n: U32): U32
    local panel = Panel { gap = 12, padding = 24, count = 0 }
    local i: U32 = 0
    while i < n do
        panel.count = panel.count + 1
        i = i + 1
    end
    return panel.padding * 2 + panel.count * panel.gap
end
export panel_extent
]])
    assert(library.panel_extent(0) == 48 and library.panel_extent(3) == 84)
    assert(text:find("48u", 1, true) and text:find("* 12u", 1, true), text)
    assert(not text:find("Panel_", 1, true), "the record never needed storage:\n" .. text)
end

test "a branch that changes one field adds one parameter":
    local library, text = native("one_field", [[
local Point = struct { x: I32, y: I32 }
local nudge = do(flag: Bool, d: I32): I32
    local p = Point { x = 1, y = 2 }
    if flag then p.x = p.x + d end
    return p.x * 10 + p.y
end
export nudge
]])
    assert(library.nudge(true, 5) == 62 and library.nudge(false, 5) == 12)
    local _, parameters = text:gsub("int32_t block%d+_%d+;", "")
    assert(parameters == 1, text)
end

test "nested records, field assignment and compound assignment":
    local library = native("nested", [[
local Inner = struct { value: U32 }
local Outer = struct { left: Inner, right: Inner, scale: U32 }
local combine = do(a: U32, b: U32): U32
    local o = Outer { left = Inner { value = a }, right = { value = b }, scale = 3 }
    o.left.value += 1
    o.scale *= 2
    return (o.left.value + o.right.value) * o.scale
end
export combine
]])
    assert(library.combine(1, 2) == (2 + 2) * 6)
end

test "records cross a native boundary and an export's C interface":
    local ffi = require "ffi"
    local library, text = native("record_call", [[
local Point = struct { x: I32, y: I32 }
local function swap(p: Point): Point
    return Point { x = p.y, y = p.x }
end
local manhattan = do(p: Point): I32
    local q = call swap p
    return q.x - q.y
end
export manhattan
local make = do(x: I32, y: I32): Point = Point { x = x, y = y }
export make
]])
    local point = library.make(3, -4)
    assert(point.x == 3 and point.y == -4)
    assert(library.manhattan(point) == -7)
    assert(text:find("static Point_%d+ swap_%d+%(Point_%d+ p1%)"), text)
end

test "a tail loop runs in constant stack, and folds under known control":
    local library, text = native("tail_depth", [[
local function count_down(k: U32, x: U32): U32
    if x == 0 then return k end
    return count_down (k + 1) (x - 1)
end
local walk = do(x: U32): U32 = count_down 0 x
export walk
local five = do(): U32 = count_down 0 5
export five
]])
    assert(library.walk(100000000) == 100000000)
    assert(library.five() == 5 and text:find("return 5u;", 1, true), text)
end
