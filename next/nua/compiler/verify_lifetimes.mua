-- The lifetimes verifier (compiler activities §7.3; buffers §2.3, §4.2): it replays a finished
-- definition's borrow states and owner transfers over its control-flow graph, from the facts
-- its builder published, without trusting that builder's own checks.
--
--   * A value whose facts say it carries a borrow must be used only while that borrow is live.
--     `Moves` ends the stored borrows it overlaps; `Ends` ends every borrow it overlaps.
--   * A borrow carried into a block argument is ended there if it ended on any incoming edge.
--   * An owner value is transferred at most once on every path: by a store, an owning call
--     argument, a return, an edge argument or a pack. That is what prevents a double release.
--     That every owner is released exactly once is a property of execution, checked against an
--     independent allocation ledger, not claimed by this verifier.
--
-- `Analysis` supplies each definition's values, borrow origins, entry states and site/edge
-- snapshots. Acquisition points come from those snapshots; invalidation is replayed from
-- instructions rather than copied from the evaluator's successful states.

local identity = require "nua.identity"
local types = require "nua.types"
local data = require "nua.compiler.data"
local graph = require "nua.compiler.graph"
local facts_module = require "nua.compiler.facts"
local verify = require "nua.compiler.verify"
local borrow_paths = require "nua.compiler.borrow_paths"
local provenance = require "nua.compiler.provenance"
local boundaries = require "nua.compiler.boundaries"

local Instruction, Terminator, Operand = data.Instruction, data.Terminator, data.Operand
local BorrowState, PlaceRoot = data.BorrowState, data.PlaceRoot

-- the borrows a value carries, from its facts
local borrows_of = do(values, operand)
    if Operand.is(operand, data.Constant) then return {} end
    local info = values[data.operand_key operand]
    if info == nil then return {} end
    local list = {}
    for _, component in pairs info.components do
        if data.ComponentInfo.is(component, data.Borrowed) then list[#list + 1] = component.borrow end
    end
    table.sort(list, |a, b| -> a.serial < b.serial)
    return list
end

-- the operands an instruction transfers, if they own storage: a store's value, a pack's
-- components, a call's arguments; every other kind transfers nothing
local Transferring = define ..graph.Inert
    Store = |node, recurse, transfer| -> transfer node.value
    Pack = do(node, recurse, transfer)
        for _, operand in ipairs node.components do transfer operand end
    end
    Invoke = do(node, recurse, transfer)
        for _, operand in ipairs node.arguments do transfer operand end
    end
end
local each_transferred = Instruction.pass "the operands an instruction transfers" with ..Transferring end

local copy_states = do(states)
    local copy = {}
    for id, state in pairs states do copy[id] = state end
    return copy
end
local copy_set = do(set)
    local copy = {}
    for key in pairs set do copy[key] = true end
    return copy
end

-- The published facts are complete and well formed: every borrow has origin facts and a valid
-- form, value facts are keyed by component paths, and every borrowed operand has its facts.
-- Answers whether the definition can be replayed.
local check_published = do(definition, published, report)
    local values, registry = published.values, published.borrows
    local valid = true
    local refuse = do(message, origin)
        valid = false
        report(definition, message, origin)
    end
    for _, info in pairs registry do
        local problem = borrow_paths.validate info
        if problem then refuse(problem, info.acquired) end
    end
    local require_borrow = do(id, origin)
        if registry[id] == nil then refuse("a borrow has no published origin facts", origin) end
    end
    local check_value
    check_value = do(value)
        if data.NativeValue.is(value, data.Reference) then
            local info = registry[value.borrow]
            if info and data.BorrowForm.is(info.form, data.Stored) and info.form.pointer == nil then
                refuse("resident provenance cannot be a materialized reference", info.acquired)
            end
        elseif data.NativeValue.is(value, data.Aggregate) then
            for _, part in pairs value.parts do check_value(part) end
        end
    end
    local check_flow = do(flow)
        for id in pairs flow.borrows do require_borrow(id, definition.origin) end
        for _, contents in pairs flow.contents do
            if data.Contents.is(contents, data.Resident) then
                for _, id in ipairs provenance.borrowed(contents.info) do require_borrow(id, definition.origin) end
            elseif data.Contents.is(contents, data.Tracked) then check_value(contents.value) end
        end
    end
    for _, info in pairs values do
        for key, component in pairs info.components do
            if not check(data.ComponentPath, key) then refuse("value facts need component-path keys", definition.origin) end
            if data.ComponentInfo.is(component, data.Borrowed) then require_borrow(component.borrow, definition.origin) end
        end
    end
    for _, flow in pairs published.entries do check_flow flow end
    for _, site in pairs published.sites do
        check_flow(site.before)
        check_flow(site.after)
    end
    for _, edge in pairs published.edges do check_flow(edge.flow) end
    for _, place in pairs definition.places do
        if PlaceRoot.is(place.root, data.IndirectRoot) then require_borrow(place.root.borrow, place.origin) end
    end
    local check_operand = do(operand, origin)
        if not Operand.is(operand, data.Constant) and types.borrows operand.type and #borrows_of(values, operand) == 0 then
            refuse("a borrowed operand has no published borrow facts", origin)
        end
    end
    for _, block in ipairs definition.blocks do
        for _, instruction in ipairs block.instructions do
            for _, operand in ipairs(verify.operands_of instruction) do check_operand(operand, instruction.site.origin) end
        end
        for _, operand in ipairs(verify.terminator_operands block.terminator) do check_operand(operand, block.terminator.origin) end
    end
    return valid
end

-- The replay of one definition (a stateful vocabulary, compiler guide §4.6). What belongs to
-- the whole replay is captured: the published facts, the borrow tracking, the places. What
-- varies per block is the working state, one table passed to every handler (§4.5):
--   flow       evolving: the borrow states and contents replayed so far
--   moved      evolving: the owner values transferred so far on this path
--   previous   evolving: the last snapshot acquisitions were taken from
--   observed   evolving: borrows whose state a call or load has already set
--   reporting  inherited: whether this pass reports (only the pass over the fixed point does)
--   replay     the callee-replay context of this block
-- Problems accumulate through `report`.
local replaying = do(program, definition, published, analysis, report)
    local values, registry = published.values, published.borrows
    local supply = identity.supply()
    local places = definition.places
    -- Formal origins remain symbolic here. Whether two distinct parameters may alias is a
    -- boundary-contract obligation, checked after substitution at the call; treating every
    -- formal as aliased would reject a valid disjoint call. This pass checks the explicit
    -- origins in this definition, not closure of the (still unfinished) boundary contracts.
    local tracking = facts_module.tracking { borrows = registry, .supply }
    local blocks_by_id = {}
    for _, block in ipairs definition.blocks do blocks_by_id[block.id] = block end
    local writer = { has_place = id -> true, declare = place -> nil }

    -- the context a native call's contract is replayed in, for one block
    local replay_context = do()
        local replay_registry, replay_places = {}, {}
        for id, info in pairs registry do replay_registry[id] = info end
        for _, item in pairs program.definitions do
            for id, place in pairs item.places do replay_places[id] = place end
        end
        local replay = { borrows = replay_registry, places = replay_places, .supply }
        replay.memory = provenance.working(replay, tracking, facts_module.paths_overlap)
        replay.check_store = |path, targets, info| -> nil
        replay.bundle_of = do(id)
            local target, target_facts = program.definitions[id], analysis.definitions[id]
            if not target or not target_facts then return nil end
            return { definition = target, facts = target_facts, contract = boundaries.project(target, target_facts, program.revision) }
        end
        return replay
    end

    ------------------------------------------------------------------------------------------
    -- the operations a handler uses on the working state

    local match_components = do(state, destination, source, source_flow, merge)
        if not destination or not source then return end
        provenance.each_borrowed_pair(destination, source, do(part, from)
            local borrow_state = source_flow.borrows[from.borrow] or data.Live {}
            local previous_state = state.flow.borrows[part.borrow]
            if not merge or not previous_state or not BorrowState.is(previous_state, data.Ended) then state.flow.borrows[part.borrow] = borrow_state end
            state.observed[part.borrow] = true
        end)
    end
    -- Snapshots tell us where a borrow is acquired, not whether a later use is legal.
    -- Replay effects independently. Only a new acquisition resets a loop-local borrow;
    -- an inherited borrow must keep the state arriving on the actual CFG edges.
    local acquire = do(state, snapshot)
        if snapshot == nil then return end
        for id, borrow_state in pairs snapshot.borrows do
            if not state.observed[id] and (state.previous == nil or state.previous.borrows[id] == nil) then state.flow.borrows[id] = borrow_state end
        end
        state.previous = snapshot
    end
    local use_borrow = do(state, borrow, origin)
        if not state.reporting then return end
        local borrow_state = state.flow.borrows[borrow]
        if registry[borrow] == nil then
            report(definition, "a borrow has no published origin facts", origin)
        elseif borrow_state == nil then
            report(definition, "a borrow is used before it is acquired", origin)
        elseif BorrowState.is(borrow_state, data.Ended) then
            report(definition, ("a borrow is used after it ended (%s)"):format(borrow_state.reason), origin)
        end
    end
    local use = do(state, operand, origin)
        local info = not Operand.is(operand, data.Constant) and values[data.operand_key(operand)]
        for key, component in pairs(info and info.components or {}) do
            if not provenance.is_payload(key) and data.ComponentInfo.is(component, data.Borrowed) then use_borrow(state, component.borrow, origin) end
        end
    end
    local transfer = do(state, operand, origin)
        if Operand.is(operand, data.Constant) or not types.owns(operand.type) then return end
        local key = data.operand_key operand
        if state.moved[key] and state.reporting then report(definition, "an owner value is transferred twice", origin) end
        state.moved[key] = true
    end
    -- an extraction uses only the borrows of the component it selects
    local use_extracted = do(state, instruction, origin)
        local info = values[data.operand_key(instruction.aggregate)]
        for key, component in pairs(info and info.components or {}) do
            if provenance.extracted_by(instruction.path, key) and data.ComponentInfo.is(component, data.Borrowed) then use_borrow(state, component.borrow, origin) end
        end
    end

    ------------------------------------------------------------------------------------------
    -- what each kind of instruction does to the working state, beyond the uses and transfers
    -- every instruction has (compiler guide §4.1: a pass checked against the family)

    local invalidate = do(instruction, recurse, state, site)
        local origin = instruction.site.origin
        local place = places[instruction.target.place]
        if place and PlaceRoot.is(place.root, data.IndirectRoot) then use_borrow(state, place.root.borrow, origin) end
        for _, base in ipairs provenance.accesses(place, places, registry) do
            local target = data.Access { place = base.place, path = provenance.concat(base.path, instruction.target.path) }
            if Instruction.is(instruction, data.Moves) then tracking.moves(state.flow, target, origin)
            else tracking.ends(state.flow, target, instruction.reason, origin) end
        end
    end
    local Replaying = define ..graph.Inert
        Moves = invalidate
        Ends = invalidate
        -- a native call: its contract replayed against the actual arguments
        Invoke = do(instruction, recurse, state, site)
            if not data.Callee.is(instruction.callee, data.DirectNua) then return end
            local origin = instruction.site.origin
            local target = instruction.callee.definition
            if analysis.contracts[target] == nil then
                if state.reporting then report(definition, "a native call has no boundary contract", origin) end
                return
            end
            local arguments = {}
            for index, operand in ipairs instruction.arguments do
                arguments[index] = not Operand.is(operand, data.Constant) and values[data.operand_key(operand)] or provenance.plain(operand.type)
            end
            local at = { flow = facts_module.fork(state.flow), .writer }
            local returned = boundaries.apply(state.replay.bundle_of(target), at, arguments, state.replay, do(path, message)
                if state.reporting then report(definition, message, origin) end
            end)
            for id in pairs registry do
                if at.flow.borrows[id] then state.flow.borrows[id] = at.flow.borrows[id] end
            end
            if instruction.result then match_components(state, values[instruction.result], returned, at.flow) end
            if site then
                for id, contents in pairs site.after.contents do
                    if data.Contents.is(contents, data.Resident) and provenance.is_memory(state.replay.places[id]) then
                        local targets = provenance.accesses(state.replay.places[id], state.replay.places, state.replay.borrows)
                        local actual = state.replay.memory.read(at.flow, targets, contents.info.type)
                        match_components(state, contents.info, actual, at.flow)
                    end
                end
            end
        end
        -- new resident components inherit the captured value's replayed state
        Store = do(instruction, recurse, state, site)
            if not site then return end
            local source = not Operand.is(instruction.value, data.Constant) and values[data.operand_key(instruction.value)]
            if not source then return end
            local targets = provenance.accesses(places[instruction.place], places, registry)
            local weak = provenance.weak_store targets
            for id, contents in pairs site.after.contents do
                if contents ~= site.before.contents[id] and data.Contents.is(contents, data.Resident) then
                    match_components(state, contents.info, source, state.flow)
                    local before = site.before.contents[id]
                    if weak and before and data.Contents.is(before, data.Resident) then match_components(state, contents.info, before.info, state.flow, true) end
                end
            end
        end
        -- a borrow loaded from memory takes the state its resident components replayed to
        Load = do(instruction, recurse, state, site)
            if not (instruction.result and types.borrows(places[instruction.place].type)) then return end
            local targets = provenance.accesses(places[instruction.place], places, registry)
            local actual = state.replay.memory.read(state.flow, targets, places[instruction.place].type)
            match_components(state, values[instruction.result], actual, state.flow)
        end
        LifetimeEnd = do(instruction, recurse, state, site)
            for id, info in pairs registry do
                if info.lifetime == instruction.lifetime and state.flow.borrows[id] then
                    state.flow.borrows[id] = data.Ended { at = instruction.site.origin, reason = "released" }
                end
            end
        end
    end
    local replay_effects = Instruction.pass "replay an instruction's effects on borrows" with ..Replaying end

    -- an instruction: acquisitions before it, its uses and transfers, its kind's effects, the
    -- acquisitions and contents after it
    local replay_instruction = do(state, instruction)
        local origin = instruction.site.origin
        local site = published.sites[instruction.site.id]
        if site then acquire(state, site.before) end
        if instruction.result then state.moved[instruction.result] = nil end
        if instruction.place then
            local place = places[instruction.place]
            if place and PlaceRoot.is(place.root, data.IndirectRoot) then use_borrow(state, place.root.borrow, origin) end
            if place and place.root.pointer then use(state, place.root.pointer, origin) end
        end
        for _, operand in ipairs(verify.operands_of instruction) do
            if Instruction.is(instruction, data.Extract) and operand == instruction.aggregate and not Operand.is(operand, data.Constant) then
                use_extracted(state, instruction, origin)
            else
                use(state, operand, origin)
            end
        end
        each_transferred(instruction, operand -> transfer(state, operand, origin))
        replay_effects(instruction, state, site)
        if site then
            acquire(state, site.after)
            for id, contents in pairs site.after.contents do state.flow.contents[id] = contents end
        end
        if instruction.result then
            for _, borrow in ipairs(borrows_of(values, data.Result { value = instruction.result, type = types.Unit })) do
                if state.flow.borrows[borrow] == nil then state.flow.borrows[borrow] = data.Live {} end
            end
        end
    end

    -- the uses a terminator makes; edge captures transport references, they do not use them
    local Ending = define
        Jump = |terminator, recurse, state| -> nil
        Branch = |terminator, recurse, state| -> use(state, terminator.condition, terminator.origin)
        Return = do(terminator, recurse, state)
            if terminator.value then
                use(state, terminator.value, terminator.origin)
                transfer(state, terminator.value, terminator.origin)
            end
        end
        Trap = |terminator, recurse, state| -> use(state, terminator.message, terminator.origin)
    end
    local replay_terminator = Terminator.pass "replay a terminator's uses" with ..Ending end

    -- one block from the states at its entry: answers the borrow states at its end, the owner
    -- transfers before its edges, and each edge's transfers (branch edges are alternatives,
    -- not two consecutive transfers)
    local replay_block = do(block, states, moved, reporting)
        local state = define
            flow = data.FlowFacts { contents = {}, borrows = states, live_lifetimes = {} }
            .moved
            previous = published.entries[block.id]
            observed = {}
            .reporting
            replay = replay_context()
        end
        if state.previous then
            for id, contents in pairs state.previous.contents do state.flow.contents[id] = contents end
        end
        -- a block's parameters are new values each time it is entered
        for index, parameter in ipairs block.arguments do
            state.moved[data.operand_key(data.BlockArgument { block = block.id, .index, type = parameter.type })] = nil
        end
        for _, instruction in ipairs block.instructions do replay_instruction(state, instruction) end
        for id in pairs state.flow.borrows do
            if registry[id] == nil then state.flow.borrows[id] = nil end
        end
        local outgoing = graph.edges_of block.terminator
        if outgoing[1] and published.edges[outgoing[1].id] then acquire(state, published.edges[outgoing[1].id].flow) end
        replay_terminator(block.terminator, state)
        local edge_moves = {}
        local before_edges = state.moved
        for _, edge in ipairs outgoing do
            state.moved = copy_set before_edges
            for _, argument in ipairs edge.arguments do transfer(state, argument, block.terminator.origin) end
            edge_moves[edge.id] = state.moved
        end
        return state.flow.borrows, before_edges, edge_moves
    end

    -- the states a target block's entry receives along one edge: borrows carried by block
    -- arguments, and references transported as path coordinates (the edge row's contents and
    -- the target entry's identify their value flow)
    local carry = do(edge, states)
        local target = blocks_by_id[edge.target]
        local carried = copy_states states
        for index, argument in ipairs edge.arguments do
            local parameter = data.BlockArgument { block = edge.target, .index, type = target.arguments[index].type }
            local incoming = borrows_of(values, argument)
            for _, joined in ipairs(borrows_of(values, parameter)) do
                local borrow_state = data.Live {}
                for _, borrow in ipairs incoming do
                    local incoming_state = states[borrow]
                    if incoming_state and BorrowState.is(incoming_state, data.Ended) then borrow_state = incoming_state end
                end
                carried[joined] = borrow_state
            end
        end
        local row, entry = published.edges[edge.id], published.entries[edge.target]
        if not (row and entry) then return carried end
        local transported = {}
        local keep = do(joined, borrow_state)
            local previous = transported[joined]
            if borrow_state and (previous == nil or BorrowState.is(borrow_state, data.Ended)) then transported[joined] = borrow_state end
        end
        for place, contents in pairs entry.contents do
            local source = row.flow.contents[place]
            if source and data.Contents.is(source, data.Tracked) and data.Contents.is(contents, data.Tracked) then
                provenance.each_reference_pair(source.value, contents.value, |from, to| -> keep(to, states[from]))
            end
            if source and data.Contents.is(source, data.Resident) and data.Contents.is(contents, data.Resident) then
                provenance.each_borrowed_pair(contents.info, source.info, |part, from| -> keep(part.borrow, states[from.borrow]))
            end
        end
        for borrow, borrow_state in pairs transported do carried[borrow] = borrow_state end
        return carried
    end

    -- running until nothing changes (compiler guide §10.6). It terminates without a bound: a
    -- borrow state only moves from live to ended, and the transfers at an entry only grow.
    -- Then one reporting pass over the fixed point.
    local run = do()
        local entry_states, entry_moved = {}, {}
        local initial = published.entries[definition.entry]
        entry_states[definition.entry] = initial and copy_states(initial.borrows) or {}
        entry_moved[definition.entry] = {}
        local order = {}
        for _, block in ipairs definition.blocks do order[#order + 1] = block.id end
        local merge_into = do(target, carried, moved)
            local known = entry_states[target]
            if known == nil then
                entry_states[target] = carried
                entry_moved[target] = copy_set moved
                return true
            end
            local changed = false
            for borrow, borrow_state in pairs carried do
                local previous = known[borrow]
                if previous == nil or (BorrowState.is(borrow_state, data.Ended) and BorrowState.is(previous, data.Live)) then
                    known[borrow] = borrow_state
                    changed = true
                end
            end
            for key in pairs moved do
                if not entry_moved[target][key] then
                    entry_moved[target][key] = true
                    changed = true
                end
            end
            return changed
        end
        local changed = true
        while changed do
            changed = false
            for _, id in ipairs order do
                if entry_states[id] then
                    local states, _, edge_moves = replay_block(blocks_by_id[id], copy_states(entry_states[id]), copy_set(entry_moved[id]), false)
                    for _, edge in ipairs(graph.edges_of(blocks_by_id[id].terminator)) do
                        if merge_into(edge.target, carry(edge, states), edge_moves[edge.id]) then changed = true end
                    end
                end
            end
        end
        for _, id in ipairs order do
            if entry_states[id] then replay_block(blocks_by_id[id], copy_states(entry_states[id]), copy_set(entry_moved[id]), true) end
        end
    end

    return define
        .run
    end
end

local verify_definition = do(program, definition, published, analysis, report)
    if check_published(definition, published, report) then
        replaying(program, definition, published, analysis, report).run()
    end
end

-- Facts belong to exactly one program revision. Missing facts are not a successful check.
local lifetimes = do(program, analysis)
    local problems = {}
    local report = do(definition, message, origin)
        problems[#problems + 1] = verify.Problem { verifier = "lifetimes", definition = definition.id, .message, .origin }
    end
    if not check(data.Analysis, analysis) then
        problems[#problems + 1] = verify.Problem { verifier = "lifetimes", message = "missing or malformed Analysis" }
        return problems
    end
    if analysis.revision ~= program.revision then
        problems[#problems + 1] = verify.Problem { verifier = "lifetimes", message = "analysis revision does not match the program" }
        return problems
    end
    for _, definition in ipairs(graph.definitions_in_order program) do
        local published = analysis.definitions[definition.id]
        local contract = analysis.contracts[definition.id]
        if contract and (contract.definition ~= definition.id or contract.revision ~= program.revision) then report(definition, "boundary contract does not match the definition and program revision", definition.origin) end
        if published == nil then
            report(definition, "a definition has no published lifetime facts", definition.origin)
        else
            verify_definition(program, definition, published, analysis, report)
        end
    end
    return problems
end

return define
    .lifetimes
end
