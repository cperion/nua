-- Explicit native-call / component-completion experiment. No backend or native execution.
-- Run from Nua's root: .local/bin/luajit ../mua/mua.lua docs/design/compiler-boundary-probe.mua
local mua = require "mua.init"
local v = assert(mua.loadfile "docs/design/compiler-activities-probe.mua") "module"
local storage = assert(mua.loadfile "docs/design/compiler-completion-probe.mua")(v)
local copy = v.copy_keys

-- A plan owns native definition variants, keyed by RELATIVE incoming completion widths,
-- never physical positions. This finite acyclic experiment is not recursive agreement.
local planning = do()
    local cache, active = {}, {}
    local prepare
    prepare = do(definition) = do(widths) = do(receiving)
        local suffix = receiving and ".receiver" or (".leases_" .. table.concat(widths, "_"))
        local key = definition.identity .. suffix
        if cache[key] then assert(cache[key].source == definition,
                "conflicting definition identity"); return cache[key] end
        assert(not active[definition],
            "recursive completion contracts are not implemented by this probe")
        active[definition] = true
        v.verify definition
        local analysis = v.analyze definition
        local parameters, leases, captures = copy definition.parameters, {}, {}
        local fresh, classes, bundles, indices, extras, incoming, originals, callees, dependencies = {}, {}, {}, {}, {}, {}, {}, {}, {}
        local output, next_position = storage.realization(), 0
        local input_bundles, edge_bundles, normalizations, capture_anchors = {}, {}, {}, {}
        local parameter_pair = do(name)
            local index = v.Parameter { identity = "boundary." .. name .. ".index", native_type = "U64" }
            local mark = v.Parameter { identity = "boundary." .. name .. ".mark", native_type = "U64" }
            parameters[#parameters + 1], parameters[#parameters + 2] = index, mark
            leases[#leases + 1] = v.Lease { .index, .mark }
            local role = "boundary." .. name
            indices[role] = index
            return { .role, .index, .mark, members = {} }
        end
        local owner_index = 0
        for _, parameter in ipairs definition.parameters do
            if parameter.native_type == "Owned U32" then
                owner_index += 1
                local bundle = {}
                for item = 1, assert(widths[owner_index], "missing incoming component width") do
                    bundle[item] = parameter_pair ("input." .. owner_index .. "." .. item)
                end
                bundles[parameter.identity] = bundle
                input_bundles[#input_bundles + 1] = bundle
            end
        end
        assert(owner_index == #widths, "extra incoming component width")
        for _, callee in ipairs(definition.callees or {}) do callees[callee.identity] = callee end
        for _, block in ipairs definition.blocks do
            originals[block.identity] = block
            for _, edge in ipairs(v.edges block.terminator) do
                incoming[edge.target] = incoming[edge.target] or {}
                incoming[edge.target][#incoming[edge.target] + 1] = edge
            end
        end
        -- Completion operands are demanded by calls and receiver resets, not by a
        -- bare native owner return: that boundary already returns its whole envelope.
        -- Propagate demand through moves/edges before building any component phis.
        local needed, changed = {}, false
        local need = do(value)
            if value.native_type == "Owned U32" and not needed[value.identity] then
                needed[value.identity], changed = true, true
            end
        end
        for _, block in ipairs definition.blocks do
            for _, node in ipairs block.instructions do
                if v.Instruction.is(node, v.Call) then
                    for _, value in ipairs node.arguments do need value end
                elseif receiving and v.Instruction.is(node, v.EndOwned) then need node.owner end
            end
        end
        while changed do
            changed = false
            for _, block in ipairs definition.blocks do
                for _, node in ipairs block.instructions do
                    if v.Instruction.is(node, v.TransferOwned) and needed[node.result.identity] then need node.source end
                end
                for index, argument in ipairs block.arguments do
                    if needed[argument.identity] then
                        for _, edge in ipairs(assert incoming[block.identity]) do need edge.arguments[index] end
                    end
                end
            end
        end
        local new_class = do()
            local ordinal = #fresh + 1
            local result
            if receiving then
                local role = "boundary.fresh." .. ordinal
                local index = (v.wide next_position).operand
                next_position += 1
                local mark = v.Result { identity = role .. ".mark", native_type = "U64" }
                indices[role] = index
                result = { .role, .index, .mark, members = {} }
            else result = parameter_pair ("fresh." .. ordinal) end
            result.ordinal, result.sites = ordinal, {}
            fresh[ordinal] = result
            if receiving then captures[#captures + 1] = v.Lease { index = result.index, mark = result.mark } end
            return result
        end
        -- Captures are realized after normalization chooses their sites. No allocation,
        -- source call, initialization, or effect is moved with an observation of the top.
        local capture_before = do(node) = do(component)
            capture_anchors[node] = capture_anchors[node] or {}
            capture_anchors[node][#capture_anchors[node] + 1] = component
        end
        local resolve = do(component) = do(path)
            while component.join do
                component = assert(component.choices[path.selections[component.join]],
                    "component selection has no correlated incoming edge")
            end
            return component
        end
        local supplement = do(edges) = do(supplied) = do(item)
            local candidate
            for _, edge in ipairs edges do
                local component = supplied[edge][item]
                if component then
                    for _, path in ipairs(assert analysis.edge_paths[edge]) do
                        local selected = resolve component path
                        assert(not candidate or candidate == selected,
                            "unequal component alternatives need another normalization")
                        candidate = selected
                    end
                end
            end
            assert(candidate and candidate.ordinal,
                "unequal imported components need another normalization")
            local missing = {}
            for _, edge in ipairs edges do
                if not supplied[edge][item] then
                    for _, path in ipairs(assert analysis.edge_paths[edge]) do
                        for site in pairs candidate.sites do
                            assert(not path.visited[site],
                                "completion role is already active on the missing edge")
                        end
                    end
                    missing[#missing + 1] = edge
                end
            end
            -- The proof includes earlier normalized acquisitions, not just allocations:
            -- an empty but already-carried role is not available to a second component.
            for _, edge in ipairs missing do
                supplied[edge][item] = candidate
                candidate.sites[edge] = true
            end
            candidate.hoisted = true
            normalizations[#normalizations + 1] = { component = candidate, .missing, .item }
        end
        local restore = do(block) = do(bundle)
            for _, component in ipairs bundle do block = output.word block ("restore") component end
            return block
        end
        for _, original in ipairs definition.blocks do
            local written = { ..original, instructions = {}, arguments = copy original.arguments }
            for _, argument in ipairs original.arguments do
                if needed[argument.identity] then
                    local width, minimum, supplied, position = 0, math.huge, {}, nil
                    local edges = assert incoming[original.identity]
                    for index, value in ipairs original.arguments do if value == argument then position = index end end
                    for _, edge in ipairs edges do
                        local bundle = assert(bundles[edge.arguments[position].identity],
                            "owner transport not available")
                        supplied[edge] = copy bundle
                        width, minimum = math.max(width, #bundle), math.min(minimum, #bundle)
                    end
                    for item = minimum + 1, width do supplement edges supplied item end
                    for _, edge in ipairs edges do
                        edge_bundles[edge] = edge_bundles[edge] or {}
                        edge_bundles[edge][position] = supplied[edge]
                    end
                    local bundle = {}
                    for item = 1, width do
                        local role = "boundary.join." .. argument.identity .. "." .. item
                        local index = v.BlockArgument { identity = role .. ".index", native_type = "U64" }
                        local mark = v.BlockArgument { identity = role .. ".mark", native_type = "U64" }
                        written.arguments[#written.arguments + 1], written.arguments[#written.arguments + 2] = index, mark
                        local choices = {}
                        for _, edge in ipairs edges do choices[edge] = supplied[edge][item] end
                        indices[role], bundle[item] = index, { .role, .index, .mark,
                            join = original.identity, .choices }
                    end
                    bundles[argument.identity] = bundle
                    extras[original.identity] = true
                end
            end
            for _, node in ipairs original.instructions do
                if v.Instruction.is(node, v.BeginOwned) then
                    local component
                    -- Reuse only a fresh LOCAL position whose allocation sites never coexist.
                    -- Calls retain their own finite footprint; imported components never merge.
                    if not receiving then
                        for _, candidate in ipairs fresh do
                            if candidate.local_position then
                                local compatible = true
                                for _, earlier in ipairs candidate.members do
                                    if (analysis.interference[node.allocation.identity] or {})[earlier] then compatible = false end
                                end
                                if compatible then component = candidate; break end
                            end
                        end
                    end
                    if not component then component = new_class(); component.local_position = true end
                    component.members[#component.members + 1] = node.allocation.identity
                    component.sites[node] = true
                    classes[node.allocation.identity] = component.ordinal
                    bundles[node.result.identity] = { component }
                    local allocated = v.BeginOwned { ..node, index = component.index }
                    if receiving then capture_before allocated component end
                    output.append written allocated
                elseif v.Instruction.is(node, v.TransferOwned) then
                    bundles[node.result.identity] = bundles[node.source.identity]
                    assert(not needed[node.result.identity] or bundles[node.result.identity],
                        "move lost completion component")
                    output.append written node
                elseif v.Instruction.is(node, v.Call) then
                    local callee = assert callees[node.callee]
                    local supplied_widths, envelope, native_arguments = {}, {}, copy node.arguments
                    for index, parameter in ipairs callee.parameters do
                        if parameter.native_type == "Owned U32" then
                            local bundle = assert bundles[node.arguments[index].identity]
                            supplied_widths[#supplied_widths + 1] = #bundle
                            for _, component in ipairs bundle do envelope[#envelope + 1] = component end
                        end
                    end
                    local child = prepare callee supplied_widths false
                    if not dependencies[child.definition.identity] then dependencies[child.definition.identity] = child.definition end
                    local call_captures = {}
                    for _, formal in ipairs child.fresh do
                        local component = new_class()
                        for _, instance in ipairs node.instances do
                            if child.classes[instance.formal] == formal.ordinal then
                                component.members[#component.members + 1] = instance.allocation.identity
                                classes[instance.allocation.identity] = component.ordinal
                            end
                        end
                        assert(#component.members > 0,
                            "native footprint has no allocation instances")
                        component.sites[node] = true
                        call_captures[#call_captures + 1] = component
                        envelope[#envelope + 1] = component
                    end
                    for _, component in ipairs envelope do
                        native_arguments[#native_arguments + 1], native_arguments[#native_arguments + 2] = component.index, component.mark
                    end
                    local called = v.Call with ..node
                        callee = child.definition.identity
                        arguments = native_arguments
                    end
                    if receiving then
                        for _, component in ipairs call_captures do capture_before called component end
                    end
                    output.append written called
                    if node.result.native_type == "Owned U32" then bundles[node.result.identity] = envelope
                    elseif receiving then written = restore written envelope end
                elseif v.Instruction.is(node, v.EndOwned) then
                    output.append written node
                    if receiving then written = restore written (assert bundles[node.owner.identity]) end
                elseif v.Instruction.is(node, v.CompleteBoundary) then
                    -- Receiver has completed ended components; a leased frame must not reset.
                else
                    assert(not v.Instruction.is(node, v.ReleaseExtent),
                        "explicit group reset needs a component contract")
                    output.append written node
                end
            end
            written.terminator = original.terminator
            output.publish written
        end
        local edge = do(original)
            if not extras[original.target] then return original end
            local arguments = copy original.arguments
            for index, argument in ipairs originals[original.target].arguments do
                if needed[argument.identity] then
                    for _, component in ipairs edge_bundles[original][index] do
                        arguments[#arguments + 1], arguments[#arguments + 2] = component.index, component.mark
                    end
                end
            end
            return v.Edge { ..original, .arguments }
        end
        local terminator = v.Terminator.pass "transport component operands" with
            Jump = do(node, recurse) = v.Jump { ..node, edge = edge node.edge }
            Branch = do(node, recurse) = v.Branch with ..node
                when_true = edge node.when_true
                when_false = edge node.when_false
            end
            Return = do(node, recurse) = node
            Trap = do(node, recurse) = node
        end
        -- An early exit may bypass acquisition of a hoisted role. Complete that still-
        -- unused reservation there, using the same Nua word. Never silently abandon it
        -- or turn a mixed acquired/unacquired exit into an unconditional second reset.
        local unused_exits = {}
        if receiving then
            for _, component in ipairs fresh do
                if component.hoisted then
                    local states = {}
                    for _, outcome in ipairs analysis.outcomes do
                        local acquired = false
                        for site in pairs component.sites do if outcome.visited[site] then acquired = true end end
                        local previous = states[outcome.ending]
                        assert(previous == nil or previous == acquired,
                            "unused completion role needs edge-specific exit placement")
                        states[outcome.ending] = acquired
                    end
                    for ending, acquired in pairs states do
                        if not acquired then
                            unused_exits[ending] = unused_exits[ending] or {}
                            unused_exits[ending][#unused_exits[ending] + 1] = component
                        end
                    end
                end
            end
        end
        -- This activity instantiates the existing Nua capture/restore words. Hoisted
        -- roles are distinct reserved positions; every new incoming acquisition has
        -- passed the absence proof. Source, allocation and call effects stay in place.
        local captured, entry = storage.realization "boundary.capture", definition.entry
        if receiving then
            local prologue = { identity = "boundary.capture.entry",
                arguments = {}, instructions = {} }
            for _, component in ipairs fresh do
                if component.hoisted then prologue = captured.word prologue ("capture") component end
            end
            if prologue.identity ~= "boundary.capture.entry" then
                entry = "boundary.capture.entry"
                prologue.terminator = v.Jump with
                    edge = v.Edge { target = definition.entry, arguments = {} }
                    at = "normalized captures"
                end
                captured.publish prologue
            end
        end
        for _, original in ipairs output.blocks do
            local written = { ..original, instructions = {} }
            for _, node in ipairs original.instructions do
                for _, component in ipairs(capture_anchors[node] or {}) do
                    if not component.hoisted then written = captured.word written ("capture") component end
                end
                captured.append written node
            end
            for _, component in ipairs(unused_exits[original.terminator] or {}) do
                written = captured.word written ("restore") component
            end
            written.terminator = original.terminator
            captured.publish written
        end
        local blocks = {}
        for _, block in ipairs captured.blocks do
            local instructions = {}
            for _, node in ipairs block.instructions do
                if v.Instruction.is(node, v.StackTop) then node = v.StackTop with ..node
                    index = assert indices[node.role]
                end
                elseif v.Instruction.is(node, v.StackWrite) then node = v.StackWrite with ..node
                    index = assert indices[node.role]
                end end
                instructions[#instructions + 1] = node
            end
            blocks[#blocks + 1] = v.Block with ..block
                .instructions
                terminator = terminator block.terminator
            end
        end
        local children = {}
        for _, child in pairs dependencies do children[#children + 1] = child end
        table.sort(children, do(left, right) = left.identity < right.identity)
        local prepared = v.verify_graph(v.Definition with ..definition
            identity = key
            .parameters
            .blocks
            .entry
            callees = children
            .captures
            .leases
            completion_mode = receiving and "receiver" or "leased"
        end)
        local result = { source = definition,
            definition = prepared, .fresh, .classes, .input_bundles, .normalizations }
        cache[key], active[definition] = result, nil
        return result
    end
    local failed = false
    return do(definition) return do(widths) return do(receiving)
                assert(not failed, "completion planning activity is closed after failure")
                local ok, result = pcall do() = prepare definition widths receiving
                if not ok then failed = true; active = {}; error(result, 0) end
                return result
            end end end
end

-- Independent interprocedural storage-event oracle. Values/marks are copied into fresh
-- call frames; only the storage world persists. No evaluator ownership predicate is reused.
local run_ledger = do(definition) = do(registry) = do(inputs) = do(prefix)
    local positions, cells, trace, observations, serial, calls, deepest = {}, {}, {}, {}, 0, 0, 0
    local position = do(index)
        assert(type index == "number" and index >= 0 and index % 1 == 0,
            "invalid physical position")
        if not positions[index] then
            local base = prefix + index * 16
            positions[index] = { top = base, floor = base, restores = 0 }
        end
        return positions[index]
    end
    local run
    run = do(program) = do(arguments) = do(depth)
        v.verify_graph(program, registry)
        serial += 1
        deepest = math.max(deepest, depth)
        local frame = "frame" .. serial
        local values, blocks, targets, capture_marks, leases = {}, {}, registry, {}, {}
        local relations = {}
        for _, fact in ipairs(program.completion_relations or {}) do relations[fact.operand.identity] = fact end
        local key = value -> frame .. ":" .. value.identity
        local custody = do(cell) = do(value)
            cell.custody = key value
        end
        for _, block in ipairs program.blocks do blocks[block.identity] = block end
        for _, capture in ipairs(program.captures or {}) do capture_marks[capture.mark] = capture end
        local incoming = {}
        for index, parameter in ipairs program.parameters do
            assert(arguments[index] ~= nil, "native parameter missing")
            values[parameter.identity] = arguments[index]
            if parameter.native_type == "Owned U32" then
                local identity = arguments[index]
                assert(cells[identity] and cells[identity].live and not incoming[identity],
                    "native inputs duplicate or lack a holding")
                incoming[identity] = true
                custody cells[identity] parameter
            end
        end
        local operand = do(value)
            if value.identity then assert(values[value.identity] ~= nil,
                    "cross-frame or undefined operand"); return values[value.identity] end
            if v.Operand.is(value, v.UnitConstant) then return "unit" end
            if v.Operand.is(value, v.WideConstant) then
                local number = tonumber value.value
                assert(number < 9007199254740992, "outside bounded ledger arithmetic")
                return number
            end
            return value.value
        end
        for _, lease in ipairs(program.leases or {}) do
            local index, mark = operand lease.index, operand lease.mark
            local stack = position index
            assert(stack.authority and stack.mark == mark,
                "native boundary replaced original capture")
            assert(not leases[index], "native boundary duplicated a completion lease")
            leases[index] = true
            trace[#trace + 1] = frame .. " leases position " .. index .. " mark " .. mark
        end
        if program.completion_mode == "region-borrower" then
            -- Input access comes from the owning header, not from a flattened history
            -- of its caller's completion obligations. Only fresh ports are native extras.
            for identity in pairs incoming do
                local stack = position cells[identity].index
                assert(stack.authority, "input header has no receiving authority")
                leases[cells[identity].index] = true
            end
            local fresh_ports = {}
            for _, value in ipairs(program.regions or {}) do
                local index = operand value
                assert(position(index).authority, "fresh region has no receiving authority")
                assert(not fresh_ports[index], "two fresh region ports alias")
                -- A recursive input can occupy the same port. The caller has checked
                -- region identity; an allocation still cannot overlap a live local input.
                fresh_ports[index], leases[index] = true, true
            end
        else
            for identity in pairs incoming do assert(leases[cells[identity].index],
                    "incoming holding is not covered by its component") end
        end
        local held = do(value)
            local identity = operand value
            local cell = assert(cells[identity], "missing owner contents")
            assert(cell.live and cell.custody == key value, "native owner has no custody")
            if program.completion_mode == "region-receiver" then
                local fact, covered = assert(relations[value.identity],
                    "owner lost completion relation"), false
                local seen = {}
                for _, member in ipairs fact.members do
                    if operand member.guard then
                        local index = operand member.index
                        assert(not seen[index], "duplicated completion relation")
                        assert(position(index).authority == frame,
                            "component names completed authority")
                        seen[index], covered = true, covered or index == cell.index
                    end
                end
                assert(covered, "completion relation does not cover current header")
                for index in pairs cell.envelope do assert(seen[index],
                        "component lost a completion obligation") end
                for index in pairs seen do assert(cell.envelope[index],
                        "component stole another completion obligation") end
            end
            return identity, cell
        end
        local unsupported = do(node, recurse) error "boundary ledger does not cover this instruction" end
        local execute = v.Instruction.pass "native frame storage events" with
            Add = do(node, recurse)
                local left, right = operand node.left, operand node.right
                assert(type left == "number" and type right == "number",
                    "bounded addition needs integers")
                values[node.result.identity] = (left + right) % 4294967296
            end
            Load = unsupported
            Store = unsupported
            Expose = unsupported
            EndContents = unsupported
            ExternalGrowth = unsupported
            ReleaseExtent = unsupported
            CompleteBoundary = unsupported
            BeginExtent = do(node, recurse) end
            BeginOwned = do(node, recurse)
                local index = operand(assert(node.index, "allocation lacks physical position"))
                local stack = position index
                assert(stack.authority, "allocation lacks an outer completion owner")
                if program.completion_mode == "leased" or program.completion_mode == "region-borrower" then assert(leases[index],
                        "allocation outside native lease") end
                for _, other in pairs cells do
                    assert(not other.live or other.index ~= index,
                        "independently live holdings share a position")
                end
                local identity = frame .. "/" .. node.allocation.identity
                assert(not cells[identity], "allocation executed twice")
                cells[identity] = { .index, low = stack.top, high = stack.top + 4, live = true,
                    custody = key node.result, payload = operand node.initial,
                    envelope = {[index] = true } }  -- concrete oracle state, never emitted runtime data
                custody cells[identity] node.result
                values[node.result.identity], stack.top = identity, stack.top + 4
                trace[#trace + 1] = "allocate " .. identity .. " at " .. cells[identity].low .. " on " .. index
            end
            TransferOwned = do(node, recurse)
                local identity, cell = held node.source
                values[node.result.identity] = identity
                custody cell node.result
            end
            BorrowOwned = do(node, recurse) local identity = held node.owner; values[node.result.identity] = { .identity } end
            ObserveBorrow = do(node, recurse)
                local cell = assert cells[(operand node.reference).identity]
                assert(cell.live and position(cell.index).top >= cell.high,
                    "native boundary invalidated observed contents")
                observations[#observations + 1] = cell.payload
            end
            EndOwned = do(node, recurse)
                local identity, cell = held node.owner
                cell.live, cell.custody = false, nil
                trace[#trace + 1] = "end " .. identity
            end
            StackTop = do(node, recurse)
                local index = operand(assert(node.index, "top lacks physical position"))
                local stack = position index
                values[node.result.identity] = stack.top
                if capture_marks[node.result] then
                    assert((program.completion_mode == "receiver" or program.completion_mode == "region-receiver") and not stack.authority,
                        "capture duplicates completion authority")
                    assert(operand capture_marks[node.result].index == index,
                        "capture index mismatch")
                    stack.authority, stack.mark = frame, stack.top
                    trace[#trace + 1] = frame .. " captures " .. index .. " at " .. stack.mark
                end
            end
            Greater = do(node, recurse) values[node.result.identity] = operand node.left > operand node.right end
            StackWrite = do(node, recurse)
                local index, top = operand node.index, operand node.top
                local stack = position index
                assert(stack.authority == frame, "frame has no completion authority")
                assert(top == stack.mark, "restore replaced original boundary mark")
                assert(top >= stack.floor and top <= stack.top, "reset outside protected stack")
                for _,
                cell in pairs cells do assert(not cell.live or cell.index ~= index or top >= cell.high,
                        "restore clips surviving sibling/holding") end
                stack.top, stack.authority, stack.restores = top, nil, stack.restores + 1
                trace[#trace + 1] = frame .. " completes " .. index .. " to " .. top
            end
            Call = do(node, recurse)
                local target, supplied, envelope = assert targets[node.callee], {}, {}
                for index, value in ipairs node.arguments do
                    if value.native_type == "Owned U32" then
                        local _, cell = held value
                        for position in pairs cell.envelope do envelope[position] = true end
                    end
                    supplied[index] = operand value
                end
                if target.completion_mode == "region-borrower" then
                    local slots = {}
                    for index, parameter in ipairs target.parameters do slots[parameter] = index end
                    for _, port in ipairs(target.regions or {}) do
                        local index = supplied[assert slots[port]]
                        envelope[index] = true
                        assert(leases[index] or position(index).authority == frame,
                            "call invents a region outside its boundary")
                        if target.region_scope ~= program.region_scope then
                            for _, cell in pairs cells do
                                assert(not cell.live or cell.index ~= index,
                                    "nonrecursive fresh region clips a caller holding")
                            end
                        end
                    end
                end
                calls += 1
                trace[#trace + 1] = frame .. " calls " .. target.identity
                local result = run target supplied (depth + 1)
                values[node.result.identity] = result
                if node.result.native_type == "Owned U32" then
                    assert(cells[result].live and cells[result].custody == "returned",
                        "native result lost its holding")
                    custody cells[result] node.result
                    cells[result].returned_to_root = cells[result].returned_to_root or depth == 1
                    if target.completion_mode == "region-borrower" then cells[result].envelope = envelope end
                    held node.result
                end
            end
        end
        local current = blocks[program.entry]
        while true do
            for _, node in ipairs current.instructions do execute node end
            local ending = current.terminator
            if v.Terminator.is(ending, v.Trap) then error("unexpected native trap: " .. ending.message) end
            if v.Terminator.is(ending, v.Return) then
                local returned = operand ending.value
                if program.result_type == "Owned U32" then held ending.value end
                for identity, cell in pairs cells do
                    if cell.live and cell.custody:sub(1, #frame + 1) == frame .. ":" then
                        assert(program.result_type == "Owned U32" and identity == returned,
                            "holding left in returning frame")
                    end
                end
                if program.result_type == "Owned U32" then cells[returned].custody = "returned" end
                trace[#trace + 1] = frame .. " returns"
                return returned
            end
            local edge
            if v.Terminator.is(ending, v.Jump) then edge = ending.edge
            else edge = operand ending.condition and ending.when_true or ending.when_false end
            local target, captured = blocks[edge.target], {}
            for index, value in ipairs edge.arguments do
                captured[index] = operand value
                if value.native_type == "Owned U32" then held value end
            end
            for index, argument in ipairs target.arguments do
                values[argument.identity] = captured[index]
                if argument.native_type == "Owned U32" then custody cells[captured[index]] argument end
            end
            current = target
        end
    end
    local arguments = {}
    for index, parameter in ipairs definition.parameters do
        local value = inputs[parameter.identity]
        assert(parameter.native_type == "Bool" and type value == "boolean" or
            parameter.native_type == "U32" and type value == "number" and value >= 0 and value < 4294967296 and value % 1 == 0,
            "receiver needs concrete Bool/U32 inputs")
        arguments[index] = inputs[parameter.identity]
    end
    local result = run definition arguments 1
    assert(result == 0, "unexpected root result")
    for _, cell in pairs cells do assert(not cell.live, "live holding outlives receiving boundary") end
    for _, stack in pairs positions do assert(not stack.authority and stack.top == stack.floor and stack.restores == 1,
            "completion lost or duplicated") end
    return { .trace, .observations, .positions, .cells, .calls, .deepest }
end
local ledger_for_inputs = do(definition) = do(inputs) = do(prefix)
    local registry = {}
    local collect
    collect = do(program)
        if registry[program.identity] then
            assert(registry[program.identity] == program, "conflicting ledger definition")
            return
        end
        registry[program.identity] = program
        for _, child in ipairs(program.callees or {}) do collect child end
    end
    collect definition
    return run_ledger definition registry inputs prefix
end
local ledger = do(definition) = do(flag) = do(prefix) = ledger_for_inputs definition ({ .flag }) prefix

------------------------------------------------------------------------------------------------
-- Staged source fixtures. A native definition is constructed once and never replayed for placement.
local constructions = 0
local construct = do(name) = do(parameters) = do(result_type) = do(body)
    return v.construct name parameters result_type do(evaluation) return do(path) return do(inputs)
                constructions += 1
                return body evaluation path inputs
            end end end
end
local formal_owner = do(name)
    local allocation = v.Allocation with
        identity = name .. ".allocation"
        extent = name .. ".extent"
        origin = v.Origin with
            identity = name .. ".contents"
            holding = name .. ".allocation"
            guarantee = "stable"
        end
    end
    return v.owner_parameter (name) { allocation }
end
local bind = do(name) = do(evaluation) = do(path) = do(value)
    local place = evaluation.declare path name ("Owned U32")
    evaluation.write path place value
    return place
end
local relay = construct "relay" { formal_owner "argument" } "Owned U32" do(evaluation) return do(path) return do(inputs)
            local argument = bind "argument" evaluation path inputs[1]
            return evaluation.take path argument
        end end end
local consume = construct "consume" { formal_owner "argument" } "U32" do(evaluation) return do(path) return do(inputs)
            bind "argument" evaluation path inputs[1]
            return v.unsigned 0
        end end end
local replace = construct "argument-or-fresh" { v.parameter "Bool" "flag", formal_owner "argument" } "Owned U32"
do(evaluation) return do(path) return do(inputs)
            local argument = bind "argument" evaluation path inputs[2]
            local result = evaluation.declare (path) "selected" "Owned U32"
            evaluation.choose path inputs[1] do(left)
                evaluation.write left result (evaluation.take left argument)
            end do(right)
                evaluation.drop right argument
                local region = evaluation.group "fresh result" right
                local owner = evaluation.owned "fresh" right region (v.unsigned 3)
                evaluation.write right result (evaluation.take right owner)
            end
            return evaluation.take path result
        end end end
local forwarding = construct "forwarding" { v.parameter "Bool" "flag", formal_owner "argument" } "Owned U32"
do(evaluation) return do(path) return do(inputs)
            local argument = bind "argument" evaluation path inputs[2]
            local result = evaluation.call path replace ({ inputs[1],
                    evaluation.take path argument })
            local returned = bind "forwarded result" evaluation path result
            return evaluation.take path returned
        end end end
local retained = construct "retained-prefix" {} "Owned U32" do(evaluation) return do(path) return do(inputs)
            local scratch_region = evaluation.group "dead prefix" path
            local scratch = evaluation.owned "scratch" path scratch_region (v.unsigned 8)
            evaluation.drop path scratch
            local result_region = evaluation.group "live suffix" path
            local result = evaluation.owned "result" path result_region (v.unsigned 9)
            return evaluation.take path result
        end end end

local root = do(name) = do(target) = do(options)
    return construct (name) { v.parameter "Bool" "flag" } "U32" do(evaluation) return do(path) return do(inputs)
                local left
                if options.prefix then
                    left = bind "pair.left" evaluation path (evaluation.call path retained ({}))
                else
                    local region = evaluation.group "pair proposal" path
                    left = evaluation.owned "pair.left" path region (v.unsigned 1)
                end
                local region = evaluation.group "sibling proposal" path
                local right = evaluation.owned "pair.right" path region (v.unsigned 2)
                if options.swap then
                    evaluation.choose path inputs[1] do(branch)
                        local a = evaluation.take branch left
                        local b = evaluation.take branch right
                        evaluation.write branch left b
                        evaluation.write branch right a
                    end do(branch) end
                end
                local sibling_view = evaluation.borrow path right
                local arguments = options.flag and { inputs[1], evaluation.take path left } or { evaluation.take path left }
                local value = evaluation.call path target arguments
                if target.result_type == "Owned U32" then
                    if options.again then value = evaluation.call path relay ({ value }) end
                    local result = bind "returned field" evaluation path value
                    evaluation.observe path (evaluation.borrow path result)
                    evaluation.drop path result
                end
                -- Crucially this observation is AFTER completion of the other field's component.
                evaluation.observe path sibling_view
                evaluation.drop path right
                return v.unsigned 0
            end end end
end
local write_program = do(definition)
    local seen, lines = {}, {}
    local visit
    visit = do(program)
        if seen[program.identity] then return end
        seen[program.identity] = true
        lines[#lines + 1] = v.write_definition program
        for _, child in ipairs(program.callees or {}) do visit child end
    end
    visit definition
    return table.concat(lines, "\n")
end
-- Preserve the original valid source witness, independently of the additional join probes.
local unequal_source = do()
    return construct "unequal-component-join" { v.parameter "Bool" "flag",
        v.parameter "Bool" "choice" } "U32"
    do(evaluation) return do(path) return do(inputs)
                local region = evaluation.group "pair" path
                local left = evaluation.owned "left" path region (v.unsigned 1)
                local right = evaluation.owned "right" path region (v.unsigned 2)
                evaluation.choose path inputs[1] do(branch)
                    local result = evaluation.call branch replace ({ inputs[2],
                            evaluation.take branch left })
                    evaluation.write branch left result
                end do(branch) end
                evaluation.observe path (evaluation.borrow path left)
                evaluation.drop path left
                evaluation.observe path (evaluation.borrow path right)
                return v.unsigned 0
            end end end
end
local api = define
    .planning
    .ledger_for_inputs
    .ledger
    .construct
    .formal_owner
    .bind
    .relay
    .replace
    .forwarding
    .write_program
    .unequal_source
    .v
    construction_count = do() = constructions
end
if ... == "module" then return api end

local accepted, executions, rejected = 0, 0, 0
local witness = do(name) = do(target) = do(options) = do(expected)
    local logical = root name target options
    local before, count = write_program logical, constructions
    local prepare = planning()
    local plan = prepare logical ({}) true
    local snapshot = write_program plan.definition
    print("\n=== " .. name .. ": logical ===\n" .. before)
    print "=== explicit native program ==="
    print(write_program plan.definition)
    for _, prefix in ipairs { 0, 64 } do
        for _, flag in ipairs { false, true } do
            local result = ledger plan.definition flag prefix
            assert(table.concat(result.observations, ",") == expected flag,
                "wrong field/native result observed")
            assert(result.calls >= 1 and result.deepest >= 2, "native boundary was flattened")
            if options.again then assert(result.deepest >= 3 and result.calls >= 3,
                    "native forwarding was flattened") end
            if options.prefix then
                local found = false
                for _, cell in pairs result.cells do
                    if cell.payload == 9 then assert(cell.low == prefix + 4); found = true end
                end
                assert(found, "retained prefix disappeared")
            end
            print("ledger " .. tostring flag .. "/" .. prefix .. ": " .. table.concat(result.trace,
                    "; "))
            executions += 1
        end
    end
    local prepare_again = planning()
    local again = prepare_again logical ({}) true
    assert(write_program again.definition == snapshot and write_program logical == before and constructions == count,
        "storage planning replayed source or changed accepted output")
    accepted += 1
    return plan
end
local plain = witness "field-round-trip" relay ({}) (flag -> "1,2")
local swapped = witness "swapped-field-round-trip" relay ({ swap = true }) (flag -> flag and "2,1" or "1,2")
local mixed = witness "mixed-field-result" replace ({ flag = true }) (flag -> flag and "1,2" or "3,2")
local forwarded = witness "forwarded-mixed-field-result" forwarding ({ flag = true, again = true }) (flag -> flag and "1,2" or "3,2")
local prefix_result = witness "retained-prefix-field" relay ({ prefix = true }) (flag -> "9,2")
local consumed = witness "consumed-field-live-sibling" consume ({}) (flag -> "2")

-- Rejected plans and boundary mutants, not valid programs counted as expected refusals.
local source_rejections = 0
local refuse = do(kind) = do(name) = do(fragment) = do(body)
    local ok, problem = pcall body
    assert(not ok and tostring(problem):find(fragment, 1, true), name .. ": " .. tostring problem)
    if kind == "plan" then rejected += 1 else source_rejections += 1 end
    print("refused " .. name .. ": " .. tostring problem)
end
local bad_plan = refuse "plan"
local bad_source = refuse "source"
local mutate
mutate = do(program) = do(change)
    local blocks, callees = {}, {}
    for _, callee in ipairs(program.callees or {}) do callees[#callees + 1] = mutate callee change end
    for _, block in ipairs program.blocks do
        local instructions = {}
        for _, node in ipairs block.instructions do
            for _, replacement in ipairs(change program node) do instructions[#instructions + 1] = replacement end
        end
        blocks[#blocks + 1] = v.Block { ..block, .instructions }
    end
    return v.Definition { ..program, .blocks, .callees }
end
local no_resets = mutate plain.definition do(program) return do(node)
        if v.Instruction.is(node, v.StackWrite) then return {} end
        return { node }
    end end
bad_plan "omitted component completion" "completion lost or duplicated" do() ledger no_resets false 0 end
local double_reset = mutate plain.definition do(program) return do(node)
        if v.Instruction.is(node, v.StackWrite) then return { node, node } end
        return { node }
    end end
bad_plan "duplicated completion authority" "frame has no completion authority" do() ledger double_reset false 0 end
local live_reset = mutate plain.definition do(program) return do(node)
        if program.completion_mode == "receiver" and v.Instruction.is(node, v.EndOwned) then return {} end
        return { node }
    end end
bad_plan "reset under a surviving holding" "restore clips surviving sibling/holding" do() ledger live_reset false 0 end
local stolen = mutate consumed.definition do(program) return do(node)
        if program.completion_mode == "leased" and v.Instruction.is(node, v.EndOwned) then
            local lease = program.leases[1]
            return { node,
                v.StackWrite with
                    role = "stolen authority"
                    top = lease.mark
                    index = lease.index
                    at = "invalid callee completion"
                end }
        end
        return { node }
    end end
bad_plan "callee steals receiver authority after logical ending" "frame has no completion authority" do() ledger stolen false 0 end

local recaptured = mutate plain.definition do(program) return do(node)
        if program.completion_mode == "receiver" and v.Instruction.is(node, v.Call) then
            local target
            for _, child in ipairs program.callees do if child.identity == node.callee then target = child end end
            local arguments, index_slot, mark_slot = copy node.arguments, nil, nil
            for index, parameter in ipairs target.parameters do
                if parameter == target.leases[1].index then index_slot = index end
                if parameter == target.leases[1].mark then mark_slot = index end
            end
            local result = v.Result { identity = "invalid.recapture", native_type = "U64" }
            local capture = v.StackTop with
                .result
                index = arguments[index_slot]
                role = "wrong new mark"
                at = "after argument allocation"
            end
            arguments[mark_slot] = result
            return { capture, v.Call { ..node, .arguments } }
        end
        return { node }
    end end
v.verify_graph recaptured
bad_plan "native parameter replaces the original mark" "native boundary replaced original capture" do() ledger recaptured false 0 end
local foreign_mark = plain.definition.callees[1].leases[1].mark
local escaping_mark = mutate plain.definition do(program) return do(node)
        if program.completion_mode == "receiver" and v.Instruction.is(node, v.StackWrite) then return { v.StackWrite with ..node
            top = foreign_mark
        end } end
        return { node }
    end end
bad_plan "mark left in returning frame" "operand identity is not canonical" do() v.verify_graph escaping_mark end

local corrupt_edge = do(edge)
    if #edge.arguments ~= 6 then return edge end
    local arguments = copy edge.arguments
    arguments[3], arguments[4], arguments[5], arguments[6] = arguments[5], arguments[6], arguments[3], arguments[4]
    return v.Edge { ..edge, .arguments }
end
local corrupt_end = v.Terminator.pass "break header/capture correlation" with
    Jump = do(node, recurse) = v.Jump { ..node, edge = corrupt_edge node.edge }
    Branch = do(node, recurse) = v.Branch with ..node
        when_true = corrupt_edge node.when_true
        when_false = corrupt_edge node.when_false
    end
    Return = do(node, recurse) = node
    Trap = do(node, recurse) = node
end
local corrupt_blocks = {}
for _, block in ipairs swapped.definition.blocks do corrupt_blocks[#corrupt_blocks + 1] = v.Block with ..block
    terminator = corrupt_end block.terminator
end end
local mismatched = v.verify_graph(v.Definition { ..swapped.definition, blocks = corrupt_blocks })
bad_plan "swap transports another field's completion" "incoming holding is not covered by its component" do() ledger mismatched true 64 end
local first_position
local shared_position = mutate plain.definition do(program) return do(node)
        if program.completion_mode == "receiver" and v.Instruction.is(node, v.BeginOwned) then
            first_position = first_position or node.index
            return { v.BeginOwned { ..node, index = first_position } }
        end
        return { node }
    end end
bad_plan "pack independent live fields together" "independently live holdings share a position" do() ledger shared_position false 0 end
local header_base = mutate prefix_result.definition do(program) return do(node)
        if program.completion_mode == "receiver" and v.Instruction.is(node, v.StackWrite) then
            return { v.StackWrite { ..node, top = (v.wide 4).operand } }
        end
        return { node }
    end end
bad_plan "restore to live header base instead of retained-prefix mark" "restore replaced original boundary mark" do() ledger header_base false 0 end
local truncated = mutate mixed.definition do(program) return do(node)
        if program.completion_mode == "receiver" and v.Instruction.is(node, v.Call) then
            local arguments = copy node.arguments
            arguments[#arguments], arguments[#arguments - 1] = nil, nil
            return { v.Call { ..node, .arguments } }
        end
        return { node }
    end end
bad_plan "lost native completion operands" "native call arity mismatch" do() v.verify_graph truncated end
local aliased_instance = mutate mixed.source do(program) return do(node)
        if v.Instruction.is(node, v.Call) and #node.instances > 0 then
            local instances = copy node.instances
            instances[1] = v.Instance { ..instances[1], allocation = program.allocations[1] }
            return { v.Call { ..node, .instances } }
        end
        return { node }
    end end
bad_plan "native fresh allocation forges an existing identity" "native fresh allocation aliases" do() v.verify aliased_instance end
local activity = planning()
local accepted_plan = activity plain.source ({}) true
local accepted_text = write_program accepted_plan.definition
bad_plan "missing incoming component contract" "missing incoming component width" do() activity relay ({}) false end
bad_plan "reuse of failed planning activity" "closed after failure" do() activity plain.source ({}) true end
assert(write_program accepted_plan.definition == accepted_text,
    "rejected planning changed accepted output")
bad_source "borrow used after native consuming call" "borrow of ended contents" do()
    construct "invalid-native-borrow" {} "U32" do(evaluation) return do(path) return do(inputs)
                local region = evaluation.group "local" path
                local owner = evaluation.owned "owner" path region (v.unsigned 1)
                local view = evaluation.borrow path owner
                evaluation.call path consume ({ evaluation.take path owner })
                evaluation.observe path view
                return v.unsigned 0
            end end end
end

assert(not package.loaded["nua.stage"], "old evaluator was loaded")
print(("\nPASS: %d native-boundary witnesses; %d prefix/branch checks; %d invalid-plan/IR rejections; %d invalid-source rejection. No native execution."):format(accepted,
        executions, rejected, source_rejections))

-- The original unequal-width acceptance witness now has a storage transformation.
-- Keep its independent flag/choice matrix; do not rewrite its source around the planner.
if arg[1] == "--unequal-components" then
    local unequal = unequal_source()
    print("\n=== unequal component join: logical ===\n" .. v.write_definition unequal)
    local prepare = planning()
    local before, count = write_program unequal, constructions
    local plan = prepare unequal ({}) true
    print("=== normalized native program ===\n" .. write_program plan.definition)
    for _, prefix in ipairs { 0, 64 } do
        for _, flag in ipairs { false, true } do
            for _, choice in ipairs { false, true } do
                local checked = ledger_for_inputs plan.definition ({ .flag, .choice }) prefix
                local expected = flag and not choice and "3,2" or "1,2"
                assert(table.concat(checked.observations, ",") == expected)
            end
        end
    end
    assert(write_program unequal == before and constructions == count,
        "normalization replayed or modified source")
    print "PASS: unequal-component acceptance; 8 independent prefix/branch checks."

end
