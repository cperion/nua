-- The words of `Text`, which is `Grow U8`: g:write and g:str are library words
-- (lib/storage.nua), and `Chars n` is lib/chars.nua. `Str` stays a compiler type
-- (nua.strings): literals and knownness depend on it.
local S = require "nua.stage"
local Mem = require "nua.memory"
local text = {}

local function fail(msg, level) S.fail(msg, (level or 2) + 1) end

-- Text ---------------------------------------------------------------------------------------------

-- The words a Text offers beyond Grow's are library words (g:write, g:str in lib/storage.nua);
-- this only states that a Text is written where it runs.
function text.methods(t)
    local methods = {}
    local write = Mem.adapter(t, 'write')
    methods.write = function(self, ...)
        if not S.cur().fn then fail('a Text is runtime storage: it is written where it runs', 2) end
        return write(self, ...)
    end
    methods.str = Mem.adapter(t, 'str')
    S.arity[methods.write] = nil
    S.arity[methods.str] = 1
    return methods
end

return text
