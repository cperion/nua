-- Flow facts (compiler activities §2.4, §4.4): what is known about places and borrows on one
-- path of control, and the operations that change it. `tracking(capabilities)` makes the
-- vocabulary of one activity: it captures that activity's borrow registry, identity supply and
-- alias policy; the facts of the current path are an argument of every verb, because they vary
-- within the activity.
--
-- Facts are working records owned by their path. `fork` copies the maps for a second path; a
-- later change replaces an entry, never a record shared with another path. Outcomes are
-- values: an ended borrow, a moved owner or an unequal join is returned to the activity, which
-- reports it or builds the join, so this module neither raises diagnostics nor emits code.

local identity = require "nua.identity"
local data = require "nua.compiler.data"

local AccessStep, Contents, BorrowState, BorrowForm = data.AccessStep, data.Contents, data.BorrowState, data.BorrowForm
local Live, Ended = data.Live, data.Ended

local fail = do(message) error("facts: " .. message, 3) end

------------------------------------------------------------------------------------------------
-- Overlap of accesses: one place, and paths that agree step by step until one ends.

local element_step = step -> AccessStep.is(step, data.KnownElement) or AccessStep.is(step, data.AnyElement)

local steps_overlap = do(left, right)
    if AccessStep.is(left, data.AnyElement) then return element_step right end
    if AccessStep.is(right, data.AnyElement) then return element_step left end
    if getmetatable left ~= getmetatable right then return false end
    if AccessStep.is(left, data.KnownElement) then return left.index == right.index end
    if AccessStep.is(left, data.FieldStep) or AccessStep.is(left, data.AlternativeStep) then return left.name == right.name end
    return true
end

local paths_overlap = do(left, right)
    for position = 1, math.min(#left, #right) do
        if not steps_overlap(left[position], right[position]) then return false end
    end
    return true
end

-- does an event at `event` affect a borrow of `borrowed`? When the borrow lies within the
-- event's storage, yes; when the event lies deeper than the borrow, only if it does not pass
-- through the contents of a buffer: ending a buffer's contents leaves a borrow of its header
-- (`Ref g`) live (buffers §2.3), while moving a whole place ends borrows of its parts.
local affects = do(event, borrowed)
    if not paths_overlap(event, borrowed) then return false end
    if #borrowed >= #event then return true end
    for position = #borrowed + 1, #event do
        if AccessStep.is(event[position], data.ContentsStep) then return false end
    end
    return true
end

------------------------------------------------------------------------------------------------
-- Outcomes of the verbs

local BorrowUse = oneof {
    derive: data.BorrowPath,     -- a held borrow with no cached pointer: derive it from the headers
    cached: data.Operand,        -- a held borrow whose pointer is still valid on this path
    fixed: data.Operand,         -- a stored borrow's pointer
    ended: Ended,                -- the borrow ended; the activity reports where and why
}
local OwnerMove = oneof {
    moved: data.NativeValue,     -- the owner value now leaving its place
    already_moved: data.Moved,   -- it had left already
    uninitialized: Unit,         -- it never held a value
}

local JoinDecision = struct { flow: data.FlowFacts, differing: Table }

------------------------------------------------------------------------------------------------

local empty = || -> data.FlowFacts { contents = {}, borrows = {}, live_lifetimes = {} }

local fork = do(flow)
    local contents, borrows, live_lifetimes = {}, {}, {}
    for place, state in pairs flow.contents do contents[place] = state end
    for borrow, state in pairs flow.borrows do borrows[borrow] = state end
    for lifetime in pairs flow.live_lifetimes do live_lifetimes[lifetime] = true end
    return data.FlowFacts { .contents, .borrows, .live_lifetimes }
end

-- two operands denote the same value: one operand, or constants of one type with the same bits
local same_constant
same_constant = do(a, b)
    if a == b then return true end
    if getmetatable a ~= getmetatable b then return false end
    local NativeConstant = data.NativeConstant
    if NativeConstant.is(a, data.IntegerBits) then return a.bits == b.bits end
    if NativeConstant.is(a, data.FloatBits) or NativeConstant.is(a, data.BooleanBit) then return a.value == b.value end
    if NativeConstant.is(a, data.UnitBits) then return true end
    if NativeConstant.is(a, data.StaticBytes) then return a.bytes == b.bytes end
    if NativeConstant.is(a, data.SymbolAddress) then return a.name == b.name and a.offset == b.offset end
    if NativeConstant.is(a, data.DefinitionAddress) then return a.definition == b.definition end
    if #a.parts ~= #b.parts then return false end
    for index, part in ipairs a.parts do
        if not same_constant(part, b.parts[index]) then return false end
    end
    return true
end
local same_operand = do(a, b)
    if a == b then return true end
    if data.Operand.is(a, data.Constant) and data.Operand.is(b, data.Constant) then
        return a.type == b.type and same_constant(a.bits, b.bits)
    end
    if getmetatable a ~= getmetatable b then return false end
    if data.Operand.is(a, data.Result) then return a.value == b.value end
    if data.Operand.is(a, data.BlockArgument) then return a.block == b.block and a.index == b.index end
    return a.definition == b.definition and a.index == b.index
end

-- two native values are the same: the same operand, or records whose parts are all the same
-- (or that are one packed operand)
local same_value
same_value = do(a, b)
    if a == b then return true end
    if getmetatable a ~= getmetatable b or a.type ~= b.type then return false end
    if data.NativeValue.is(a, data.Bits) then return same_operand(a.operand, b.operand) end
    if data.NativeValue.is(a, data.Owned) then return same_operand(a.header, b.header) end
    if data.NativeValue.is(a, data.Reference) then return a.borrow == b.borrow end
    local a_parts, b_parts = next(a.parts) ~= nil, next(b.parts) ~= nil
    if not a_parts and not b_parts then return a.packed ~= nil and b.packed ~= nil and same_operand(a.packed, b.packed) end
    if not a_parts or not b_parts then return false end
    for name, part in pairs a.parts do
        if b.parts[name] == nil or not same_value(part, b.parts[name]) then return false end
    end
    for name in pairs b.parts do
        if a.parts[name] == nil then return false end
    end
    return true
end

-- contents agree when they are the same record, or track the same native value or operand
local same_contents = do(left, right)
    if left == right then return true end
    if getmetatable left ~= getmetatable right then return false end
    if Contents.is(left, data.Tracked) then
        local a, b = left.value, right.value
        if a == b then return true end
        if data.NativeValue.is(a, data.Aggregate) then return same_value(a, b) end
        if data.NativeValue.is(a, data.Bits) and data.NativeValue.is(b, data.Bits) then
            return a.type == b.type and same_operand(a.operand, b.operand)
        end
        if data.NativeValue.is(a, data.Owned) and data.NativeValue.is(b, data.Owned) then
            return a.type == b.type and same_operand(a.header, b.header)
        end
        if data.NativeValue.is(a, data.Reference) and data.NativeValue.is(b, data.Reference) then
            return a.type == b.type and a.borrow == b.borrow
        end
        return false
    end
    return Contents.is(left, data.Uninitialized)
end

-- capabilities: `borrows`, the activity's registry of borrow records (a map it owns);
-- `supply`, its identity supply; `may_alias(place, other)`, whether two distinct root places
-- may name the same storage (two Ref parameters may; two locals never do)
local tracking = do(capabilities)
    local registry = capabilities.borrows
    local supply = capabilities.supply
    local may_alias = capabilities.may_alias or (|a, b| -> false)
    if type registry ~= "table" or supply == nil then fail("tracking needs a borrow registry and an identity supply") end

    local accesses_overlap = do(left, right)
        if left.place ~= right.place and not may_alias(left.place, right.place) then return false end
        return paths_overlap(left.path, right.path)
    end
    local touches = do(info, access)
        for _, origin in ipairs info.origins do
            local same_storage = origin.place == access.place or may_alias(origin.place, access.place)
            if same_storage and affects(access.path, origin.path) then return true end
        end
        return false
    end
    local info_of = do(borrow)
        local info = registry[borrow]
        if info == nil then fail("unknown " .. identity.describe borrow) end
        return info
    end

    -- a new held borrow of a path, live on this path of control
    local borrow = do(flow, path, mutable, lifetime, acquired)
        local info = data.BorrowInfo with
            id = supply.fresh identity.BorrowId
            form = data.Held { .path }
            origins = { data.Access { place = path.root, path = path.steps } }
            .mutable
            .lifetime
            .acquired
        end
        registry[info.id] = info
        flow.borrows[info.id] = Live {}
        return info
    end

    -- how to obtain a borrow's pointer here, or why it cannot be used
    local use = do(flow, borrow)
        local info = info_of borrow
        local state = flow.borrows[borrow]
        if state == nil then fail(identity.describe borrow .. " is not known on this path") end
        if BorrowState.is(state, Ended) then return BorrowUse.ended state end
        if BorrowForm.is(info.form, data.Stored) then return BorrowUse.fixed info.form.pointer end
        if state.pointer then return BorrowUse.cached state.pointer end
        return BorrowUse.derive info.form.path
    end

    -- remember the pointer derived for a held borrow, until its storage moves
    local cache = do(flow, borrow, pointer)
        local state = flow.borrows[borrow]
        if not BorrowState.is(state, Live) then fail("cache: " .. identity.describe borrow .. " is not live") end
        flow.borrows[borrow] = Live { .pointer }
    end

    -- a borrow written into data, passed to a compiled word or to C becomes a stored borrow
    -- of the same storage: a fixed pointer from now on; the held one it came from stays held
    local store = do(flow, borrow, pointer, acquired)
        local info = info_of borrow
        local stored = data.BorrowInfo { ..info, id = supply.fresh identity.BorrowId, form = data.Stored { .pointer }, .acquired }
        registry[stored.id] = stored
        flow.borrows[stored.id] = flow.borrows[borrow]
        return stored
    end

    -- storage at `access` may relocate: held borrows forget their pointer; stored ones end
    local moves = do(flow, access, at)
        for id, state in pairs flow.borrows do
            if BorrowState.is(state, Live) then
                local info = info_of id
                if touches(info, access) then
                    if BorrowForm.is(info.form, data.Stored) then
                        flow.borrows[id] = Ended { .at, reason = "grew" }
                    elseif state.pointer then
                        flow.borrows[id] = Live {}
                    end
                end
            end
        end
    end

    -- the borrows of `access` end, held or stored
    local ends = do(flow, access, reason, at)
        for id, state in pairs flow.borrows do
            if BorrowState.is(state, Live) and touches(info_of id, access) then
                flow.borrows[id] = Ended { .at, .reason }
            end
        end
    end

    -- an owner leaves its place: the place is moved and the borrows of it end
    local move_owner = do(flow, place, at)
        local contents = flow.contents[place]
        if contents == nil or Contents.is(contents, data.Uninitialized) then return OwnerMove.uninitialized() end
        if Contents.is(contents, data.Moved) then return OwnerMove.already_moved contents end
        if not Contents.is(contents, data.Tracked) then fail("move_owner: the owner in " .. identity.describe place .. " is not tracked") end
        flow.contents[place] = data.Moved { .at }
        ends(flow, data.Access { .place, path = {} }, "moved", at)
        return OwnerMove.moved contents.value
    end

    -- the facts after several incoming paths join. Borrow states join: ended on any edge is
    -- ended; a cached pointer survives only where every edge has the same one. Contents that
    -- agree are kept; the places whose contents differ are named, for the activity to give
    -- them block arguments, edge stores or releases. A lifetime is live if live on every edge.
    local agree = do(incoming)
        if #incoming == 0 then fail("agree needs at least one incoming path") end
        local first = incoming[1]
        local joined = empty()
        local differing = {}
        for place, contents in pairs first.contents do
            local agreeing = true
            for position = 2, #incoming do
                local other = incoming[position].contents[place]
                if other == nil or not same_contents(contents, other) then agreeing = false end
            end
            if agreeing then joined.contents[place] = contents else differing[#differing + 1] = place end
        end
        for position = 2, #incoming do
            for place in pairs incoming[position].contents do
                if first.contents[place] == nil then differing[#differing + 1] = place end
            end
        end
        table.sort(differing, |a, b| -> a.serial < b.serial)
        local borrow_ids = {}
        for _, flow in ipairs incoming do
            for id in pairs flow.borrows do borrow_ids[id] = true end
        end
        for id in pairs borrow_ids do
            local result = nil
            for _, flow in ipairs incoming do
                local state = flow.borrows[id]
                if state == nil then
                    -- a borrow made on one path only does not exist after the join
                    result = false
                    break
                end
                if BorrowState.is(state, Ended) then
                    result = state
                    break
                end
                if result == nil then
                    result = state
                elseif BorrowState.is(result, Live) and result.pointer ~= state.pointer then
                    result = Live {}
                end
            end
            if result then joined.borrows[id] = result end
        end
        for lifetime in pairs first.live_lifetimes do
            local everywhere = true
            for position = 2, #incoming do
                if not incoming[position].live_lifetimes[lifetime] then everywhere = false end
            end
            if everywhere then joined.live_lifetimes[lifetime] = true end
        end
        return JoinDecision { flow = joined, .differing }
    end

    -- the borrow a block argument carries after a join: the union of the incoming borrows'
    -- origins, ended if any incoming borrow ended there
    local join_borrows = do(incoming_flows, incoming_borrows, joined_flow, lifetime, acquired)
        local origins, mutable, state = {}, true, Live {}
        for position, id in ipairs incoming_borrows do
            local info = info_of id
            for _, origin in ipairs info.origins do origins[#origins + 1] = origin end
            mutable = mutable and info.mutable
            local incoming_state = incoming_flows[position].borrows[id]
            if incoming_state == nil then fail("join_borrows: " .. identity.describe id .. " is unknown on its edge") end
            if BorrowState.is(incoming_state, Ended) and BorrowState.is(state, Live) then state = incoming_state end
        end
        local first = info_of(incoming_borrows[1])
        local info = data.BorrowInfo { ..first, id = supply.fresh identity.BorrowId, .origins, .mutable, .lifetime, .acquired }
        registry[info.id] = info
        joined_flow.borrows[info.id] = state
        return info
    end

    return define
        .borrow
        .use
        .cache
        .store
        .moves
        .ends
        .move_owner
        .agree
        .join_borrows
        overlap = accesses_overlap
    end
end

return define
    .BorrowUse
    .OwnerMove
    .JoinDecision
    .empty
    .fork
    .same_contents
    .same_operand
    .same_value
    .paths_overlap
    .affects
    .tracking
end
