-- The platform mechanisms (compiler activities §3.2; buffers §3.4): what cannot be written in Nua,
-- each binding with its native signature and symbols. Applying one in a typed body emits a
-- `Mechanism` instruction. Storage needs none: lib/platform.nua is ordinary Nua over system calls.
-- What remains for this table is the task context switch, which is assembly.

local Mechanism = {}
Mechanism.__index = Mechanism
Mechanism.__tostring = mechanism -> "the mechanism " .. mechanism.name

local bindings = {}

return define
    .bindings
    is_mechanism = value -> getmetatable value == Mechanism
end
