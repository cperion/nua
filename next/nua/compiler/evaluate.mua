-- Evaluation (compiler activities §5.2, §6): the vocabulary hosted bodies call. One handler set
-- serves known and unknown values: a known computation folds, an unknown one becomes residual
-- code, in source order, and a known result never erases an effect that must still execute.
--
-- `evaluating(compilation)` makes the vocabulary once per compilation. What varies within it
-- is the path, an argument of every verb: a mutable handle holding the writer and block code
-- goes to, the flow facts, the invocation, the innermost loop and the source line. A join
-- replaces a path's state; a branch arm or loop round gets a path of its own.
--
-- Control (§6): a dynamic branch builds each arm as a child construction and joins the arms that
-- continue. A loop runs rounds at compile time while each round stays entirely known (syntax
-- §6.2: no residual statement, every place it writes still known); the first round that is not
-- is rolled back and the loop becomes residual from there, its header generalizing exactly the
-- carried places whose contents disagree on a continuing edge, until the header holds.

-- The vocabulary is assembled from its parts under nua/compiler/evaluation/, each adding its
-- verbs to the one table E; `compile` supplies the capabilities the evaluation does not own
-- (the definitions) and wires them explicitly (§1.1); primitives are a kind of
-- host value (hosting.primitive), recognized by the operations part.

local core = require "nua.compiler.evaluation.core"
local parts = {
    require "nua.compiler.evaluation.values",
    require "nua.compiler.evaluation.records",
    require "nua.compiler.evaluation.sums",
    require "nua.compiler.evaluation.joins",
    require "nua.compiler.evaluation.selections",
    require "nua.compiler.evaluation.bindings",
    require "nua.compiler.evaluation.references",
    require "nua.compiler.evaluation.computation",
    require "nua.compiler.evaluation.control",
    require "nua.compiler.evaluation.loops",
    require "nua.compiler.evaluation.application",
    require "nua.compiler.evaluation.owners",
    require "nua.compiler.evaluation.views",
    require "nua.compiler.evaluation.lifetimes",
    require "nua.compiler.evaluation.crossings",
    require "nua.compiler.evaluation.operations",
    require "nua.compiler.evaluation.members",
    require "nua.compiler.evaluation.host_views",
}

local evaluating = do(compilation, capabilities)
    local E = {}
    local construction = core(compilation, E, capabilities)
    for _, part in ipairs parts do part(E, construction) end
    return E
end

return define
    .evaluating
end
