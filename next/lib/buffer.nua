-- Buffers (docs/design/buffers.md §2.2, §4.1): the one storage primitive, as Nua words.
--
-- A buffer is a header { data, length, capacity } and one allocation of `capacity` elements, the
-- first `length` initialized. `words(T)` makes the members of buffers of T once (served for
-- every `Buffer T` by the family registered below): each takes the buffer by reference and
-- declares its effect on the borrows of the contents: growth `moves` them (a held view
-- survives, a stored one ends), shrinking and clearing `ends` them.
--
-- Every operation builds its new storage, writes the header, then releases what it replaced:
-- at a trap every header describes valid storage (buffers §2.5).

local allocator = import "allocator"

local index = import "index"

local made = {}

-- `B`: the buffer type served (`Buffer T` when not given, or the fixed-length owner `Array T`)
local words = do(T, B)
    B = B or Buffer T
    if made[B] then return made[B] end
    local size = size_of T
    -- elements that own storage are reached by reference, and released with their buffer
    local owning = owns T

    local bytes_of = do(count: U64): U64 = count * size

    -- capacity at least `wanted`: doubling, from 4. A pinned buffer reserves its limit once
    -- and commits as it grows, so its storage never moves (syntax §9.12).
    local grown_capacity = do(self: Ref B, wanted: U64): U64
        local capacity: U64 = self.capacity + self.capacity
        if capacity < 4 then capacity = 4 end
        if capacity < wanted then capacity = wanted end
        return capacity
    end
    local default_limit = math.floor(1073741824 / math.max(size, 1))

    local reserve = do(self: Ref B, wanted: U64): Unit
        if wanted <= self.capacity then return end
        if B.reserved then
            if self.limit == 0 then self.limit = default_limit end
            if wanted > self.limit then trap "a pinned buffer grew past its reserved limit" end
            if self.capacity == 0 then self.data = Ptr(T)(platform.reserve_range(bytes_of self.limit)) end
            local capacity = grown_capacity(self, wanted)
            if capacity > self.limit then capacity = self.limit end
            platform.commit_range(Ptr(U8)(self.data), bytes_of capacity)
            self.capacity = capacity
            return
        end
        local capacity = grown_capacity(self, wanted)
        local fresh = Ptr(T)(allocator.allocate(bytes_of capacity))
        if self.length > 0 then
            platform.move_bytes(Ptr(U8)(fresh), Ptr(U8)(self.data), bytes_of self.length)
        end
        local old_data = self.data
        local old_capacity = self.capacity
        self.data = fresh
        self.capacity = capacity
        if old_capacity > 0 then allocator.release(Ptr(U8)(old_data), bytes_of old_capacity) end
        moves self
    end

    -- growth moves, whether or not this push happens to need new storage: the rule a reader
    -- relies on does not depend on what the compiler knows about the capacity (buffers §2.3)
    local push = do(self: Ref B, value: T): Unit
        reserve(self, self.length + 1)
        initialize(self, self.length, value)
        self.length = self.length + 1
        if not B.reserved then moves self end
    end

    -- `b[i]` is the element's place (syntax §9.12, §16): its index checked at every use; an
    -- element is read as a copy, or, when it owns storage, by reference
    local element = do(self: Ref B, at): Ref T
        index.unsigned at
        local i = U64 at
        if i >= self.length then trap "index out of range" end
        return element_of(self, i)
    end

    -- `finish(b, first, limit)` (buffers §4.1): the elements of `[first, limit)` leave the
    -- initialized prefix: those that own storage are released
    local finish = do(self: Ref B, first: U64, limit: U64): Unit
        if owning then
            local index = first
            while index < limit do
                drop(element_of(self, index))
                index = index + 1
            end
        end
    end

    local pop = do(self: Ref B): T
        if self.length == 0 then trap "pop of an empty buffer" end
        self.length = self.length - 1
        ends(self, "shrank")
        return take(self, self.length)
    end

    local truncate = do(self: Ref B, length: U64): Unit
        if length > self.length then trap "truncate past the length" end
        finish(self, length, self.length)
        self.length = length
        ends(self, "shrank")
    end

    local clear = do(self: Ref B): Unit
        finish(self, 0, self.length)
        self.length = 0
        ends(self, "cleared")
    end

    local release = do(self: Ref B): Unit
        finish(self, 0, self.length)
        if self.capacity > 0 then
            if B.reserved then platform.release_range(Ptr(U8)(self.data), bytes_of self.limit)
            else allocator.release(Ptr(U8)(self.data), bytes_of self.capacity) end
        end
    end

    -- views: held borrows of the contents (buffers §2.3); `sub` views `[first, limit)`
    local sub = do(self: Ref B, first: U64, limit: U64): Slice T
        if first > limit or limit > self.length then trap "a view past the length" end
        return buffer_view(self, first, limit - first)
    end
    local all = do(self: Ref B): Slice T = buffer_view(self, 0, self.length)
    -- the elements lent for writing (syntax §12.2: marked at the call, `f(Ref xs)`)
    local all_mut = do(self: Ref B): Slice.mut T = buffer_view(self, 0, self.length, Slice.mut T)

    -- `Buffer(T) { … }` (syntax §16, `__cast`): an empty buffer, each entry pushed; the loop is
    -- over the host table, so it runs while specializing
    local construct = do(entries): B
        local built: B
        if B.reserved and entries.limit then built.limit = entries.limit end
        for _, entry in ipairs entries do
            push(Ref built, entry)
        end
        return built
    end
    local cast = do(value, native_type)
        if type value == "table" and getmetatable value == nil then return construct value end
        return nil
    end

    -- `Array(T, n) {}` (syntax §9.3): n zeroed elements, a length fixed when built
    local build = do(count: U64, entries): B
        local built: B
        reserve(Ref built, count)
        local i: U64 = 0
        while i < count do
            initialize(Ref built, i, zero_of T)
            i = i + 1
        end
        built.length = count
        return built
    end

    -- `copy b` (syntax §9.2): a new allocation, every initialized element copied
    local copied = do(self: Ref B): B
        local built: B
        if self.length > 0 then reserve(Ref built, self.length) end
        local i: U64 = 0
        while i < self.length do
            initialize(Ref built, i, copy(element_of(self, i)))
            i = i + 1
        end
        built.length = self.length
        return built
    end

    local shared = define
        __copy = copied
        .sub
        .all
        .all_mut
        __index = element
        __release = release
    end
    local members = B.fixed and define
        ..shared
        .build
    end or define
        ..shared
        .reserve
        .push
        .pop
        .truncate
        .clear
        __cast = cast
    end
    -- a buffer of bytes is text being built (syntax §14.2): it lends a `Str`
    if T == U8 and not B.fixed then
        members.str = do(self: Ref B): Str = buffer_view(self, 0, self.length, Str)
        local text = import("text").words(B, reserve)
        members.write, members.append = text.write, text.append
    end
    made[B] = members
    return members
end

-- the members of every `Buffer T` and `Array T` (syntax §16.1: served once per family)
family(Buffer, |element, native_type| -> words(element, native_type))

return {
    words = words,
}
