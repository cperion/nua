-- The compilation root (compiler activities §7.5): it creates the compilation's identities,
-- origins and place registry, makes the evaluation vocabulary, loads the source through Mua with
-- the Nua host, and closes each export into a definition. The program it answers has passed
-- the implemented graph/type/lifetime checks; this is not yet a backend readiness certificate.
-- A refusal is an error naming the source line.
--
--   compile(source, filename) -> { program, analysis, exports }
--   compile_c(source, filename) -> C text, prototypes, program

local specifications = require "nua.compiler.specifications"
local mua = require "mua"
local identity = require "nua.identity"
local types = require "nua.types"
local data = require "nua.compiler.data"
local graph = require "nua.compiler.graph"
local facts = require "nua.compiler.facts"
local hosting = require "nua.compiler.hosting"
local rules = require "nua.compiler.rules"
local evaluate = require "nua.compiler.evaluate"
local definitions_module = require "nua.compiler.definitions"
local verify = require "nua.compiler.verify"
local verify_lifetimes = require "nua.compiler.verify_lifetimes"
local front = require "nua.front"
local emit_c = require "nua.emit_c"
local platform = require "nua.compiler.platform"
local bridge_module = require "nua.compiler.bridge"

-- the Nua libraries of the replacement live beside its compiler, in next/lib
local library_directory = (debug.getinfo(1, "S").source:match("^@(.*)/nua/compile%.mua$") or "next") .. "/lib"

-- the names a Nua source sees besides Lua's: the native types and their constructors
local prelude = define
    U8 = types.U8
    U16 = types.U16
    U32 = types.U32
    U64 = types.U64
    I8 = types.I8
    I16 = types.I16
    I32 = types.I32
    I64 = types.I64
    F32 = types.F32
    F64 = types.F64
    Bool = types.Bool
    Unit = types.Unit
    Str = types.Str
    Ptr = types.pointer
    Ref = types.reference
    Buffer = types.growable
    Grow = types.growable
    Slice = types.slice
    Text = types.buffer types.U8
    size_of = native_type -> types.layout(native_type, { pointer_bits = 64 }).size
end

-- the words C reserves: an export cannot be named by one
local c_keywords = {}
for keyword in ([[auto break case char const continue default do double else enum extern float for goto
if inline int long register restrict return short signed sizeof static struct switch typedef union
unsigned void volatile while _Bool _Complex _Imaginary _Alignas _Alignof _Atomic _Generic _Noreturn
_Static_assert _Thread_local bool true false]]):gmatch("%S+") do c_keywords[keyword] = true end

-- the compilation: the data every activity of one compilation shares (compiler activities
-- §1.1): its identity supply, places, borrows, exports and the origins of source positions
local new_compilation = do()
    local supply = identity.supply()
    local origins, origin_ids = {}, {}
    return define
        .supply
        places = {}
        place_scope = {}
        borrows = {}
        exports = {}
        globals = {}
        headers = {}
        .origins
        origin = do(origin_source, line)
            local key = tostring origin_source .. ":" .. tostring line
            local found = origin_ids[key]
            if found then return found end
            found = supply.fresh identity.OriginId
            origin_ids[key] = found
            origins[found] = data.Origin { id = found, span = data.Span { source = origin_source or "?", line = math.max(line or 1, 1) } }
            return found
        end
    end
end

-- the host environment Nua sources run in: the prelude, the runtime the front end's output
-- calls (`__nua`), `import` of the Nua library, and the primitives. Answers the environment
-- and the loader of a source text.
local hosting_environment = do(compilation, filename, E)
    local runtime = define
        -- a word applied saturated from Lua is applied by this compilation (syntax §3.7)
        word = description -> hosting.word(description, E.host_apply)
        record = do(name, fields, line)
            for _, field in ipairs fields do
                if not check(types.NativeType, field.type) then
                    error(("%s:%d: the field '%s' of %s is %s, not a native type"):format(filename, line, field.name, name, tostring field.type), 0)
                end
            end
            local ok, record_or_problem = pcall(types.record, name, fields)
            if not ok then error(("%s:%d: %s"):format(filename, line, tostring record_or_problem), 0) end
            return record_or_problem
        end
        sum = do(name, alternatives, line)
            local ok, sum_or_problem = pcall(types.sum, name, alternatives)
            if not ok then error(("%s:%d: %s"):format(filename, line, tostring sum_or_problem), 0) end
            return sum_or_problem
        end
        -- a member of a native type (syntax §8, §16), or a field of a Lua table
        member = do(owner, name, value, line)
            if not check(types.NativeType, owner) then
                owner[name] = value
                return
            end
            local ok, problem = pcall(types.define_member, owner, name, value)
            if not ok then error(("%s:%d: %s"):format(filename, line, tostring problem), 0) end
        end
        -- the receiver of a method: a reference to its type's place; a Lua table's method
        -- receives the table
        receiver = owner -> check(types.NativeType, owner) and types.reference owner or nil
        export = do(value, c_name, line)
            if not (hosting.is_word value or hosting.is_application value) then
                error(("%s:%d: export needs a word, got %s"):format(filename, line, tostring value), 0)
            end
            if c_keywords[c_name] then
                error(("%s:%d: the C name '%s' is a C keyword: export it as another name (export %s as \"...\")"):format(filename, line, c_name, c_name), 0)
            end
            compilation.exports[#compilation.exports + 1] = { .value, .c_name, .line }
        end
    end
    local environment = setmetatable({ __nua = runtime, platform = platform.bindings, ..prelude }, { __index = _G })
    local load_nua = do(text, name)
        local chunk, problem = mua.load(text, "@" .. name, { host = front.host name })
        if not chunk then error(problem, 0) end
        setfenv(chunk, environment)
        return chunk()
    end
    -- `import "allocator"`: a Nua library from next/lib, compiled once in this compilation
    local imported = {}
    environment.import = do(name)
        if imported[name] == nil then
            local path = ("%s/%s.nua"):format(library_directory, name)
            local file = io.open(path, "rb")
            if not file then error(("import: no Nua library %s (looked for %s)"):format(name, path), 2) end
            local text = file:read "*a"
            file:close()
            imported[name] = { value = load_nua(text, path) }
        end
        return imported[name].value
    end
    for _, name in ipairs { "trap", "moves", "ends", "element_of", "initialize", "take", "drop", "view_length", "view_element_of", "subview_of", "static_text", "array_element_of", "array_view", "zero_of", "view_data", "reinterpret", "hold_structure", "release_structure", "null", "static_cstring", "buffer_view", "loaned_view", "raw_view", "view_as", "end_loan", "fnptr", "atomic_operation", "fence" } do environment[name] = hosting.primitive(name, E.host_primitive) end
    environment.copy = hosting.primitive("copy", E.host_primitive, true)
    environment.owns = types.owns
    environment.Inferred = hosting.Inferred
    -- `family(Buffer, provider)`: a library serves the members of every type of a kind
    environment.family = types.define_family
    -- `host(v)`: the Lua value of a known value (syntax §3.7); `type_of(v)`: a staged value's
    -- native type (syntax §2.2)
    environment.host = E.host_value
    environment.type_of = E.type_of
    environment.is_known = E.is_known
    environment.same_value = E.same_value
    -- foreign C (syntax §17): `extern(name, params, result, { header = "<stdio.h>", variadic = true })`
    environment.extern = do(name, parameters, result, options)
        options = options or {}
        return hosting.foreign({ .name, .parameters, .result, header = options.header, variadic = options.variadic == true }, do(foreign, arguments)
            error(("%s is a foreign function: it is applied inside an evaluation, never while compiling at top level"):format(name), 3)
        end)
    end
    -- a Text of its own limit (syntax §9.12)
    types.define_member(types.buffer types.U8, "pinned", types.buffer(types.U8, true))
    -- `global(T, options)` (syntax §21.1): the `Ptr T` of a C object
    local global_count = 0
    environment.global = do(native_type, options)
        options = options or {}
        if not check(types.NativeType, native_type) then error("global takes a native type, got " .. tostring native_type, 2) end
        if native_type == types.Unit or types.borrows native_type or types.NativeType.is(native_type, types.OpaqueType) then
            error(("a global cannot be %s"):format(types.describe native_type), 2)
        end
        if (options.exported or options.imported) and not options.name then error("an exported or imported global needs a name", 2) end
        global_count += 1
        local c_name = (options.exported or options.imported) and options.name or ("nua_global_%s_%d"):format((options.name or "unnamed"):gsub("[^%w_]", "_"), global_count)
        local policy = options.thread_local and "thread_local" or options.shared and "unchecked_shared" or types.owns native_type and "thread_affine_owner" or "plain"
        local zero = data.Constant { type = native_type, bits = data.ZeroBits {} }
        local initial = options.init and (rules.is_float native_type and rules.float(native_type, options.init) or rules.integer(native_type, options.init)) or zero
        local id = compilation.supply.fresh identity.GlobalId
        compilation.globals[id] = data.Global with
            .id
            name = c_name
            type = native_type
            initializer = data.StaticValue { value = initial.bits }
            .policy
            lifetime = compilation.supply.fresh identity.LifetimeId
            origin = compilation.origin(filename, 0)
            exported = options.exported == true
            imported = options.imported == true
            header = options.header
        end
        return data.Bits { type = types.pointer native_type, operand = data.Constant { type = types.pointer native_type, bits = data.SymbolAddress { name = c_name, offset = 0 } } }
    end
    environment.Fn = |parameters, result| -> types.function_type(parameters, result)
    environment.Atomic = types.atomic
    environment.is_integer = rules.is_integer
    -- what only a header knows (syntax §18): a constant, a variable read where it is called,
    -- a layout
    local needs_header = do(header)
        if header then compilation.headers[header] = true end
    end
    environment.cconst = do(name, native_type, header)
        needs_header header
        return E.known(data.Constant { type = native_type, bits = data.ForeignValue { .name } })
    end
    environment.cread = do(name, native_type, header)
        return hosting.foreign({ .name, parameters = {}, result = native_type, header = header, variadic = false, reads = true }, do(foreign, arguments)
            error(("%s is a C variable: it is read inside an evaluation, never while compiling at top level"):format(name), 3)
        end)
    end
    environment.cstruct = do(c_name, header, source)
        needs_header header
        local record = types.RecordType { name = c_name, fields = {}, .c_name }
        local entries = type source == "function" and source(record) or source
        for _, entry in ipairs entries do
            if entry[2] == record then error(("cstruct %s: the type being declared may occur only behind a pointer"):format(c_name), 2) end
            record.fields[#record.fields + 1] = types.Field { name = entry[1], type = entry[2], c_member = entry[3] }
        end
        return record
    end
    environment.size_of = do(native_type)
        if types.NativeType.is(native_type, types.RecordType) and native_type.c_name then
            return E.known(data.Constant { type = types.U64, bits = data.ForeignValue { name = "sizeof(" .. native_type.c_name .. ")" } })
        end
        return prelude.size_of native_type
    end
    -- `test "name" do ... end` (syntax §3.10): a computation of program construction, named
    local test_names = {}
    environment.test = do(name, body)
        if type name ~= "string" then error("test: the name must be text known while compiling", 2) end
        if body == nil then return block -> environment.test(name, block) end
        test_names[#test_names + 1] = name
        local done, problem = xpcall(body, |message| -> tostring message)
        local trail = table.concat(test_names, " > ")
        test_names[#test_names] = nil
        if not done then error(("test %q:\n%s"):format(trail, problem), 0) end
    end
    -- `assert` also takes a native condition, which must be a known Bool (syntax §3.10)
    environment.assert = function(...)
        local condition = (...)
        local native_type = environment.type_of condition
        if native_type == nil then return assert(...) end
        if native_type ~= types.Bool then error("assert: a native condition is a Bool, not " .. types.describe native_type, 2) end
        if not environment.is_known condition then error("assert: this condition is not known while compiling, and an assertion is never a run-time check", 2) end
        if environment.host condition == false then error(select(2, ...) or "assertion failed", 2) end
        return ...
    end
    -- `require "nua.x"` is a bundled library; other names are Lua's
    environment.require = do(name)
        local bundled = name:match("^nua%.(.+)$")
        if bundled then return environment.import(bundled) end
        return require(name)
    end
    environment.opaque = types.opaque
    environment.CString = types.CString
    -- `Array(T, n)`: n known while compiling makes the value type (syntax §13)
    -- and, n known only when the program runs, the builder of the owner `Array T` (§9.3);
    -- `Array(T)` is the owner's type
    environment.Array = do(element, count)
        if count == nil then return types.buffer(element, false, true) end
        if E.is_known count then return types.fixed_array(element, E.host_value count) end
        return environment.import("buffer").words(element, types.buffer(element, false, true)).build(count)
    end
    environment.FixedArray = types.fixed_array
    return environment, load_nua
end

-- an export closed into a specification: its known supply stays known, the native
-- requirements still unsupplied are its parameters
local export_specification = do(E, export, filename)
    local word, supplied = hosting.supplied_of export.value
    local specification = {}
    for index, requirement in ipairs word.requirements do
        local argument = supplied[index]
        if index <= #supplied then
            if requirement.type == nil then
                specification[index] = specifications.KnownHost { value = argument }
            else
                local path = { source = filename, line = export.line }
                specification[index] = specifications.KnownNative { value = E.from_host(path, requirement.type, argument, ("the argument '%s' of %s"):format(requirement.name, word.name)) }
            end
        else
            if requirement.type == nil then
                error(("%s:%d: export %s: the parameter '%s' needs a native type"):format(filename, export.line, export.c_name, requirement.name), 0)
            end
            specification[index] = specifications.Dynamic { type = requirement.type }
        end
    end
    return word, specification
end

-- only definitions reachable from the exports are kept (compiler activities §6.3): one
-- requested by a construction that was later discarded is not part of the program
local reachable_definitions = do(built, exports)
    local definitions, pending = {}, {}
    for _, export in ipairs exports do pending[#pending + 1] = export.definition end
    while #pending > 0 do
        local id = table.remove pending
        if definitions[id] == nil then
            definitions[id] = built[id]
            for called in pairs(graph.called_definitions built[id]) do pending[#pending + 1] = called end
        end
    end
    return definitions
end

-- the verifiers over the finished program and its facts; any problem refuses the compilation
local verified = do(program, analysis, filename)
    local problems = verify.all program
    for _, problem in ipairs(verify_lifetimes.lifetimes(program, analysis)) do problems[#problems + 1] = problem end
    if #problems == 0 then return end
    local lines = {}
    for _, problem in ipairs problems do lines[#lines + 1] = ("%s: %s"):format(problem.verifier, problem.message) end
    error(filename .. ": the compiled program does not verify:\n" .. table.concat(lines, "\n"), 0)
end

-- a source compiled: run it in the host environment, close its exports into definitions, keep
-- what they reach, publish the facts, and verify
local compiling_with_members = do(source, filename)
    local compilation = new_compilation()
    -- the evaluation and the definitions cooperate: each receives the other's vocabulary,
    -- wired here explicitly (compiler activities §1.1)
    local definitions_capability = {}
    local E = evaluate.evaluating(compilation, { definitions = definitions_capability, bridge = bridge_module.bridge() })
    local registry = definitions_module.defining(compilation, E)
    definitions_capability.request = registry.request
    definitions_capability.contract_of = registry.contract_of
    definitions_capability.bundle_of = registry.bundle_of
    definitions_capability.abi_of = registry.abi_of
    local environment, load_nua = hosting_environment(compilation, filename, E)
    -- the words of buffers of each element type, from the Nua library
    -- the built-in kinds the Nua library serves register their members (syntax §16.1)
    environment.import "buffer"
    environment.import "slice"
    environment.import "array"
    environment.view_of = environment.import("slice").foreign_view
    types.slice.of_raw(|pointer, count, view_type| -> environment.raw_view(pointer, count, view_type))
    environment.Chars = environment.import("chars").Chars
    environment.Store = environment.import("store").Store
    environment.Id = environment.import("store").Id
    environment.Map = environment.import("map").Map
    environment.cformat = environment.import("cformat").cformat
    environment.import "str"
    environment.import "atomic"
    environment.atomic_ptr = environment.import("atomic").atomic_ptr
    load_nua(source, filename)

    local exports = {}
    for _, export in ipairs compilation.exports do
        local word, specification = export_specification(E, export, filename)
        local id = registry.define_export(word, specification, filename, export.line)
        exports[#exports + 1] = data.Export { name = export.c_name, definition = id }
    end
    local definitions = reachable_definitions(registry.definitions(), exports)
    local program = data.Program with
        revision = 0
        .definitions
        words = registry.words()
        globals = compilation.globals
        headers = compilation.headers
        .exports
        lifetimes = {}
        origins = compilation.origins
    end
    local published, contracts = {}, {}
    local all_facts, all_contracts = registry.facts(), registry.contracts()
    for id in pairs definitions do
        published[id] = assert(all_facts[id])
        contracts[id] = assert(all_contracts[id])
    end
    local analysis = data.Analysis { revision = program.revision, definitions = published, .contracts }
    verified(program, analysis, filename)
    return define
        .program
        .analysis
        .exports
    end
end

-- the members of native types belong to the compilation that defines them: its registry is
-- installed while it runs, and the one it replaced restored, refused or not
local compiling = do(source, filename)
    local previous = types.use_registry(types.registry())
    local results = { pcall(compiling_with_members, source, filename) }
    types.use_registry previous
    if not results[1] then error(results[2], 0) end
    return results[2]
end

local compile_c = do(source, filename)
    local compiled = compiling(source, filename)
    local text, prototypes = emit_c.emit compiled.program
    return text, prototypes, compiled.program
end

return define
    compile = compiling
    .compile_c
end
