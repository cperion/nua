-- A Lua staging continuation can invalidate storage immediately after lending.
-- Deliberately not a native word: its automatic argument binding would mask a
-- deferred-read bug in view_of's own completion.
local release = extern("free", { Ptr U8 }, Unit, { header = "<stdlib.h>" })
local release_after = function(pointer, value)
    release pointer
    return value
end

local foreign_byte = do(pointer: Ptr U8): U8
    return release_after(pointer, view_of(pointer, 1) do(bytes) return bytes[0] end)
end
export foreign_byte
