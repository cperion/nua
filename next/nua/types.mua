-- Native types: what a native value can be. A closed family; the compiler's questions about a
-- type (its name, whether it owns or borrows storage, its layout on a target) are passes over
-- it. Constructed types are interned, so one type is one record and compares by identity.
-- Records are nominal: each declaration is a new type. Sums are structural (syntax §11.1): their
-- alternatives in canonical order, by name, so two spellings of the same alternatives (the
-- same names with the same payload types) are one type.
--
-- `Buffer T` is the one storage primitive (docs/design/buffers.md); the containers (`Grow`,
-- `Text`, `Store`, `Map`) are records over buffers, declared by the Nua library, not here.

local shapes = require "nua.shapes"
local list_of = shapes.list_of
local Natural = shapes.Natural
local Positive = shapes.Positive

local NativeType = family "native type"
local IntegerType = struct { name: String, bits: Positive, signed: Boolean }
local FloatType = struct { name: String, bits: Positive }
local BooleanType = struct { name: String }
local UnitType = struct { name: String }
local PointerType = struct { target: NativeType }
local ReferenceType = struct { target: NativeType }
local ViewType = struct { element: NativeType, mutable: Boolean, text: Boolean }
local FixedArrayType = struct { element: NativeType, count: Natural }
local Field = struct { name: String, type: NativeType }
local RecordType = struct { name: String, fields: list_of(Field) }
local Alternative = struct { name: String, payload: NativeType }
local SumType = struct { name: String, alternatives: list_of(Alternative) }
-- `fixed`: the owner `Array T` (syntax §9.3): a buffer whose length is set when it is built
local BufferType = struct { element: NativeType, pinned: Boolean, fixed: Boolean }
local FunctionType = struct { parameters: list_of(NativeType), result: NativeType, variadic: Boolean }
NativeType {
    IntegerType, FloatType, BooleanType, UnitType, PointerType, ReferenceType, ViewType,
    FixedArrayType, RecordType, SumType, BufferType, FunctionType
}

------------------------------------------------------------------------------------------------
-- Construction. Scalars exist once; composite types are interned by their components.

local integer = |name, bits, signed| -> IntegerType { .name, .bits, .signed }
local U8, U16, U32, U64 = integer("U8", 8, false), integer("U16", 16, false), integer("U32", 32, false), integer("U64", 64, false)
local I8, I16, I32, I64 = integer("I8", 8, true), integer("I16", 16, true), integer("I32", 32, true), integer("I64", 64, true)
local F32 = FloatType { name = "F32", bits = 32 }
local F64 = FloatType { name = "F64", bits = 64 }
local Bool = BooleanType { name = "Bool" }
local Unit = UnitType { name = "Unit" }

-- one table per constructor, keyed by its components in order; weak, so unused types go
local interned = do()
    local root = setmetatable({}, { __mode = "k" })
    return do(components, make)
        local level = root
        for index = 1, #components - 1 do
            local key = components[index]
            local next_level = level[key]
            if next_level == nil then
                next_level = setmetatable({}, { __mode = "k" })
                level[key] = next_level
            end
            level = next_level
        end
        local last = components[#components]
        local found = level[last]
        if found == nil then
            found = make()
            level[last] = found
        end
        return found
    end
end

local need_type = do(value, what)
    if not check(NativeType, value) then
        error(what .. " expects a native type, got " .. tostring value, 3)
    end
end

local pointers, references, views, arrays, buffers, functions = interned(), interned(), interned(), interned(), interned(), interned()

local pointer = do(target)
    need_type(target, "Ptr")
    return pointers({ target }, || -> PointerType { .target })
end
local reference = do(target)
    need_type(target, "Ref")
    return references({ target }, || -> ReferenceType { .target })
end
local view = do(element, mutable)
    need_type(element, "Slice")
    return views({ element, mutable == true, false }, || -> ViewType { .element, mutable = mutable == true, text = false })
end
-- Str is the read-only view of bytes with the text words
local Str = ViewType { element = U8, mutable = false, text = true }
-- `Slice T`, `Slice.mut T`: the view constructors, as one object (the family's constructor)
local slice = setmetatable(define
    mut = element -> view(element, true)
end, { __call = |_, element| -> view element, __tostring = || -> "Slice" })
local fixed_array = do(element, count)
    need_type(element, "Array")
    if not check(Natural, count) then error("Array(T, n) expects a natural count, got " .. tostring count, 2) end
    return arrays({ element, count }, || -> FixedArrayType { .element, .count })
end
local buffer = do(element, pinned, fixed)
    need_type(element, "Buffer")
    return buffers({ element, pinned == true, fixed == true }, || -> BufferType { .element, pinned = pinned == true, fixed = fixed == true })
end
local function_type = do(parameters, result, variadic)
    for _, parameter in ipairs parameters do need_type(parameter, "a function parameter") end
    need_type(result, "a function result")
    local key = { #parameters, variadic == true }
    for _, parameter in ipairs parameters do key[#key + 1] = parameter end
    key[#key + 1] = result
    return functions(key, || -> FunctionType { .parameters, .result, variadic = variadic == true })
end

-- nominal declarations: two records with the same fields are different types
local record = do(name, fields)
    local seen = {}
    local checked = {}
    for _, entry in ipairs fields do
        if seen[entry.name] then error(("record %s: two fields are named %s"):format(name, entry.name), 2) end
        seen[entry.name] = true
        checked[#checked + 1] = Field { name = entry.name, type = entry.type }
    end
    return RecordType { .name, fields = checked }
end
local sums = interned()
local borrows      -- a pass below: does a type hold a borrow
-- a sum of named alternatives, each with a payload type (`Unit` for none); its name is the one
-- it was first declared with
local sum = do(name, alternatives)
    local seen, sorted = {}, {}
    for _, entry in ipairs alternatives do
        if seen[entry.name] then error(("sum %s: two alternatives are named %s"):format(name, entry.name), 2) end
        seen[entry.name] = true
        need_type(entry.payload, ("the alternative '%s' of %s"):format(entry.name, name))
        if borrows entry.payload then
            error(("sum %s: the payload of '%s' holds a borrow; a payload may hold owners, never references"):format(name, entry.name), 2)
        end
        sorted[#sorted + 1] = entry
    end
    if #sorted == 0 then error(("sum %s needs at least one alternative"):format(name), 2) end
    table.sort(sorted, |a, b| -> a.name < b.name)
    local key = {}
    for _, entry in ipairs sorted do
        key[#key + 1] = entry.name
        key[#key + 1] = entry.payload
    end
    return sums(key, do()
        local checked = {}
        for _, entry in ipairs sorted do checked[#checked + 1] = Alternative { name = entry.name, payload = entry.payload } end
        return SumType { .name, alternatives = checked }
    end)
end

-- the alternative of a sum by name, and its tag (its position in canonical order, from 0)
local alternative_of = do(sum_type, name)
    for index, alternative in ipairs sum_type.alternatives do
        if alternative.name == name then return alternative, index - 1 end
    end
    return nil
end

-- A sum value described at host level: the alternative and its payload (a host value, or a
-- native value inside a typed body). It becomes a native value where it meets the sum type.
local Variant = struct { sum: SumType, alternative: String, payload: Any }
-- A value of a native type described in host code (syntax §2.2: types are compile-time
-- values): `I32(n)`, `Fixed { raw = … }`. It becomes a native value where it meets its type.
local Described = struct { type: NativeType, value: Any }

-- A constructor: `Shape.rect { … }`, `Opt.some x`, and for a Unit alternative `Opt.none` or
-- `Direction.left()`. Applied, it answers the variant; a Unit constructor stands for its variant
-- where a value is meant. It is a callable host value, as a primitive is.
local Constructor = {}
Constructor.__tostring = constructor -> ("%s.%s"):format(constructor.sum.name, constructor.alternative.name)
Constructor.__call = do(constructor, payload)
    if constructor.alternative.payload == Unit and payload ~= nil then
        error(("%s takes no payload"):format(tostring constructor), 2)
    end
    return Variant { sum = constructor.sum, alternative = constructor.alternative.name, .payload }
end
local is_constructor = value -> getmetatable value == Constructor
local constructors = setmetatable({}, { __mode = "k" })
-- the members of a sum type its fields do not answer are its constructors
function SumType:__index(member)
    local alternative = alternative_of(self, member)
    if alternative == nil then return nil end
    local by_name = constructors[self]
    if by_name == nil then
        by_name = {}
        constructors[self] = by_name
    end
    local found = by_name[member]
    if found == nil then
        found = setmetatable({ sum = self, .alternative }, Constructor)
        by_name[member] = found
    end
    return found
end
-- the host description a value stands for, if it describes a sum value: a variant, or a Unit
-- constructor not applied
local variant_of = do(value)
    if check(Variant, value) then return value end
    if is_constructor value and value.alternative.payload == Unit then return Variant { sum = value.sum, alternative = value.alternative.name, payload = nil } end
    return nil
end

------------------------------------------------------------------------------------------------
-- Passes.

local named = do(node, recurse) return node.name end
local Describing = define
    IntegerType = named
    FloatType = named
    BooleanType = named
    UnitType = named
    PointerType = do(node, recurse) return "Ptr " .. recurse node.target end
    ReferenceType = do(node, recurse) return "Ref " .. recurse node.target end
    ViewType = do(node, recurse)
        if node.text then return "Str" end
        return (node.mutable and "Slice.mut " or "Slice ") .. recurse node.element
    end
    FixedArrayType = do(node, recurse) return ("Array(%s, %d)"):format(recurse node.element, node.count) end
    RecordType = named
    SumType = named
    BufferType = do(node, recurse) return (node.fixed and "Array " or node.pinned and "Buffer.pinned " or "Buffer ") .. recurse node.element end
    FunctionType = do(node, recurse)
        local parameters = {}
        for index, parameter in ipairs node.parameters do parameters[index] = recurse parameter end
        if node.variadic then parameters[#parameters + 1] = "..." end
        return ("Fn(%s): %s"):format(table.concat(parameters, ", "), recurse node.result)
    end
end
local describe = NativeType.pass "describe a native type" with ..Describing end

-- Does a value of the type own storage? Buffers do, and aggregates holding them. References,
-- views, pointers and functions never own what they reach.
local never = do(node, recurse) return false end
local Owning = define
    IntegerType = never
    FloatType = never
    BooleanType = never
    UnitType = never
    PointerType = never
    ReferenceType = never
    ViewType = never
    FunctionType = never
    BufferType = do(node, recurse) return true end
    FixedArrayType = do(node, recurse) return recurse node.element end
    RecordType = do(node, recurse)
        for _, field in ipairs node.fields do
            if recurse field.type then return true end
        end
        return false
    end
    SumType = do(node, recurse)
        for _, alternative in ipairs node.alternatives do
            if recurse alternative.payload then return true end
        end
        return false
    end
end
local owns = NativeType.pass "does a native type own storage" with ..Owning end

-- Does a value of the type hold a borrow? Raw pointers are not borrows (they carry no lifetime).
local Borrowing = define ..Owning
    ReferenceType = do(node, recurse) return true end
    ViewType = do(node, recurse) return true end
    BufferType = do(node, recurse) return false end
end
borrows = NativeType.pass "does a native type hold a borrow" with ..Borrowing end

------------------------------------------------------------------------------------------------
-- Layout on a target: size, alignment and the offsets of the parts a native value has.

local NativeLayout = struct { size: Natural, alignment: Positive, fields: Table }
local align_up = |offset, alignment| -> math.ceil(offset / alignment) * alignment

-- C's rule for a sequence of parts: each at its alignment, the whole rounded to the largest
local sequence = do(parts)
    local offset, alignment, fields = 0, 1, {}
    for _, part in ipairs parts do
        offset = align_up(offset, part.layout.alignment)
        fields[#fields + 1] = { name = part.name, offset = offset, layout = part.layout }
        offset += part.layout.size
        alignment = math.max(alignment, part.layout.alignment)
    end
    return NativeLayout { size = align_up(offset, alignment), .alignment, .fields }
end

local scalar = bytes -> NativeLayout { size = bytes, alignment = math.max(bytes, 1), fields = {} }

local Laying = define
    IntegerType = do(node, recurse, target) return scalar(node.bits / 8) end
    FloatType = do(node, recurse, target) return scalar(node.bits / 8) end
    BooleanType = do(node, recurse, target) return scalar 1 end
    UnitType = do(node, recurse, target) return NativeLayout { size = 0, alignment = 1, fields = {} } end
    PointerType = do(node, recurse, target) return scalar(target.pointer_bits / 8) end
    ReferenceType = do(node, recurse, target) return scalar(target.pointer_bits / 8) end
    FunctionType = do(node, recurse, target) return scalar(target.pointer_bits / 8) end
    ViewType = do(node, recurse, target)
        return sequence {
            { name = "data", layout = scalar(target.pointer_bits / 8) },
            { name = "length", layout = recurse(U64, target) },
        }
    end
    BufferType = do(node, recurse, target)
        local parts = {
            { name = "data", layout = scalar(target.pointer_bits / 8) },
            { name = "length", layout = recurse(U64, target) },
            { name = "capacity", layout = recurse(U64, target) },
        }
        if node.pinned then parts[#parts + 1] = { name = "limit", layout = recurse(U64, target) } end
        return sequence parts
    end
    FixedArrayType = do(node, recurse, target)
        local element = recurse(node.element, target)
        local stride = align_up(element.size, element.alignment)
        return NativeLayout { size = stride * node.count, alignment = element.alignment, fields = {} }
    end
    RecordType = do(node, recurse, target)
        local parts = {}
        for index, field in ipairs node.fields do
            parts[index] = { name = field.name, layout = recurse(field.type, target) }
        end
        return sequence parts
    end
    -- a tag, then the payloads sharing one region aligned for the most demanding of them
    SumType = do(node, recurse, target)
        local size, alignment = 0, 1
        local payloads = {}
        for _, alternative in ipairs node.alternatives do
            local layout = recurse(alternative.payload, target)
            payloads[#payloads + 1] = { name = alternative.name, layout = layout }
            size = math.max(size, layout.size)
            alignment = math.max(alignment, layout.alignment)
        end
        local payload = NativeLayout { .size, .alignment, fields = payloads }
        return sequence {
            { name = "tag", layout = recurse(U32, target) },
            { name = "payload", layout = payload },
        }
    end
end
local layout = NativeType.pass "lay out a native type on a target" with ..Laying end

------------------------------------------------------------------------------------------------
-- Members (syntax §8, §16.3): the methods and hooks a library gives a native type, by name. A
-- type's own members are stored for it; a kind constructed per component (`Buffer T`,
-- `Slice T`, `Ptr T`, ...) is served per family, its provider answering the members of each
-- type of the kind. A type's own members come before its family's: `Str` has its text words
-- and the words of the `Slice` family.

-- the members of one compilation: its own members, family providers and the family members
-- made so far. A compilation installs its registry while it runs (`use_registry`); the native
-- types are shared by every compilation, their members are not.
local registry = || -> { own = setmetatable({}, { __mode = "k" }), providers = {}, made = setmetatable({}, { __mode = "k" }) }
local current = nil
-- install `next` (nil: none); answers the registry it replaces
local use_registry = do(next)
    local previous = current
    current = next
    return previous
end
local active = do()
    if current == nil then error("the members of native types are defined while a compilation runs", 3) end
    return current
end
-- the variant (kind) of each type constructor, for registering a family by its constructor
local kinds_of_constructors = define
    [pointer] = PointerType
    [reference] = ReferenceType
    [view] = ViewType
    [slice] = ViewType
    [fixed_array] = FixedArrayType
    [buffer] = BufferType
end

local define_member = do(native_type, name, value)
    if not check(NativeType, native_type) then error("a member is defined on a native type, not " .. tostring native_type, 2) end
    if NativeType.is(native_type, RecordType) then
        for _, field in ipairs native_type.fields do
            if field.name == name then error(("%s: the method '%s' has the name of a field"):format(native_type.name, name), 2) end
        end
    end
    local own = active().own
    local members = own[native_type]
    if members == nil then
        members = {}
        own[native_type] = members
    end
    if members[name] ~= nil then error(("%s already has a member '%s'"):format(describe native_type, name), 2) end
    members[name] = value
end

-- `family(Buffer, provider)`: the members of every `Buffer T` are `provider(T)`'s
local define_family = do(constructor, provider)
    local kind = kinds_of_constructors[constructor]
    if kind == nil then error("family: " .. tostring constructor .. " is not a type constructor served per family", 2) end
    local providers = active().providers
    if providers[kind] ~= nil then error("family: the family of " .. tostring kind .. " is registered already", 2) end
    providers[kind] = provider
end

local family_of = do(native_type)
    for kind, provider in pairs(active().providers) do
        if NativeType.is(native_type, kind) then return provider end
    end
    return nil
end
-- what a provider answers for one type: the component its constructor took
local Components = define
    PointerType = |node, recurse| -> node.target
    ReferenceType = |node, recurse| -> node.target
    ViewType = |node, recurse| -> node.element
    FixedArrayType = |node, recurse| -> node.element
    BufferType = |node, recurse| -> node.element
    IntegerType = |node, recurse| -> nil
    FloatType = |node, recurse| -> nil
    BooleanType = |node, recurse| -> nil
    UnitType = |node, recurse| -> nil
    RecordType = |node, recurse| -> nil
    SumType = |node, recurse| -> nil
    FunctionType = |node, recurse| -> nil
end
local component_of = NativeType.pass "the component a family type is made of" with ..Components end

-- a member of a native type by name: its own, else its family's; nil when it has none
local member = do(native_type, name)
    if current == nil then return nil end
    local own = current.own[native_type]
    if own and own[name] ~= nil then return own[name] end
    local provider = family_of native_type
    if provider == nil then return nil end
    local members = current.made[native_type]
    if members == nil then
        members = provider(component_of native_type, native_type) or {}
        current.made[native_type] = members
    end
    return members[name]
end

-- host-level reads and assignments of a declared type's members: `function Fixed.__cast(v)`
-- and `Fixed.__cast` (its descriptor's own fields answer first)
for _, kind in ipairs { RecordType, ViewType, BufferType, FixedArrayType } do
    kind.__index = |native_type, name| -> member(native_type, name)
    kind.__newindex = |native_type, name, value| -> define_member(native_type, name, value)
end
-- a scalar, pointer or record type applied in host code describes a value of it
for _, kind in ipairs { IntegerType, FloatType, BooleanType, PointerType, RecordType } do
    kind.__call = |native_type, value| -> Described { type = native_type, .value }
end
local constructor_of_sum = SumType.__index
SumType.__index = do(sum_type, name)
    local found = constructor_of_sum(sum_type, name)
    if found ~= nil then return found end
    return member(sum_type, name)
end
SumType.__newindex = |sum_type, name, value| -> define_member(sum_type, name, value)

return define
    .NativeType
    .IntegerType
    .FloatType
    .BooleanType
    .UnitType
    .PointerType
    .ReferenceType
    .ViewType
    .FixedArrayType
    .Field
    .RecordType
    .Alternative
    .SumType
    .BufferType
    .FunctionType
    .NativeLayout
    .U8
    .U16
    .U32
    .U64
    .I8
    .I16
    .I32
    .I64
    .F32
    .F64
    .Bool
    .Unit
    .Str
    .pointer
    .reference
    .view
    .slice
    .fixed_array
    .buffer
    .function_type
    .record
    .sum
    .alternative_of
    .Variant
    .Described
    .is_constructor
    .variant_of
    .describe
    .owns
    .borrows
    .layout
    .define_member
    .define_family
    .member
    .registry
    .use_registry
end
