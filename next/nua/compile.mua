-- The compilation root (compiler activities §7.5): it creates the compilation's identities,
-- origins and place registry, makes the evaluation vocabulary, loads the source through Mua with
-- the Nua host, and closes each export into a definition. The program it answers has passed
-- the implemented graph/type/lifetime checks; this is not yet a backend readiness certificate.
-- A refusal is an error naming the source line.
--
--   compile(source, filename) -> { program, analysis, exports }
--   compile_c(source, filename) -> C text, prototypes, program

local specifications = require "nua.compiler.specifications"
local mua = require "mua"
local identity = require "nua.identity"
local types = require "nua.types"
local data = require "nua.compiler.data"
local graph = require "nua.compiler.graph"
local facts = require "nua.compiler.facts"
local hosting = require "nua.compiler.hosting"
local evaluate = require "nua.compiler.evaluate"
local definitions_module = require "nua.compiler.definitions"
local verify = require "nua.compiler.verify"
local verify_lifetimes = require "nua.compiler.verify_lifetimes"
local front = require "nua.front"
local emit_c = require "nua.emit_c"
local platform = require "nua.compiler.platform"

-- the Nua libraries of the replacement live beside its compiler, in next/lib
local library_directory = (debug.getinfo(1, "S").source:match("^@(.*)/nua/compile%.mua$") or "next") .. "/lib"

-- the names a Nua source sees besides Lua's: the native types and their constructors
local prelude = define
    U8 = types.U8
    U16 = types.U16
    U32 = types.U32
    U64 = types.U64
    I8 = types.I8
    I16 = types.I16
    I32 = types.I32
    I64 = types.I64
    F32 = types.F32
    F64 = types.F64
    Bool = types.Bool
    Unit = types.Unit
    Str = types.Str
    Ptr = types.pointer
    Ref = types.reference
    Buffer = types.buffer
    Grow = types.buffer
    Slice = types.view
    size_of = native_type -> types.layout(native_type, { pointer_bits = 64 }).size
end

-- the compilation: the data every activity of one compilation shares (compiler activities
-- §1.1): its identity supply, places, borrows, exports and the origins of source positions
local new_compilation = do()
    local supply = identity.supply()
    local origins, origin_ids = {}, {}
    return define
        .supply
        places = {}
        place_scope = {}
        borrows = {}
        exports = {}
        .origins
        origin = do(origin_source, line)
            local key = tostring origin_source .. ":" .. tostring line
            local found = origin_ids[key]
            if found then return found end
            found = supply.fresh identity.OriginId
            origin_ids[key] = found
            origins[found] = data.Origin { id = found, span = data.Span { source = origin_source or "?", line = math.max(line or 1, 1) } }
            return found
        end
    end
end

-- the host environment Nua sources run in: the prelude, the runtime the front end's output
-- calls (`__nua`), `import` of the Nua library, and the primitives. Answers the environment
-- and the loader of a source text.
local hosting_environment = do(compilation, filename)
    local runtime = define
        word = hosting.word
        record = do(name, fields, line)
            for _, field in ipairs fields do
                if not check(types.NativeType, field.type) then
                    error(("%s:%d: the field '%s' of %s is %s, not a native type"):format(filename, line, field.name, name, tostring field.type), 0)
                end
            end
            local ok, record_or_problem = pcall(types.record, name, fields)
            if not ok then error(("%s:%d: %s"):format(filename, line, tostring record_or_problem), 0) end
            return record_or_problem
        end
        sum = do(name, alternatives, line)
            local ok, sum_or_problem = pcall(types.sum, name, alternatives)
            if not ok then error(("%s:%d: %s"):format(filename, line, tostring sum_or_problem), 0) end
            return sum_or_problem
        end
        export = do(value, c_name, line)
            if not (hosting.is_word value or hosting.is_application value) then
                error(("%s:%d: export needs a word, got %s"):format(filename, line, tostring value), 0)
            end
            compilation.exports[#compilation.exports + 1] = { .value, .c_name, .line }
        end
    end
    local environment = setmetatable({ __nua = runtime, platform = platform.bindings, ..prelude }, { __index = _G })
    local load_nua = do(text, name)
        local chunk, problem = mua.load(text, "@" .. name, { host = front.host name })
        if not chunk then error(problem, 0) end
        setfenv(chunk, environment)
        return chunk()
    end
    -- `import "allocator"`: a Nua library from next/lib, compiled once in this compilation
    local imported = {}
    environment.import = do(name)
        if imported[name] == nil then
            local path = ("%s/%s.nua"):format(library_directory, name)
            local file = io.open(path, "rb")
            if not file then error(("import: no Nua library %s (looked for %s)"):format(name, path), 2) end
            local text = file:read "*a"
            file:close()
            imported[name] = { value = load_nua(text, path) }
        end
        return imported[name].value
    end
    for _, name in ipairs { "trap", "moves", "ends", "view_of", "element_of", "drop" } do environment[name] = hosting.primitive name end
    environment.owns = types.owns
    return environment, load_nua
end

-- an export closed into a specification: its known supply stays known, the native
-- requirements still unsupplied are its parameters
local export_specification = do(E, export, filename)
    local word, supplied = hosting.supplied_of export.value
    local specification = {}
    for index, requirement in ipairs word.requirements do
        local argument = supplied[index]
        if index <= #supplied then
            if requirement.type == nil then
                specification[index] = specifications.KnownHost { value = argument }
            else
                local path = { source = filename, line = export.line }
                specification[index] = specifications.KnownNative { value = E.from_host(path, requirement.type, argument, ("the argument '%s' of %s"):format(requirement.name, word.name)) }
            end
        else
            if requirement.type == nil then
                error(("%s:%d: export %s: the parameter '%s' needs a native type"):format(filename, export.line, export.c_name, requirement.name), 0)
            end
            specification[index] = specifications.Dynamic { type = requirement.type }
        end
    end
    return word, specification
end

-- only definitions reachable from the exports are kept (compiler activities §6.3): one
-- requested by a construction that was later discarded is not part of the program
local reachable_definitions = do(built, exports)
    local definitions, pending = {}, {}
    for _, export in ipairs exports do pending[#pending + 1] = export.definition end
    while #pending > 0 do
        local id = table.remove pending
        if definitions[id] == nil then
            definitions[id] = built[id]
            for called in pairs(graph.called_definitions built[id]) do pending[#pending + 1] = called end
        end
    end
    return definitions
end

-- the verifiers over the finished program and its facts; any problem refuses the compilation
local verified = do(program, analysis, filename)
    local problems = verify.all program
    for _, problem in ipairs(verify_lifetimes.lifetimes(program, analysis)) do problems[#problems + 1] = problem end
    if #problems == 0 then return end
    local lines = {}
    for _, problem in ipairs problems do lines[#lines + 1] = ("%s: %s"):format(problem.verifier, problem.message) end
    error(filename .. ": the compiled program does not verify:\n" .. table.concat(lines, "\n"), 0)
end

-- a source compiled: run it in the host environment, close its exports into definitions, keep
-- what they reach, publish the facts, and verify
local compiling = do(source, filename)
    local compilation = new_compilation()
    -- the evaluation and the definitions cooperate: each receives the other's vocabulary,
    -- wired here explicitly (compiler activities §1.1)
    local definitions_capability, library_capability = {}, {}
    local E = evaluate.evaluating(compilation, { definitions = definitions_capability, library = library_capability })
    local registry = definitions_module.defining(compilation, E)
    definitions_capability.request = registry.request
    definitions_capability.contract_of = registry.contract_of
    definitions_capability.bundle_of = registry.bundle_of
    local environment, load_nua = hosting_environment(compilation, filename)
    -- the words of buffers of each element type, from the Nua library
    library_capability.buffer_words = element -> environment.import("buffer").words(element)
    load_nua(source, filename)

    local exports = {}
    for _, export in ipairs compilation.exports do
        local word, specification = export_specification(E, export, filename)
        local id = registry.define_export(word, specification, filename, export.line)
        exports[#exports + 1] = data.Export { name = export.c_name, definition = id }
    end
    local definitions = reachable_definitions(registry.definitions(), exports)
    local program = data.Program with
        revision = 0
        .definitions
        words = registry.words()
        globals = {}
        .exports
        lifetimes = {}
        origins = compilation.origins
    end
    local published, contracts = {}, {}
    local all_facts, all_contracts = registry.facts(), registry.contracts()
    for id in pairs definitions do
        published[id] = assert(all_facts[id])
        contracts[id] = assert(all_contracts[id])
    end
    local analysis = data.Analysis { revision = program.revision, definitions = published, .contracts }
    verified(program, analysis, filename)
    return define
        .program
        .analysis
        .exports
    end
end

local compile_c = do(source, filename)
    local compiled = compiling(source, filename)
    local text, prototypes = emit_c.emit compiled.program
    return text, prototypes, compiled.program
end

return define
    compile = compiling
    .compile_c
end
