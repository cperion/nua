-- The evaluation vocabulary, part: Views: held borrows of a buffer's contents, derived from its
-- current header; stored views fixed where they are written.
-- A part adds its verbs to the one vocabulary E (compiler activities §5.2); parts reach one
-- another only through E, and the evaluation's construction capabilities through core.

local ffi = require "ffi"
local identity = require "nua.identity"
local types = require "nua.types"
local data = require "nua.compiler.data"
local cells = require "nua.compiler.evaluation.cells"
local graph = require "nua.compiler.graph"
local facts = require "nua.compiler.facts"
local rules = require "nua.compiler.rules"
local hosting = require "nua.compiler.hosting"
local platform = require "nua.compiler.platform"
local effects = require "nua.compiler.effects"
local borrow_paths = require "nua.compiler.borrow_paths"
local provenance = require "nua.compiler.provenance"
local boundaries = require "nua.compiler.boundaries"
local NativeValue, Operand, Contents = data.NativeValue, data.Operand, data.Contents
local is_native = value -> check(NativeValue, value)
local lua_type = type

return do(E, core)
    local supply, fresh, tracking, memory, fail, site, origin_of, remember_borrows, enter, append, terminate, remember_reference, definitions = core.supply, core.fresh, core.tracking, core.memory, core.fail, core.site, core.origin_of, core.remember_borrows, core.enter, core.append, core.terminate, core.remember_reference, core.definitions
    local compilation = core.compilation
    --------------------------------------------------------------------------------------------
    -- views (buffers §2.3): a held borrow of a buffer's contents is a path from the buffer's
    -- place with a range; each use derives the pointer from the buffer's current header, so
    -- growth never ends it, and shrinking or clearing does


    -- `view_of(self, first, count)`: the primitive a buffer's words make views with
    -- (`view_type`, when given, the view to make of a buffer's elements: a `Slice.mut`, or a
    -- `Str` of a buffer of bytes)
    E.make_view = do(path, reference, first, count, view_type)
        if not (E.is_reference reference and types.NativeType.is(reference.type, types.ReferenceType)) then fail(path, "view_of takes a reference to a buffer") end
        if data.BorrowForm.is(compilation.borrows[reference.borrow].form, data.Selected) then
            return E.dispatch_reference(path, reference, |arm, selected| -> E.make_view(arm, selected, first, count, view_type))
        end
        -- Constructing a held view records its path; it does not derive an address.
        local state = assert(path.flow.borrows[reference.borrow])
        if data.BorrowState.is(state, data.Ended) then fail(path, ("a borrow is used after it ended (%s)"):format(state.reason)) end
        local buffer_type = reference.type.target
        local base_info = compilation.borrows[reference.borrow]
        local base = base_info.form
        if not data.BorrowForm.is(base, data.Held) then fail(path, "a held view through this stored header reference is not available yet") end
        local steps = {}
        for index, step in ipairs base.path.steps do steps[index] = step end
        steps[#steps + 1] = data.ContentsStep {}
        if not E.is_buffer buffer_type then fail(path, "view_of takes a reference to a buffer") end
        first = E.from_host(path, types.U64, first, "the first element of the view")
        count = E.from_host(path, types.U64, count, "the length of the view")
        local borrow_path = data.BorrowPath { root = base.path.root, .steps, indices = base.path.indices, range = data.Range { first = first.operand, count = count.operand } }
        local info = tracking.borrow(path.flow, borrow_path, false, base_info.lifetime, origin_of path, reference.borrow)
        local origins = {}
        for _, origin in ipairs base_info.origins do
            local extended = {}
            for position, step in ipairs origin.path do extended[position] = step end
            extended[#extended + 1] = data.ContentsStep {}
            origins[#origins + 1] = data.Access { place = origin.place, path = extended }
        end
        info = data.BorrowInfo { ..info, .origins }
        compilation.borrows[info.id] = info
        local made = view_type or types.view(buffer_type.element)
        if not types.NativeType.is(made, types.ViewType) or made.element ~= buffer_type.element then
            fail(path, ("view_of makes a view of %s, not %s"):format(types.describe buffer_type.element, types.describe made))
        end
        if made.mutable then info = data.BorrowInfo { ..info, mutable = true } end
        compilation.borrows[info.id] = info
        return data.Reference { type = made, borrow = info.id }
    end

    -- the pointer to a view's first element here, and its count
    E.view_pair_types = {}
    E.view_parts = do(path, view)
        local info = compilation.borrows[view.borrow]
        if data.BorrowForm.is(info.form, data.Selected) then
            local pair_type = E.view_pair_types[view.type]
            if pair_type == nil then
                pair_type = types.record("view coordinates", { { name = "data", type = types.pointer(view.type.element) }, { name = "length", type = types.U64 } })
                E.view_pair_types[view.type] = pair_type
            end
            local pair = E.dispatch_reference(path, view, do(arm, selected)
                local start, count = E.view_parts(arm, selected)
                return data.Aggregate { type = pair_type, parts = { data = start, length = count } }
            end)
            return E.part(path, pair, "data"), E.part(path, pair, "length")
        end
        local use = tracking.use(path.flow, view.borrow)
        return use with
            ended = state -> fail(path, ("a borrow is used after it ended (%s)"):format(state.reason))
            fixed = do(packed)
                local pointer_type = types.pointer view.type.element
                -- a constant view (static text): its parts are known
                if Operand.is(packed, data.Constant) and data.NativeConstant.is(packed.bits, data.AggregateBits) then
                    return E.known(data.Constant { type = pointer_type, bits = packed.bits.parts[1] }), E.known(data.Constant { type = types.U64, bits = packed.bits.parts[2] })
                end
                local start = E.extract(path, packed, data.FieldComponent { name = "data" }, pointer_type)
                local count = E.extract(path, packed, data.FieldComponent { name = "length" }, types.U64)
                return E.bits(pointer_type, start), E.bits(types.U64, count)
            end
            select = selected -> error("a selected view must be dispatched", 0)
            cached = pointer -> fail(path, "a cached view pointer is not available yet")
            derive = do(borrow_path)
                local steps = {}
                for index = 1, #borrow_path.steps - 1 do steps[index] = borrow_path.steps[index] end
                local reached = E.reach_path(path, data.BorrowPath { root = borrow_path.root, .steps, indices = borrow_path.indices }, view.borrow)
                local header = E.reached_value(path, reached)
                if not cells.is_raw(reached) then header = E.deref(path, header) end
                local first = E.bits(types.U64, borrow_path.range.first)
                -- a view of an array: its address, which puts the array in memory (syntax §13)
                if E.is_array header.type then
                    local base = tracking.borrow(path.flow, data.BorrowPath { root = borrow_path.root, .steps, indices = borrow_path.indices }, false, compilation.borrows[view.borrow].lifetime, origin_of path, view.borrow)
                    local address = E.pack_reference(path, data.Reference { type = types.reference header.type, borrow = base.id })
                    local element_pointer = types.pointer view.type.element
                    local start = E.compute(path, "reinterpret", element_pointer, { E.bits(address.type, address) })
                    return E.compute(path, "pointer_offset", element_pointer, { start, first }), E.bits(types.U64, borrow_path.range.count)
                end
                local data_pointer = E.part(path, header, "data")
                local start = E.compute(path, "pointer_offset", data_pointer.type, { data_pointer, first })
                return start, E.bits(types.U64, borrow_path.range.count)
            end
        end
    end

    -- A reference/view written into a record is stored: its pointer (and a view's
    -- count) is fixed there, including when its source was selected or held.
    E.stored_borrow = do(path, view)
        if not E.is_reference(view) then return view end
        local info = compilation.borrows[view.borrow]
        if data.BorrowForm.is(info.form, data.Stored) then return view end
        local packed = E.is_view(view) and E.pack_view(path, view) or E.pack_reference(path, view)
        local stored = tracking.store(path.flow, view.borrow, packed, origin_of path)
        remember_reference(path, packed, stored.id)
        return data.Reference { type = view.type, borrow = stored.id }
    end

    -- a view as a value in memory: its current pointer and count, packed
    E.pack_view = do(path, view)
        local start, count = E.view_parts(path, view)
        local result = fresh identity.ValueId
        append(path, data.Pack { site = site path, .result, type = view.type, components = { start.operand, count.operand } })
        local operand = data.Result { value = result, type = view.type }
        remember_reference(path, operand, view.borrow)
        return operand
    end

    -- the view primitives (syntax §12.2): what the Slice words of the Nua library are written
    -- over. None checks a bound: the words do.

    -- `static_text(bytes)`: a Lua string as a `Str` of static data (syntax §14.1, `Str.__cast`):
    -- a constant view, borrowing nothing that ends (§9.5)
    E.static_text = do(path, bytes)
        if lua_type bytes ~= "string" then fail(path, "static_text takes a Lua string") end
        local constant = data.Constant { type = types.Str, bits = data.AggregateBits { parts = {
            data.StaticAddress { .bytes, offset = 0 }, data.IntegerBits { bits = ffi.cast("uint64_t", #bytes) },
        } } }
        local info = data.BorrowInfo { id = fresh identity.BorrowId, form = data.Stored { pointer = constant }, origins = {}, mutable = false, lifetime = fresh identity.LifetimeId, acquired = origin_of path }
        compilation.borrows[info.id] = info
        path.flow.borrows[info.id] = data.Live {}
        path.writer.borrow info
        return data.Reference { type = types.Str, borrow = info.id }
    end

    -- `view_data(s)`: the raw pointer to a view's first element (for the bytes of a mechanism)
    E.view_data = do(path, view)
        if not E.is_view view then fail(path, "view_data takes a view") end
        local start = E.view_parts(path, view)
        return start
    end

    -- `view_length(s)`: a view's count, from its current coordinates
    E.view_length = do(path, view)
        if not E.is_view view then fail(path, "view_length takes a view") end
        -- a held view's count is in its range: no pointer is derived for it
        local use = tracking.use(path.flow, view.borrow)
        local held = use with
            ended = state -> fail(path, ("a borrow is used after it ended (%s)"):format(state.reason))
            derive = borrow_path -> E.bits(types.U64, borrow_path.range.count)
            cached = pointer -> nil
            fixed = pointer -> nil
            select = selected -> nil
        end
        if held then return held end
        local _, count = E.view_parts(path, view)
        return count
    end

    -- `view_element_of(s, i)`: a reference to element `i` of a view, through the view's borrow:
    -- of a held view, held (element `first + i` of the buffer's contents, rederived after
    -- growth); of a stored view, a fixed pointer
    E.view_element_of = do(path, view, index)
        if not E.is_view view then fail(path, "view_element_of takes a view") end
        local info = compilation.borrows[view.borrow]
        if data.BorrowForm.is(info.form, data.Selected) then
            return E.dispatch_reference(path, view, |arm, selected| -> E.view_element_of(arm, selected, index))
        end
        index = E.from_host(path, types.U64, index, "the index")
        local reference_type = types.reference view.type.element
        local use = tracking.use(path.flow, view.borrow)
        return use with
            ended = state -> fail(path, ("a borrow is used after it ended (%s)"):format(state.reason))
            select = selected -> error("a selected view must be dispatched", 0)
            cached = pointer -> fail(path, "a cached view pointer is not available yet")
            derive = do(borrow_path)
                local at = E.operate(path, "add", E.bits(types.U64, borrow_path.range.first), index)
                local constant = E.constant_of at
                local step = constant and data.KnownElement { index = tonumber(rules.integer_value constant) } or data.AnyElement {}
                local steps, indices = {}, {}
                for position, existing in ipairs borrow_path.steps do steps[position] = existing end
                for position, operand in ipairs(borrow_path.indices or {}) do indices[position] = operand end
                steps[#steps + 1] = step
                indices[#indices + 1] = at.operand
                local element = tracking.borrow(path.flow, data.BorrowPath { root = borrow_path.root, .steps, .indices }, info.mutable, info.lifetime, origin_of path, view.borrow)
                local origins = {}
                for _, origin in ipairs info.origins do
                    local extended = {}
                    for position, existing in ipairs origin.path do extended[position] = existing end
                    extended[#extended + 1] = step
                    origins[#origins + 1] = data.Access { place = origin.place, path = extended }
                end
                element = data.BorrowInfo { ..element, .origins }
                compilation.borrows[element.id] = element
                return data.Reference { type = reference_type, borrow = element.id }
            end
            fixed = do(packed)
                local start = E.view_parts(path, view)
                local pointer = E.compute(path, "pointer_offset", start.type, { start, index })
                local operand = E.compute(path, "reinterpret", reference_type, { pointer }).operand
                local element = data.BorrowInfo { ..info, id = fresh identity.BorrowId, form = data.Stored { pointer = operand }, acquired = origin_of path, source = view.borrow }
                compilation.borrows[element.id] = element
                path.flow.borrows[element.id] = path.flow.borrows[view.borrow]
                remember_reference(path, operand, element.id)
                return data.Reference { type = reference_type, borrow = element.id }
            end
        end
    end

    -- `subview_of(s, first, count)`: the view of `count` elements from `first` of a view; a
    -- held view's is held (rederived from the current header), a stored view's stored
    E.subview_of = do(path, view, first, count)
        if not E.is_view view then fail(path, "subview_of takes a view") end
        local info = compilation.borrows[view.borrow]
        if data.BorrowForm.is(info.form, data.Selected) then
            return E.dispatch_reference(path, view, |arm, selected| -> E.subview_of(arm, selected, first, count))
        end
        first = E.from_host(path, types.U64, first, "the first element")
        count = E.from_host(path, types.U64, count, "the count")
        local use = tracking.use(path.flow, view.borrow)
        return use with
            ended = state -> fail(path, ("a borrow is used after it ended (%s)"):format(state.reason))
            select = selected -> error("a selected view must be dispatched", 0)
            cached = pointer -> fail(path, "a cached view pointer is not available yet")
            derive = do(borrow_path)
                local start = E.operate(path, "add", E.bits(types.U64, borrow_path.range.first), first)
                local held = data.BorrowPath { root = borrow_path.root, steps = borrow_path.steps, indices = borrow_path.indices, range = data.Range { first = start.operand, count = count.operand } }
                local sub = tracking.borrow(path.flow, held, info.mutable, info.lifetime, origin_of path, view.borrow)
                sub = data.BorrowInfo { ..sub, origins = info.origins }
                compilation.borrows[sub.id] = sub
                return data.Reference { type = view.type, borrow = sub.id }
            end
            fixed = do(packed)
                local start = E.view_parts(path, view)
                local moved = E.compute(path, "pointer_offset", start.type, { start, first })
                -- a sub-view of a constant view (static text) is a constant view
                if E.constant_of moved and E.constant_of count then
                    local constant = data.Constant { type = view.type, bits = data.AggregateBits { parts = { moved.operand.bits, count.operand.bits } } }
                    local sub = data.BorrowInfo { ..info, id = fresh identity.BorrowId, form = data.Stored { pointer = constant }, acquired = origin_of path, source = view.borrow }
                    compilation.borrows[sub.id] = sub
                    path.flow.borrows[sub.id] = path.flow.borrows[view.borrow]
                    path.writer.borrow sub
                    return data.Reference { type = view.type, borrow = sub.id }
                end
                local result = fresh identity.ValueId
                append(path, data.Pack { site = site path, .result, type = view.type, components = { moved.operand, count.operand } })
                local operand = data.Result { value = result, type = view.type }
                local sub = data.BorrowInfo { ..info, id = fresh identity.BorrowId, form = data.Stored { pointer = operand }, acquired = origin_of path, source = view.borrow }
                compilation.borrows[sub.id] = sub
                path.flow.borrows[sub.id] = path.flow.borrows[view.borrow]
                remember_reference(path, operand, sub.id)
                return data.Reference { type = view.type, borrow = sub.id }
            end
        end
    end
end
